  <ul class="bottom-nav-list">
    <li class="bottom-nav-slot">
      <a href="/#start" class="bottom-nav-item" data-nav-section="start">
        <span class="bnav-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>
          </svg>
        </span>
        <span class="bnav-label">Start</span>
      </a>
    </li>

    <li class="bottom-nav-slot">
      <a href="/#teams" class="bottom-nav-item" data-nav-section="teams">
        <span class="bnav-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/>
            <circle cx="9" cy="7" r="4"/>
            <path d="M22 21v-2a4 4 0 0 0-3-3.87"/>

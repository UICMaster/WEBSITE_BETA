    </li>

    <li class="bottom-nav-slot">
      <a href="/#tabelle" class="bottom-nav-item" data-nav-section="tabelle">
        <span class="bnav-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 20V10"/>
            <path d="M12 20V4"/>
            <path d="M6 20v-6"/>
          </svg>
        </span>
        <span class="bnav-label">Tabelle</span>
      </a>
    </li>

    <li class="bottom-nav-slot">
      <a href="/#termine" class="bottom-nav-item" data-nav-section="termine">
        <span class="bnav-icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>

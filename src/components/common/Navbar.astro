</nav>

<!-- Backdrop + Slide-Up "Mehr" Bottom Sheet -->
<div id="mobile-sheet-backdrop" class="mobile-sheet-backdrop" aria-hidden="true"></div>

<aside
  id="mobile-more-sheet"
  class="mobile-more-sheet"
  role="dialog"
  aria-modal="true"
  aria-labelledby="mobile-sheet-title"
  aria-hidden="true"
>
  <button type="button" id="mobile-sheet-handle" class="sheet-handle-trigger" aria-label="Menü schließen">
    <span class="sheet-handle-bar" aria-hidden="true"></span>
  </button>

  <div class="sheet-header">
    <a href="/#start" class="sheet-brand" data-sheet-link>
      <img src="/assets/logo/logo.svg" alt="UIC Logo" width="26" height="26" />
      <span id="mobile-sheet-title" class="sheet-title">ULTRA INSTINCT CREW</span>
    </a>
    <button type="button" id="mobile-sheet-close" class="sheet-close" aria-label="Menü schließen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <line x1="18" y1="6" x2="6" y2="18"/>
        <line x1="6" y1="6" x2="18" y2="18"/>
      </svg>
    </button>
  </div>

  <div class="sheet-section-label text-mono">BEREICHE</div>
  <nav aria-label="Weitere Bereiche">
    <ul class="sheet-grid">
      <li>
        <a href="/#organisation" class="sheet-tile" data-nav-section="organisation" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Organisation</span>
        </a>
      </li>

      <li>
        <a href="/ruhmeshalle" class="sheet-tile" data-nav-path="/ruhmeshalle" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7z"/>
              <path d="M5 20h14"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Ruhmeshalle</span>
        </a>
      </li>

      <li>
        <a href="/#stream" class="sheet-tile" data-nav-section="stream" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="7" width="20" height="15" rx="2"/>
              <polyline points="17 2 12 7 7 2"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Live-Stream</span>
        </a>
      </li>

      <li>
        <a href="/#partner" class="sheet-tile" data-nav-section="partner" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Partner</span>
        </a>
      </li>

      <li>
        <a href="/#medien" class="sheet-tile" data-nav-section="medien" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Medien</span>
        </a>
      </li>

      <li>
        <a href="/#bewerbung" class="sheet-tile" data-nav-section="bewerbung" data-sheet-link>
          <span class="sheet-tile-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round">
              <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="8.5" cy="7" r="4"/>
              <line x1="20" y1="8" x2="20" y2="14"/>
              <line x1="23" y1="11" x2="17" y2="11"/>
            </svg>
          </span>
          <span class="sheet-tile-text">Bewerbung</span>
        </a>
      </li>
    </ul>
  </nav>

  <div class="sheet-section-label text-mono">ANGEBOTE & LINKS</div>
  <div class="sheet-ext-row">
    <a
      href="https://teams.spized.com/ultrainstinctcrew"
      target="_blank"
      rel="noopener noreferrer"
      class="sheet-ext-pill"
      data-sheet-link
    >
      <span class="sheet-ext-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
          <line x1="3" y1="6" x2="21" y2="6"/>
          <path d="M16 10a4 4 0 0 1-8 0"/>
        </svg>
        <span>Offizieller Shop</span>
      </span>
      <span class="arrow-ext" aria-hidden="true">↗</span>
    </a>

    <a
      href="https://turnier.ultrainstinctcrew.com/"
      target="_blank"
      rel="noopener noreferrer"
      class="sheet-ext-pill"
      data-sheet-link
    >
      <span class="sheet-ext-left">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/>
          <path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/>
          <path d="M4 22h16"/>
          <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22"/>
          <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22"/>
          <path d="M18 2H6v7a6 6 0 0 0 12 0V2z"/>
        </svg>
        <span>UIC Turnier</span>
      </span>
      <span class="arrow-ext" aria-hidden="true">↗</span>
    </a>
  </div>

  <div class="sheet-footer">
    <a
      href="mailto:support@ultrainstinctcrew.com?subject=Bewerbung%20UIC%20Roster&body=Hallo%20UIC%20Team,%0D%0A%0D%0AHiermit%20m%C3%B6chte%20ich%20mich%20f%C3%BCr%20eines%20eurer%20Teams%20bewerben.%0D%0A%0D%0A---%20MEINE%20DATEN%20---%0D%0ASummoner%20Name:%20%0D%0AOp.gg%20Link:%20%0D%0AAktueller%20Rang:%20%0D%0APrim%C3%A4re%20Rolle:%20%0D%0ADiscord%20ID:%20%0D%0A%0D%0A---%20NACHRICHT%20---%0D%0A"
      class="btn btn-primary btn-full sheet-cta-btn"
      data-sheet-link
    >
      BEWIRB DICH ALS SPIELER ODER TEAM
    </a>

    <div class="sheet-legal-links text-mono">
      <a href="/impressum" data-nav-path="/impressum" data-sheet-link>Impressum</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/datenschutzbestimmungen" data-nav-path="/datenschutzbestimmungen" data-sheet-link>Datenschutz</a>
    </div>
  </div>
</aside>

<style>
  /* Free Floating Pill - Larger by default, shrinks on scroll down, expands on scroll up */
  .floating-nav-wrapper {
    position: fixed;
    top: 1.6rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 1000;
    width: max-content;
    max-width: min(1420px, calc(100vw - 2rem));
    pointer-events: none;
    transition: top 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .floating-nav-wrapper.is-compact {
    top: 1rem;
  }

  .pill-shell {
    position: relative;
    overflow: hidden;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 1.75rem;
    background: rgba(14, 14, 18, 0.92);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-full);
    padding: 11px 14px 11px 26px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.75), 0 0 0 1px rgba(255, 255, 255, 0.05);
    transition:
      padding 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      gap 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      border-color var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .floating-nav-wrapper.is-compact .pill-shell {
    gap: 1.25rem;
    padding: 7px 10px 7px 20px;
  }

  .pill-shell:hover {
    border-color: rgba(255, 255, 255, 0.28);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.1);
  }

  /* Left Brand */
  .brand-link {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    text-decoration: none;
  }

  .brand-crest {
    width: 36px;
    height: 36px;
    filter: drop-shadow(0 0 8px rgba(255, 255, 255, 0.2));
    transition:
      width 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      height 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      transform var(--transition-fast);
  }

  .floating-nav-wrapper.is-compact .brand-crest {
    width: 30px;
    height: 30px;
  }

  .brand-link:hover .brand-crest {
    transform: scale(1.08);
  }

  .brand-wordmark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.38rem;
    letter-spacing: 0.04em;
    color: var(--text-white);
    transition: font-size 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .floating-nav-wrapper.is-compact .brand-wordmark {
    font-size: 1.2rem;
  }

  /* Center Nav Links & Physical Sliding Glider */
  .nav-menu {
    position: relative;
    display: flex;
    align-items: center;
  }

  .nav-glider {
    position: absolute;
    top: 50%;
    left: 0;
    height: calc(100% - 4px);
    transform: translate3d(var(--glider-x, 0px), -50%, 0);
    width: var(--glider-w, 0px);
    background: rgba(255, 255, 255, 0.11);
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: var(--radius-full);
    pointer-events: none;
    opacity: var(--glider-opacity, 0);
    transition:
      transform 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      width 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.2s ease,
      height 0.32s cubic-bezier(0.22, 1, 0.36, 1);
    z-index: 0;
  }

  .nav-links {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    list-style: none;
    gap: 6px;
    margin: 0;
    padding: 0;
    transition: gap 0.32s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .floating-nav-wrapper.is-compact .nav-links {
    gap: 2px;
  }

  .nav-item {
    display: block;
    padding: 0.6rem 1.05rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-secondary);
    border-radius: var(--radius-full);
    transition:
      padding 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      font-size 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      color var(--transition-fast);
    white-space: nowrap;
    text-decoration: none;
  }

  .floating-nav-wrapper.is-compact .nav-item {
    padding: 0.45rem 0.85rem;
    font-size: 0.8125rem;
  }

  .nav-item:hover,
  .nav-item.is-active {
    color: var(--text-white);
  }

  .nav-ext {
    color: var(--text-muted);
  }

  .arrow-ext {
    font-size: 0.7em;
    opacity: 0.7;
  }

  /* Right Action */
  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .btn-pill-apply {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #ffffff;
    color: #000000;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8125rem;
    letter-spacing: 0.05em;
    padding: 0.72rem 1.65rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(255, 255, 255, 0.2);
    transition:
      padding 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      font-size 0.32s cubic-bezier(0.22, 1, 0.36, 1),
      background var(--transition-fast),
      transform var(--transition-fast),
      box-shadow var(--transition-fast);
  }

  .floating-nav-wrapper.is-compact .btn-pill-apply {
    font-size: 0.75rem;
    padding: 0.55rem 1.35rem;
  }

  .btn-pill-apply:hover {
    background: #f4f4f5;
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(255, 255, 255, 0.3);
  }

  /* Mobile Bottom Navigation Bar (hidden on desktop) */
  .mobile-bottom-bar,
  .mobile-sheet-backdrop,
  .mobile-more-sheet {
    display: none;
  }

  @media (max-width: 1100px) {
    .desktop-only {
      display: none !important;
    }

    /* Full-width docked native-style bottom bar */
    .mobile-bottom-bar {
      display: block;
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      background: rgba(10, 10, 14, 0.94);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-top: 1px solid rgba(255, 255, 255, 0.14);
      box-shadow: 0 -10px 32px rgba(0, 0, 0, 0.8);
      padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    }

    .bottom-nav-list {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(5, minmax(0, 1fr));
      max-width: 560px;
      margin: 0 auto;
      padding: 0;
      gap: 2px;
    }

    .bottom-nav-slot {
      min-width: 0;
    }

    .bottom-nav-item {
      width: 100%;
      min-height: 52px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      padding: 4px 2px;
      color: var(--text-muted);
      text-decoration: none;
      border-radius: var(--radius-sm);
      -webkit-tap-highlight-color: transparent;
      transition: color var(--transition-fast), transform 0.12s ease;
    }

    .bottom-nav-item:active {
      transform: scale(0.94);
    }

    .bnav-icon-wrap {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 46px;
      height: 28px;
      border-radius: var(--radius-full);
      border: 1px solid transparent;
      transition:
        background var(--transition-fast),
        border-color var(--transition-fast),
        color var(--transition-fast),
        box-shadow var(--transition-fast);
    }

    .bnav-label {
      font-family: var(--font-display);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.01em;
      line-height: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }

    .bottom-nav-item:hover,
    .bottom-nav-item.is-active,
    .bottom-more-btn.is-open {
      color: var(--text-white);
    }

    .bottom-nav-item.is-active .bnav-icon-wrap,
    .bottom-more-btn.is-open .bnav-icon-wrap {
      background: rgba(255, 255, 255, 0.14);
      border-color: rgba(255, 255, 255, 0.25);
      box-shadow: 0 2px 12px rgba(255, 255, 255, 0.08);
    }

    /* Subtle active dot on "Mehr" when viewing secondary sections/pages */
    .more-active-dot {
      position: absolute;
      top: 4px;
      right: 8px;
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: #ffffff;
      box-shadow: 0 0 6px rgba(255, 255, 255, 0.75);
      opacity: 0;
      transform: scale(0.5);
      transition: opacity var(--transition-fast), transform var(--transition-fast);
    }

    .bottom-more-btn.has-secondary-active .more-active-dot {
      opacity: 1;
      transform: scale(1);
    }

    .bottom-more-btn.has-secondary-active:not(.is-open) {
      color: var(--text-primary);
    }

    .bottom-more-btn.has-secondary-active:not(.is-open) .bnav-icon-wrap {
      background: rgba(255, 255, 255, 0.07);
      border-color: rgba(255, 255, 255, 0.14);
    }

    /* Sheet Backdrop */
    .mobile-sheet-backdrop {
      display: block;
      position: fixed;
      inset: 0;
      z-index: 1001;
      background: rgba(0, 0, 0, 0.68);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.24s ease, visibility 0.24s ease;
    }

    .mobile-sheet-backdrop.is-open {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    /* Slide-Up "Mehr" Sheet */
    .mobile-more-sheet {
      display: flex;
      flex-direction: column;
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 1002;
      max-width: 600px;
      width: 100%;
      max-height: 85dvh;
      margin: 0 auto;
      background: rgba(12, 12, 16, 0.98);
      backdrop-filter: blur(28px);
      -webkit-backdrop-filter: blur(28px);
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      border-left: 1px solid rgba(255, 255, 255, 0.08);
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 20px 20px 0 0;
      padding: 8px 18px calc(18px + env(safe-area-inset-bottom));
      box-shadow: 0 -20px 60px rgba(0, 0, 0, 0.9);
      overflow-y: auto;
      transform: translateY(105%);
      visibility: hidden;
      pointer-events: none;
      transition: transform 0.28s cubic-bezier(0.22, 1, 0.36, 1), visibility 0.28s ease;
    }

    .mobile-more-sheet.is-open {
      transform: translateY(0);
      visibility: visible;
      pointer-events: auto;
    }

    .sheet-handle-trigger {
      display: flex;
      justify-content: center;
      padding: 4px 0 10px;
      width: 100%;
    }

    .sheet-handle-bar {
      width: 38px;
      height: 4px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.25);
    }

    .sheet-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding-bottom: 12px;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.09);
    }

    .sheet-brand {
      display: flex;
      align-items: center;
      gap: 10px;
      text-decoration: none;
    }

    .sheet-title {
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      color: var(--text-white);
    }

    .sheet-close {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 34px;
      height: 34px;
      border-radius: var(--radius-full);
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(255, 255, 255, 0.05);
      color: var(--text-primary);
      cursor: pointer;
      transition: background var(--transition-fast), border-color var(--transition-fast);
    }

    .sheet-close:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(255, 255, 255, 0.28);
    }

    .sheet-section-label {
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      color: var(--text-dim);
      margin-bottom: 8px;
    }

    .sheet-grid {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 16px;
      padding: 0;
    }

    .sheet-tile {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 12px;
      background: rgba(255, 255, 255, 0.035);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: var(--radius-md);
      color: var(--text-secondary);
      text-decoration: none;
      font-family: var(--font-display);
      font-size: 0.875rem;
      font-weight: 700;
      transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }

    .sheet-tile:hover,
    .sheet-tile.is-active {
      background: rgba(255, 255, 255, 0.11);
      border-color: rgba(255, 255, 255, 0.26);
      color: var(--text-white);
    }

    .sheet-tile-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      border-radius: var(--radius-xs);
      background: rgba(255, 255, 255, 0.06);
      color: var(--text-primary);
      flex-shrink: 0;
    }

    .sheet-tile.is-active .sheet-tile-icon {
      background: #ffffff;
      color: #000000;
    }

    .sheet-tile-text {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sheet-ext-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-bottom: 16px;
    }

    .sheet-ext-pill {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      padding: 10px 12px;
      background: rgba(255, 255, 255, 0.025);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-sm);
      color: var(--text-secondary);
      font-size: 0.8125rem;
      font-weight: 700;
      text-decoration: none;
      transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
    }

    .sheet-ext-pill:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.24);
      color: var(--text-white);
    }

    .sheet-ext-left {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-width: 0;
    }

    .sheet-ext-left span {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .sheet-footer {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .sheet-cta-btn {
      font-family: var(--font-display);
      font-size: 0.8125rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      padding: 0.85rem 1.25rem;
      border-radius: var(--radius-full);
    }

    .sheet-legal-links {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      font-size: 0.72rem;
      color: var(--text-dim);
    }

    .sheet-legal-links a {
      color: var(--text-muted);
      text-decoration: none;
      padding: 2px 4px;
    }

    .sheet-legal-links a:hover,
    .sheet-legal-links a.is-active {
      color: var(--text-white);
    }
  }
</style>

<script>
  const navWrapper = document.getElementById('floating-nav-wrapper');
  const navGlider = document.getElementById('nav-glider');
  const navLinksContainer = document.getElementById('desktop-nav-links');
  const desktopNavItems = document.querySelectorAll<HTMLAnchorElement>('#desktop-nav-links .nav-item');

  const bottomNav = document.getElementById('mobile-bottom-nav');
  const bottomNavLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-bottom-nav .bottom-nav-item[data-nav-section]');
  const moreBtn = document.getElementById('mobile-more-btn');
  const moreSheet = document.getElementById('mobile-more-sheet');
  const sheetBackdrop = document.getElementById('mobile-sheet-backdrop');
  const sheetCloseBtn = document.getElementById('mobile-sheet-close');
  const sheetHandleBtn = document.getElementById('mobile-sheet-handle');
  const sheetTrackableLinks = document.querySelectorAll<HTMLAnchorElement>('#mobile-more-sheet [data-nav-section], #mobile-more-sheet [data-nav-path]');

  const PRIMARY_MOBILE_SECTIONS = new Set(['start', 'teams', 'tabelle', 'termine']);

  let activeDesktopNavEl: HTMLAnchorElement | null = null;
  let hoveredDesktopNavEl: HTMLAnchorElement | null = null;

  const moveNavGlider = (targetEl: HTMLAnchorElement | null) => {
    if (!navGlider || !navLinksContainer || !targetEl) {
      if (navGlider) navGlider.style.setProperty('--glider-opacity', '0');
      return;
    }
    const menuRect = navLinksContainer.parentElement?.getBoundingClientRect();
    const itemRect = targetEl.getBoundingClientRect();
    if (!menuRect || itemRect.width === 0) return;
    const offsetX = itemRect.left - menuRect.left;
    navGlider.style.setProperty('--glider-x', `${offsetX}px`);
    navGlider.style.setProperty('--glider-w', `${itemRect.width}px`);
    navGlider.style.setProperty('--glider-opacity', '1');
  };

  const syncActiveState = (mode: 'section' | 'path', value: string) => {
    // 1. Desktop pill + glider
    let matchedDesktop: HTMLAnchorElement | null = null;
    desktopNavItems.forEach((item) => {
      const matches = mode === 'section'
        ? item.getAttribute('data-nav-section') === value
        : item.getAttribute('data-nav-path') === value;
      item.classList.toggle('is-active', matches);
      if (matches) matchedDesktop = item;
    });
    activeDesktopNavEl = matchedDesktop;
    if (!hoveredDesktopNavEl) moveNavGlider(activeDesktopNavEl);

    // 2. Mobile bottom bar primary items
    bottomNavLinks.forEach((item) => {
      const matches = mode === 'section' && item.getAttribute('data-nav-section') === value;
      item.classList.toggle('is-active', matches);
      if (matches) {
        item.setAttribute('aria-current', 'location');
      } else {
        item.removeAttribute('aria-current');
      }
    });

    // 3. Mobile "Mehr" sheet items + secondary indicator dot on "Mehr" button
    let anySheetActive = false;
    sheetTrackableLinks.forEach((item) => {
      const matches = mode === 'section'
        ? item.getAttribute('data-nav-section') === value
        : item.getAttribute('data-nav-path') === value;
      item.classList.toggle('is-active', matches);
      if (matches) anySheetActive = true;
    });

    const isSecondarySection = mode === 'section' ? !PRIMARY_MOBILE_SECTIONS.has(value) : anySheetActive;
    moreBtn?.classList.toggle('has-secondary-active', isSecondarySection);
  };

  desktopNavItems.forEach((item) => {
    item.addEventListener('mouseenter', () => {
      hoveredDesktopNavEl = item;
      moveNavGlider(item);
    });
  });

  navLinksContainer?.addEventListener('mouseleave', () => {
    hoveredDesktopNavEl = null;
    moveNavGlider(activeDesktopNavEl);
  });

  // Path-based or Section-based Active Spy
  const path = window.location.pathname;
  if (path.includes('/ruhmeshalle') || path.includes('/honored')) {
    syncActiveState('path', '/ruhmeshalle');
  } else if (path.includes('/brandkit') || path.includes('/obs')) {
    syncActiveState('section', 'medien');
  } else if (path.includes('/impressum')) {
    syncActiveState('path', '/impressum');
  } else if (path.includes('/datenschutzbestimmungen')) {
    syncActiveState('path', '/datenschutzbestimmungen');
  } else {
    const sectionIds = new Set<string>();
    desktopNavItems.forEach((item) => {
      const sec = item.getAttribute('data-nav-section');
      if (sec) sectionIds.add(sec);
    });

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            syncActiveState('section', entry.target.id);
          }
        }
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: 0 }
    );

    sectionIds.forEach((id) => {
      const el = document.getElementById(id);
      if (el) observer.observe(el);
    });
  }

  // Desktop scroll-direction aware compact sizing
  if (navWrapper) {
    let lastScrollY = window.scrollY;

    const onScroll = () => {
      const currentY = window.scrollY;
      const wasCompact = navWrapper.classList.contains('is-compact');
      if (currentY <= 36) {
        navWrapper.classList.remove('is-compact');
      } else if (currentY > lastScrollY + 4) {
        navWrapper.classList.add('is-compact');
      } else if (currentY < lastScrollY - 4) {
        navWrapper.classList.remove('is-compact');
      }
      if (wasCompact !== navWrapper.classList.contains('is-compact')) {
        setTimeout(() => moveNavGlider(hoveredDesktopNavEl || activeDesktopNavEl), 330);
      }
      lastScrollY = currentY;
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => moveNavGlider(hoveredDesktopNavEl || activeDesktopNavEl), { passive: true });
    onScroll();
  }

  // Mobile Bottom Bar + Slide-Up "Mehr" Sheet controller
  if (bottomNav && moreBtn && moreSheet && sheetBackdrop) {
    const isSheetOpen = () => moreSheet.classList.contains('is-open');

    const openMoreSheet = () => {
      moreSheet.classList.add('is-open');
      sheetBackdrop.classList.add('is-open');
      moreBtn.classList.add('is-open');
      moreBtn.setAttribute('aria-expanded', 'true');
      moreSheet.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      sheetCloseBtn?.focus();
    };

    const closeMoreSheet = (restoreFocus = true) => {
      if (!isSheetOpen()) return;
      moreSheet.classList.remove('is-open');
      sheetBackdrop.classList.remove('is-open');
      moreBtn.classList.remove('is-open');
      moreBtn.setAttribute('aria-expanded', 'false');
      moreSheet.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (restoreFocus) moreBtn.focus();
    };

    moreBtn.addEventListener('click', () => {
      if (isSheetOpen()) {
        closeMoreSheet(false);
      } else {
        openMoreSheet();
      }
    });

    sheetCloseBtn?.addEventListener('click', () => closeMoreSheet(true));
    sheetHandleBtn?.addEventListener('click', () => closeMoreSheet(true));
    sheetBackdrop.addEventListener('click', () => closeMoreSheet(false));

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isSheetOpen()) {
        closeMoreSheet(true);
      }
    });

    moreSheet.querySelectorAll('[data-sheet-link]').forEach((link) => {
      link.addEventListener('click', () => closeMoreSheet(false));
    });

    // Ensure overflow/sheet state resets if viewport crosses desktop threshold
    const desktopMq = window.matchMedia('(min-width: 1101px)');
    desktopMq.addEventListener('change', (e) => {
      if (e.matches) closeMoreSheet(false);
    });
  }
</script>

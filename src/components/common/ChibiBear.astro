</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-chibi-widget]').forEach((spot) => {
    const btn = spot.querySelector<HTMLButtonElement>('.chibi-trigger');
    const bubble = spot.querySelector<HTMLElement>('[data-chibi-bubble]');
    const rawPhrases = spot.getAttribute('data-chibi-phrases');
    let phrases: string[] = [];
    try {
      phrases = rawPhrases ? JSON.parse(rawPhrases) : [];
    } catch {}

    let idx = 0;
    let talkTimer: ReturnType<typeof setTimeout> | undefined;
    const isSleepVariant = spot.classList.contains('chibi-sleep');

    btn?.addEventListener('click', () => {
      if (phrases.length > 0 && bubble) {
        idx = (idx + 1) % phrases.length;
        bubble.textContent = phrases[idx];
      }
      spot.classList.add('is-talking');
      if (talkTimer) clearTimeout(talkTimer);
      talkTimer = setTimeout(() => {
        spot.classList.remove('is-talking');
      }, isSleepVariant ? 4000 : 2400);
    });
  });
</script>

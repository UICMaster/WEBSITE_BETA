---
// src/components/overlay/OverlayTicker.astro
---

<!-- ======================================================================
     2. TOP DOCKED PRIME LEAGUE MATCH TICKER (SOLID BROADCAST DESIGN)
     ====================================================================== -->
<header id="overlay-ticker" role="region" aria-label="Ultra Instinct Crew Spieltage Ticker">
  <div class="ticker-brand-pill">
    <img src="/assets/logo/logo.svg" alt="UIC Wappen" class="ticker-crest" width="24" height="24" />
    <img src="/assets/logo/logo-wordmark.svg" alt="ULTRA INSTINCT CREW" class="ticker-wordmark" width="188" height="13" />
  </div>

  <div class="ticker-viewport">
    <div class="ticker-track" id="ticker-track">
      <div class="match-item">
        <span class="m-time-badge">SPIELPLAN</span>
      </div>
    </div>
  </div>
</header>

<style is:global>
  #overlay-ticker {
    position: fixed;
    top: 0;
    left: 0;
    width: 1920px;
    height: 54px;
    background: #0a0f1a;
    border-bottom: 1px solid #263147;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.75), inset 0 -1px 0 rgba(0, 229, 255, 0.22);
    z-index: 50;
    display: flex;
    align-items: center;
    transform: translateZ(0);
  }

  body.ticker-off #overlay-ticker,
  body.scene-starting #overlay-ticker {
    display: none !important;
  }

  .ticker-brand-pill {
    display: flex;
    align-items: center;
    gap: 14px;
    height: 100%;
    padding: 0 26px;
    background: #060a12;
    border-right: 1px solid #00E5FF;
    flex-shrink: 0;
    z-index: 2;
    position: relative;
  }

  .ticker-brand-pill::after {
    content: '';
    position: absolute;
    right: -1px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: #00E5FF;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
  }

  .ticker-crest {
    width: 24px;
    height: 24px;
    max-width: 24px;
    max-height: 24px;
    object-fit: contain;
    flex-shrink: 0;
    filter: drop-shadow(0 0 8px rgba(0, 229, 255, 0.4));
  }

  .ticker-wordmark {
    height: 13px;
    width: auto;
    object-fit: contain;
    display: block;
    flex-shrink: 0;
  }

  .ticker-viewport {
    flex: 1;
    overflow: hidden;
    position: relative;
    height: 100%;
    display: flex;
    align-items: center;
    mask-image: linear-gradient(90deg, transparent 0%, black 32px, black calc(100% - 32px), transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, black 32px, black calc(100% - 32px), transparent 100%);
  }

  .ticker-track {
    display: inline-flex;
    align-items: center;
    width: max-content;
    will-change: transform;
  }

  .match-item {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 16px;
    height: 38px;
    background: #060a12;
    border: 1px solid #1e293b;
    border-radius: 6px;
    flex-shrink: 0;
    white-space: nowrap;
    margin-right: 16px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .m-time-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #cbd5e1;
    background: #111827;
    border: 1px solid #263147;
    padding: 3px 9px;
    border-radius: 4px;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .m-time-badge.heute {
    background: #0c2333;
    color: #00E5FF;
    border-color: #00E5FF;
    font-weight: 800;
  }

  .m-time-badge.morgen {
    background: #1e1333;
    color: #d8b4fe;
    border-color: #a855f7;
    font-weight: 800;
  }

  .match-status-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: 4px;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .match-status-badge.is-confirmed {
    color: #10b981;
    background: #09221c;
    border: 1px solid #10b981;
  }

  .match-status-badge.is-unconfirmed {
    color: #f59e0b;
    background: #261b0a;
    border: 1px solid #f59e0b;
  }

  .match-status-badge.is-result {
    color: #ffffff;
    background: #0c2333;
    border: 1px solid #00E5FF;
  }

  .m-team {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .m-logo {
    width: 18px !important;
    height: 18px !important;
    max-width: 18px !important;
    max-height: 18px !important;
    object-fit: cover;
    border-radius: 4px;
    background: #060a12;
    flex-shrink: 0;
    display: inline-block;
  }

  .m-name {
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 700;
    color: #ffffff;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }

  .m-vs {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.6875rem;
    font-weight: 900;
    color: #00E5FF;
    padding: 0 2px;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }
</style>

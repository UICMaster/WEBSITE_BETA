---
// src/components/overlay/PregameScene.astro
---

<!-- SCENE 2: PREGAME (16:9 CAMS, STREAM CHAT, 5-STARTER STRIP & 320PX BLUEBOTTLE ZONE) -->
<section id="stage-pregame" class="broadcast-stage" aria-label="2. Pregame & Draft">
  <div class="pregame-content-wrap">

    <!-- 1. TOP SCOREBOARD & MATCHUP HEADER -->
    <header class="pregame-scoreboard" id="pregame-team-spotlight">
      <!-- Home Team (UIC) -->
      <div class="pg-team pg-home">
        <div class="pg-crest-wrap">
          <img id="pregame-uic-logo" class="pg-crest" src="/assets/logo/logo.png" alt="UIC Team" width="50" height="50" />
        </div>
        <div class="pg-team-info">
          <div class="pg-team-name" id="pregame-uic-name"></div>
          <div class="pg-team-sub text-mono" id="pregame-uic-meta"></div>
        </div>
        <div class="pg-team-stats">
          <div class="pg-stat-pill">
            <span class="pg-stat-lbl text-mono">BILANZ</span>
            <span class="pg-stat-val text-mono" id="pregame-record-val"></span>
          </div>
          <div class="pg-stat-pill">
            <span class="pg-stat-lbl text-mono">FORM</span>
            <div class="form-badges-row" id="pregame-form-pills"></div>
          </div>
        </div>
      </div>

      <!-- Center Matchup Spine -->
      <div class="pg-center-spine">
        <span class="pg-match-meta text-mono" id="pregame-match-meta">PRIME LEAGUE</span>
        <div class="pg-vs-pill text-mono">VS</div>
        <span class="pg-match-time text-mono" id="pregame-match-time"></span>
      </div>

      <!-- Away Team (Opponent) -->
      <div class="pg-team pg-away">
        <div class="pg-away-status">
          <span class="pg-status-chip text-mono" id="pregame-match-status">SPIELTAG</span>
        </div>
        <div class="pg-team-info pg-info-right">
          <div class="pg-team-name" id="pregame-enemy-name"></div>
          <div class="pg-team-sub away-sub text-mono" id="pregame-enemy-meta"></div>
        </div>
        <div class="pg-crest-wrap">
          <img id="pregame-enemy-logo" class="pg-crest" src="/assets/logo/logo.png" alt="Gegner" width="50" height="50" />
        </div>
      </div>
    </header>

    <!-- 1b. CLASSIC ORGA HEADER BAR (Shown when ?team=none) -->
    <header class="pregame-classic-bar">
      <div class="pcb-left">
        <img src="/assets/logo/logo.png" alt="UIC" class="pcb-logo" width="38" height="38" />
        <div class="pcb-title-group">
          <span class="pcb-title">ULTRA INSTINCT CREW</span>
          <span class="pcb-sub text-mono">PREGAME &amp; DRAFT LOBBY</span>
        </div>
      </div>
      <div class="pcb-right text-mono">
        <span>WEB: <strong>ultrainstinctcrew.com</strong></span>
        <span class="pcb-dot">&bull;</span>
        <span>DISCORD: <strong>discord.gg/ultrainstinctcrew</strong></span>
        <span class="pcb-dot">&bull;</span>
        <span>SHOP: <strong>teams.spized.com/ultrainstinctcrew</strong></span>
      </div>
    </header>

    <!-- 2. MAIN STAGE ROW: 16:9 CASTER CAMERAS & STREAM CHAT -->
    <div class="pregame-main-row" id="pregame-main-row">

      <!-- Strictly 16:9 Cams Container -->
      <div class="pregame-cams-wrapper" id="pregame-cams-wrapper">
        <!-- Cam 1 (16:9) -->
        <div class="cam-box-169" id="cam-box-1">
          <div class="cam-aspect-guard">
            <div class="cam-viewport-hole"></div>
            <div class="cam-lower-third">
              <span class="cam-lt-accent"></span>
              <span class="cam-lt-tag text-mono">DESK</span>
              <span class="cam-lt-sep"></span>
              <span class="cam-lt-name" id="cam-1-label">CASTER 1</span>
            </div>
          </div>
        </div>

        <!-- Cam 2 (16:9) -->
        <div class="cam-box-169" id="cam-box-2">
          <div class="cam-aspect-guard">
            <div class="cam-viewport-hole"></div>
            <div class="cam-lower-third">
              <span class="cam-lt-accent"></span>
              <span class="cam-lt-tag text-mono">DESK</span>
              <span class="cam-lt-sep"></span>
              <span class="cam-lt-name" id="cam-2-label">CASTER 2</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Fallback Matchup & Schedule Panel when Cams are hidden (?layout=none) -->
      <div class="pregame-nocam-stage" id="pregame-nocam-stage">
        <div class="nocam-header">
          <span class="nocam-tag text-mono">SPIELPLAN &amp; SAISONVERLAUF</span>
          <span class="nocam-sub text-mono" id="pregame-nocam-team"></span>
        </div>
        <div class="nocam-schedule-grid" id="pregame-nocam-schedule"></div>
      </div>

      <!-- Redesigned Stream Chat Window (Supports embedded Streamlabs Chat URL or OBS Source) -->
      <aside class="pregame-chat-card" id="pregame-chat-card">
        <div class="chat-card-header">
          <div class="chat-card-title">
            <span class="chat-title-accent"></span>
            <svg class="twitch-svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M11.571 4.714h1.715v5.143H11.57zm4.715 0H18v5.143h-1.714zM6 0L1.714 4.286v15.428h5.143V24l4.286-4.286h3.428L22.286 12V0zm14.571 11.143l-3.428 3.428h-3.429l-3 3v-3H6.857V1.714h13.714z"/></svg>
            <span>STREAM CHAT</span>
          </div>
          <span class="chat-channel-tag text-mono" id="chat-channel-tag">TWITCH</span>
        </div>
        <div class="chat-viewport-transparent" id="pregame-chat-viewport">
          <iframe
            id="chat-widget-iframe"
            class="chat-widget-iframe"
            title="Streamlabs Chat Widget"
            allow="autoplay; encrypted-media"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </aside>

    </div>

    <!-- 3. 5-STARTER LINEUP STRIP (DIRECTLY ABOVE THE 320PX BLUEBOTTLE DRAFT ZONE) -->
    <div class="pregame-starters-strip" id="pregame-starters-strip" aria-label="Startaufstellung">
      <!-- Populated via JS with 5 starters (TOP, JGL, MID, BOT, SUP) -->
    </div>

  </div>

  <!-- RESERVED 320PX BLUEBOTTLE DRAFT ZONE (Y: 760px - 1080px, 100% CLEAN & TRANSPARENT) -->
  <div id="bluebottle-reserve-zone" aria-hidden="true"></div>
</section>

<style is:global>
  /* --- SCENE 2: PREGAME & DRAFT STAGE --- */
  #stage-pregame {
    display: none;
    position: absolute;
    inset: 0;
    width: 1920px;
    height: 1080px;
    padding: 74px 88px 336px;
    box-sizing: border-box;
    overflow: hidden;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
  }

  body.ticker-off #stage-pregame {
    padding-top: 32px;
  }

  body.scene-pregame #stage-pregame {
    display: flex !important;
  }

  .pregame-content-wrap {
    width: 1744px;
    height: 100%;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
  }

  /* 1. TOP SCOREBOARD & MATCHUP HEADER */
  .pregame-scoreboard {
    width: 100%;
    height: 82px;
    background: rgba(10, 15, 26, 0.9);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 228px 1fr;
    align-items: center;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .pg-team {
    display: flex;
    align-items: center;
    gap: 20px;
    min-width: 0;
  }

  .pg-away {
    justify-content: flex-end;
  }

  .pg-crest-wrap {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .pg-crest {
    width: 40px;
    height: 40px;
    object-fit: contain;
    filter: drop-shadow(0 0 10px rgba(0, 229, 255, 0.35));
  }

  .pg-away .pg-crest {
    filter: drop-shadow(0 0 10px rgba(138, 43, 226, 0.35));
  }

  .pg-team-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .pg-info-right {
    text-align: right;
    align-items: flex-end;
  }

  .pg-team-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pg-team-sub {
    font-size: 0.75rem;
    font-weight: 700;
    color: #00E5FF;
    letter-spacing: 0.1em;
  }

  .pg-team-sub.away-sub {
    color: #a78bfa;
  }

  .pg-team-stats {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-left: auto;
    padding-right: 16px;
  }

  .pg-stat-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    background: rgba(6, 10, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 6px;
  }

  .pg-stat-lbl {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: var(--text-muted);
  }

  .pg-stat-val {
    font-size: 0.8125rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.06em;
  }

  .form-badges-row {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .pg-center-spine {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 3px;
    border-left: 1px solid rgba(255, 255, 255, 0.1);
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0 18px;
    height: 58px;
  }

  .pg-match-meta {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #00E5FF;
    letter-spacing: 0.12em;
  }

  .pg-vs-pill {
    font-family: 'Orbitron', sans-serif;
    font-size: 1.125rem;
    font-weight: 900;
    color: #ffffff;
    letter-spacing: 0.12em;
    line-height: 1.1;
  }

  .pg-match-time {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
  }

  .pg-away-status {
    margin-right: auto;
    padding-left: 16px;
  }

  .pg-status-chip {
    font-size: 0.6875rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    padding: 4px 10px;
    border-radius: 4px;
    background: rgba(0, 229, 255, 0.1);
    border: 1px solid rgba(0, 229, 255, 0.35);
    color: #00E5FF;
  }

  /* 2. MAIN STAGE ROW: 16:9 CAMS & CHAT (IMPROVED SPACING & REDESIGNED FRAMES) */
  .pregame-main-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    width: 100%;
    flex: 1;
    min-height: 0;
  }

  .pregame-cams-wrapper {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
  }

  /* Duo Caster Default (with Chat): 2x 656x369 (exact 16:9) + 384x369 Chat + 2x 24px gap = 1744px */
  .cam-box-169 {
    width: 656px;
    height: 369px;
    position: relative;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-bottom: 2px solid rgba(0, 229, 255, 0.75);
    border-radius: 10px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.68), inset 0 0 24px rgba(0, 0, 0, 0.45), inset 0 1px 0 rgba(255, 255, 255, 0.14);
    overflow: hidden;
    flex-shrink: 0;
    transform: translateZ(0);
  }

  /* Subtle top-corner architectural accents */
  .cam-box-169::before {
    content: '';
    position: absolute;
    top: 0;
    left: 24px;
    right: 24px;
    height: 1px;
    background: linear-gradient(90deg, transparent 0%, rgba(0, 229, 255, 0.45) 50%, transparent 100%);
    pointer-events: none;
    z-index: 4;
  }

  /* Duo Caster without Chat: 2x 752x423 (exact 16:9) */
  body.chat-off .cam-box-169 {
    width: 752px;
    height: 423px;
  }

  /* Solo Caster Mode (16:9 752x423) */
  .cam-box-169.is-solo,
  body.layout-cam-1 .cam-box-169 {
    width: 752px;
    height: 423px;
  }

  .cam-aspect-guard {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .cam-viewport-hole {
    flex: 1;
    width: 100%;
    height: 100%;
    background: transparent;
  }

  /* Sleek Lower-Third Caster Nameplate (Docked at bottom-left, never obscures face) */
  .cam-lower-third {
    position: absolute;
    bottom: 14px;
    left: 16px;
    z-index: 5;
    pointer-events: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    height: 34px;
    padding: 0 16px 0 12px;
    background: rgba(8, 12, 22, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 6px;
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.65);
  }

  .cam-lt-accent {
    width: 3px;
    height: 16px;
    border-radius: 2px;
    background: #00E5FF;
    box-shadow: 0 0 8px rgba(0, 229, 255, 0.6);
  }

  .cam-lt-tag {
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    color: #00E5FF;
  }

  .cam-lt-sep {
    width: 1px;
    height: 12px;
    background: rgba(255, 255, 255, 0.18);
  }

  .cam-lt-name {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.1em;
  }

  /* No-Cam Stage (?layout=none) */
  .pregame-nocam-stage {
    display: none;
    flex: 1;
    height: 369px;
    background: rgba(10, 15, 26, 0.88);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-bottom: 2px solid rgba(0, 229, 255, 0.55);
    border-radius: 10px;
    padding: 22px 28px;
    flex-direction: column;
    gap: 14px;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.65);
  }

  body.layout-none .pregame-nocam-stage {
    display: flex;
  }

  .nocam-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nocam-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: #00E5FF;
    letter-spacing: 0.12em;
  }

  .nocam-sub {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .nocam-schedule-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
    flex: 1;
    align-content: start;
  }

  .nocam-match-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: rgba(6, 10, 18, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    gap: 12px;
  }

  .nocam-match-row.is-next {
    border-color: rgba(0, 229, 255, 0.5);
    background: rgba(0, 229, 255, 0.08);
  }

  .nocam-m-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .nocam-m-day {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #00E5FF;
    min-width: 28px;
  }

  .nocam-m-logo {
    width: 22px;
    height: 22px;
    object-fit: contain;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .nocam-m-enemy {
    font-size: 0.875rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nocam-m-right {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  /* Redesigned Stream Chat Box */
  .pregame-chat-card {
    width: 384px;
    height: 369px;
    background: rgba(10, 15, 26, 0.86);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-bottom: 2px solid rgba(168, 85, 247, 0.65);
    border-radius: 10px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.68), inset 0 1px 0 rgba(255, 255, 255, 0.12);
    flex-shrink: 0;
    transform: translateZ(0);
  }

  body.layout-cam-1 .pregame-chat-card {
    width: 440px;
    height: 423px;
  }

  body.chat-off .pregame-chat-card {
    display: none !important;
  }

  .chat-card-header {
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    background: linear-gradient(90deg, rgba(8, 12, 22, 0.96) 0%, rgba(16, 14, 30, 0.92) 100%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  .chat-card-title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: 'Orbitron', sans-serif;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #ffffff;
  }

  .chat-title-accent {
    width: 3px;
    height: 15px;
    border-radius: 2px;
    background: #a855f7;
    box-shadow: 0 0 8px rgba(168, 85, 247, 0.6);
  }

  .twitch-svg {
    color: #c084fc;
  }

  .chat-channel-tag {
    font-size: 0.625rem;
    font-weight: 800;
    color: #c4b5fd;
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.32);
    padding: 3px 9px;
    border-radius: 4px;
    letter-spacing: 0.12em;
  }

  .chat-channel-tag.is-connected {
    color: #00E5FF;
    background: rgba(0, 229, 255, 0.1);
    border-color: rgba(0, 229, 255, 0.38);
  }

  .chat-viewport-transparent {
    flex: 1;
    width: 100%;
    position: relative;
    background: transparent;
    overflow: hidden;
  }

  .chat-widget-iframe {
    display: none;
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
  }

  .chat-widget-iframe.is-loaded {
    display: block;
  }

  /* 3. 5-STARTER LINEUP STRIP */
  .pregame-starters-strip {
    width: 100%;
    height: 82px;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 18px;
    flex-shrink: 0;
  }

  .pg-starter-card {
    background: rgba(10, 15, 26, 0.9);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.13);
    border-radius: 10px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 14px;
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.58), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    min-width: 0;
  }

  .pg-starter-avatar {
    width: 52px;
    height: 52px;
    border-radius: 8px;
    object-fit: cover;
    object-position: center top;
    background: rgba(6, 9, 15, 0.85);
    border: 1px solid rgba(0, 229, 255, 0.32);
    flex-shrink: 0;
  }

  .pg-starter-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }

  .pg-starter-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 6px;
  }

  .pg-starter-role {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #00E5FF;
    letter-spacing: 0.08em;
  }

  .pg-starter-role img {
    width: 12px;
    height: 12px;
    object-fit: contain;
  }

  .pg-starter-kda {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
  }

  .pg-starter-name {
    font-family: var(--font-display);
    font-size: 0.9375rem;
    font-weight: 800;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    line-height: 1.1;
  }

  .pg-starter-rank {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* RESERVED 320PX BLUEBOTTLE DRAFT ZONE */

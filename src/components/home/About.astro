---
// src/components/home/About.astro
import { totalTeams, communityCount, discordInviteUrl } from '../../utils/uicData';
---

<section id="about" class="section-pad about-section">
  <!-- Minimalist Monochrome Rift Nexus & Base Terrace Contours -->
  <div class="about-bg-fx" aria-hidden="true">
    <div class="about-glare"></div>

    <div class="about-topo-wrap">
      <svg
        class="about-topo-svg"
        viewBox="0 0 1600 840"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="about-topo-stroke" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.025" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.09" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.025" />
          </linearGradient>
          <linearGradient id="about-nexus-stroke" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.12" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.04" />
          </linearGradient>
        </defs>

        <!-- 1. Stepped Base High-Ground Terrace Isolines (Radiating Toward All 3 Lanes) -->
        <g stroke="url(#about-topo-stroke)" stroke-width="1">
          <path d="M-120,580 C240,560 540,465 835,345 C1130,225 1350,85 1680,-40" />
          <path d="M-120,635 C275,610 585,510 885,385 C1185,260 1395,120 1720,-5" />
          <path d="M-120,690 C310,660 630,555 935,425 C1240,295 1440,155 1720,35" stroke-opacity="0.65" />

          <!-- Outer Base Plateau Contours -->
          <path d="M680,310 C835,195 1135,175 1345,255 C1555,335 1595,495 1435,595 C1275,695 975,705 765,615 C555,525 525,425 680,310 Z" />
          <path d="M745,335 C875,238 1125,222 1300,288 C1475,354 1508,485 1375,568 C1242,651 995,658 820,582 C645,506 615,432 745,335 Z" />
          <path d="M815,360 C918,282 1115,270 1252,322 C1389,374 1415,475 1310,540 C1205,605 1012,610 875,550 C738,490 712,438 815,360 Z" />
        </g>

        <!-- 2. Concentric Nexus Courtyard Rings & 3 Inhibitor Nodes (@ 1080, 440) -->
        <g>
          <ellipse cx="1080" cy="440" rx="235" ry="86" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.95" stroke-dasharray="10 8" />
          <ellipse cx="1080" cy="440" rx="160" ry="58" stroke="rgba(255, 255, 255, 0.11)" stroke-width="0.95" />
          <ellipse cx="1080" cy="440" rx="92" ry="34" stroke="rgba(255, 255, 255, 0.16)" stroke-width="1.05" />

          <!-- 3 Directional Lane Vectors & Inhibitor Nodes (Top, Mid, Bot) -->
          <g stroke="rgba(255, 255, 255, 0.12)" stroke-width="0.9" stroke-dasharray="4 7">
            <line x1="910" y1="382" x2="710" y2="315" />
            <line x1="862" y1="468" x2="640" y2="515" />
            <line x1="1015" y1="522" x2="915" y2="675" />
          </g>
          <!-- Inhibitor Node 1 (Top Gate) -->
          <polygon points="845,352 855,360 845,368 835,360" stroke="rgba(255, 255, 255, 0.25)" stroke-width="1" fill="#050507" />
          <circle cx="845" cy="360" r="1.8" fill="rgba(255, 255, 255, 0.45)" />
          <!-- Inhibitor Node 2 (Mid Gate) -->
          <polygon points="795,482 805,490 795,498 785,490" stroke="rgba(255, 255, 255, 0.25)" stroke-width="1" fill="#050507" />
          <circle cx="795" cy="490" r="1.8" fill="rgba(255, 255, 255, 0.45)" />
          <!-- Inhibitor Node 3 (Bot Gate) -->
          <polygon points="975,580 985,588 975,596 965,588" stroke="rgba(255, 255, 255, 0.25)" stroke-width="1" fill="#050507" />
          <circle cx="975" cy="588" r="1.8" fill="rgba(255, 255, 255, 0.45)" />
        </g>

        <!-- 3. Minimalist Nexus Obelisk & Pedestal Wireframe (@ 1080, 440) -->
        <g stroke="url(#about-nexus-stroke)" stroke-width="1.1" stroke-linejoin="round">
          <!-- Octagonal Stepped Nexus Plinth -->
          <polygon points="996,440 1032,462 1128,462 1164,440 1142,412 1018,412" fill="rgba(255, 255, 255, 0.014)" />
          <polygon points="1018,412 1046,428 1114,428 1142,412 1124,386 1036,386" />
          <line x1="1046" y1="428" x2="1032" y2="462" />
          <line x1="1114" y1="428" x2="1128" y2="462" />

          <!-- Four Protective Nexus Ward Pylons Framing the Crystal -->
          <polygon points="1008,395 1022,325 1034,340 1026,406" fill="rgba(255, 255, 255, 0.015)" />
          <polygon points="1152,395 1138,325 1126,340 1134,406" fill="rgba(255, 255, 255, 0.015)" />
          <polygon points="1042,418 1052,348 1062,358 1058,424" fill="rgba(255, 255, 255, 0.012)" />
          <polygon points="1118,418 1108,348 1098,358 1102,424" fill="rgba(255, 255, 255, 0.012)" />
        </g>

        <!-- 4. Levitating Nexus Crystal Monolith (@ 1080, 310) -->
        <g class="about-nexus-crystal">
          <circle cx="1080" cy="310" r="64" stroke="rgba(255, 255, 255, 0.065)" stroke-width="0.85" stroke-dasharray="4 7" />
          <circle cx="1080" cy="310" r="38" stroke="rgba(255, 255, 255, 0.11)" stroke-width="0.9" />
          <polygon
            points="1080,242 1108,305 1080,376 1052,305"
            stroke="rgba(255, 255, 255, 0.3)"
            stroke-width="1.15"
            fill="rgba(255, 255, 255, 0.035)"
          />
          <polyline points="1052,305 1080,320 1108,305" stroke="rgba(255, 255, 255, 0.22)" stroke-width="0.95" />
          <line x1="1080" y1="242" x2="1080" y2="376" stroke="rgba(255, 255, 255, 0.22)" stroke-width="0.95" />
          <circle cx="1080" cy="308" r="2.5" fill="rgba(255, 255, 255, 0.6)" />
        </g>

        <!-- Travelling Monochrome Base Terrace Glint -->
        <path
          class="about-topo-glint"
          d="M-120,580 C240,560 540,465 835,345 C1130,225 1350,85 1680,-40"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header">
      <div class="section-badge-pill">VEREINSSTRUKTUR</div>
      <h2 class="section-title">
        STRUKTUR & <span class="text-gradient">ORGANISATION</span>
      </h2>
      <p class="section-desc">
        Bei uns finden Spieler feste Teams, geregelten Ligabetrieb in der Prime League und eine verlässliche Gemeinschaft. Vom Einstieg bis zum leistungsorientierten Wettbewerb begleiten wir unsere Spieler langfristig.
      </p>
    </div>

    <!-- Clean Modern Agency Bento Matrix -->
    <div class="bento-grid">
      
      <!-- Bento 1: Prime League Ladder Trajectory (Span 8) -->
      <div class="bento-card bento-span-8">
        <div class="card-meta">
          <span class="meta-num">01</span>
          <span class="meta-tag">LIGA & WETTKAMPF</span>
        </div>
        
        <h3 class="card-title">LIGABETRIEB IN DER PRIME LEAGUE</h3>
        <p class="card-body">
          Erfolg im eSport verlangt Verlässlichkeit und klare Abläufe. Wir bieten {totalTeams} eigenständigen Teams feste Trainingszeiten, organisatorische Unterstützung bei den Spieltagen und eine kontinuierliche Förderung durch alle Spielklassen der Prime League.
        </p>

        <!-- Division Progression Strip -->
        <div class="ladder-strip">
          <div class="ladder-step">
            <span class="step-label">EINSTIEG</span>
            <span class="step-tier">STARTER DIVISION</span>
          </div>
          <div class="ladder-arrow">&rarr;</div>
          <div class="ladder-step">
            <span class="step-label">AUFBAU</span>
            <span class="step-tier">DIVISION 5 &bull; 6</span>
          </div>
          <div class="ladder-arrow">&rarr;</div>
          <div class="ladder-step is-active">
            <span class="step-label">WETTKAMPF</span>
            <span class="step-tier">DIVISION 4</span>
          </div>
          <div class="ladder-arrow">&rarr;</div>
          <div class="ladder-step step-target">
            <span class="step-label">ZIEL</span>
            <span class="step-tier">DIVISION 3 &bull; HÖHER</span>
          </div>
        </div>
      </div>

      <!-- Bento 2: Community & Menschlichkeit (Span 4) -->
      <div class="bento-card bento-span-4">
        <div class="card-meta">
          <span class="meta-num">02</span>
          <span class="meta-tag">GEMEINSCHAFT</span>
        </div>

        <h3 class="card-title">{communityCount} SPIELER UND FANS</h3>
        <p class="card-body">
          Unsere Gemeinschaft bildet das verlässliche Fundament unseres Vereins. Neben den Ligaspielen organisieren wir vereinsinterne Turniere, gemeinsame Abende im Sprachkanal und pflegen einen respektvollen Umgang miteinander.
        </p>

        <div class="community-stats-row">
          <div class="c-stat-box">
            <span class="c-stat-val">{communityCount}</span>
            <span class="c-stat-lbl">MITGLIEDER</span>
          </div>
          <div class="c-stat-box">
            <span class="c-stat-val">TÄGLICH</span>
            <span class="c-stat-lbl">GEMEINSAMES TRAINING</span>
          </div>
        </div>

        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-full">
          GEMEINSCHAFT BEITRETEN &rarr;
        </a>
      </div>

      <!-- Bento 3: Talentschmiede & Coaching (Span 4) -->
      <div class="bento-card bento-span-4">
        <div class="card-meta">
          <span class="meta-num">03</span>
          <span class="meta-tag">AUSBILDUNG</span>
        </div>

        <h3 class="card-title">TRAINING & SPIELERFÖRDERUNG</h3>
        <p class="card-body">
          Regelmäßige Spielanalysen, individuelle Rückmeldungen erfahrener Spieler und gezielte Vorbereitung auf anstehende Spieltage stärken jedes Team nachhaltig.
        </p>

        <ul class="coaching-points">
          <li><span>&bull;</span> Individuelle Rückmeldungen zu Rollen und Champions</li>
          <li><span>&bull;</span> Analysen von Spielzügen, Kartenkontrolle und Drafts</li>
          <li><span>&bull;</span> Absprache im Team und strategische Entscheidungen</li>
        </ul>
      </div>

      <!-- Bento 4: Content & Broadcast Studio (Span 8) -->
      <div class="bento-card bento-span-8">
        <div class="card-meta">
          <span class="meta-num">04</span>
          <span class="meta-tag">ÜBERTRAGUNG & TURNIERE</span>
        </div>

        <div class="broadcast-layout">
          <div>
            <h3 class="card-title">SPIELTAGS-ÜBERTRAGUNG & VEREINSTURNIERE</h3>
            <p class="card-body">
              Wir übertragen wichtige Ligaspiele mit eigenem Kommentar live auf Twitch, veranstalten regelmäßige Vereinsturniere und fassen die Höhepunkte der Saison zusammen.
            </p>
            <div class="broadcast-tags">
              <span class="b-tag">LIVE-KOMMENTAR</span>
              <span class="b-tag">VEREINSTURNIERE</span>
              <span class="b-tag">SPIELANALYSEN</span>
              <span class="b-tag">SPIELER-INTERVIEWS</span>
            </div>
          </div>

          <div class="broadcast-metric-box">
            <div class="b-metric-item">
              <span class="b-val">1080p</span>
              <span class="b-lbl">BILDQUALITÄT</span>
            </div>
            <div class="b-metric-item">
              <span class="b-val">LIVE</span>
              <span class="b-lbl">SPIELTAGE MIT KOMMENTAR</span>
            </div>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>

<style>
  .about-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Minimalist Monochrome Rift Nexus & Base Terrace Background */
  .about-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .about-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 50% 48% at 68% 42%, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 52%, transparent 78%);
  }

  .about-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 88% 80% at 58% 46%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
    -webkit-mask-image: radial-gradient(ellipse 88% 80% at 58% 46%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
  }

  .about-topo-svg {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    display: block;
    animation: aboutTopoBreathe 34s ease-in-out infinite alternate;
  }

  .about-nexus-crystal {
    animation: aboutCrystalFloat 8s ease-in-out infinite alternate;
  }

  .about-topo-glint {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 220 1600;
    stroke-dashoffset: 1820;
    animation: aboutGlintTravel 30s linear infinite;
  }

  @keyframes aboutTopoBreathe {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(1%, -0.8%, 0) scale(1.025); }
  }

  @keyframes aboutCrystalFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }

  @keyframes aboutGlintTravel {
    0% { stroke-dashoffset: 1820; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .about-topo-svg,
    .about-nexus-crystal,
    .about-topo-glint {
      animation: none !important;
    }
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: var(--space-lg);
  }

  .bento-span-8 {
    grid-column: span 8;
  }

  .bento-span-4 {
    grid-column: span 4;
  }

  .bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color var(--transition-fast), transform var(--transition-smooth);
  }

  .bento-card:hover {
    background: #121216;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .meta-num {
    font-family: var(--font-tech);
    font-size: 0.8125rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .meta-tag {
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: var(--text-white);
    letter-spacing: -0.01em;
    margin-bottom: var(--space-sm);
    line-height: 1.2;
  }

  .card-body {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--text-secondary);
    margin-bottom: var(--space-xl);
  }

  /* Ladder Strip */
  .ladder-strip {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-md);
    overflow-x: auto;
  }

  .ladder-step {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-xs);
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.02);
    min-width: 100px;
  }

  .ladder-step.is-active {
    background: #ffffff;
    color: #000000;
  }

  .ladder-step.is-active .step-label {
    color: rgba(0, 0, 0, 0.7);
  }

  .ladder-step.is-active .step-tier {
    color: #000000;
  }

  .step-label {
    font-family: var(--font-tech);
    font-size: 0.625rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
  }

  .step-tier {
    font-family: var(--font-tech);
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-white);
  }

  .ladder-arrow {
    color: rgba(255, 255, 255, 0.3);
    font-size: 0.875rem;
  }

  /* Community Stats */
  .community-stats-row {
    display: flex;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .c-stat-box {
    flex: 1;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
  }

  .c-stat-val {
    font-family: var(--font-tech);
    font-weight: 800;
    font-size: 1.25rem;
    color: #ffffff;
  }

  .c-stat-lbl {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* Coaching Points */
  .coaching-points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
  }

  .coaching-points li {
    font-size: 0.875rem;
    color: var(--text-secondary);
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .coaching-points li span {
    color: rgba(255, 255, 255, 0.4);
  }

  /* Broadcast Studio */
  .broadcast-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: var(--space-xl);
    align-items: center;
  }

  .broadcast-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .b-tag {
    font-family: var(--font-tech);
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 4px 10px;
    border-radius: var(--radius-xs);
  }

  .broadcast-metric-box {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .b-metric-item {
    display: flex;
    flex-direction: column;
  }

  .b-val {
    font-family: var(--font-tech);
    font-weight: 800;
    font-size: 1.35rem;
    color: #ffffff;
  }

  .b-lbl {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
  }

  /* Responsive */
  @media (max-width: 992px) {
    .bento-span-8, .bento-span-4 {
      grid-column: span 12;
    }

    .broadcast-layout {
      grid-template-columns: 1fr;
    }
  }
</style>

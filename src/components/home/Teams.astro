</style>

<script define:vars={{ playerSearchIndex }}>
  const teamTabs = document.querySelectorAll('[data-team-target]');
  const teamPanels = document.querySelectorAll('[data-team-panel]');
  const dropdownSelect = document.getElementById('team-dropdown-select');
  const pillScroll = document.getElementById('teams-pill-scroll');
  const teamGlider = document.getElementById('team-pill-glider');
  const rostersViewport = document.querySelector('.rosters-viewport');

  const updateTeamGlider = (activeTab) => {
    if (!teamGlider || !pillScroll || !activeTab) return;
    pillScroll.classList.add('has-glider');
    teamGlider.style.setProperty('--team-glider-x', `${activeTab.offsetLeft}px`);
    teamGlider.style.setProperty('--team-glider-w', `${activeTab.offsetWidth}px`);
    teamGlider.style.setProperty('--team-glider-opacity', '1');
  };

  const setActiveTeam = (target, focusTab = false) => {
    let matchedTab = null;
    teamTabs.forEach((t) => {
      const isMatch = t.getAttribute('data-team-target') === target;
      t.classList.toggle('is-active', isMatch);
      t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
      t.setAttribute('tabindex', isMatch ? '0' : '-1');
      if (isMatch) {
        matchedTab = t;
        if (focusTab) t.focus();
        t.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    });

    if (matchedTab) updateTeamGlider(matchedTab);

    teamPanels.forEach((p) => {
      const isMatch = p.getAttribute('data-team-panel') === target;
      if (isMatch) {
        const tpl = p.querySelector('template.deferred-roster-tpl');
        if (tpl) {
          p.appendChild(tpl.content.cloneNode(true));
          tpl.remove();
        }
      }
      p.classList.toggle('is-active', isMatch);
    });

    if (dropdownSelect && dropdownSelect.value !== target) {
      dropdownSelect.value = target;
    }
  };

  // Initialize glider on first active tab
  const initialActiveTab = document.querySelector('.team-nav-pill.is-active');
  if (initialActiveTab) {
    requestAnimationFrame(() => updateTeamGlider(initialActiveTab));
    window.addEventListener('resize', () => {
      const current = document.querySelector('.team-nav-pill.is-active');
      if (current) updateTeamGlider(current);
    }, { passive: true });
  }

  teamTabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => {
      const target = tab.getAttribute('data-team-target');
      if (target) setActiveTeam(target);
    });

    tab.addEventListener('keydown', (e) => {
      let nextIdx = null;
      if (e.key === 'ArrowRight') nextIdx = (idx + 1) % teamTabs.length;
      else if (e.key === 'ArrowLeft') nextIdx = (idx - 1 + teamTabs.length) % teamTabs.length;
      else if (e.key === 'Home') nextIdx = 0;
      else if (e.key === 'End') nextIdx = teamTabs.length - 1;

      if (nextIdx !== null) {
        e.preventDefault();
        const target = teamTabs[nextIdx].getAttribute('data-team-target');
        if (target) setActiveTeam(target, true);
      }
    });
  });

  if (dropdownSelect) {
    dropdownSelect.addEventListener('change', (e) => {
      const target = e.target.value;
      if (target) setActiveTeam(target);
    });
  }

  // Interactive 10-Game Sparkline Scrubbing (Delegated for all 14 teams)
  if (rostersViewport) {
    rostersViewport.addEventListener('pointerover', (e) => {
      const col = e.target.closest('.spark-col');
      if (!col) return;
      const box = col.closest('.history-spark-box');
      if (!box) return;
      box.classList.add('is-scrubbing');
      box.querySelectorAll('.spark-col.is-hovered').forEach((c) => c.classList.remove('is-hovered'));
      col.classList.add('is-hovered');
      const sub = box.querySelector('.spark-sub');
      if (sub) {
        const g = col.getAttribute('data-game');
        const kda = col.getAttribute('data-kda');
        const dpm = col.getAttribute('data-dpm');
        sub.textContent = `S${g} • ${kda} KDA • ${dpm} DPM`;
      }
    });

    rostersViewport.addEventListener('pointerout', (e) => {
      const col = e.target.closest('.spark-col');
      if (!col) return;
      const box = col.closest('.history-spark-box');
      if (!box) return;
      const related = e.relatedTarget;
      if (related && box.contains(related) && related.closest('.spark-col')) return;
      box.classList.remove('is-scrubbing');
      box.querySelectorAll('.spark-col.is-hovered').forEach((c) => c.classList.remove('is-hovered'));
      const sub = box.querySelector('.spark-sub');
      if (sub) {
        sub.textContent = sub.getAttribute('data-default-text') || 'KDA • DPM';
      }
    });
  }

  // Instant Cross-Team Player Search
  const searchInput = document.getElementById('player-quick-search');
  const searchResults = document.getElementById('player-search-results');
  const searchWrap = document.getElementById('player-search-wrap');

  const jumpToPlayer = (hit) => {
    if (!hit) return;
    setActiveTeam(hit.teamKey, false);
    if (searchResults) searchResults.classList.remove('is-open');
    if (searchInput) searchInput.value = '';

    requestAnimationFrame(() => {
      const card = document.querySelector(`[data-player-card-uid="${CSS.escape(hit.uid)}"]`);
      if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        card.classList.add('is-spotlight-target');
        setTimeout(() => card.classList.remove('is-spotlight-target'), 2200);
      }
    });
  };

  if (searchInput && searchResults && Array.isArray(playerSearchIndex)) {
    let currentHits = [];

    const renderSearchHits = (query) => {
      const q = String(query || '').trim().toLowerCase();
      if (!q) {
        searchResults.classList.remove('is-open');
        searchResults.innerHTML = '';
        currentHits = [];
        return;
      }

      currentHits = playerSearchIndex
        .filter((p) =>
          p.name.toLowerCase().includes(q) ||
          p.tag.toLowerCase().includes(q) ||
          p.role.toLowerCase().includes(q) ||
          p.teamName.toLowerCase().includes(q) ||
          p.tier.toLowerCase().includes(q)
        )
        .slice(0, 8);

      searchResults.innerHTML = '';
      if (currentHits.length === 0) {
        const empty = document.createElement('div');
        empty.className = 'search-empty-msg';
        empty.textContent = 'Kein Spieler gefunden.';
        searchResults.appendChild(empty);
      } else {
        currentHits.forEach((hit) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = 'search-hit-btn';
          btn.setAttribute('role', 'option');

          const main = document.createElement('div');
          main.className = 'search-hit-main';

          const nameSpan = document.createElement('span');
          nameSpan.className = 'search-hit-name';
          nameSpan.textContent = hit.tag ? `${hit.name} #${hit.tag}` : hit.name;

          const metaSpan = document.createElement('span');
          metaSpan.className = 'search-hit-meta';
          metaSpan.textContent = `${hit.teamName} • ${hit.tier}`;

          main.appendChild(nameSpan);
          main.appendChild(metaSpan);

          const roleSpan = document.createElement('span');
          roleSpan.className = 'search-hit-role';
          roleSpan.textContent = hit.role;

          btn.appendChild(main);
          btn.appendChild(roleSpan);
          btn.addEventListener('click', () => jumpToPlayer(hit));
          searchResults.appendChild(btn);
        });
      }
      searchResults.classList.add('is-open');
    };

    searchInput.addEventListener('input', (e) => renderSearchHits(e.target.value));
    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && currentHits.length > 0) {
        e.preventDefault();
        jumpToPlayer(currentHits[0]);
      } else if (e.key === 'Escape') {
        searchResults.classList.remove('is-open');
      }
    });

    document.addEventListener('click', (e) => {
      if (searchWrap && !searchWrap.contains(e.target)) {
        searchResults.classList.remove('is-open');
      }
    });
  }
</script>

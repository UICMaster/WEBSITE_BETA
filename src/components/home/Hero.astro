---
// src/components/home/Hero.astro
import { totalTeams, totalAthletes, primeTierShort, communityCount, nextMatch, discordInviteUrl } from '../../utils/uicData';
---

<section id="hero" class="hero-section">
  <!-- UIC Brand-Centric 3D Crystal Monolith, Smart C-Claw Framing & 14-Teams Constellation -->
  <div class="hero-bg-fx" aria-hidden="true">
    <div class="hero-glare"></div>

    <div class="hero-topo-wrap">
      <svg
        class="hero-topo-svg topo-layer-primary"
        viewBox="0 0 1600 900"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <!-- Volumetric Dark-Glass & Crystalline Specular Gradients for the 3D UIC Brand Monolith -->
          <linearGradient id="uic-monolith-3d-extrude" x1="15%" y1="0%" x2="85%" y2="100%">
            <stop offset="0%" stop-color="#000000" stop-opacity="0.68" />
            <stop offset="55%" stop-color="#050811" stop-opacity="0.76" />
            <stop offset="100%" stop-color="#000000" stop-opacity="0.84" />
          </linearGradient>

          <!-- Outer Diamond Crest Rim (Subtle Cyan-to-Violet Brand Luminance Blended into Monochrome Glass) -->
          <linearGradient id="uic-outer-rim-grad" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.095" />
            <stop offset="45%" stop-color="#ffffff" stop-opacity="0.055" />
            <stop offset="100%" stop-color="#f5d0fe" stop-opacity="0.085" />
          </linearGradient>

          <!-- Upper Crown & Inner Chamber Energy Layer -->
          <linearGradient id="uic-crown-energy" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.14" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.075" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.03" />
          </linearGradient>

          <!-- Glowing Inner Rhomboid Eye Chambers (Left & Right UIC Cores) -->
          <radialGradient id="uic-eye-chamber-glow" cx="50%" cy="50%" r="58%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.32" />
            <stop offset="45%" stop-color="#e0f2fe" stop-opacity="0.18" />
            <stop offset="82%" stop-color="#ffffff" stop-opacity="0.07" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.015" />
          </radialGradient>

          <!-- Mid Geometric Frame & C-Claw Dock -->
          <linearGradient id="uic-mid-frame-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.085" />
            <stop offset="50%" stop-color="#e2e8f0" stop-opacity="0.052" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.075" />
          </linearGradient>

          <!-- Sculpted Metallic U-I-C Armor Base -->
          <linearGradient id="uic-armor-base-grad" x1="15%" y1="0%" x2="85%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.11" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.065" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.032" />
          </linearGradient>

          <!-- Beveled 3D Silver Facet Strips -->
          <linearGradient id="uic-bevel-mid-grad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.165" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.095" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.048" />
          </linearGradient>

          <!-- Pure Specular Platinum/White Raised Faces (U, I, C Crown Surfaces) -->
          <linearGradient id="uic-platinum-top-grad" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.24" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.145" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.07" />
          </linearGradient>

          <!-- Crisp Rim Stroke Gradient -->
          <linearGradient id="uic-rim-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#e0f2fe" stop-opacity="0.26" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.34" />
            <stop offset="100%" stop-color="#f5d0fe" stop-opacity="0.24" />
          </linearGradient>

          <!-- Open 45° Brand Architecture & Constellation Conduit Fade -->
          <linearGradient id="uic-conduit-fade" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.015" />
            <stop offset="30%" stop-color="#ffffff" stop-opacity="0.085" />
            <stop offset="58%" stop-color="#ffffff" stop-opacity="0.16" />
            <stop offset="86%" stop-color="#ffffff" stop-opacity="0.085" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.01" />
          </linearGradient>
        </defs>

        <!-- ================= 1. OPEN 45° UIC BRAND ARCHITECTURE, SMART C-CLAW DOCK & 14-TEAMS CONSTELLATION ================= -->
        <g stroke="url(#uic-conduit-fade)" stroke-width="0.95" stroke-linejoin="round">
          <!-- Open-Ended 45° Diamond Sanctuary Chevrons Echoing the Official UIC Crest (No Closed Box) -->
          <path
            d="M 915,115 L 1245,445 L 915,775 L 585,445 Z"
            fill="rgba(255, 255, 255, 0.008)"
            stroke-dasharray="18 10 4 10"
          />
          <!-- Second Stepped 45° Architectural Wing Chevrons (Open Top & Bottom) -->
          <path
            d="M 785,175 L 515,445 L 785,715 M 1045,175 L 1315,445 L 1045,715"
            stroke-width="1.1"
          />
          <!-- Third Wide 45° Wing Sweeping Behind Left Typography & Right Matchup Card -->
          <path
            d="M 675,135 L 365,445 L 675,755 M 1155,135 L 1465,445 L 1155,755"
            stroke-dasharray="8 10"
            stroke-opacity="0.65"
          />

          <!-- Geometric Stepped Brand Floor Inlay Chevrons Flowing Left Under Hero Content -->
          <polygon
            points="645,445 585,415 515,445 585,475"
            fill="rgba(255, 255, 255, 0.018)"
            stroke="rgba(255, 255, 255, 0.10)"
          />
          <polygon
            points="515,445 445,418 365,445 445,472"
            fill="rgba(255, 255, 255, 0.014)"
            stroke="rgba(255, 255, 255, 0.08)"
          />

          <!-- Leftward 45° Brand Conduits Flowing Under 'ULTRA INSTINCT CREW' & Metrics Strip -->
          <path d="M 645,445 L 515,445 L 405,335 L 90,335 L -80,335" stroke-width="1.15" />
          <path d="M 585,445 L 365,445 L 275,535 L 40,535 L -80,535" stroke-width="1.1" />
          <path d="M 745,275 L 605,275 L 495,165 L 140,165 L -60,165" stroke-dasharray="10 8" stroke-opacity="0.72" />
          <path d="M 745,615 L 605,615 L 495,725 L 140,725 L -60,725" stroke-dasharray="10 8" stroke-opacity="0.72" />

          <!-- SMART-FRAMING C-CLAW DOCK: Horizontal Energy Rails Emerging Directly from the Right 'C' Opening (X=1048..1174, Y=436..455) to Cradle the Matchup Card -->
          <path
            d="M 1048,436 L 1245,436 L 1345,336 L 1640,336"
            stroke="rgba(255, 255, 255, 0.22)"
            stroke-width="1.25"
          />
          <path
            d="M 1048,455 L 1245,455 L 1345,555 L 1640,555"
            stroke="rgba(255, 255, 255, 0.22)"
            stroke-width="1.25"
          />
          <path
            d="M 1174,445 L 1640,445"
            stroke="rgba(255, 255, 255, 0.16)"
            stroke-width="1.0"
            stroke-dasharray="6 8"
          />

          <!-- Perspective Arena Pedestal Rings Beneath the Floating UIC Monolith (@ 915, 736) -->
          <ellipse cx="915" cy="736" rx="340" ry="42" stroke="rgba(255, 255, 255, 0.11)" />
          <ellipse cx="915" cy="736" rx="230" ry="26" stroke="rgba(255, 255, 255, 0.16)" stroke-dasharray="10 6" />
          <ellipse cx="915" cy="736" rx="125" ry="14" fill="rgba(255, 255, 255, 0.025)" stroke="rgba(255, 255, 255, 0.22)" />

          <!-- THE 14 UIC TEAMS CONSTELLATION NODES (14 Illuminated Rhomboid Beacons Representing the 14 Active Prime League Teams) -->
          <g fill="rgba(255, 255, 255, 0.18)" stroke="rgba(255, 255, 255, 0.42)" stroke-width="0.85">
            <!-- Left Wing Constellation (7 Teams: Prime, Ascend, Cyber, Dynasty, Eclipse, Hydra, Nova) -->
            <polygon points="515,437 523,445 515,453 507,445" />
            <polygon points="405,328 412,335 405,342 398,335" />
            <polygon points="365,438 372,445 365,452 358,445" />
            <polygon points="275,528 282,535 275,542 268,535" />
            <polygon points="605,268 612,275 605,282 598,275" />
            <polygon points="605,608 612,615 605,622 598,615" />
            <polygon points="210,328 217,335 210,342 203,335" />

            <!-- Center & Right Wing Constellation (7 Teams: Phoenix, Raiders, Spark, Strawhats, Tempest, Vakuum, Dinonuggets) -->
            <polygon points="915,107 923,115 915,123 907,115" />
            <polygon points="915,767 923,775 915,783 907,775" />
            <polygon points="1245,429 1252,436 1245,443 1238,436" />
            <polygon points="1245,448 1252,455 1245,462 1238,455" />
            <polygon points="1315,438 1322,445 1315,452 1308,445" />
            <polygon points="1345,329 1352,336 1345,343 1338,336" />
            <polygon points="1345,548 1352,555 1345,562 1338,555" />
          </g>
        </g>

        <!-- ================= 2. PIXEL-TRACED 3D UIC BRAND MONOLITH & GLASS-FACET CREST (12 VOLUMETRIC LAYERS @ 915, 445) ================= -->
        <g stroke-linejoin="round" stroke-linecap="round">

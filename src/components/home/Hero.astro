---
// src/components/home/Hero.astro
import { totalTeams, totalAthletes, primeTierShort, communityCount, nextMatch, discordInviteUrl } from '../../utils/uicData';
---

<section id="hero" class="hero-section">
  <!-- Hyper-Realistic Summoner's Rift Nexus Monolith & Seamless Radial Base Sanctuary -->
  <div class="hero-bg-fx" aria-hidden="true">
    <div class="hero-glare"></div>

    <div class="hero-topo-wrap">
      <svg
        class="hero-topo-svg topo-layer-primary"
        viewBox="0 0 1600 900"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <!-- Volumetric Shading & Translucent Dark-Glass Gradients for Nexus Monolith -->
          <linearGradient id="nexus-silhouette-base" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.032" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.018" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.008" />
          </linearGradient>
          <linearGradient id="nexus-stone-mid" x1="15%" y1="0%" x2="85%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.072" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.042" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.018" />
          </linearGradient>
          <linearGradient id="nexus-stone-bright" x1="15%" y1="0%" x2="85%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.13" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.078" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.032" />

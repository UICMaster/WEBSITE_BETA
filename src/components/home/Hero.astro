---
// src/components/home/Hero.astro
import { totalTeams, totalAthletes, primeTierShort, communityCount, nextMatch, discordInviteUrl } from '../../utils/uicData';
---

<section id="hero" class="hero-section">
  <!-- Subtle Background Glare & Sharp Grid Lines -->
  <div class="hero-bg-fx" aria-hidden="true">
    <div class="hero-glare"></div>
    <div class="hero-lines"></div>
  </div>

  <div class="container hero-container">
    
    <!-- Hero Main Stage -->
    <div class="hero-content">
      
      <div class="hero-badge-strip">
        <span class="hero-badge">PRIME LEAGUE ESPORT</span>
        <span class="hero-badge-sub text-mono">
          <span>DEUTSCHLAND</span>
        </span>
      </div>

      <h1 class="hero-title">
        <span class="hero-title-main">ULTRA INSTINCT CREW</span>
      </h1>

      <p class="hero-desc">
        Die deutsche League of Legends eSport Organisation. Mit {totalTeams} aktiven Teams und {totalAthletes} Spielern verbinden wir geregeltes Ligaspiel in der Prime League mit einer lebendigen Gemeinschaft für alle Spielstärken.
      </p>

      <!-- Key Metrics Counter Strip -->
      <div class="hero-metrics-bar">
        <div class="metric-item">
          <span class="metric-val text-mono">{totalTeams}</span>
          <span class="metric-lbl">TEAMS</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{totalAthletes}</span>
          <span class="metric-lbl">SPIELER</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{primeTierShort}</span>
          <span class="metric-lbl">LIGA</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{communityCount}</span>
          <span class="metric-lbl">GEMEINSCHAFT</span>
        </div>
      </div>

      <!-- Hero Actions -->
      <div class="hero-actions">
        <a href="#teams" class="btn btn-primary btn-lg">
          <span>TEAMS ANSEHEN</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a href="#stats" class="btn btn-outline btn-lg">
          <span>SPIELPLAN & TABELLE</span>
        </a>

        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg discord-btn">
          <span>DISCORD SERVER</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>

    </div>

    <!-- Right Side: Matchup Card -->
    <div class="hero-matchup-col">
      <div class="matchup-bento-card">
        
        <div>
          <div class="card-meta">
            <span class="meta-num text-mono">
              {nextMatch.matchDay ? `SPIELTAG ${nextMatch.matchDay}` : 'SPIELTAG'}
            </span>
            <span class="meta-tag text-mono">PRIME LEAGUE &bull; {nextMatch.teamTier.toUpperCase()}</span>
            {nextMatch.isScheduled && (
              <span class={`match-status-badge ${nextMatch.confirmed ? 'is-confirmed' : 'is-unconfirmed'}`}>
                {nextMatch.confirmedLabel}
              </span>
            )}
          </div>

          <h2 class="card-title name-with-link">
            <span>NÄCHSTES SPIEL</span>
            {nextMatch.matchLink && (
              <a
                href={nextMatch.matchLink}
                target="_blank"
                rel="noopener noreferrer"
                class="link-forward-arrow"
                title={`Prime League Match: ${nextMatch.team} gegen ${nextMatch.enemy} öffnen`}
                aria-label={`Prime League Match: ${nextMatch.team} gegen ${nextMatch.enemy} öffnen`}
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
          </h2>

          <!-- Clash Strip -->
          <div class="matchup-clash-strip">
            <!-- Home Team -->
            <div class="m-team home">
              <div class="m-crest-wrap has-img">
                <img
                  src={nextMatch.teamLogo}
                  alt={`${nextMatch.team} Wappen`}
                  class="m-crest m-crest-full"
                  width="58"
                  height="58"
                  decoding="async"
                />
              </div>
              <span class="m-name name-with-link">
                <span>{nextMatch.team.toUpperCase()}</span>
                {nextMatch.teamLink && (
                  <a
                    href={nextMatch.teamLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-forward-arrow"
                    title={`${nextMatch.team} auf Prime League öffnen`}
                    aria-label={`${nextMatch.team} auf Prime League öffnen`}
                  >
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                )}
              </span>
            </div>

            <!-- VS Clash Badge -->
            <div class="m-clash-badge">
              <span class="m-vs text-mono">VS</span>
              <span class="m-time text-mono">{nextMatch.dateFormatted}</span>
              {nextMatch.isScheduled && (
                <span class="m-clock text-mono">{nextMatch.timeFormatted} UHR</span>
              )}
            </div>

            <!-- Opponent -->
            <div class="m-team away">
              <div class={`m-crest-wrap ${nextMatch.enemyLogo ? 'has-img' : 'm-crest-enemy'}`}>
                {nextMatch.enemyLogo ? (
                  <img
                    src={nextMatch.enemyLogo}
                    alt={`${nextMatch.enemy} Wappen`}
                    class="m-crest m-crest-full"
                    width="58"
                    height="58"
                    decoding="async"
                  />
                ) : (
                  <span class="m-enemy-tag text-mono">{nextMatch.enemyTag.slice(0, 3)}</span>
                )}
              </div>
              <span class="m-name name-with-link">
                <span>{nextMatch.enemy}</span>
                {nextMatch.enemyLink && (
                  <a
                    href={nextMatch.enemyLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-forward-arrow"
                    title={`${nextMatch.enemy} auf Prime League öffnen`}
                    aria-label={`${nextMatch.enemy} auf Prime League öffnen`}
                  >
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                )}
              </span>
            </div>
          </div>

          <!-- Live T-Minus Countdown Strip -->
          {nextMatch.isScheduled && nextMatch.beginISO && (
            <div
              class="matchup-countdown-bar text-mono"
              id="hero-match-countdown"
              data-begin-iso={nextMatch.beginISO}
              aria-live="polite"
              aria-label="Verbleibende Zeit bis zum Spielbeginn"
            >
              <span class="cd-label" id="hero-cd-status">SPIELSTART IN</span>
              <div class="cd-timer" id="hero-cd-timer" aria-atomic="true">
                <span class="cd-unit"><strong id="cd-days">--</strong><small>T</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-hours">--</strong><small>S</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-mins">--</strong><small>M</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-secs">--</strong><small>SEK</small></span>
              </div>
            </div>
          )}

          <!-- Starters Strip -->
          <div class="matchup-starters-strip" aria-labelledby="hero-starters-heading">
            <span class="starters-label text-mono" id="hero-starters-heading">
              AUFGEBOT ({nextMatch.team.toUpperCase()}):
            </span>
            <ul class="starters-pills" role="list">
              {nextMatch.starters.map((player) => (
                <li class="starter-chip text-mono">
                  <span class="starter-role">{player.role}</span>
                  <span class="starter-name">{player.name.replace('UIC ', '')}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="matchup-cta-row">
          <a href="#stats" class="btn btn-outline matchup-cta-btn">
            <span>TABELLE & SPIELPLAN</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          {nextMatch.isScheduled && nextMatch.beginISO && (
            <button
              type="button"
              class="btn btn-outline matchup-ics-btn text-mono"
              data-ics-trigger
              data-ics-title={`${nextMatch.team} vs. ${nextMatch.enemy} (Prime League)`}
              data-ics-desc={`Prime League (${nextMatch.teamTier}) — ${nextMatch.team} gegen ${nextMatch.enemy}`}
              data-ics-loc={nextMatch.matchLink || 'https://www.primeleague.gg'}
              data-ics-begin={nextMatch.beginISO}
              title="Spieltermin als .ICS Kalenderdatei speichern"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>+ KALENDER</span>
            </button>
          )}
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(7.5rem, 11vw, 10rem);
    padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: #000000;
    overflow: hidden;
  }

  /* Subtle Background Glare & Sharp Grid Lines */
  .hero-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }

  .hero-glare {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(ellipse 60% 45% at 24% 20%, rgba(255, 255, 255, 0.055) 0%, rgba(255, 255, 255, 0.015) 45%, transparent 75%);
  }

  .hero-lines {
    position: absolute;
    inset: 0;
    background-image: 
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, #000000 15%, transparent 80%);
    -webkit-mask-image: radial-gradient(ellipse 75% 65% at 50% 40%, #000000 15%, transparent 80%);
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* Left Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    min-width: 0;
    max-width: 100%;
  }

  .hero-badge-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #000000;
    background: #ffffff;
    padding: 3px 10px;
    border-radius: var(--radius-xs);
  }

  .hero-badge-sub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  /* Clean, Bold, Solid Title (No Hollow Outline) */
  .hero-title {
    margin: 0;
    line-height: 0.95;
    max-width: 100%;
  }

  .hero-title-main {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 8.2vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #ffffff;
    display: block;
    text-transform: uppercase;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .hero-desc {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0;
  }

  /* Solid Distinct Raised Metrics Bar */
  .hero-metrics-bar {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .metric-val {
    font-weight: 800;
    font-size: 1.4rem;
    color: #ffffff;
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .metric-sep {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    border-radius: var(--radius-full);
  }

  .discord-btn {
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Matchup Card (Matching Ökosystem Bento Design Layers) */
  .hero-matchup-col {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .matchup-bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
    transition: border-color var(--transition-fast), transform var(--transition-smooth);
    max-width: 100%;
    box-sizing: border-box;
  }

  .matchup-bento-card:hover {
    background: #121216;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .meta-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: #ffffff;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
  }

  .meta-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: #ffffff;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
    line-height: 1.2;
  }

  .matchup-clash-strip {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-md);
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-md);
    padding: var(--space-lg);
    margin-bottom: var(--space-sm);
  }

  .m-team {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  .m-crest-wrap {
    width: 58px;
    height: 58px;
    border-radius: var(--radius-md);
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.45);
    flex-shrink: 0;
  }

  .m-crest-full {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .m-crest-enemy {
    border-style: dashed;
  }

  .m-enemy-tag {
    font-size: 0.9375rem;
    font-weight: 800;
    color: var(--text-secondary);
  }

  .m-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.9375rem;
    color: #ffffff;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .m-clash-badge {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 6px 14px;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .m-vs {
    font-size: 0.9375rem;
    font-weight: 900;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }

  .m-time {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #ffffff;
    white-space: nowrap;
  }

  .m-clock {
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  /* Live Countdown Bar */
  .matchup-countdown-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-sm);
    padding: 10px 14px;
    margin-bottom: var(--space-sm);
    background: #111116;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-sm);
    font-variant-numeric: tabular-nums;
  }

  .cd-label {
    display: inline-flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .cd-timer {
    display: inline-flex;
    align-items: baseline;
    gap: 5px;
    font-size: 0.9375rem;
    color: #ffffff;
  }

  .cd-unit strong {
    font-size: 1.05rem;
    font-weight: 800;
    color: #ffffff;
  }

  .cd-unit small {
    font-size: 0.6875rem;
    font-weight: 700;
    color: #a1a1aa;
    margin-left: 2px;
  }

  .cd-colon {
    color: rgba(255, 255, 255, 0.4);
    font-weight: 700;
    font-size: 0.875rem;
    margin: 0 1px;
  }

  /* Starters Strip (High-Contrast & Accessible List) */
  .matchup-starters-strip {
    display: flex;
    flex-direction: column;
    gap: 8px;
    background: #0f0f13;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    padding: 12px 14px;
    margin-bottom: var(--space-md);
  }

  .starters-label {
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--text-secondary);
    letter-spacing: 0.06em;
  }

  .starters-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .starter-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    color: #ffffff;
    background: #15151c;
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 4px 10px;
    border-radius: var(--radius-xs);
  }

  .starter-role {
    color: #60a5fa;
    font-weight: 800;
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
  }

  .starter-name {
    color: #ffffff;
    font-weight: 700;
  }

  /* Matchup Actions Row */
  .matchup-cta-row {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  .matchup-cta-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 0.85rem 1.25rem;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    border-radius: var(--radius-full);
  }

  .matchup-ics-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 0.85rem 1.1rem;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.04em;
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 6rem;
      padding-bottom: 4.5rem;
      min-height: auto;
    }

    .hero-content {
      gap: var(--space-md);
    }

    .hero-title-main {
      font-size: clamp(2.15rem, 10.5vw, 3.3rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }

    .hero-desc {
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .hero-metrics-bar {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 16px;
      padding: var(--space-md);
    }

    .metric-sep {
      display: none;
    }

    .metric-item {
      padding: 4px 6px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: var(--radius-xs);
    }

    .metric-val {
      font-size: 1.25rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn-lg {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.25rem;
      font-size: 0.875rem;
    }

    .matchup-bento-card {
      padding: var(--space-lg);

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xl);
    }
  }

  @media (max-width: 640px) {
    .hero-section {
      padding-top: 6rem;
      padding-bottom: 4.5rem;
      min-height: auto;
    }

    .hero-content {
      gap: var(--space-md);
    }

    .hero-title-main {
      font-size: clamp(2.15rem, 10.5vw, 3.3rem);
      line-height: 0.98;
      letter-spacing: -0.03em;
    }

    .hero-desc {
      font-size: 0.95rem;
      line-height: 1.55;
    }

    .hero-metrics-bar {
      width: 100%;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));

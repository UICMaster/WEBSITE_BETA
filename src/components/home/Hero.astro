---
// src/components/home/Hero.astro
import { totalTeams, totalAthletes, primeTierShort, communityCount, nextMatch, discordInviteUrl } from '../../utils/uicData';
---

<section id="hero" class="hero-section">
  <!-- Architectural Monochrome Topographic Contours -->
  <div class="hero-bg-fx" aria-hidden="true">
    <div class="hero-glare"></div>

    <div class="hero-topo-wrap">
      <!-- Primary Elevation Contours (Rift Basin & Dual Ridges) -->
      <svg
        class="hero-topo-svg topo-layer-primary"
        viewBox="0 0 1600 900"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="topo-stroke-base" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.03" />
            <stop offset="45%" stop-color="#ffffff" stop-opacity="0.09" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.025" />
          </linearGradient>
          <linearGradient id="topo-stroke-ridge" x1="0%" y1="20%" x2="100%" y2="80%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.04" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.14" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.03" />
          </linearGradient>
        </defs>

        <!-- Diagonal Rift Valley Sweeps (Full-Stage Isolines) -->
        <g stroke="url(#topo-stroke-base)" stroke-width="1">
          <path d="M-120,780 C180,710 390,520 680,470 C970,420 1190,230 1720,120" />
          <path d="M-120,830 C210,750 420,555 715,500 C1010,445 1230,260 1720,165" />
          <path d="M-120,880 C240,790 450,590 750,530 C1050,470 1270,295 1720,210" />
          <path d="M-120,730 C150,665 360,485 645,440 C930,395 1150,195 1720,75" />
          <path d="M-120,680 C120,620 330,450 610,410 C890,370 1110,160 1720,30" />
        </g>

        <!-- North-West High-Ground Elevation Rings (Behind Hero Title) -->
        <g stroke="url(#topo-stroke-ridge)" stroke-width="1">
          <path d="M-80,140 C80,90 290,70 430,145 C570,220 550,355 410,420 C270,485 70,460 -90,390 Z" />
          <path d="M-40,175 C95,130 270,115 385,175 C500,235 485,340 370,390 C255,440 85,420 -50,360 Z" />
          <path d="M10,210 C115,172 245,160 335,205 C425,250 415,322 325,358 C235,394 105,380 5,332 Z" />
          <path d="M65,242 C135,215 220,208 282,238 C344,268 338,308 275,330 C212,352 130,342 62,308 Z" />
          <path d="M-130,95 C65,35 320,15 490,110 C660,205 635,380 465,465 C295,550 50,520 -140,435 Z" />
          <path d="M-180,50 C50,-20 355,-40 555,75 C755,190 720,405 525,510 C330,615 30,580 -190,480 Z" />
        </g>

        <!-- South-East Tactical Plateau Rings (Behind Matchup Card) -->
        <g stroke="url(#topo-stroke-ridge)" stroke-width="1">
          <path d="M1040,460 C1175,395 1375,410 1495,500 C1615,590 1585,735 1445,795 C1305,855 1110,825 1005,725 C900,625 905,525 1040,460 Z" />
          <path d="M1085,495 C1195,442 1355,455 1450,528 C1545,601 1522,715 1410,762 C1298,809 1142,785 1058,705 C974,625 975,548 1085,495 Z" />
          <path d="M1132,532 C1218,490 1335,500 1405,556 C1475,612 1458,695 1372,730 C1286,765 1172,748 1110,686 C1048,624 1046,574 1132,532 Z" />
          <path d="M1182,570 C1242,540 1318,548 1362,585 C1406,622 1395,674 1338,696 C1281,718 1205,708 1165,668 C1125,628 1122,600 1182,570 Z" />
          <path d="M990,420 C1155,342 1400,360 1545,470 C1690,580 1655,760 1485,832 C1315,904 1075,868 950,748 C825,628 825,498 990,420 Z" />
        </g>

        <!-- Subtle Travelling Monochrome Ridge Glints -->
        <path
          class="topo-ridge-glint"
          d="M-120,780 C180,710 390,520 680,470 C970,420 1190,230 1720,120"
        />
        <path
          class="topo-ridge-glint topo-glint-delayed"
          d="M-80,140 C80,90 290,70 430,145 C570,220 550,355 410,420 C270,485 70,460 -90,390 Z"
        />
        <path
          class="topo-ridge-glint topo-glint-slow"
          d="M1040,460 C1175,395 1375,410 1495,500 C1615,590 1585,735 1445,795 C1305,855 1110,825 1005,725 C900,625 905,525 1040,460 Z"
        />
      </svg>

      <!-- Secondary Deep-Field Contours (Counter-Drifting Parallax Layer) -->
      <svg
        class="hero-topo-svg topo-layer-secondary"
        viewBox="0 0 1600 900"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <g stroke="rgba(255, 255, 255, 0.04)" stroke-width="0.85" stroke-dasharray="6 10">
          <path d="M-100,610 C220,560 440,390 740,360 C1040,330 1280,150 1700,40" />
          <path d="M-100,920 C270,830 510,640 820,580 C1130,520 1350,350 1700,270" />
        </g>
        <g stroke="rgba(255, 255, 255, 0.035)" stroke-width="0.85">
          <path d="M240,-60 C420,80 590,230 790,260 C990,290 1190,190 1420,-40" />
          <path d="M180,-60 C385,110 570,275 795,310 C1020,345 1240,230 1490,-40" />
          <path d="M120,960 C340,790 550,660 780,640 C1010,620 1210,730 1440,960" />
        </g>
      </svg>
    </div>
  </div>

  <div class="container hero-container">
    
    <!-- Hero Main Stage -->
    <div class="hero-content">
      
      <div class="hero-badge-strip">
        <span class="hero-badge">PRIME LEAGUE ESPORT</span>
        <span class="hero-badge-sub text-mono">
          <span>DEUTSCHLAND</span>
        </span>
      </div>

      <h1 class="hero-title">
        <span class="hero-title-main">ULTRA INSTINCT CREW</span>
      </h1>

      <p class="hero-desc">
        Die deutsche League of Legends eSport Organisation. Mit {totalTeams} aktiven Teams und {totalAthletes} Spielern verbinden wir geregeltes Ligaspiel in der Prime League mit einer lebendigen Gemeinschaft für alle Spielstärken.
      </p>

      <!-- Key Metrics Counter Strip -->
      <div class="hero-metrics-bar">
        <div class="metric-item">
          <span class="metric-val text-mono">{totalTeams}</span>
          <span class="metric-lbl">TEAMS</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{totalAthletes}</span>
          <span class="metric-lbl">SPIELER</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{primeTierShort}</span>
          <span class="metric-lbl">LIGA</span>
        </div>
        <div class="metric-sep"></div>
        <div class="metric-item">
          <span class="metric-val text-mono">{communityCount}</span>
          <span class="metric-lbl">GEMEINSCHAFT</span>
        </div>
      </div>

      <!-- Hero Actions -->
      <div class="hero-actions">
        <a href="#teams" class="btn btn-primary btn-lg">
          <span>TEAMS ANSEHEN</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a href="#stats" class="btn btn-outline btn-lg">
          <span>SPIELPLAN & TABELLE</span>
        </a>

        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline btn-lg discord-btn">
          <span>DISCORD SERVER</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M7 7h10v10"/></svg>
        </a>
      </div>

    </div>

    <!-- Right Side: Matchup Card -->
    <div class="hero-matchup-col">
      <div class="matchup-bento-card">
        
        <div>
          <div class="card-meta">
            <span class="meta-num text-mono">
              {nextMatch.matchDay ? `SPIELTAG ${nextMatch.matchDay}` : 'SPIELTAG'}
            </span>
            <span class="meta-tag text-mono">PRIME LEAGUE &bull; {nextMatch.teamTier.toUpperCase()}</span>
            {nextMatch.isScheduled && (
              <span class={`match-status-badge ${nextMatch.confirmed ? 'is-confirmed' : 'is-unconfirmed'}`}>
                {nextMatch.confirmedLabel}
              </span>
            )}
          </div>

          <h2 class="card-title name-with-link">
            <span>NÄCHSTES SPIEL</span>
            {nextMatch.matchLink && (
              <a
                href={nextMatch.matchLink}
                target="_blank"
                rel="noopener noreferrer"
                class="link-forward-arrow"
                title={`Prime League Match: ${nextMatch.team} gegen ${nextMatch.enemy} öffnen`}
                aria-label={`Prime League Match: ${nextMatch.team} gegen ${nextMatch.enemy} öffnen`}
              >
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            )}
          </h2>

          <!-- Clash Strip -->
          <div class="matchup-clash-strip">
            <!-- Home Team -->
            <div class="m-team home">
              <div class="m-crest-wrap has-img">
                <img
                  src={nextMatch.teamLogo}
                  alt={`${nextMatch.team} Wappen`}
                  class="m-crest m-crest-full"
                  width="58"
                  height="58"
                  decoding="async"
                />
              </div>
              <span class="m-name name-with-link">
                <span>{nextMatch.team.toUpperCase()}</span>
                {nextMatch.teamLink && (
                  <a
                    href={nextMatch.teamLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-forward-arrow"
                    title={`${nextMatch.team} auf Prime League öffnen`}
                    aria-label={`${nextMatch.team} auf Prime League öffnen`}
                  >
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                )}
              </span>
            </div>

            <!-- VS Clash Badge -->
            <div class="m-clash-badge">
              <span class="m-vs text-mono">VS</span>
              <span class="m-time text-mono">{nextMatch.dateFormatted}</span>
              {nextMatch.isScheduled && (
                <span class="m-clock text-mono">{nextMatch.timeFormatted} UHR</span>
              )}
            </div>

            <!-- Opponent -->
            <div class="m-team away">
              <div class={`m-crest-wrap ${nextMatch.enemyLogo ? 'has-img' : 'm-crest-enemy'}`}>
                {nextMatch.enemyLogo ? (
                  <img
                    src={nextMatch.enemyLogo}
                    alt={`${nextMatch.enemy} Wappen`}
                    class="m-crest m-crest-full"
                    width="58"
                    height="58"
                    decoding="async"
                  />
                ) : (
                  <span class="m-enemy-tag text-mono">{nextMatch.enemyTag.slice(0, 3)}</span>
                )}
              </div>
              <span class="m-name name-with-link">
                <span>{nextMatch.enemy}</span>
                {nextMatch.enemyLink && (
                  <a
                    href={nextMatch.enemyLink}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-forward-arrow"
                    title={`${nextMatch.enemy} auf Prime League öffnen`}
                    aria-label={`${nextMatch.enemy} auf Prime League öffnen`}
                  >
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                  </a>
                )}
              </span>
            </div>
          </div>

          <!-- Live T-Minus Countdown Strip -->
          {nextMatch.isScheduled && nextMatch.beginISO && (
            <div
              class="matchup-countdown-bar text-mono"
              id="hero-match-countdown"
              data-begin-iso={nextMatch.beginISO}
              aria-live="polite"
              aria-label="Verbleibende Zeit bis zum Spielbeginn"
            >
              <span class="cd-label" id="hero-cd-status">SPIELSTART IN</span>
              <div class="cd-timer" id="hero-cd-timer" aria-atomic="true">
                <span class="cd-unit"><strong id="cd-days">--</strong><small>T</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-hours">--</strong><small>S</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-mins">--</strong><small>M</small></span>
                <span class="cd-colon" aria-hidden="true">:</span>
                <span class="cd-unit"><strong id="cd-secs">--</strong><small>SEK</small></span>
              </div>
            </div>
          )}

          <!-- Starters Strip -->
          <div class="matchup-starters-strip" aria-labelledby="hero-starters-heading">
            <span class="starters-label text-mono" id="hero-starters-heading">
              AUFGEBOT ({nextMatch.team.toUpperCase()}):
            </span>
            <ul class="starters-pills" role="list">
              {nextMatch.starters.map((player) => (
                <li class="starter-chip text-mono">
                  <span class="starter-role">{player.role}</span>
                  <span class="starter-name">{player.name.replace('UIC ', '')}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="matchup-cta-row">
          <a href="#stats" class="btn btn-outline matchup-cta-btn">
            <span>TABELLE & SPIELPLAN</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          {nextMatch.isScheduled && nextMatch.beginISO && (
            <button
              type="button"
              class="btn btn-outline matchup-ics-btn text-mono"
              data-ics-trigger
              data-ics-title={`${nextMatch.team} vs. ${nextMatch.enemy} (Prime League)`}
              data-ics-desc={`Prime League (${nextMatch.teamTier}) — ${nextMatch.team} gegen ${nextMatch.enemy}`}
              data-ics-loc={nextMatch.matchLink || 'https://www.primeleague.gg'}
              data-ics-begin={nextMatch.beginISO}
              title="Spieltermin als .ICS Kalenderdatei speichern"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
              <span>+ KALENDER</span>
            </button>
          )}
        </div>

      </div>
    </div>

  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding-top: clamp(7.5rem, 11vw, 10rem);
    padding-bottom: clamp(5.5rem, 8vw, 7.5rem);
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    background: #000000;
    overflow: hidden;
  }

  /* Architectural Monochrome Topographic Contours */
  .hero-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .hero-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 58% 46% at 22% 24%, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.018) 48%, transparent 76%),
      radial-gradient(ellipse 45% 42% at 78% 62%, rgba(255, 255, 255, 0.04) 0%, transparent 70%);
  }

  .hero-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 88% 78% at 50% 46%, #000000 25%, rgba(0, 0, 0, 0.65) 62%, transparent 92%);
    -webkit-mask-image: radial-gradient(ellipse 88% 78% at 50% 46%, #000000 25%, rgba(0, 0, 0, 0.65) 62%, transparent 92%);
  }

  .hero-topo-svg {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    display: block;
    will-change: transform;
  }

  .topo-layer-primary {
    animation: topoBreathePrimary 28s ease-in-out infinite alternate;
  }

  .topo-layer-secondary {
    animation: topoBreatheSecondary 36s ease-in-out infinite alternate;
  }

  .topo-ridge-glint {
    stroke: rgba(255, 255, 255, 0.26);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-dasharray: 220 1600;
    stroke-dashoffset: 1820;
    animation: topoGlintTravel 26s linear infinite;
  }

  .topo-glint-delayed {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-dasharray: 180 1400;
    stroke-dashoffset: 1580;
    animation-duration: 32s;
    animation-delay: -11s;
  }

  .topo-glint-slow {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-dasharray: 160 1500;
    stroke-dashoffset: 1660;
    animation-duration: 38s;
    animation-delay: -19s;
  }

  @keyframes topoBreathePrimary {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-1.5%, 1.2%, 0) scale(1.035);
    }
  }

  @keyframes topoBreatheSecondary {
    0% {
      transform: translate3d(0, 0, 0) scale(1.02);
    }
    100% {
      transform: translate3d(1.5%, -1.2%, 0) scale(0.985);
    }
  }

  @keyframes topoGlintTravel {
    0% {
      stroke-dashoffset: 1820;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topo-layer-primary,
    .topo-layer-secondary,
    .topo-ridge-glint {
      animation: none !important;
    }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: var(--container-max);
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  /* Left Content */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
    min-width: 0;
    max-width: 100%;
  }

  .hero-badge-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-xs);
  }

  .hero-badge {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #000000;
    background: #ffffff;
    padding: 3px 10px;
    border-radius: var(--radius-xs);
  }

  .hero-badge-sub {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
  }

  /* Clean, Bold, Solid Title (No Hollow Outline) */
  .hero-title {
    margin: 0;
    line-height: 0.95;
    max-width: 100%;
  }

  .hero-title-main {
    font-family: var(--font-display);
    font-size: clamp(2.35rem, 8.2vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    color: #ffffff;
    display: block;
    text-transform: uppercase;
    max-width: 100%;
    overflow-wrap: break-word;
  }

  .hero-desc {
    font-size: clamp(1.05rem, 1.35vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-secondary);
    max-width: 620px;
    margin: 0;
  }

  /* Solid Distinct Raised Metrics Bar */
  .hero-metrics-bar {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    padding: var(--space-md) var(--space-xl);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    width: fit-content;
    max-width: 100%;
    box-sizing: border-box;
  }

  .metric-item {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .metric-val {
    font-weight: 800;
    font-size: 1.4rem;
    color: #ffffff;
    line-height: 1.1;
  }

  .metric-lbl {
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
  }

  .metric-sep {
    width: 1px;
    height: 30px;
    background: rgba(255, 255, 255, 0.1);
    flex-shrink: 0;
  }

  /* Hero Actions */
  .hero-actions {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
    width: 100%;
  }

  .btn-lg {
    padding: 0.95rem 2rem;
    font-size: 0.9375rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    border-radius: var(--radius-full);
  }

  .discord-btn {
    border-color: rgba(255, 255, 255, 0.2);
  }

  /* Matchup Card (Matching Ökosystem Bento Design Layers) */
  .hero-matchup-col {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .matchup-bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-lg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7);
    transition: border-color var(--transition-fast), transform var(--transition-smooth);
    max-width: 100%;
    box-sizing: border-box;
  }

  .matchup-bento-card:hover {
    background: #121216;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xs);
  }

  .meta-num {
    font-size: 0.75rem;
    font-weight: 800;
    color: #ffffff;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
  }

  .meta-tag {
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .card-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    color: #ffffff;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-md);
    line-height: 1.2;
  }

  .matchup-clash-strip {
    display: flex;
    justify-content: space-between;

    }

    .metric-val {
      font-size: 1.25rem;
    }

    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }

    .hero-actions .btn-lg {
      width: 100%;
      justify-content: center;
      padding: 0.85rem 1.25rem;
      font-size: 0.875rem;
    }

    .matchup-bento-card {
      padding: var(--space-lg);
      gap: var(--space-md);
    }


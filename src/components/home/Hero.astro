  /* Architectural Monochrome Topographic Contours */
  .hero-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .hero-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 40% 40% at 52% 51%, rgba(255, 255, 255, 0.052) 0%, rgba(255, 255, 255, 0.015) 54%, transparent 82%),
      radial-gradient(ellipse 26% 24% at 66% 31%, rgba(255, 255, 255, 0.04) 0%, transparent 70%);
  }

  .hero-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 80% 80% at 52% 51%, #000000 40%, rgba(0, 0, 0, 0.8) 70%, transparent 96%);
    -webkit-mask-image: radial-gradient(ellipse 80% 80% at 52% 51%, #000000 40%, rgba(0, 0, 0, 0.8) 70%, transparent 96%);
  }

  .hero-topo-svg {
    position: absolute;
    inset: -4%;
    width: 108%;
    height: 108%;
    display: block;
    will-change: transform;
  }

  .topo-layer-primary {
    animation: topoBreathePrimary 28s ease-in-out infinite alternate;
  }

  .topo-layer-secondary {
    animation: topoBreatheSecondary 36s ease-in-out infinite alternate;
  }

  .topo-ridge-glint {
    stroke: rgba(255, 255, 255, 0.26);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-dasharray: 220 1600;
    stroke-dashoffset: 1820;
    animation: topoGlintTravel 26s linear infinite;
  }

  .topo-glint-delayed {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-dasharray: 180 1400;
    stroke-dashoffset: 1580;
    animation-duration: 32s;
    animation-delay: -11s;
  }

  .topo-glint-slow {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-dasharray: 160 1500;
    stroke-dashoffset: 1660;
    animation-duration: 38s;
    animation-delay: -19s;
  }

  @keyframes topoBreathePrimary {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-1.5%, 1.2%, 0) scale(1.035);
    }
  }

  @keyframes topoBreatheSecondary {
    0% {
      transform: translate3d(0, 0, 0) scale(1.02);
    }
    100% {
      transform: translate3d(1.5%, -1.2%, 0) scale(0.985);
    }
  }

  @keyframes topoGlintTravel {
    0% {
      stroke-dashoffset: 1820;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .topo-layer-primary,
    .topo-layer-secondary,
    .topo-ridge-glint {
      animation: none !important;
    }
  }


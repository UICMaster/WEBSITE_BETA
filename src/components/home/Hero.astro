      padding: var(--space-md);
      gap: var(--space-xs);
    }

    .m-crest-wrap {
      width: 46px;
      height: 46px;
    }

    .m-name {
      font-size: 0.8125rem;
    }

    .m-clash-badge {
      padding: 5px 8px;
    }

    .matchup-cta-row {
      flex-direction: column;
      align-items: stretch;
    }

    .matchup-cta-btn,

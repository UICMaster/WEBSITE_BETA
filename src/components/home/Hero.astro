    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-glare,
    .hero-orb,
    .hero-beam,
    .hero-lines,
    .hero-scanline {
      animation: none !important;
    }
  }
</style>

<script>
  // Animated Ultra Instinct Background Energy Particles
  const heroCanvas = document.getElementById('hero-particles-canvas') as HTMLCanvasElement | null;
  if (heroCanvas && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = heroCanvas.getContext('2d');
    if (ctx) {
      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);

      interface Particle {
        x: number;
        y: number;
        r: number;
        vy: number;
        vx: number;
        alpha: number;
        pulseSpeed: number;
        phase: number;
      }

      let particles: Particle[] = [];

      const initParticles = () => {
        const rect = heroCanvas.parentElement?.getBoundingClientRect();
        width = rect ? rect.width : window.innerWidth;
        height = rect ? rect.height : window.innerHeight;
        dpr = Math.min(window.devicePixelRatio || 1, 2);
        heroCanvas.width = width * dpr;
        heroCanvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        const count = width < 640 ? 26 : 52;
        particles = Array.from({ length: count }, () => ({
          x: Math.random() * width,
          y: Math.random() * height,
          r: Math.random() * 1.8 + 0.6,
          vy: -(Math.random() * 0.45 + 0.15),
          vx: (Math.random() - 0.5) * 0.25,
          alpha: Math.random() * 0.55 + 0.15,
          pulseSpeed: Math.random() * 0.025 + 0.01,
          phase: Math.random() * Math.PI * 2
        }));
      };

      initParticles();
      window.addEventListener('resize', initParticles, { passive: true });

      let isHeroVisible = true;
      const heroObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            isHeroVisible = entry.isIntersecting;
          }
        },
        { threshold: 0 }
      );
      heroObserver.observe(heroCanvas);

      const renderParticles = () => {
        if (isHeroVisible) {
          ctx.clearRect(0, 0, width, height);

          for (let i = 0; i < particles.length; i++) {
            const p = particles[i];
            p.phase += p.pulseSpeed;
            p.y += p.vy;
            p.x += p.vx + Math.sin(p.phase) * 0.18;

            if (p.y < -10) {
              p.y = height + 10;
              p.x = Math.random() * width;
            }
            if (p.x < -10) p.x = width + 10;
            if (p.x > width + 10) p.x = -10;

            const currentAlpha = p.alpha * (0.65 + 0.35 * Math.sin(p.phase));

            // Soft aura glow + bright silver core
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r * 2.6, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(226, 232, 240, ${currentAlpha * 0.22})`;
            ctx.fill();

            ctx.beginPath();
            ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${currentAlpha})`;
            ctx.fill();
          }
        }
        requestAnimationFrame(renderParticles);
      };

      requestAnimationFrame(renderParticles);
    }
  }

  const cdWrap = document.getElementById('hero-match-countdown');
  if (cdWrap) {
    const beginIso = cdWrap.getAttribute('data-begin-iso');
    const daysEl = document.getElementById('cd-days');
    const hoursEl = document.getElementById('cd-hours');
    const minsEl = document.getElementById('cd-mins');
    const secsEl = document.getElementById('cd-secs');
    const statusEl = document.getElementById('hero-cd-status');
    const timerEl = document.getElementById('hero-cd-timer');

    const pad = (n: number) => String(n).padStart(2, '0');

    const updateCountdown = () => {
      if (!beginIso) return;
      const target = new Date(beginIso).getTime();
      const diff = target - Date.now();

      if (diff <= 0) {
        if (statusEl) statusEl.textContent = 'SPIEL LÄUFT AKTUELL';
        if (timerEl) timerEl.textContent = 'LIVE';
        return;
      }

      const totalSecs = Math.floor(diff / 1000);
      const d = Math.floor(totalSecs / 86400);
      const h = Math.floor((totalSecs % 86400) / 3600);
      const m = Math.floor((totalSecs % 3600) / 60);
      const s = totalSecs % 60;

      if (daysEl) daysEl.textContent = pad(d);
      if (hoursEl) hoursEl.textContent = pad(h);
      if (minsEl) minsEl.textContent = pad(m);
      if (secsEl) secsEl.textContent = pad(s);
    };

    updateCountdown();
    setInterval(updateCountdown, 1000);
  }

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement | null)?.closest<HTMLButtonElement>('[data-ics-trigger]');
    if (!btn) return;
    const downloadFn = (window as any).downloadUicIcs;
    if (typeof downloadFn === 'function') {
      downloadFn({
        title: btn.getAttribute('data-ics-title'),
        description: btn.getAttribute('data-ics-desc'),
        location: btn.getAttribute('data-ics-loc'),
        beginISO: btn.getAttribute('data-ics-begin')
      });
    }
  });
</script>

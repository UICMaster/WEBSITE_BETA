---
// src/components/home/AudioDeck.astro

const tracks = [
  {
    title: "UIC HYMNE • 2026 Q4",
    subtitle: "Offizielle Organisations-Hymne (Q4 Edit)",
    category: "orga",
    badge: "ORGA HYMNE",
    cover: "/assets/logo/logo.svg",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026_2.mp3"
  },
  {
    title: "UIC HYMNE • 2026 Original",
    subtitle: "Offizielle Organisations-Hymne 2026",
    category: "orga",
    badge: "ORGA HYMNE",
    cover: "/assets/logo/logo.svg",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026.mp3"
  },
  {
    title: "UIC HYMNE • Lagerfeuer",
    subtitle: "Acoustic & Community Version 2026",
    category: "orga",
    badge: "COMMUNITY",
    cover: "/assets/logo/logo.svg",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2026_FAM.mp3"
  },
  {
    title: "UIC HYMNE • 2025",
    subtitle: "Offizielle Organisations-Hymne 2025",
    category: "orga",
    badge: "ORGA ARCHIV",
    cover: "/assets/logo/logo.svg",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_ORGA_HYMNE_2025.mp3"
  },
  {
    title: "UIC EMBER • Team-Hymne",
    subtitle: "Prime League Team Anthem 2026",
    category: "team",
    badge: "TEAM EMBER",
    cover: "/assets/teams/ember.webp",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_EMBER_2026.mp3"
  },
  {
    title: "UIC CYBER • Team-Hymne",
    subtitle: "Prime League Team Anthem 2026",
    category: "team",
    badge: "TEAM CYBER",
    cover: "/assets/teams/cyber.webp",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_CYBER_2026.mp3"
  },
  {
    title: "UIC FREEZER • Team-Hymne",
    subtitle: "Prime League Team Anthem 2026",
    category: "team",
    badge: "TEAM FREEZER",
    cover: "/assets/teams/freezer.webp",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_FREEZER_2026.mp3"
  },
  {
    title: "UIC VAKUUM • Team-Hymne",
    subtitle: "Prime League Team Anthem 2026",
    category: "team",
    badge: "TEAM VAKUUM",
    cover: "/assets/teams/vakuum.webp",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_VAKUUM_2026.mp3"
  },
  {
    title: "UIC NIGHT • Team-Hymne",
    subtitle: "Prime League Team Anthem 2026",
    category: "team",
    badge: "TEAM NIGHT",
    cover: "/assets/teams/night.webp",
    src: "/assets/audio/ULTRA_INSTINCT_CREW_TEAM_NIGHT_2026.mp3"
  }
];

const orgaCount = tracks.filter((t) => t.category === "orga").length;
const teamCount = tracks.filter((t) => t.category === "team").length;
---

<div id="uic-audio-widget" class="audio-widget is-collapsed" aria-label="UIC Audio Player">
  <audio id="hymn-audio-element" preload="metadata"></audio>

  <!-- Floating Docked Pill (Always Visible) -->
  <div class="pill-bar">
    <button
      type="button"
      id="audio-pill-toggle"
      class="pill-trigger"
      title="Audio-Player ein-/ausklappen"
      aria-label="Audio-Player öffnen oder schließen"
      aria-expanded="false"
      aria-controls="expanded-audio-deck"
    >
      <span class="pill-cover-wrap">
        <img
          id="pill-track-cover"
          src={tracks[0].cover}
          alt=""
          width="20"
          height="20"
          class="pill-cover-img"
        />
      </span>
      <span class="equalizer-bars" aria-hidden="true">
        <span class="bar bar-1"></span>
        <span class="bar bar-2"></span>
        <span class="bar bar-3"></span>
      </span>
      <span id="current-track-label" class="pill-title text-mono">UIC HYMNEN</span>
      <span class="pill-chevron" aria-hidden="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 15l-6-6-6 6"/>
        </svg>
      </span>
    </button>

    <button type="button" id="pill-play-btn" class="pill-ctrl" aria-label="Abspielen oder Pausieren">
      <svg id="icon-pill-play" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
      <svg id="icon-pill-pause" class="hidden" width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
    </button>
  </div>

  <!-- Expanded Studio Deck Window -->
  <div id="expanded-audio-deck" class="expanded-deck" role="dialog" aria-label="UIC Hymnen & Team-Songs">
    <div class="deck-top">
      <div class="deck-top-left">
        <span class="deck-brand text-mono">UIC AUDIO DECK</span>
        <span class="deck-count-pill text-mono">{tracks.length} TRACKS</span>
      </div>
      <button type="button" id="deck-close-btn" class="deck-btn-close" aria-label="Audio-Player minimieren" title="Minimieren (Esc)">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Now Playing Showcase Card -->
    <div class="now-playing-card">
      <div class="np-cover-box">
        <img
          id="deck-track-cover"
          src={tracks[0].cover}
          alt="Track Cover"
          width="42"
          height="42"
          class="np-cover-img"
        />
      </div>
      <div class="np-meta">
        <div class="np-badge-row">
          <span id="deck-track-badge" class="np-badge text-mono">{tracks[0].badge}</span>
        </div>
        <strong id="deck-track-title" class="np-title">{tracks[0].title}</strong>
        <span id="deck-track-subtitle" class="np-subtitle">{tracks[0].subtitle}</span>
      </div>
      <a
        id="deck-download-btn"
        href={tracks[0].src}
        download
        class="np-download-btn"
        title="Aktuellen Track als MP3 herunterladen"
        aria-label="Aktuellen Track als MP3 herunterladen"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
          <path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v2a2 2 0 002 2h12a2 2 0 002-2v-2"/>
        </svg>
      </a>
    </div>

    <!-- Interactive Scrubber with Pointer-Capture & Playhead -->
    <div class="scrub-section">
      <div
        class="scrub-container"
        id="scrub-container"
        role="slider"
        tabindex="0"
        aria-label="Wiedergabefortschritt"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
      >
        <div class="scrub-bg">
          <div id="scrub-fill" class="scrub-fill"></div>
        </div>
        <div id="scrub-thumb" class="scrub-thumb" aria-hidden="true"></div>
      </div>

      <div class="time-row text-mono">
        <span id="audio-curr-time">0:00</span>
        <span id="audio-duration">0:00</span>
      </div>
    </div>

    <!-- Transport & Volume Controls Row -->
    <div class="deck-transport-row">
      <div class="deck-controls">
        <button type="button" id="btn-prev-track" class="btn-ctrl-icon" aria-label="Vorheriger Track" title="Vorheriger Track">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
        </button>

        <button type="button" id="btn-main-play" class="btn-ctrl-play" aria-label="Abspielen oder Pausieren">
          <svg id="icon-main-play" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
          <svg id="icon-main-pause" class="hidden" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>

        <button type="button" id="btn-next-track" class="btn-ctrl-icon" aria-label="Nächster Track" title="Nächster Track">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
        </button>
      </div>

      <div class="deck-volume">
        <button
          type="button"
          id="btn-audio-mute"
          class="btn-ctrl-icon vol-mute-btn"
          aria-label="Ton ein- oder ausschalten"
          title="Ton ein/aus"
        >
          <svg id="icon-vol-on" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"/>
          </svg>
          <svg id="icon-vol-muted" class="hidden" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/>
            <line x1="23" y1="9" x2="17" y2="15"/>
            <line x1="17" y1="9" x2="23" y2="15"/>
          </svg>
        </button>

        <input
          type="range"
          id="audio-vol-slider"
          class="vol-slider"
          min="0"
          max="100"
          value="75"
          aria-label="Lautstärke"
        />
      </div>
    </div>

    <!-- Categorized Playlist Selector -->
    <div class="deck-playlist">
      <div class="playlist-header">
        <span class="playlist-heading text-mono">TITELAUSWAHL</span>
        <div class="playlist-filters text-mono" role="tablist" aria-label="Tracks nach Kategorie filtern">
          <button type="button" class="pf-chip is-active" data-audio-filter="all">ALLE ({tracks.length})</button>
          <button type="button" class="pf-chip" data-audio-filter="orga">ORGA ({orgaCount})</button>
          <button type="button" class="pf-chip" data-audio-filter="team">TEAMS ({teamCount})</button>
        </div>
      </div>

      <ul class="playlist-items">
        {tracks.map((t, i) => (
          <li data-track-category={t.category}>
            <button
              type="button"
              class={`playlist-track ${i === 0 ? 'is-active' : ''}`}
              data-track-index={i}
            >
              <span class="track-number text-mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="track-thumb-wrap">
                <img src={t.cover} alt="" width="20" height="20" class="track-thumb-img" loading="lazy" />
              </span>
              <span class="track-info">
                <span class="track-name">{t.title}</span>
                <span class="track-cat text-mono">{t.badge}</span>
              </span>
              <span class="track-state-indicator" aria-hidden="true"></span>
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .audio-widget {
    position: fixed;
    bottom: calc(38px + var(--space-md));
    right: var(--space-lg);
    z-index: 999;
    font-family: var(--font-body);
  }

  .hidden {
    display: none !important;
  }

  /* Docked Monochrome Pill Bar */
  .pill-bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(13, 13, 16, 0.94);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-radius: var(--radius-full);
    padding: 5px 7px 5px 10px;
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.8), 0 0 0 1px rgba(255, 255, 255, 0.04);
    transition: border-color var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pill-bar:hover {
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(18, 18, 23, 0.98);
  }

  .audio-widget.is-playing .pill-bar {
    border-color: rgba(255, 255, 255, 0.32);
  }

  .pill-trigger {
    display: flex;
    align-items: center;
    gap: 8px;
    background: none;
    border: none;
    cursor: pointer;
    color: var(--text-white);
    padding: 2px 4px 2px 0;
  }

  .pill-cover-wrap {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #050507;
    border: 1px solid rgba(255, 255, 255, 0.16);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    flex-shrink: 0;
  }

  .pill-cover-img {
    width: 17px;
    height: 17px;
    object-fit: contain;
  }

  .pill-title {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    max-width: 150px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .pill-chevron {
    color: var(--text-muted);
    display: inline-flex;
    align-items: center;
    transition: transform var(--transition-fast), color var(--transition-fast);
  }

  .audio-widget.is-expanded .pill-chevron {
    transform: rotate(180deg);
    color: var(--text-white);
  }

  .pill-ctrl {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    flex-shrink: 0;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .pill-ctrl:hover {
    transform: scale(1.06);
    box-shadow: 0 0 14px rgba(255, 255, 255, 0.35);
  }

  /* Animated Equalizer */
  .equalizer-bars {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    height: 13px;
  }

  .bar {
    width: 2px;
    background-color: var(--text-white);
    border-radius: 1px;
    height: 4px;
  }

  .is-playing .bar-1 { animation: eqBounce 0.75s infinite ease-in-out alternate; }
  .is-playing .bar-2 { animation: eqBounce 1.05s infinite ease-in-out alternate 0.2s; }
  .is-playing .bar-3 { animation: eqBounce 0.55s infinite ease-in-out alternate 0.35s; }

  @keyframes eqBounce {
    from { height: 3px; }
    to { height: 13px; }
  }

  /* Expanded Studio Deck */
  .expanded-deck {
    display: none;
    position: absolute;
    bottom: calc(100% + 12px);
    right: 0;
    width: 356px;
    background: rgba(13, 13, 16, 0.97);
    border: 1px solid rgba(255, 255, 255, 0.16);
    backdrop-filter: blur(28px);
    -webkit-backdrop-filter: blur(28px);
    border-radius: var(--radius-lg);
    padding: 18px;
    box-shadow: 0 24px 64px rgba(0, 0, 0, 0.85), 0 0 0 1px rgba(255, 255, 255, 0.05);
    flex-direction: column;
    gap: 14px;
    animation: fadeIn var(--transition-fast) forwards;
  }

  .audio-widget.is-expanded .expanded-deck {
    display: flex;
  }

  .deck-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    padding-bottom: 10px;
  }

  .deck-top-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .deck-brand {
    font-size: 0.6875rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: 0.08em;
  }

  .deck-count-pill {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.06em;
  }

  .deck-btn-close {
    width: 26px;
    height: 26px;
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .deck-btn-close:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.24);
    background: rgba(255, 255, 255, 0.08);
  }

  /* Now Playing Card */
  .now-playing-card {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #08080a;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    padding: 10px 12px;
  }

  .np-cover-box {
    width: 48px;
    height: 48px;
    border-radius: var(--radius-sm);
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.14);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .np-cover-img {
    width: 36px;
    height: 36px;
    object-fit: contain;
  }

  .np-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    flex: 1;
  }

  .np-badge-row {
    display: flex;
    align-items: center;
  }

  .np-badge {
    font-size: 0.58rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #d4d4d8;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.14);
    padding: 1px 6px;
    border-radius: 3px;
  }

  .np-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: #ffffff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-subtitle {
    font-size: 0.72rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .np-download-btn {
    width: 30px;
    height: 30px;
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .np-download-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.32);
    background: rgba(255, 255, 255, 0.1);
  }

  /* Scrubber */
  .scrub-section {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .scrub-container {
    --scrub-pct: 0%;
    position: relative;
    cursor: pointer;
    height: 18px;
    display: flex;
    align-items: center;
    touch-action: none;
    user-select: none;
  }

  .scrub-bg {
    width: 100%;
    height: 5px;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-full);
    overflow: hidden;
  }

  .scrub-fill {
    width: var(--scrub-pct);
    height: 100%;
    background: #ffffff;
    border-radius: var(--radius-full);
  }

  .scrub-thumb {
    position: absolute;
    top: 50%;
    left: var(--scrub-pct);
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
    transform: translate(-50%, -50%) scale(0.85);
    transition: transform 0.15s ease;
    pointer-events: none;
  }

  .scrub-container:hover .scrub-thumb,
  .scrub-container:focus-visible .scrub-thumb {
    transform: translate(-50%, -50%) scale(1.15);
  }

  .time-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.675rem;
    color: var(--text-muted);
  }

  /* Transport & Volume */
  .deck-transport-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .deck-controls {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .btn-ctrl-icon {
    width: 32px;
    height: 32px;
    border-radius: var(--radius-xs);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
  }

  .btn-ctrl-icon:hover {
    color: var(--text-white);
    border-color: rgba(255, 255, 255, 0.25);
    background: rgba(255, 255, 255, 0.08);
  }

  .btn-ctrl-play {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast);
  }

  .btn-ctrl-play:hover {
    transform: scale(1.06);
    box-shadow: 0 0 16px rgba(255, 255, 255, 0.35);
  }

  .deck-volume {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #08080a;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-sm);
    padding: 4px 10px 4px 6px;
  }

  .vol-mute-btn {
    width: 26px;
    height: 26px;
    border: none;
    background: transparent;
  }

  .vol-mute-btn:hover {
    background: transparent;
  }

  .vol-slider {
    --vol-pct: 75%;
    -webkit-appearance: none;
    appearance: none;
    width: 72px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #ffffff var(--vol-pct), rgba(255, 255, 255, 0.16) var(--vol-pct));
    outline: none;
    cursor: pointer;
  }

  .vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #ffffff;
    cursor: pointer;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.6);
  }

  .vol-slider::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    border: none;
    background: #ffffff;
    cursor: pointer;
  }

  /* Playlist */
  .deck-playlist {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    padding-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .playlist-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .playlist-heading {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
  }

  .playlist-filters {
    display: inline-flex;
    gap: 4px;
    background: #08080a;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-xs);
    padding: 2px;
  }

  .pf-chip {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    padding: 3px 7px;
    border-radius: 3px;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .pf-chip:hover {
    color: #ffffff;
  }

  .pf-chip.is-active {
    background: #ffffff;
    color: #000000;
  }

  .playlist-items {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-height: 184px;
    overflow-y: auto;
    scrollbar-width: thin;
    padding-right: 2px;
  }

  .playlist-track {
    display: flex;
    align-items: center;
    gap: 9px;
    width: 100%;
    padding: 6px 8px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    text-align: left;
    color: var(--text-secondary);
    transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
  }

  .playlist-track:hover {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.08);
    color: var(--text-white);
  }

  .playlist-track.is-active {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-white);
  }

  .track-number {
    font-size: 0.625rem;
    color: var(--text-muted);
    width: 16px;
    flex-shrink: 0;
  }

  .track-thumb-wrap {
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: #000000;
    border: 1px solid rgba(255, 255, 255, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    overflow: hidden;
  }

  .track-thumb-img {
    width: 18px;
    height: 18px;
    object-fit: contain;
  }

  .track-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex: 1;
  }

  .track-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: inherit;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .track-cat {
    font-size: 0.58rem;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .track-state-indicator {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: transparent;
    flex-shrink: 0;
  }

  .playlist-track.is-active .track-state-indicator {
    background: #ffffff;
    box-shadow: 0 0 8px rgba(255, 255, 255, 0.8);
  }

  .audio-widget.is-playing .playlist-track.is-active .track-state-indicator {
    background: #34d399;
    box-shadow: 0 0 8px rgba(52, 211, 153, 0.9);
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 1100px) {
    .audio-widget {
      bottom: calc(76px + env(safe-area-inset-bottom));
      right: var(--space-md);
    }

    .expanded-deck {
      width: min(356px, calc(100vw - 2 * var(--space-md)));
    }
  }
</style>

<script is:inline define:vars={{ tracks }}>
  const widget = document.getElementById('uic-audio-widget');
  const audio = document.getElementById('hymn-audio-element');
  const pillToggle = document.getElementById('audio-pill-toggle');
  const pillPlayBtn = document.getElementById('pill-play-btn');
  const pillCover = document.getElementById('pill-track-cover');
  const mainPlayBtn = document.getElementById('btn-main-play');
  const closeBtn = document.getElementById('deck-close-btn');
  const prevBtn = document.getElementById('btn-prev-track');
  const nextBtn = document.getElementById('btn-next-track');
  const currentLabel = document.getElementById('current-track-label');
  const deckCover = document.getElementById('deck-track-cover');
  const deckBadge = document.getElementById('deck-track-badge');
  const deckTitle = document.getElementById('deck-track-title');
  const deckSubtitle = document.getElementById('deck-track-subtitle');
  const deckDownload = document.getElementById('deck-download-btn');
  const scrubContainer = document.getElementById('scrub-container');
  const currTime = document.getElementById('audio-curr-time');
  const durTime = document.getElementById('audio-duration');
  const muteBtn = document.getElementById('btn-audio-mute');
  const volSlider = document.getElementById('audio-vol-slider');
  const iconVolOn = document.getElementById('icon-vol-on');
  const iconVolMuted = document.getElementById('icon-vol-muted');
  const trackBtns = document.querySelectorAll('.playlist-track');
  const filterBtns = document.querySelectorAll('[data-audio-filter]');
  const playlistItems = document.querySelectorAll('[data-track-category]');

  const VOL_STORAGE_KEY = 'uic_audio_volume';
  let currentIdx = 0;

  function formatTime(s) {
    if (!isFinite(s) || s < 0) return '0:00';
    const mins = Math.floor(s / 60);
    const secs = Math.floor(s % 60);
    return `${mins}:${secs < 10 ? '0' : ''}${secs}`;
  }

  function setScrubPercent(pct) {
    const clamped = Math.max(0, Math.min(100, pct || 0));
    scrubContainer?.style.setProperty('--scrub-pct', `${clamped}%`);
    scrubContainer?.setAttribute('aria-valuenow', String(Math.round(clamped)));
  }

  function syncVolumeUI() {
    if (!audio) return;
    const effectivePct = audio.muted ? 0 : Math.round(audio.volume * 100);
    if (volSlider) {
      volSlider.value = String(effectivePct);
      volSlider.style.setProperty('--vol-pct', `${effectivePct}%`);
    }
    iconVolOn?.classList.toggle('hidden', audio.muted || effectivePct === 0);
    iconVolMuted?.classList.toggle('hidden', !(audio.muted || effectivePct === 0));
  }

  function initVolume() {
    if (!audio) return;
    let saved = 75;
    try {
      const raw = localStorage.getItem(VOL_STORAGE_KEY);
      if (raw !== null && !isNaN(Number(raw))) {
        saved = Math.max(0, Math.min(100, Number(raw)));
      }
    } catch {}
    audio.volume = saved / 100;
    audio.muted = saved === 0;
    syncVolumeUI();
  }

  function updateMediaSession(track) {
    if (!('mediaSession' in navigator) || !track) return;
    try {
      navigator.mediaSession.metadata = new MediaMetadata({
        title: track.title,
        artist: 'Ultra Instinct Crew',
        album: track.badge,
        artwork: [{ src: track.cover, sizes: '256x256', type: 'image/webp' }]
      });
    } catch {}
  }

  function loadTrack(idx) {
    const track = tracks[idx];
    if (!track || !audio) return;
    currentIdx = idx;
    audio.src = track.src;
    setScrubPercent(0);
    if (currTime) currTime.textContent = '0:00';
    if (durTime) durTime.textContent = '0:00';

    if (currentLabel) currentLabel.textContent = track.title;
    if (pillCover) pillCover.src = track.cover;
    if (deckCover) deckCover.src = track.cover;
    if (deckBadge) deckBadge.textContent = track.badge;
    if (deckTitle) deckTitle.textContent = track.title;
    if (deckSubtitle) deckSubtitle.textContent = track.subtitle;
    if (deckDownload) deckDownload.setAttribute('href', track.src);

    trackBtns.forEach((b, i) => {
      b.classList.toggle('is-active', i === idx);
    });

    updateMediaSession(track);
  }

  function syncPlayIcons() {
    const playing = Boolean(audio && !audio.paused);
    widget?.classList.toggle('is-playing', playing);
    document.getElementById('icon-pill-play')?.classList.toggle('hidden', playing);
    document.getElementById('icon-pill-pause')?.classList.toggle('hidden', !playing);
    document.getElementById('icon-main-play')?.classList.toggle('hidden', playing);
    document.getElementById('icon-main-pause')?.classList.toggle('hidden', !playing);
  }

  function playCurrent() {
    if (!audio) return;
    if (!audio.getAttribute('src')) loadTrack(currentIdx);
    audio.play().catch(() => {});
  }

  function togglePlay() {
    if (!audio) return;
    if (!audio.getAttribute('src')) loadTrack(0);
    if (audio.paused) {
      playCurrent();
    } else {
      audio.pause();
    }
  }

  function stepTrack(delta) {
    const next = (currentIdx + delta + tracks.length) % tracks.length;
    loadTrack(next);
    playCurrent();
  }

  const setDeckExpanded = (expanded) => {
    widget?.classList.toggle('is-expanded', expanded);
    pillToggle?.setAttribute('aria-expanded', expanded ? 'true' : 'false');
  };

  initVolume();

  pillToggle?.addEventListener('click', () => {
    setDeckExpanded(!widget?.classList.contains('is-expanded'));
  });

  closeBtn?.addEventListener('click', () => {
    setDeckExpanded(false);
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && widget?.classList.contains('is-expanded')) {
      setDeckExpanded(false);
    }
  });

  document.addEventListener('pointerdown', (e) => {
    if (widget?.classList.contains('is-expanded') && !widget.contains(e.target)) {
      setDeckExpanded(false);
    }
  });

  pillPlayBtn?.addEventListener('click', togglePlay);
  mainPlayBtn?.addEventListener('click', togglePlay);
  prevBtn?.addEventListener('click', () => stepTrack(-1));
  nextBtn?.addEventListener('click', () => stepTrack(1));

  muteBtn?.addEventListener('click', () => {
    if (!audio) return;
    if (audio.muted || audio.volume === 0) {
      audio.muted = false;
      if (audio.volume === 0) audio.volume = 0.75;
    } else {
      audio.muted = true;
    }
    syncVolumeUI();
  });

  volSlider?.addEventListener('input', () => {
    if (!audio || !volSlider) return;
    const val = Math.max(0, Math.min(100, Number(volSlider.value)));
    audio.volume = val / 100;
    audio.muted = val === 0;
    try {
      localStorage.setItem(VOL_STORAGE_KEY, String(val));
    } catch {}
    syncVolumeUI();
  });

  trackBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.getAttribute('data-track-index'));
      loadTrack(idx);
      playCurrent();
    });
  });

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-audio-filter') || 'all';
      filterBtns.forEach((b) => b.classList.toggle('is-active', b === btn));
      playlistItems.forEach((li) => {
        const cat = li.getAttribute('data-track-category');
        const show = filter === 'all' || cat === filter;
        li.classList.toggle('hidden', !show);
      });
    });
  });

  audio?.addEventListener('play', syncPlayIcons);
  audio?.addEventListener('pause', syncPlayIcons);
  audio?.addEventListener('volumechange', syncVolumeUI);

  audio?.addEventListener('loadedmetadata', () => {
    if (durTime && audio.duration) {
      durTime.textContent = formatTime(audio.duration);
    }
  });

  audio?.addEventListener('timeupdate', () => {
    if (audio.duration) {
      const pct = (audio.currentTime / audio.duration) * 100;
      setScrubPercent(pct);
      if (currTime) currTime.textContent = formatTime(audio.currentTime);
      if (durTime) durTime.textContent = formatTime(audio.duration);
    }
  });

  audio?.addEventListener('ended', () => stepTrack(1));

  // Pointer-Capture Drag Scrubber
  const seekFromClientX = (clientX) => {
    if (!scrubContainer || !audio) return;
    if (!audio.getAttribute('src')) loadTrack(currentIdx);
    if (!audio.duration) return;
    const rect = scrubContainer.getBoundingClientRect();
    const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    audio.currentTime = ratio * audio.duration;
    setScrubPercent(ratio * 100);
  };

  let isScrubbing = false;
  scrubContainer?.addEventListener('pointerdown', (e) => {
    isScrubbing = true;
    scrubContainer.setPointerCapture(e.pointerId);
    seekFromClientX(e.clientX);
  });

  scrubContainer?.addEventListener('pointermove', (e) => {
    if (!isScrubbing) return;
    seekFromClientX(e.clientX);
  });

  scrubContainer?.addEventListener('pointerup', (e) => {
    if (!isScrubbing) return;
    isScrubbing = false;
    scrubContainer.releasePointerCapture(e.pointerId);
  });

  scrubContainer?.addEventListener('keydown', (e) => {
    if (!audio || !audio.duration) return;
    if (e.key === 'ArrowRight') {
      e.preventDefault();
      audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
    } else if (e.key === 'ArrowLeft') {
      e.preventDefault();
      audio.currentTime = Math.max(0, audio.currentTime - 5);
    }
  });

  if ('mediaSession' in navigator) {
    try {
      navigator.mediaSession.setActionHandler('play', playCurrent);
      navigator.mediaSession.setActionHandler('pause', () => audio?.pause());
      navigator.mediaSession.setActionHandler('previoustrack', () => stepTrack(-1));
      navigator.mediaSession.setActionHandler('nexttrack', () => stepTrack(1));
    } catch {}
  }
</script>

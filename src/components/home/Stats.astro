---
// src/components/home/Stats.astro
import rawPrimeStats from '../../../data/prime_stats.json';
import rawTeams from '../../../data/teams.json';

interface Match {
  begin?: string;
  confirmed?: boolean;
  result?: string;
  match_type?: string;
  match_day?: number;
  enemy_team?: {
    team_tag?: string;
    name?: string;
    logo_url?: string;
    prime_league_link?: string;
  };
  prime_league_link?: string;
}

interface TeamStatsComputed {
  key: string;
  name: string;
  division: string;
  logoSrc: string;
  primeLeagueLink: string | null;
  playedGames: number;
  seriesWins: number;
  seriesLosses: number;
  draws: number;
  mapWins: number;
  mapLosses: number;
  points: number;
  winRate: number;
  form: string[];
  recentMatches: {
    resultText: string;
    score: string;
    enemy: string;
    enemyLogo: string | null;
    date: string;
    confirmed: boolean;
    confirmedLabel: "Bestätigt" | "Unbestätigt";
    link: string | null;
  }[];
  upcomingMatches: {
    enemy: string;
    enemyLogo: string | null;
    matchDay: number | null;
    dateFormatted: string;
    confirmed: boolean;
    confirmedLabel: "Bestätigt" | "Unbestätigt";
    link: string | null;
  }[];
}

const now = new Date();
let totalGlobalMatches = 0;
let totalGlobalWins = 0;
let totalGlobalDraws = 0;
let totalGlobalPoints = 0;
const teamAssetMap = import.meta.glob('/public/assets/teams/*.{webp,png,jpg,svg}');

const teamsMeta = (rawTeams || {}) as Record<string, any>;
const hasPrimeLeagueId = (key: string, teamObj?: any): boolean => {
  const id = teamsMeta[key]?.primeLeagueId ?? teamObj?.primeLeagueId;
  return Boolean(id !== undefined && id !== null && String(id).trim() !== '');
};

const teamsStatsList: TeamStatsComputed[] = Object.entries(rawPrimeStats as Record<string, any>)
  .filter(([key, team]) => team && Array.isArray(team.matches) && hasPrimeLeagueId(key, team))
  .map(([key, team]) => {
    const matches: Match[] = team.matches || [];
    let mapWins = 0, mapLosses = 0, points = 0, sWins = 0, sLosses = 0;
    let form: string[] = [];
    let recentMatches: TeamStatsComputed['recentMatches'] = [];
    let upcomingMatches: TeamStatsComputed['upcomingMatches'] = [];

    const sortedMatches = [...matches].sort((a, b) => {
      const dateA = a.begin ? new Date(a.begin).getTime() : 0;
      const dateB = b.begin ? new Date(b.begin).getTime() : 0;
      return dateA - dateB;
    });

    sortedMatches.forEach((m) => {
      const mDate = m.begin ? new Date(m.begin) : null;
      if (m.result && mDate && mDate < now) {
        const parts = m.result.split(':').map(Number);
        if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1])) {
          const [us, them] = parts;
          mapWins += us;
          mapLosses += them;

          if (us === 2 && them === 0) points += 3;
          else if (us === 2 && them === 1) points += 2;
          else if (us === 1 && them === 1) points += 1;
          else if (us === 1 && them === 2) points += 1;

          const isWin = us > them;
          const isDraw = us === them;

          if (isWin) {
            form.push('W');
            sWins++;
          } else if (isDraw) {
            form.push('D');
          } else {
            form.push('L');
            sLosses++;
          }

          recentMatches.push({
            resultText: isWin ? "SIEG" : isDraw ? "UNENTSCHIEDEN" : "NIEDERLAGE",
            score: `${us} : ${them}`,
            enemy: m.enemy_team?.team_tag || m.enemy_team?.name || "Gegner",
            enemyLogo: m.enemy_team?.logo_url || null,
            date: mDate.toLocaleDateString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: '2-digit' }),
            confirmed: true,
            confirmedLabel: "Bestätigt",
            link: m.prime_league_link || null
          });
        }
      }

      if (!m.result) {
        const isConfirmed = m.confirmed === true;
        upcomingMatches.push({
          enemy: m.enemy_team?.team_tag || m.enemy_team?.name || "TBD",
          enemyLogo: m.enemy_team?.logo_url || null,
          matchDay: m.match_day ?? null,
          dateFormatted: mDate 
            ? mDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' })
            : "Offen",
          confirmed: isConfirmed,
          confirmedLabel: isConfirmed ? "Bestätigt" : "Unbestätigt",
          link: m.prime_league_link || null
        });
      }
    });

    const draws = form.filter(f => f === 'D').length;
    const totalSeries = sWins + sLosses + draws;
    const winRate = totalSeries > 0 ? Math.round(((sWins + (draws * 0.5)) / totalSeries) * 100) : 0;

    totalGlobalMatches += totalSeries;
    totalGlobalWins += sWins;
    totalGlobalDraws += draws;
    totalGlobalPoints += points;

    const hasLocalTeamWebp = `/public/assets/teams/${key}.webp` in teamAssetMap;
    const hasLocalTeamPng = `/public/assets/teams/${key}.png` in teamAssetMap;
    const logoSrc: string =
      team.logoUrl ||
      (hasLocalTeamWebp
        ? `/assets/teams/${key}.webp`
        : hasLocalTeamPng
          ? `/assets/teams/${key}.png`
          : team.api_meta?.logo_url || '/assets/logo/logo.svg');

    return {
      key,
      name: team.teamDisplay || `UIC ${key.toUpperCase()}`,
      division: team.tier || team.api_meta?.division || 'Prime League',
      logoSrc,
      primeLeagueLink: team.api_meta?.prime_league_link || null,
      playedGames: totalSeries,
      seriesWins: sWins,
      seriesLosses: sLosses,
      draws,
      mapWins,
      mapLosses,
      points,
      winRate,
      form: form.slice(-5),
      recentMatches: recentMatches.reverse().slice(0, 3),
      upcomingMatches: upcomingMatches.slice(0, 3)
    };
  });

const globalWinRate = totalGlobalMatches > 0 
  ? Math.round(((totalGlobalWins + (totalGlobalDraws * 0.5)) / totalGlobalMatches) * 100)
  : 0;

// Sort by points for leaderboard
const leaderboard = [...teamsStatsList].sort((a, b) => b.points - a.points);

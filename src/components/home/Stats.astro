<script>
  const warTabs = document.querySelectorAll<HTMLButtonElement>('[data-war-target]');
  const warPanels = document.querySelectorAll<HTMLElement>('.war-panel');
  const warTabsContainer = document.getElementById('war-room-tabs');
  const warGlider = document.getElementById('war-tab-glider');

  const updateWarGlider = (activeTab: HTMLButtonElement | null) => {
    if (!warGlider || !warTabsContainer || !activeTab) return;
    warTabsContainer.classList.add('has-glider');
    warGlider.style.setProperty('--war-glider-x', `${activeTab.offsetLeft}px`);
    warGlider.style.setProperty('--war-glider-w', `${activeTab.offsetWidth}px`);
    warGlider.style.setProperty('--war-glider-opacity', '1');
  };

  const activateWarTab = (tab: HTMLButtonElement, focusTab = false) => {
    const target = tab.getAttribute('data-war-target');
    if (!target) return;

    warTabs.forEach(t => {
      const isCurrent = t === tab;
      t.classList.toggle('is-active', isCurrent);
      t.setAttribute('aria-selected', isCurrent ? 'true' : 'false');
      t.setAttribute('tabindex', isCurrent ? '0' : '-1');
    });
    updateWarGlider(tab);

    warPanels.forEach(p => p.classList.remove('is-active'));

    if (focusTab) tab.focus();

    const activePanel = document.getElementById(target);
    if (activePanel) {
      const tpl = activePanel.querySelector<HTMLTemplateElement>('template.deferred-fixtures-tpl');
      if (tpl) {
        activePanel.appendChild(tpl.content.cloneNode(true));
        tpl.remove();
      }
      activePanel.classList.add('is-active');
    }
  };

  const initialWarTab = document.querySelector<HTMLButtonElement>('.war-tab.is-active');
  if (initialWarTab) {
    requestAnimationFrame(() => updateWarGlider(initialWarTab));
    window.addEventListener('resize', () => {
      const current = document.querySelector<HTMLButtonElement>('.war-tab.is-active');
      if (current) updateWarGlider(current);
    }, { passive: true });
  }

  warTabs.forEach((tab, idx) => {
    tab.addEventListener('click', () => activateWarTab(tab));
    tab.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        const nextIdx = e.key === 'ArrowRight'
          ? (idx + 1) % warTabs.length
          : (idx - 1 + warTabs.length) % warTabs.length;
        activateWarTab(warTabs[nextIdx], true);
      }
    });
  });

  // Interactive Table Column Sorting
  const sortHeaders = document.querySelectorAll<HTMLTableCellElement>('.th-sortable');
  const tbody = document.getElementById('standings-tbody');
  let currentSortCol = 'points';
  let currentSortAsc = false;

  sortHeaders.forEach((th) => {
    th.addEventListener('click', () => {
      if (!tbody) return;
      const col = th.getAttribute('data-sort-col');
      if (!col) return;

      if (currentSortCol === col) {
        currentSortAsc = !currentSortAsc;
      } else {
        currentSortCol = col;
        currentSortAsc = col === 'name' || col === 'division';
      }

      sortHeaders.forEach((h) => {
        const isThis = h === th;
        h.classList.toggle('is-sorted', isThis);
        h.setAttribute('aria-sort', isThis ? (currentSortAsc ? 'ascending' : 'descending') : 'none');
        const ind = h.querySelector('.sort-ind');
        if (ind) ind.textContent = isThis ? (currentSortAsc ? '↑' : '↓') : '↕';
      });

      const rows = Array.from(tbody.querySelectorAll<HTMLTableRowElement>('tr.table-row'));
      rows.sort((a, b) => {
        if (col === 'name' || col === 'division') {
          const vA = a.getAttribute(`data-${col}`) || '';
          const vB = b.getAttribute(`data-${col}`) || '';
          return currentSortAsc ? vA.localeCompare(vB, 'de') : vB.localeCompare(vA, 'de');
        }
        const nA = Number(a.getAttribute(`data-${col}`) || 0);
        const nB = Number(b.getAttribute(`data-${col}`) || 0);
        return currentSortAsc ? nA - nB : nB - nA;
      });

      rows.forEach((r, idx) => {
        const rankBadge = r.querySelector('.rank-badge');
        if (rankBadge) {
          rankBadge.textContent = String(idx + 1).padStart(2, '0');
          rankBadge.classList.toggle('top-tier', idx < 3);
        }
        tbody.appendChild(r);
      });
    });
  });

  // Click Team Name in Standings -> Jump to Team Match Dossier in Tab 2
  const fixturesTabBtn = document.getElementById('btn-tab-fixtures') as HTMLButtonElement | null;
  document.querySelectorAll<HTMLButtonElement>('[data-jump-fixture]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const teamKey = btn.getAttribute('data-jump-fixture');
      if (!teamKey || !fixturesTabBtn) return;
      activateWarTab(fixturesTabBtn, false);
      requestAnimationFrame(() => {
        const card = document.querySelector<HTMLElement>(`[data-fixture-card="${CSS.escape(teamKey)}"]`);
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
          card.classList.add('is-spotlight-target');
          setTimeout(() => card.classList.remove('is-spotlight-target'), 2200);
        }
      });
    });
  });
</script>

---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <!-- Ultra-Subtle Minimalist Monochrome Topographic Contours -->
  <div class="partners-bg-fx" aria-hidden="true">
    <div class="partners-topo-wrap">
      <svg
        class="partners-topo-svg"
        viewBox="0 0 1600 680"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="partners-subtle-line" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.01" />
            <stop offset="30%" stop-color="#ffffff" stop-opacity="0.05" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.035" />
            <stop offset="70%" stop-color="#ffffff" stop-opacity="0.05" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.01" />
          </linearGradient>
        </defs>

        <!-- Minimal Sweeping Horizon Contours -->
        <g stroke="url(#partners-subtle-line)" stroke-width="0.9">
          <path d="M-100,440 C240,415 480,330 800,330 C1120,330 1360,415 1700,440" />
          <path d="M-100,485 C260,460 500,372 800,372 C1100,372 1340,460 1700,485" stroke-opacity="0.7" />
          <path d="M-100,220 C260,245 500,290 800,290 C1100,290 1340,245 1700,220" stroke-opacity="0.6" />
        </g>

        <!-- Whisper-Quiet Symmetrical Contour Rings Left & Right -->
        <g stroke="rgba(255, 255, 255, 0.038)" stroke-width="0.85">
          <path d="M 520,225 C 430,175 305,200 275,290 C 245,380 315,465 430,458 C 485,454 525,430 548,395" />
          <circle cx="430" cy="330" r="46" stroke-dasharray="4 8" />
          <circle cx="430" cy="330" r="18" />

          <path d="M 1080,225 C 1170,175 1295,200 1325,290 C 1355,380 1285,465 1170,458 C 1115,454 1075,430 1052,395" />
          <circle cx="1170" cy="330" r="46" stroke-dasharray="4 8" />
          <circle cx="1170" cy="330" r="18" />
        </g>

        <!-- Single Subtle Glint Along Horizon Line -->
        <path
          class="partners-topo-glint"
          d="M-100,440 C240,415 480,330 800,330 C1120,330 1360,415 1700,440"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header text-center">
      <div class="section-badge-pill">PARTNER & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Team-Organisation, Spielanalyse und Turnierbetrieb zusammen.
      </p>
    </div>

    <!-- Active Partner Showcase: Minimalist Open Layout with Clear Descriptions -->
    <div class="sponsors-showcase">
      
      <!-- Partner 1: RiftOPS -->
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="RiftOPS Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ORGANISATION & TEAM-MANAGEMENT</span>
        <p class="sponsor-desc">
          Plattform für Organisation und Teams: Verwaltet unsere Prime League Spiele und nächsten Gegner, liefert Spielanalysen und bietet Kalender-Funktionen, Events sowie Prep-Rooms für die Spieltagsvorbereitung.
        </p>
        <div class="sponsor-tags text-mono" aria-label="RiftOPS Funktionen">
          <span class="sponsor-tag">PRIME LEAGUE</span>
          <span class="sponsor-tag">ANALYSEN & GEGNER</span>
          <span class="sponsor-tag">PREP-ROOMS</span>
          <span class="sponsor-tag">KALENDER & EVENTS</span>
        </div>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <!-- Partner 2: Esport GenesiZ -->
      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="Esport GenesiZ Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport GenesiZ Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">TURNIERE & EVENT-SYSTEME</span>
        <p class="sponsor-desc">
          Spezialisiert auf kompetitive Turniere und Community-Events mit vielseitigen Turniersystemen wie Multi-Bracket, Round Robin, Swiss-System, Double K.O. und weiteren Wettkampfformaten.
        </p>
        <div class="sponsor-tags text-mono" aria-label="Esport GenesiZ Turniersysteme">
          <span class="sponsor-tag">MULTI-BRACKET</span>
          <span class="sponsor-tag">ROUND ROBIN</span>
          <span class="sponsor-tag">SWISS-SYSTEM</span>
          <span class="sponsor-tag">DOUBLE K.O.</span>
        </div>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Ultra-Subtle Minimalist Topographic Background */
  .partners-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .partners-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000000 15%, rgba(0, 0, 0, 0.5) 58%, transparent 90%);
    -webkit-mask-image: radial-gradient(ellipse 85% 75% at 50% 45%, #000000 15%, rgba(0, 0, 0, 0.5) 58%, transparent 90%);
  }

  .partners-topo-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }

  .partners-topo-glint {
    stroke: rgba(255, 255, 255, 0.11);
    stroke-width: 1;
    stroke-linecap: round;
    stroke-dasharray: 180 1800;
    stroke-dashoffset: 1980;
    animation: partnersGlintTravel 36s linear infinite;
  }

  @keyframes partnersGlintTravel {
    0% { stroke-dashoffset: 1980; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-topo-glint {
      animation: none !important;
    }
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Minimalist Open 2-Column Sponsors Showcase */
  .sponsors-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 1080px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    padding: var(--space-md) 0;
  }

  .sponsor-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    text-decoration: none;
    padding: var(--space-md);
    transition: transform var(--transition-smooth);
  }

  .sponsor-item:hover,
  .sponsor-item:focus-visible {
    transform: translateY(-2px);
  }

  .sponsor-logo {
    max-height: 48px;
    width: auto;
    margin-bottom: 4px;
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
    transition: filter var(--transition-fast), opacity var(--transition-fast), transform var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-logo,
  .sponsor-item:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: scale(1.03);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-white);
    transition: color var(--transition-fast);
  }

  .sponsor-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0;
  }

  .sponsor-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }

  .sponsor-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-tag,
  .sponsor-item:focus-visible .sponsor-tag {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-white);
  }

  .sponsor-sep {
    width: 1px;
    height: 100%;
    min-height: 160px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    align-self: stretch;
  }

  @media (max-width: 768px) {
    .sponsors-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .sponsor-sep {
      width: 60%;
      height: 1px;
      min-height: 1px;
      margin-inline: auto;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    }
  }

  /* Centered Contact Underneath */
  .partner-contact-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    max-width: 820px;
    padding: var(--space-xl) var(--space-2xl);
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .partner-contact-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .contact-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .contact-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .btn-partner-contact {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .partner-contact-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .btn-partner-contact {
      width: 100%;
    }
  }
</style>

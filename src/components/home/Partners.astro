---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <!-- Minimalist Monochrome Summoner's Rift Lane Background -->
  <div class="partners-bg-fx" aria-hidden="true">
    <div class="partners-topo-wrap">
      <svg
        class="partners-topo-svg"
        viewBox="0 0 1600 680"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="partners-lane-stroke" x1="0%" y1="100%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.015" />
            <stop offset="25%" stop-color="#ffffff" stop-opacity="0.075" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.095" />
            <stop offset="75%" stop-color="#ffffff" stop-opacity="0.075" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.015" />
          </linearGradient>
          <linearGradient id="partners-river-cross" x1="25%" y1="0%" x2="75%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.0" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.055" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0" />
          </linearGradient>
        </defs>

        <!-- 1. Flanking Lane Wall Topographic Banks (North-West & South-East Ridges) -->
        <g stroke="url(#partners-lane-stroke)" stroke-width="0.9">
          <!-- Upper Lane Bank Contours -->
          <path d="M-120,475 C260,395 540,305 800,245 C1060,185 1340,95 1720,15" stroke-opacity="0.55" />
          <path d="M-120,515 C265,435 545,342 800,282 C1055,222 1335,132 1720,52" stroke-opacity="0.8" />
          <!-- Inner Lane Corridor Boundaries -->
          <path d="M-120,548 C270,468 550,375 800,315 C1050,255 1330,162 1720,82" stroke-width="1.05" />
          <path d="M-120,602 C270,522 550,429 800,369 C1050,309 1330,216 1720,136" stroke-width="1.05" />
          <!-- Lower Lane Bank Contours -->
          <path d="M-120,635 C265,555 545,462 800,402 C1055,342 1335,252 1720,172" stroke-opacity="0.8" />
          <path d="M-120,675 C260,595 540,505 800,445 C1060,385 1340,295 1720,215" stroke-opacity="0.55" />
        </g>

        <!-- 2. Center Lane Track (Dashed Minion Wave Axis) -->
        <path
          d="M-120,575 C270,495 550,402 800,342 C1050,282 1330,189 1720,109"
          stroke="url(#partners-lane-stroke)"
          stroke-width="1"
          stroke-dasharray="8 10"
        />

        <!-- 3. Subtle Transverse River Crossing at Mid-Lane Center -->
        <g stroke="url(#partners-river-cross)" stroke-width="0.85">
          <path d="M 520,-40 C 640,165 735,285 800,342 C 865,399 960,515 1080,720" stroke-dasharray="5 9" />
          <path d="M 475,-40 C 598,170 695,292 762,350 C 829,408 925,525 1042,720" />
          <path d="M 565,-40 C 682,160 775,278 838,334 C 901,390 995,505 1118,720" />
        </g>

        <!-- 4. Minimalist Outer Turret Nodes & Center Lane Clash Ring -->
        <g stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.95">
          <!-- Left Outer Turret Node (Blue Side) -->
          <circle cx="430" cy="432" r="24" stroke="rgba(255, 255, 255, 0.06)" stroke-dasharray="3 5" />
          <circle cx="430" cy="432" r="5" fill="#050507" />
          <circle cx="430" cy="432" r="1.8" fill="rgba(255, 255, 255, 0.38)" stroke="none" />

          <!-- Center Lane Intersection Node -->
          <circle cx="800" cy="342" r="14" stroke="rgba(255, 255, 255, 0.08)" />
          <circle cx="800" cy="342" r="2" fill="rgba(255, 255, 255, 0.3)" stroke="none" />

          <!-- Right Outer Turret Node (Red Side) -->
          <circle cx="1170" cy="252" r="24" stroke="rgba(255, 255, 255, 0.06)" stroke-dasharray="3 5" />
          <circle cx="1170" cy="252" r="5" fill="#050507" />
          <circle cx="1170" cy="252" r="1.8" fill="rgba(255, 255, 255, 0.38)" stroke="none" />
        </g>

        <!-- 5. Animated Lane Wave Glints (Flowing Along the Lane Corridor) -->
        <path
          class="partners-lane-glint"
          d="M-120,548 C270,468 550,375 800,315 C1050,255 1330,162 1720,82"
        />
        <path
          class="partners-lane-glint partners-lane-glint-reverse"
          d="M 1720,136 C 1330,216 1050,309 800,369 C 550,429 270,522 -120,602"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header text-center">
      <div class="section-badge-pill">PARTNER & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Team-Organisation, Spielanalyse und Turnierbetrieb zusammen.
      </p>
    </div>

    <!-- Active Partner Showcase: Minimalist Open Layout with Clear Descriptions -->
    <div class="sponsors-showcase">
      
      <!-- Partner 1: RiftOPS -->
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="RiftOPS Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ORGANISATION & TEAM-MANAGEMENT</span>
        <p class="sponsor-desc">
          Plattform für Organisation und Teams: Verwaltet unsere Prime League Spiele und nächsten Gegner, liefert Spielanalysen und bietet Kalender-Funktionen, Events sowie Prep-Rooms für die Spieltagsvorbereitung.
        </p>
        <div class="sponsor-tags text-mono" aria-label="RiftOPS Funktionen">
          <span class="sponsor-tag">PRIME LEAGUE</span>
          <span class="sponsor-tag">ANALYSEN & GEGNER</span>
          <span class="sponsor-tag">PREP-ROOMS</span>
          <span class="sponsor-tag">KALENDER & EVENTS</span>
        </div>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <!-- Partner 2: Esport GenesiZ -->
      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="Esport GenesiZ Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport GenesiZ Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">TURNIERE & EVENT-SYSTEME</span>
        <p class="sponsor-desc">
          Spezialisiert auf kompetitive Turniere und Community-Events mit vielseitigen Turniersystemen wie Multi-Bracket, Round Robin, Swiss-System, Double K.O. und weiteren Wettkampfformaten.
        </p>
        <div class="sponsor-tags text-mono" aria-label="Esport GenesiZ Turniersysteme">
          <span class="sponsor-tag">MULTI-BRACKET</span>
          <span class="sponsor-tag">ROUND ROBIN</span>
          <span class="sponsor-tag">SWISS-SYSTEM</span>
          <span class="sponsor-tag">DOUBLE K.O.</span>
        </div>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Minimalist Summoner's Rift Lane Background */
  .partners-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .partners-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000000 18%, rgba(0, 0, 0, 0.55) 60%, transparent 92%);
    -webkit-mask-image: radial-gradient(ellipse 88% 78% at 50% 45%, #000000 18%, rgba(0, 0, 0, 0.55) 60%, transparent 92%);
  }

  .partners-topo-svg {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    display: block;
    animation: partnersLaneDrift 34s ease-in-out infinite alternate;
  }

  .partners-lane-glint {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 180 1800;
    stroke-dashoffset: 1980;
    animation: partnersLaneGlint 24s linear infinite;
  }

  .partners-lane-glint-reverse {
    stroke: rgba(255, 255, 255, 0.14);
    animation-duration: 28s;
    animation-delay: -11s;
  }

  @keyframes partnersLaneDrift {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(-1%, 0.6%, 0) scale(1.018); }
  }

  @keyframes partnersLaneGlint {
    0% { stroke-dashoffset: 1980; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-topo-svg,
    .partners-lane-glint {
      animation: none !important;
    }
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Minimalist Open 2-Column Sponsors Showcase */
  .sponsors-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 1080px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    padding: var(--space-md) 0;
  }

  .sponsor-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    text-decoration: none;
    padding: var(--space-md);
    transition: transform var(--transition-smooth);
  }

  .sponsor-item:hover,
  .sponsor-item:focus-visible {
    transform: translateY(-2px);
  }

  .sponsor-logo {
    max-height: 48px;
    width: auto;
    margin-bottom: 4px;
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
    transition: filter var(--transition-fast), opacity var(--transition-fast), transform var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-logo,
  .sponsor-item:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: scale(1.03);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-white);
    transition: color var(--transition-fast);
  }

  .sponsor-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0;
  }

  .sponsor-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }

  .sponsor-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-tag,
  .sponsor-item:focus-visible .sponsor-tag {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-white);
  }

  .sponsor-sep {
    width: 1px;
    height: 100%;
    min-height: 160px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    align-self: stretch;
  }

  @media (max-width: 768px) {
    .sponsors-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .sponsor-sep {
      width: 60%;
      height: 1px;
      min-height: 1px;
      margin-inline: auto;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    }
  }

  /* Centered Contact Underneath */
  .partner-contact-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    max-width: 820px;
    padding: var(--space-xl) var(--space-2xl);
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .partner-contact-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .contact-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .contact-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .btn-partner-contact {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .partner-contact-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .btn-partner-contact {
      width: 100%;
    }
  }
</style>

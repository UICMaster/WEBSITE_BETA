---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <!-- Minimalist Monochrome Faceted Glass-Chip Drake & Fine Line Architecture -->
  <div class="partners-bg-fx" aria-hidden="true">
    <div class="partners-glare"></div>

    <div class="partners-drake-wrap">
      <svg
        class="partners-drake-svg"
        viewBox="0 0 1600 720"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <!-- Translucent Glass-Chip Surface Gradients -->
          <linearGradient id="drake-glass-bright" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.055" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.022" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.008" />
          </linearGradient>
          <linearGradient id="drake-glass-mid" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.038" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.01" />
          </linearGradient>
          <linearGradient id="drake-glass-soft" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.026" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.005" />
          </linearGradient>
          <!-- Fine Edge Wireframe Gradient -->
          <linearGradient id="drake-edge-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.06" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.18" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
          </linearGradient>
        </defs>

        <!-- ================= 1. FINE ARCHITECTURAL CONSTRUCTION LINES & ALTAR RINGS ================= -->
        <g stroke="rgba(255, 255, 255, 0.065)" stroke-width="0.85">
          <!-- Perspective Dragon Pit / Pedestal Rings at Base -->
          <ellipse cx="800" cy="590" rx="340" ry="74" stroke-dasharray="8 10" />
          <ellipse cx="800" cy="590" rx="210" ry="44" />
          <!-- Geometric Wing-Span Construction Arcs & Guides -->
          <circle cx="800" cy="285" r="245" stroke-dasharray="3 8" stroke-opacity="0.7" />
          <line x1="140" y1="165" x2="1460" y2="165" stroke-dasharray="4 10" stroke-opacity="0.45" />
          <line x1="800" y1="35" x2="800" y2="665" stroke-dasharray="5 9" stroke-opacity="0.5" />
          <!-- Diagonal Structural Tangents from Wing Joints -->
          <line x1="520" y1="115" x2="210" y2="480" stroke-dasharray="3 7" stroke-opacity="0.45" />
          <line x1="1080" y1="115" x2="1390" y2="480" stroke-dasharray="3 7" stroke-opacity="0.45" />
        </g>

        <!-- ================= 2. LEFT WING — TRANSLUCENT GLASS-CHIP PANELS & SPARS ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1" stroke-linejoin="round">
          <!-- Outer Primary Wing Blade (Glass Chip 1 & 2) -->
          <polygon points="742,225 520,115 155,165 365,245" fill="url(#drake-glass-bright)" />
          <polygon points="155,165 365,245 215,315" fill="url(#drake-glass-mid)" />
          <!-- Mid-Outer Wing Membrane Panel (Glass Chip 3 & 4) -->
          <polygon points="742,225 365,245 485,335 732,278" fill="url(#drake-glass-soft)" />
          <polygon points="365,245 215,315 340,395 485,335" fill="url(#drake-glass-bright)" />
          <!-- Mid-Inner Wing Membrane Panel (Glass Chip 5 & 6) -->
          <polygon points="732,278 485,335 585,425 748,332" fill="url(#drake-glass-mid)" />
          <polygon points="485,335 340,395 468,472 585,425" fill="url(#drake-glass-soft)" />
          <!-- Inner Trailing Wing Pinion (Glass Chip 7) -->
          <polygon points="748,332 585,425 655,498 762,385" fill="url(#drake-glass-bright)" />
          <!-- Wing Thumb Claw Spire at Apex (@ 520, 115) -->
          <polygon points="520,115 488,62 548,96" fill="url(#drake-glass-bright)" />
          <polygon points="520,115 548,96 635,172" fill="url(#drake-glass-soft)" />

          <!-- Fine Internal Wing Facet Ribs (Secondary Hairlines) -->
          <g stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75">
            <line x1="520" y1="115" x2="365" y2="245" />
            <line x1="520" y1="115" x2="485" y2="335" />
            <line x1="742" y1="225" x2="215" y2="315" />
            <line x1="732" y1="278" x2="340" y2="395" />
            <line x1="748" y1="332" x2="468" y2="472" />
          </g>
        </g>

        <!-- ================= 3. RIGHT WING — TRANSLUCENT GLASS-CHIP PANELS & SPARS ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1" stroke-linejoin="round">
          <!-- Outer Primary Wing Blade (Glass Chip 1 & 2) -->
          <polygon points="858,225 1080,115 1445,165 1235,245" fill="url(#drake-glass-bright)" />
          <polygon points="1445,165 1235,245 1385,315" fill="url(#drake-glass-mid)" />
          <!-- Mid-Outer Wing Membrane Panel (Glass Chip 3 & 4) -->
          <polygon points="858,225 1235,245 1115,335 868,278" fill="url(#drake-glass-soft)" />
          <polygon points="1235,245 1385,315 1260,395 1115,335" fill="url(#drake-glass-bright)" />
          <!-- Mid-Inner Wing Membrane Panel (Glass Chip 5 & 6) -->
          <polygon points="868,278 1115,335 1015,425 852,332" fill="url(#drake-glass-mid)" />
          <polygon points="1115,335 1260,395 1132,472 1015,425" fill="url(#drake-glass-soft)" />
          <!-- Inner Trailing Wing Pinion (Glass Chip 7) -->
          <polygon points="852,332 1015,425 945,498 838,385" fill="url(#drake-glass-bright)" />
          <!-- Wing Thumb Claw Spire at Apex (@ 1080, 115) -->
          <polygon points="1080,115 1112,62 1052,96" fill="url(#drake-glass-bright)" />
          <polygon points="1080,115 1052,96 965,172" fill="url(#drake-glass-soft)" />

          <!-- Fine Internal Wing Facet Ribs (Secondary Hairlines) -->
          <g stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75">
            <line x1="1080" y1="115" x2="1235" y2="245" />
            <line x1="1080" y1="115" x2="1115" y2="335" />
            <line x1="858" y1="225" x2="1385" y2="315" />
            <line x1="868" y1="278" x2="1260" y2="395" />
            <line x1="852" y1="332" x2="1132" y2="472" />
          </g>
        </g>

        <!-- ================= 4. HORNED DRAGON HEAD, TORSO ARMOR & TAIL PLATES ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1.05" stroke-linejoin="round">
          <!-- Swept-Back Dragon Crown Horns -->
          <polygon points="782,118 728,46 762,135" fill="url(#drake-glass-bright)" />
          <polygon points="818,118 872,46 838,135" fill="url(#drake-glass-bright)" />
          <polygon points="762,135 712,88 754,158" fill="url(#drake-glass-mid)" />
          <polygon points="838,135 888,88 846,158" fill="url(#drake-glass-mid)" />

          <!-- Sculpted Dragon Skull, Brow & Snout -->
          <polygon points="800,88 818,118 800,152 782,118" fill="url(#drake-glass-bright)" />
          <polygon points="782,118 762,135 776,176 800,152" fill="url(#drake-glass-mid)" />
          <polygon points="818,118 838,135 824,176 800,152" fill="url(#drake-glass-mid)" />
          <polygon points="800,152 824,176 800,202 776,176" fill="url(#drake-glass-bright)" />

          <!-- Segmented Neck & Shoulder Armor Plates -->
          <polygon points="776,176 742,225 800,238 800,202" fill="url(#drake-glass-soft)" />
          <polygon points="824,176 858,225 800,238 800,202" fill="url(#drake-glass-soft)" />
          <polygon points="742,225 732,278 768,285 800,238" fill="url(#drake-glass-mid)" />
          <polygon points="858,225 868,278 832,285 800,238" fill="url(#drake-glass-mid)" />

          <!-- Lower Ribcage & Waist Chevron Shards -->
          <polygon points="732,278 748,332 800,356 768,285" fill="url(#drake-glass-soft)" />
          <polygon points="868,278 852,332 800,356 832,285" fill="url(#drake-glass-soft)" />
          <polygon points="748,332 762,385 800,418 800,356" fill="url(#drake-glass-mid)" />
          <polygon points="852,332 838,385 800,418 800,356" fill="url(#drake-glass-mid)" />

          <!-- Sweeping Articulated Tail Vertebrae & Tail-Spade -->
          <polygon points="762,385 774,452 800,478 800,418" fill="url(#drake-glass-soft)" />
          <polygon points="838,385 826,452 800,478 800,418" fill="url(#drake-glass-soft)" />
          <polygon points="774,452 792,522 818,505 800,478" fill="url(#drake-glass-mid)" />
          <polygon points="826,452 818,505 792,522 836,548 852,498" fill="url(#drake-glass-bright)" />
          <polygon points="792,522 836,548 878,592 824,578" fill="url(#drake-glass-mid)" />
          <!-- Bladed Tail Tip Crest -->
          <polygon points="878,592 942,612 895,642 824,578" fill="url(#drake-glass-bright)" />
        </g>

        <!-- ================= 5. DETACHED FLOATING GLASS-CHIP SHARDS & VERTEX NODES ================= -->
        <g class="drake-floating-shards" stroke="rgba(255, 255, 255, 0.16)" stroke-width="0.9">
          <!-- Left Wingtip Floating Shards -->
          <polygon points="105,195 142,182 128,218" fill="url(#drake-glass-bright)" />
          <polygon points="168,352 198,338 186,374" fill="url(#drake-glass-mid)" />
          <polygon points="442,78 468,64 462,96" fill="url(#drake-glass-soft)" />
          <!-- Right Wingtip Floating Shards -->
          <polygon points="1495,195 1458,182 1472,218" fill="url(#drake-glass-bright)" />
          <polygon points="1432,352 1402,338 1414,374" fill="url(#drake-glass-mid)" />
          <polygon points="1158,78 1132,64 1138,96" fill="url(#drake-glass-soft)" />
        </g>

        <!-- ================= 6. LEVITATING DRAGON SOUL CRYSTAL CORE (@ 800, 290) ================= -->
        <g class="drake-soul-core">
          <circle cx="800" cy="290" r="46" stroke="rgba(255, 255, 255, 0.09)" stroke-width="0.85" stroke-dasharray="3 6" />
          <circle cx="800" cy="290" r="28" stroke="rgba(255, 255, 255, 0.15)" stroke-width="0.95" />
          <polygon
            points="800,248 824,290 800,332 776,290"
            stroke="rgba(255, 255, 255, 0.34)"
            stroke-width="1.15"
            fill="rgba(255, 255, 255, 0.045)"
          />
          <polyline points="776,290 800,302 824,290" stroke="rgba(255, 255, 255, 0.24)" stroke-width="0.9" />
          <line x1="800" y1="248" x2="800" y2="332" stroke="rgba(255, 255, 255, 0.24)" stroke-width="0.9" />
          <circle cx="800" cy="290" r="2.5" fill="rgba(255, 255, 255, 0.65)" />
        </g>

        <!-- Structural Vertex Nodes on Wing Knuckles & Tips -->
        <g stroke="rgba(255, 255, 255, 0.22)" stroke-width="0.9" fill="#050507">
          <circle cx="520" cy="115" r="4" /><circle cx="520" cy="115" r="1.5" fill="rgba(255, 255, 255, 0.45)" stroke="none" />
          <circle cx="1080" cy="115" r="4" /><circle cx="1080" cy="115" r="1.5" fill="rgba(255, 255, 255, 0.45)" stroke="none" />
          <circle cx="155" cy="165" r="3.5" />
          <circle cx="1445" cy="165" r="3.5" />
          <circle cx="365" cy="245" r="3" />
          <circle cx="1235" cy="245" r="3" />
        </g>

        <!-- ================= 7. TRAVELLING MONOCHROME EDGE GLINTS ================= -->
        <path
          class="partners-drake-glint"
          d="M 155,165 L 520,115 L 742,225 L 800,152 L 858,225 L 1080,115 L 1445,165"
        />
        <path
          class="partners-drake-glint partners-drake-glint-delayed"
          d="M 215,315 L 365,245 L 485,335 L 585,425 L 748,332 L 800,418 L 852,332 L 1015,425 L 1115,335 L 1235,245 L 1385,315"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header text-center">
      <div class="section-badge-pill">PARTNER & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Team-Organisation, Spielanalyse und Turnierbetrieb zusammen.
      </p>
    </div>

    <!-- Active Partner Showcase: Minimalist Open Layout with Clear Descriptions -->
    <div class="sponsors-showcase">
      
      <!-- Partner 1: RiftOPS -->
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="RiftOPS Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ORGANISATION & TEAM-MANAGEMENT</span>
        <p class="sponsor-desc">
          Plattform für Organisation und Teams: Verwaltet unsere Prime League Spiele und nächsten Gegner, liefert Spielanalysen und bietet Kalender-Funktionen, Events sowie Prep-Rooms für die Spieltagsvorbereitung.
        </p>
        <div class="sponsor-tags text-mono" aria-label="RiftOPS Funktionen">
          <span class="sponsor-tag">PRIME LEAGUE</span>
          <span class="sponsor-tag">ANALYSEN & GEGNER</span>
          <span class="sponsor-tag">PREP-ROOMS</span>
          <span class="sponsor-tag">KALENDER & EVENTS</span>
        </div>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <!-- Partner 2: Esport GenesiZ -->
      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="Esport GenesiZ Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport GenesiZ Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">TURNIERE & EVENT-SYSTEME</span>
        <p class="sponsor-desc">
          Spezialisiert auf kompetitive Turniere und Community-Events mit vielseitigen Turniersystemen wie Multi-Bracket, Round Robin, Swiss-System, Double K.O. und weiteren Wettkampfformaten.
        </p>
        <div class="sponsor-tags text-mono" aria-label="Esport GenesiZ Turniersysteme">
          <span class="sponsor-tag">MULTI-BRACKET</span>
          <span class="sponsor-tag">ROUND ROBIN</span>
          <span class="sponsor-tag">SWISS-SYSTEM</span>
          <span class="sponsor-tag">DOUBLE K.O.</span>
        </div>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Minimalist Monochrome Faceted Glass-Chip Drake Background */
  .partners-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .partners-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 52% 45% at 50% 38%, rgba(255, 255, 255, 0.04) 0%, rgba(255, 255, 255, 0.01) 52%, transparent 78%);
  }

  .partners-drake-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 90% 82% at 50% 46%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
    -webkit-mask-image: radial-gradient(ellipse 90% 82% at 50% 46%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
  }

  .partners-drake-svg {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    display: block;
    animation: drakeWingBreathe 30s ease-in-out infinite alternate;
  }

  .drake-soul-core,
  .drake-floating-shards {
    animation: drakeCrystalFloat 7s ease-in-out infinite alternate;
  }

  .partners-drake-glint {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 200 1600;
    stroke-dashoffset: 1800;
    animation: drakeGlintTravel 26s linear infinite;
  }

  .partners-drake-glint-delayed {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-dasharray: 160 1500;
    stroke-dashoffset: 1660;
    animation-duration: 32s;
    animation-delay: -14s;
  }

  @keyframes drakeWingBreathe {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(0, -1%, 0) scale(1.022); }
  }

  @keyframes drakeCrystalFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }

  @keyframes drakeGlintTravel {
    0% { stroke-dashoffset: 1800; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-drake-svg,
    .drake-soul-core,
    .drake-floating-shards,
    .partners-drake-glint {
      animation: none !important;
    }
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Minimalist Open 2-Column Sponsors Showcase */
  .sponsors-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 1080px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    padding: var(--space-md) 0;
  }

  .sponsor-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    text-decoration: none;
    padding: var(--space-md);
    transition: transform var(--transition-smooth);
  }

  .sponsor-item:hover,
  .sponsor-item:focus-visible {
    transform: translateY(-2px);
  }

  .sponsor-logo {
    max-height: 48px;
    width: auto;
    margin-bottom: 4px;
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
    transition: filter var(--transition-fast), opacity var(--transition-fast), transform var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-logo,
  .sponsor-item:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: scale(1.03);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-white);
    transition: color var(--transition-fast);
  }

  .sponsor-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0;
  }

  .sponsor-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }

  .sponsor-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-tag,
  .sponsor-item:focus-visible .sponsor-tag {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-white);
  }

  .sponsor-sep {
    width: 1px;
    height: 100%;
    min-height: 160px;
    background: linear-gradient(180deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    align-self: stretch;
  }

  @media (max-width: 768px) {
    .sponsors-showcase {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .sponsor-sep {
      width: 60%;
      height: 1px;
      min-height: 1px;
      margin-inline: auto;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.12) 20%, rgba(255, 255, 255, 0.12) 80%, transparent);
    }
  }

  /* Centered Contact Underneath */
  .partner-contact-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    max-width: 820px;
    padding: var(--space-xl) var(--space-2xl);
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .partner-contact-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .contact-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .contact-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .btn-partner-contact {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .partner-contact-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .btn-partner-contact {
      width: 100%;
    }
  }
</style>

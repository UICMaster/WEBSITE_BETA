---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <!-- Minimalist Monochrome Twin Buff-Shrines (Red & Blue Crest Symmetry) & Jungle Contours -->
  <div class="partners-bg-fx" aria-hidden="true">
    <div class="partners-glare"></div>

    <div class="partners-topo-wrap">
      <svg
        class="partners-topo-svg"
        viewBox="0 0 1600 720"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="partners-jungle-line" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.02" />
            <stop offset="28%" stop-color="#ffffff" stop-opacity="0.09" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.06" />
            <stop offset="72%" stop-color="#ffffff" stop-opacity="0.09" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
          </linearGradient>
          <linearGradient id="partners-shrine-wall" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.04" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.15" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.04" />
          </linearGradient>
        </defs>

        <!-- 1. Connecting Jungle Corridor & River-Bridge Topographic Isolines -->
        <g stroke="url(#partners-jungle-line)" stroke-width="1">
          <path d="M-120,485 C180,455 390,345 640,345 C745,345 855,345 960,345 C1210,345 1420,455 1720,485" />
          <path d="M-120,530 C195,500 410,385 655,385 C750,385 850,385 945,385 C1190,385 1405,500 1720,530" />
          <path d="M-120,215 C195,245 410,305 655,305 C750,305 850,305 945,305 C1190,305 1405,245 1720,215" stroke-opacity="0.7" />
          <path d="M-120,170 C180,200 390,265 640,265 C745,265 855,265 960,265 C1210,265 1420,200 1720,170" stroke-opacity="0.5" />
        </g>

        <!-- 2. Left Buff-Shrine Basin (Embercrest / Red Brambleback Alcove @ 440, 340) -->
        <g stroke="url(#partners-shrine-wall)" stroke-width="1.05">
          <!-- Horseshoe Jungle Wall Wrapping Left Shrine (Opening Toward Center) -->
          <path d="M 555,205 C 445,135 275,165 235,285 C 195,405 285,525 435,515 C 505,510 555,480 585,435" />
          <path d="M 535,232 C 442,172 305,195 272,295 C 239,395 312,492 435,484 C 492,480 535,455 560,418" />
          <path d="M 515,258 C 440,210 335,226 308,305 C 281,384 338,458 435,452 C 478,449 512,430 532,400" />
          <path d="M 495,284 C 438,248 365,258 345,315 C 325,372 365,425 435,420 C 465,418 490,404 505,382" stroke-width="1.25" />
        </g>

        <!-- Left Shrine Rune Rings & Embercrest Core (@ 435, 340) -->
        <g>
          <circle cx="435" cy="340" r="64" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.9" stroke-dasharray="5 7" />
          <circle cx="435" cy="340" r="38" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.95" />
          <!-- Angular Embercrest Diamond / Flame Sigil -->
          <polygon
            points="435,310 457,340 435,370 413,340"
            stroke="rgba(255, 255, 255, 0.26)"
            stroke-width="1.1"
            fill="rgba(255, 255, 255, 0.02)"
          />
          <polygon
            points="435,322 447,340 435,358 423,340"
            stroke="rgba(255, 255, 255, 0.16)"
            stroke-width="0.9"
          />
          <circle cx="435" cy="340" r="2.5" fill="rgba(255, 255, 255, 0.48)" />
        </g>

        <!-- 3. Right Buff-Shrine Basin (Crest of Insight / Blue Sentinel Alcove @ 1165, 340) -->
        <g stroke="url(#partners-shrine-wall)" stroke-width="1.05">
          <!-- Symmetrical Horseshoe Jungle Wall Wrapping Right Shrine (Opening Toward Center) -->
          <path d="M 1045,205 C 1155,135 1325,165 1365,285 C 1405,405 1315,525 1165,515 C 1095,510 1045,480 1015,435" />
          <path d="M 1065,232 C 1158,172 1295,195 1328,295 C 1361,395 1288,492 1165,484 C 1108,480 1065,455 1040,418" />
          <path d="M 1085,258 C 1160,210 1265,226 1292,305 C 1319,384 1262,458 1165,452 C 1122,449 1088,430 1068,400" />
          <path d="M 1105,284 C 1162,248 1235,258 1255,315 C 1275,372 1235,425 1165,420 C 1135,418 1110,404 1095,382" stroke-width="1.25" />
        </g>

        <!-- Right Shrine Rune Rings & Crest of Insight Core (@ 1165, 340) -->
        <g>
          <circle cx="1165" cy="340" r="64" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.9" stroke-dasharray="5 7" />
          <circle cx="1165" cy="340" r="38" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.95" />
          <!-- Hexagonal Crest of Insight / Runic Sigil -->
          <polygon
            points="1165,312 1189,326 1189,354 1165,368 1141,354 1141,326"
            stroke="rgba(255, 255, 255, 0.26)"
            stroke-width="1.1"
            fill="rgba(255, 255, 255, 0.02)"
          />
          <polygon
            points="1165,323 1180,331 1180,349 1165,357 1150,349 1150,331"
            stroke="rgba(255, 255, 255, 0.16)"
            stroke-width="0.9"
          />
          <circle cx="1165" cy="340" r="2.5" fill="rgba(255, 255, 255, 0.48)" />
        </g>

        <!-- 4. Center Synergy Convergence Node (@ 800, 340) -->
        <g stroke="rgba(255, 255, 255, 0.12)" stroke-width="0.9">
          <circle cx="800" cy="340" r="26" stroke-dasharray="3 6" />
          <circle cx="800" cy="340" r="9" />
          <circle cx="800" cy="340" r="2" fill="rgba(255, 255, 255, 0.35)" stroke="none" />
          <line x1="499" y1="340" x2="774" y2="340" stroke="rgba(255, 255, 255, 0.07)" stroke-dasharray="4 8" />
          <line x1="826" y1="340" x2="1101" y2="340" stroke="rgba(255, 255, 255, 0.07)" stroke-dasharray="4 8" />
        </g>

        <!-- 5. Travelling Monochrome Shrine & Conduit Glints -->
        <path
          class="partners-topo-glint"
          d="M-120,485 C180,455 390,345 640,345 C745,345 855,345 960,345 C1210,345 1420,455 1720,485"
        />
        <path
          class="partners-topo-glint partners-glint-left"
          d="M 555,205 C 445,135 275,165 235,285 C 195,405 285,525 435,515 C 505,510 555,480 585,435"
        />
        <path
          class="partners-topo-glint partners-glint-right"
          d="M 1045,205 C 1155,135 1325,165 1365,285 C 1405,405 1315,525 1165,515 C 1095,510 1045,480 1015,435"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header text-center">
      <div class="section-badge-pill">PARTNER & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Spielanalyse, Organisation und Vereinswesen zusammen.
      </p>
    </div>

    <!-- Active Partner Logos: Open, Borderless Clean Showcase with Subtle Buff-Aura on Hover -->
    <div class="sponsors-showcase">
      
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item sponsor-riftops"
        aria-label="RiftOPS Partnerseite"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">SPIELANALYSEN & STATISTIKEN</span>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item sponsor-genesiz"
        aria-label="Esport Genesiz Partnerseite"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport Genesiz Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ESPORT-ORGANISATION & GEMEINSCHAFT</span>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Minimalist Monochrome Twin Buff-Shrines Background */
  .partners-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .partners-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 38% 42% at 28% 46%, rgba(255, 255, 255, 0.035) 0%, transparent 72%),
      radial-gradient(ellipse 38% 42% at 72% 46%, rgba(255, 255, 255, 0.035) 0%, transparent 72%);
  }

  .partners-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 90% 82% at 50% 48%, #000000 24%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
    -webkit-mask-image: radial-gradient(ellipse 90% 82% at 50% 48%, #000000 24%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
  }

  .partners-topo-svg {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    display: block;
    animation: partnersTopoBreathe 32s ease-in-out infinite alternate;
  }

  .partners-topo-glint {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 220 1700;
    stroke-dashoffset: 1920;
    animation: partnersGlintTravel 30s linear infinite;
  }

  .partners-glint-left,
  .partners-glint-right {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-dasharray: 150 1100;
    stroke-dashoffset: 1250;
    animation: partnersShrineGlint 24s linear infinite;
  }

  .partners-glint-right {
    animation-delay: -12s;
  }

  @keyframes partnersTopoBreathe {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(0, -1%, 0) scale(1.022); }
  }

  @keyframes partnersGlintTravel {
    0% { stroke-dashoffset: 1920; }
    100% { stroke-dashoffset: 0; }
  }

  @keyframes partnersShrineGlint {
    0% { stroke-dashoffset: 1250; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-topo-svg,
    .partners-topo-glint {
      animation: none !important;
    }
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Open Borderless Sponsors Showcase */
  .sponsors-showcase {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(2rem, 6vw, 4.5rem);
    flex-wrap: wrap;
    margin-bottom: var(--space-3xl);
    padding: var(--space-lg) 0;
  }

  .sponsor-item {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    padding: var(--space-lg) var(--space-2xl);
    border-radius: var(--radius-lg);
    transition: transform var(--transition-smooth);
    isolation: isolate;
  }

  /* Subtle Brand Buff-Aura Behind Logo on Hover */
  .sponsor-item::before {
    content: '';
    position: absolute;
    inset: -18px -28px;
    border-radius: var(--radius-xl);
    opacity: 0;
    pointer-events: none;
    z-index: -1;
    filter: blur(18px);
    transition: opacity 0.35s cubic-bezier(0.16, 1, 0.3, 1), transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    transform: scale(0.92);
  }

  .sponsor-riftops::before {
    background: radial-gradient(
      ellipse 70% 65% at 50% 45%,
      rgba(255, 35, 69, 0.22) 0%,
      rgba(255, 35, 69, 0.07) 48%,
      transparent 75%
    );
  }

  .sponsor-genesiz::before {
    background: radial-gradient(
      ellipse 70% 65% at 50% 45%,
      rgba(0, 255, 230, 0.2) 0%,
      rgba(0, 255, 230, 0.06) 48%,
      transparent 75%
    );
  }

  .sponsor-item:hover,
  .sponsor-item:focus-visible {
    transform: translateY(-3px);
  }

  .sponsor-item:hover::before,
  .sponsor-item:focus-visible::before {
    opacity: 1;
    transform: scale(1.04);
  }

  .sponsor-logo {
    max-height: 52px;
    width: auto;
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
    transition: filter var(--transition-smooth), opacity var(--transition-fast), transform var(--transition-fast);
  }

  .sponsor-riftops:hover .sponsor-logo,
  .sponsor-riftops:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1) drop-shadow(0 0 18px rgba(255, 35, 69, 0.28));
    opacity: 1;
    transform: scale(1.05);
  }

  .sponsor-genesiz:hover .sponsor-logo,
  .sponsor-genesiz:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1) drop-shadow(0 0 18px rgba(0, 255, 230, 0.26));
    opacity: 1;
    transform: scale(1.05);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    transition: color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-label,
  .sponsor-item:focus-visible .sponsor-label {
    color: #ffffff;
  }

  .sponsor-sep {
    width: 1px;
    height: 48px;
    background: rgba(255, 255, 255, 0.12);
  }

  @media (max-width: 640px) {
    .sponsor-sep {
      display: none;
    }
  }

  /* Centered Contact Underneath */
  .partner-contact-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    max-width: 820px;
    padding: var(--space-xl) var(--space-2xl);
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .partner-contact-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .contact-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .contact-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .contact-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .btn-partner-contact {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .partner-contact-card {
      flex-direction: column;
      text-align: center;
      align-items: center;
    }

    .btn-partner-contact {
      width: 100%;
    }
  }
</style>

---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <div class="container">
    <!-- Section Header -->
    <div class="section-header text-center">
      <div class="section-badge-pill">NETZWERK & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Team-Organisation, Spielanalyse und Turnierbetrieb zusammen.
      </p>
    </div>

    <!-- Active Partner Showcase: Minimalist Open Layout with Clear Descriptions -->
    <div class="sponsors-showcase">
      
      <!-- Partner 1: RiftOPS -->
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="RiftOPS Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ORGANISATION & TEAM-MANAGEMENT</span>
        <p class="sponsor-desc">
          Plattform für Organisation und Teams: Verwaltet unsere Prime League Spiele und nächsten Gegner, liefert Spielanalysen und bietet Kalender-Funktionen, Events sowie Prep-Rooms für die Spieltagsvorbereitung.
        </p>
        <div class="sponsor-tags text-mono" aria-label="RiftOPS Funktionen">
          <span class="sponsor-tag">PRIME LEAGUE</span>
          <span class="sponsor-tag">ANALYSEN & GEGNER</span>
          <span class="sponsor-tag">PREP-ROOMS</span>
          <span class="sponsor-tag">KALENDER & EVENTS</span>
        </div>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <!-- Partner 2: Esport GenesiZ -->
      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="Esport GenesiZ Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport GenesiZ Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">TURNIERE & EVENT-SYSTEME</span>
        <p class="sponsor-desc">
          Spezialisiert auf kompetitive Turniere und Community-Events mit vielseitigen Turniersystemen wie Multi-Bracket, Round Robin, Swiss-System, Double K.O. und weiteren Wettkampfformaten.
        </p>
        <div class="sponsor-tags text-mono" aria-label="Esport GenesiZ Turniersysteme">
          <span class="sponsor-tag">MULTI-BRACKET</span>
          <span class="sponsor-tag">ROUND ROBIN</span>
          <span class="sponsor-tag">SWISS-SYSTEM</span>
          <span class="sponsor-tag">DOUBLE K.O.</span>
        </div>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Active Partners: Minimalist Showcase */
  .sponsors-showcase {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: stretch;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 980px;
    margin: 0 auto var(--space-3xl);
    padding: var(--space-md) 0;
  }

  .sponsor-sep {
    width: 1px;
    height: 120px;
    align-self: center;
    background: rgba(255, 255, 255, 0.12);
  }

  .sponsor-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    padding: 1rem 0.5rem;
    transition: transform var(--transition-smooth);
  }

  .sponsor-item:hover {
    transform: translateY(-3px);
  }

  .sponsor-logo {
    height: 62px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    margin-bottom: 1.25rem;
    filter: grayscale(1) brightness(0.95);
    opacity: 0.82;
    transition: filter 0.25s ease, opacity 0.25s ease, transform 0.25s ease;
  }

  .sponsor-item:hover .sponsor-logo,
  .sponsor-item:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: scale(1.04);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--text-secondary);
    margin-bottom: 0.6rem;
    transition: color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-label {
    color: #ffffff;
  }

  .sponsor-desc {
    font-size: 0.88rem;
    color: var(--text-muted);
    line-height: 1.65;
    max-width: 42ch;
    margin: 0 0 1.1rem;
  }

  /* Minimalist Feature Pills */
  .sponsor-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: auto;
  }

  .sponsor-tag {
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    color: rgba(255, 255, 255, 0.52);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.24rem 0.55rem;
    background: rgba(255, 255, 255, 0.015);
  }

  /* Centered Contact Underneath (Dashed Frame) */
  .partner-contact-wrap {
    display: flex;
    justify-content: center;
    width: 100%;
  }

  .partner-contact-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-xl);
    width: 100%;
    max-width: 820px;
    padding: var(--space-xl) var(--space-2xl);
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.18);
    border-radius: var(--radius-md);
    text-align: left;
    transition: border-color var(--transition-fast);
  }

  .partner-contact-card:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .contact-text-block {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-align: left;
  }

  .contact-tag {
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-secondary);
    letter-spacing: 0.08em;
  }

  .contact-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .contact-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0;
  }

  .btn-partner-contact {
    white-space: nowrap;
    padding: 0.75rem 1.5rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  /* Responsive */
  @media (max-width: 820px) {
    .sponsors-showcase {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    .sponsor-sep {
      width: 80px;
      height: 1px;
    }

    .partner-contact-card {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .contact-text-block {
      align-items: center;
      text-align: center;
    }

    .btn-partner-contact {
      width: 100%;
      max-width: 280px;
      text-align: center;
      justify-content: center;
    }
  }
</style>

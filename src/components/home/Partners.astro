---
// src/components/home/Partners.astro
---

<section id="partners" class="section-pad partners-section">
  <!-- Minimalist Monochrome 3/4 Roaring Hextech-Drake (Left-Side Glass-Chip & Fine Line Architecture) -->
  <div class="partners-bg-fx" aria-hidden="true">
    <div class="partners-glare"></div>

    <div class="partners-drake-wrap">
      <svg
        class="partners-drake-svg"
        viewBox="0 0 1600 720"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <!-- Translucent Glass-Chip Surface Gradients -->
          <linearGradient id="drake-glass-bright" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.068" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.028" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.01" />
          </linearGradient>
          <linearGradient id="drake-glass-mid" x1="20%" y1="0%" x2="80%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.042" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.012" />
          </linearGradient>
          <linearGradient id="drake-glass-soft" x1="100%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.026" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.006" />
          </linearGradient>
          <linearGradient id="drake-maw-depth" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.018" />
            <stop offset="50%" stop-color="#000000" stop-opacity="0.45" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.025" />
          </linearGradient>
          <!-- Fine Edge Wireframe Gradient -->
          <linearGradient id="drake-edge-stroke" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.08" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.2" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.06" />
          </linearGradient>
          <linearGradient id="drake-pit-fade" x1="0%" y1="50%" x2="100%" y2="50%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.03" />
            <stop offset="35%" stop-color="#ffffff" stop-opacity="0.11" />
            <stop offset="75%" stop-color="#ffffff" stop-opacity="0.04" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.0" />
          </linearGradient>
        </defs>

        <!-- ================= 1. DRAGON PIT FLOOR SIGIL & FINE CONSTRUCTION LINES (LEFT STAGE) ================= -->
        <g stroke="url(#drake-pit-fade)" stroke-width="0.95">
          <!-- Perspective Hextech Pit Floor Rings Beneath Drake (@ 375, 535) -->
          <ellipse cx="375" cy="535" rx="310" ry="102" stroke-dasharray="12 10" />
          <ellipse cx="375" cy="535" rx="225" ry="74" />
          <ellipse cx="375" cy="535" rx="145" ry="48" stroke-dasharray="5 7" />
          <!-- Geometric Hextech Floor Pattern Notches -->
          <polygon points="150,535 205,512 245,535 205,558" fill="url(#drake-glass-soft)" />
          <polygon points="600,535 545,512 505,535 545,558" fill="url(#drake-glass-soft)" />
          <path d="M 245,535 L 505,535" stroke-dasharray="4 8" stroke-opacity="0.6" />
          <path d="M 375,433 L 375,637" stroke-dasharray="4 8" stroke-opacity="0.6" />
          <!-- Subtle Sweeping Contour Extension Toward Center-Right -->
          <path d="M 600,535 C 790,535 960,485 1240,455" stroke-dasharray="6 10" stroke-opacity="0.5" />
          <path d="M 555,215 C 745,255 940,315 1180,335" stroke-dasharray="3 9" stroke-opacity="0.4" />
        </g>

        <!-- ================= 2. ARCHED SEGMENTED TAIL & HEXTECH TAIL-MACE (SWEEPING UP-LEFT) ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1" stroke-linejoin="round">
          <!-- Segmented Armored Tail Vertebrae (Rising from Hip @ 295,365 to Tip @ 105,105) -->
          <polygon points="295,365 252,338 272,308 318,338" fill="url(#drake-glass-mid)" />
          <polygon points="252,338 214,298 238,270 272,308" fill="url(#drake-glass-bright)" />
          <polygon points="214,298 182,254 206,230 238,270" fill="url(#drake-glass-mid)" />
          <polygon points="182,254 156,208 178,188 206,230" fill="url(#drake-glass-bright)" />
          <polygon points="156,208 136,164 156,150 178,188" fill="url(#drake-glass-soft)" />
          <!-- Dorsal Tail Ridge Spikes -->
          <polygon points="272,308 286,286 302,324" fill="url(#drake-glass-bright)" />
          <polygon points="238,270 252,248 266,284" fill="url(#drake-glass-bright)" />
          <polygon points="206,230 218,210 232,244" fill="url(#drake-glass-bright)" />
          <!-- Iconic 3-Pronged Hextech Tail-Mace / Spade (@ 132, 136) -->
          <polygon points="156,150 162,108 142,124 136,164" fill="url(#drake-glass-bright)" />
          <polygon points="136,164 102,138 122,126 142,124" fill="url(#drake-glass-mid)" />
          <polygon points="142,124 96,86 122,126" fill="url(#drake-glass-bright)" />
          <circle cx="136" cy="136" r="6" fill="#050507" stroke="rgba(255, 255, 255, 0.3)" />
          <circle cx="136" cy="136" r="2" fill="rgba(255, 255, 255, 0.55)" stroke="none" />
        </g>

        <!-- ================= 3. LEFT WING (EXTENDING HORIZONTALLY LEFT WITH GAUNTLET JOINT) ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1" stroke-linejoin="round">
          <!-- Inner Wing Arm (Shoulder @ 325,358 to Wing Gauntlet @ 215,365) -->
          <polygon points="325,335 215,342 225,382 332,374" fill="url(#drake-glass-mid)" />
          <!-- Armored Hextech Wing-Wrist Gauntlet (@ 165..245, 330..388) -->
          <polygon points="245,336 162,322 145,346 218,386 248,368" fill="url(#drake-glass-bright)" />
          <polygon points="162,322 115,314 145,346" fill="url(#drake-glass-mid)" />
          <!-- Swept-Left Wing Blades & Translucent Membrane Chips -->
          <polygon points="162,322 -65,248 -25,295 145,346" fill="url(#drake-glass-bright)" />
          <polygon points="145,346 -25,295 -45,332 185,368" fill="url(#drake-glass-soft)" />
          <polygon points="218,386 -45,332 45,375 248,368" fill="url(#drake-glass-mid)" />
          <!-- Fine Internal Wing Ribs -->
          <line x1="162" y1="322" x2="-25" y2="295" stroke="rgba(255, 255, 255, 0.1)" stroke-width="0.75" />
          <line x1="218" y1="386" x2="-25" y2="295" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75" />
        </g>

        <!-- ================= 4. RIGHT WING (SWEEPING HIGH UP-RIGHT LIKE REFERENCE POSTURE) ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1" stroke-linejoin="round">
          <!-- Rising Wing Arm from Upper Back (@ 465, 268) to High Knuckle Joint (@ 555, 215) -->
          <polygon points="455,265 535,195 568,225 485,292" fill="url(#drake-glass-mid)" />
          <!-- Armored High Wing-Knuckle Gauntlet & Jewel Node (@ 555, 215) -->
          <polygon points="525,235 552,162 595,125 582,208 545,248" fill="url(#drake-glass-bright)" />
          <circle cx="552" cy="206" r="7" fill="#050507" stroke="rgba(255, 255, 255, 0.32)" />
          <circle cx="552" cy="206" r="2.5" fill="rgba(255, 255, 255, 0.6)" stroke="none" />
          <!-- High Sweeping Primary Wing Spars & Glass-Chip Membranes (Reaching Top @ 690, -15) -->
          <polygon points="552,162 542,78 578,108 595,125" fill="url(#drake-glass-soft)" />
          <polygon points="595,125 658,-20 622,115 582,208" fill="url(#drake-glass-bright)" />
          <polygon points="582,208 622,115 715,-10 645,148" fill="url(#drake-glass-mid)" />
          <polygon points="542,78 658,-20 595,125 578,108" fill="url(#drake-glass-soft)" />
          <!-- Fine Internal Wing Ribs & Construction Tangents -->
          <line x1="552" y1="206" x2="658" y2="-20" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.85" />
          <line x1="582" y1="208" x2="715" y2="-10" stroke="rgba(255, 255, 255, 0.11)" stroke-width="0.8" />
        </g>

        <!-- ================= 5. HIND LEGS, CLAWS & ARMORED TORSO / SADDLE PLATES ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1.05" stroke-linejoin="round">
          <!-- Back-Left Hind Leg & Talons (@ 272, 478) -->
          <polygon points="318,374 275,412 298,438 342,398" fill="url(#drake-glass-soft)" />
          <polygon points="275,412 262,462 288,468 298,438" fill="url(#drake-glass-mid)" />
          <polygon points="262,462 248,486 266,488 275,492 288,468" fill="url(#drake-glass-bright)" />

          <!-- Foreground Center-Left Leg & Armored Knee Claws (@ 348, 578) -->
          <polygon points="365,435 328,488 358,505 395,458" fill="url(#drake-glass-mid)" />
          <polygon points="328,488 334,548 360,548 358,505" fill="url(#drake-glass-bright)" />
          <polygon points="334,548 322,584 344,588 358,585 368,576 360,548" fill="url(#drake-glass-bright)" />

          <!-- Dorsal Back Armor Saddle & Glowing Spine Crystal (@ 385, 318) -->
          <polygon points="318,338 385,305 432,325 368,365" fill="url(#drake-glass-bright)" />
          <polygon points="385,305 376,262 402,292 412,316" fill="url(#drake-glass-bright)" />
          <!-- Neck Collar / Pauldron Armor Plate (@ 435, 305) -->
          <polygon points="418,282 468,262 492,302 448,348 412,322" fill="url(#drake-glass-bright)" />

          <!-- Torso / Chest Plates & Hextech Shoulder Core (@ 388, 432) -->
          <polygon points="332,374 368,365 448,348 465,428 395,458 342,398" fill="url(#drake-glass-soft)" />
          <polygon points="395,458 465,428 485,468 425,478" fill="url(#drake-glass-mid)" />
          <!-- Octagonal Hextech Shoulder Core Node (@ 388, 432) -->
          <polygon points="388,408 408,420 408,444 388,456 368,444 368,420" fill="url(#drake-glass-bright)" />
          <circle cx="388" cy="432" r="8" fill="#050507" stroke="rgba(255, 255, 255, 0.34)" />
          <circle cx="388" cy="432" r="2.8" fill="rgba(255, 255, 255, 0.65)" stroke="none" />
        </g>

        <!-- ================= 6. ICONIC ROARING HEXTECH HEAD, TALL NASAL HORN & OPEN MAW ================= -->
        <g stroke="url(#drake-edge-stroke)" stroke-width="1.1" stroke-linejoin="round">
          <!-- Open Roaring Maw Interior (Faceted Dark Cavity Between Upper & Lower Jaws) -->
          <polygon
            points="515,318 568,308 548,432 512,468 482,395"
            fill="url(#drake-maw-depth)"
          />
          <!-- Internal Maw Geometric Soundwave / Energy Ribs -->
          <line x1="492" y1="358" x2="554" y2="352" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75" />
          <line x1="488" y1="388" x2="548" y2="392" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75" />
          <line x1="496" y1="418" x2="540" y2="425" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.75" />

          <!-- Heavy Armored Lower Jaw & Chin Beard-Spike Dropping Steeply (@ 518, 498) -->
          <polygon points="462,382 496,392 508,448 475,432" fill="url(#drake-glass-mid)" />
          <polygon points="452,412 475,402 486,428 458,432" fill="url(#drake-glass-bright)" />
          <polygon points="475,432 508,448 552,432 568,452 536,458 518,502 486,458" fill="url(#drake-glass-bright)" />
          <!-- Lower Jaw Fangs -->
          <polygon points="508,448 516,430 524,445" fill="url(#drake-glass-bright)" />
          <polygon points="532,442 542,424 548,438" fill="url(#drake-glass-bright)" />

          <!-- Upper Snout, Brow Armor & Maxilla Fangs (@ 470..585, 260..325) -->
          <polygon points="468,262 518,248 532,282 482,302" fill="url(#drake-glass-mid)" />
          <polygon points="482,302 532,282 586,282 572,312 515,318" fill="url(#drake-glass-bright)" />
          <!-- Glowing Slit Eye Facet -->
          <polygon points="502,292 526,285 518,298 498,298" fill="rgba(255, 255, 255, 0.65)" stroke="none" />
          <!-- Upper Jaw Fangs -->
          <polygon points="536,315 544,332 552,314" fill="url(#drake-glass-bright)" />
          <polygon points="558,312 565,328 572,312" fill="url(#drake-glass-bright)" />

          <!-- Tall Iconic Hextech Nasal Horn Spire Rising From Snout Bridge (@ 532,282 -> 504,162) -->
          <polygon
            class="drake-horn-spire"
            points="522,282 502,162 554,264 542,286"
            fill="url(#drake-glass-bright)"
            stroke="rgba(255, 255, 255, 0.35)"
          />
          <line x1="502" y1="162" x2="534" y2="284" stroke="rgba(255, 255, 255, 0.25)" stroke-width="0.9" />

          <!-- Three Swept-Back Cheek / Temple Crystal Fins (Exact Match to Screenshot) -->
          <polygon points="485,295 432,282 465,312" fill="url(#drake-glass-bright)" stroke="rgba(255, 255, 255, 0.28)" />
          <polygon points="482,312 424,312 462,332" fill="url(#drake-glass-bright)" stroke="rgba(255, 255, 255, 0.28)" />
          <polygon points="478,330 434,344 468,348" fill="url(#drake-glass-mid)" stroke="rgba(255, 255, 255, 0.24)" />
        </g>

        <!-- ================= 7. FLOATING GLASS-CHIP SHARDS & STRUCTURAL VERTEX NODES ================= -->
        <g class="drake-floating-shards" stroke="rgba(255, 255, 255, 0.18)" stroke-width="0.9">
          <polygon points="478,135 496,118 492,148" fill="url(#drake-glass-bright)" />
          <polygon points="615,285 648,272 634,304" fill="url(#drake-glass-mid)" />
          <polygon points="592,382 618,374 608,402" fill="url(#drake-glass-soft)" />
          <polygon points="72,115 92,98 88,128" fill="url(#drake-glass-bright)" />
        </g>

        <!-- Fine Technical Vertex Nodes on Key Silhouette Points -->
        <g stroke="rgba(255, 255, 255, 0.26)" stroke-width="0.9" fill="#050507">
          <circle cx="502" cy="162" r="3.5" /><circle cx="502" cy="162" r="1.4" fill="rgba(255, 255, 255, 0.65)" stroke="none" />
          <circle cx="586" cy="282" r="3" />
          <circle cx="518" cy="502" r="3" />
          <circle cx="162" cy="322" r="3.5" />
          <circle cx="96" cy="86" r="3" />
        </g>

        <!-- ================= 8. TRAVELLING MONOCHROME EDGE GLINTS ================= -->
        <path
          class="partners-drake-glint"
          d="M -65,248 L 162,322 L 325,335 L 418,282 L 502,162 L 554,264 L 586,282 L 518,502"
        />
        <path
          class="partners-drake-glint partners-drake-glint-delayed"
          d="M 96,86 L 156,150 L 238,270 L 318,338 L 455,265 L 552,162 L 658,-20"
        />
      </svg>
    </div>
  </div>

  <div class="container">
    
    <div class="section-header text-center">
      <div class="section-badge-pill">PARTNER & KOOPERATIONEN</div>
      <h2 class="section-title">
        UNSERE <span class="text-gradient">PARTNER</span>
      </h2>
      <p class="section-desc centered">
        Gemeinsam im eSport. Wir arbeiten eng mit Partnern aus den Bereichen Team-Organisation, Spielanalyse und Turnierbetrieb zusammen.
      </p>
    </div>

    <!-- Active Partner Showcase: Minimalist Open Layout with Clear Descriptions -->
    <div class="sponsors-showcase">
      
      <!-- Partner 1: RiftOPS -->
      <a 
        href="https://boellerbande.fp-labs.net/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="RiftOPS Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/riftops-horizontal-dark.svg" 
          alt="RiftOPS Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">ORGANISATION & TEAM-MANAGEMENT</span>
        <p class="sponsor-desc">
          Plattform für Organisation und Teams: Verwaltet unsere Prime League Spiele und nächsten Gegner, liefert Spielanalysen und bietet Kalender-Funktionen, Events sowie Prep-Rooms für die Spieltagsvorbereitung.
        </p>
        <div class="sponsor-tags text-mono" aria-label="RiftOPS Funktionen">
          <span class="sponsor-tag">PRIME LEAGUE</span>
          <span class="sponsor-tag">ANALYSEN & GEGNER</span>
          <span class="sponsor-tag">PREP-ROOMS</span>
          <span class="sponsor-tag">KALENDER & EVENTS</span>
        </div>
      </a>

      <div class="sponsor-sep" aria-hidden="true"></div>

      <!-- Partner 2: Esport GenesiZ -->
      <a 
        href="https://esport-genesiz.de/" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="sponsor-item"
        aria-label="Esport GenesiZ Partnerseite öffnen"
      >
        <img 
          src="/assets/logo/GenesiZ_horizontal_tranz_V1.svg" 
          alt="Esport GenesiZ Logo" 
          class="sponsor-logo"
          loading="lazy" 
        />
        <span class="sponsor-label text-mono">TURNIERE & EVENT-SYSTEME</span>
        <p class="sponsor-desc">
          Spezialisiert auf kompetitive Turniere und Community-Events mit vielseitigen Turniersystemen wie Multi-Bracket, Round Robin, Swiss-System, Double K.O. und weiteren Wettkampfformaten.
        </p>
        <div class="sponsor-tags text-mono" aria-label="Esport GenesiZ Turniersysteme">
          <span class="sponsor-tag">MULTI-BRACKET</span>
          <span class="sponsor-tag">ROUND ROBIN</span>
          <span class="sponsor-tag">SWISS-SYSTEM</span>
          <span class="sponsor-tag">DOUBLE K.O.</span>
        </div>
      </a>

    </div>

    <!-- Contact & Become Partner CTA: Centered Underneath -->
    <div class="partner-contact-wrap">
      <div class="partner-contact-card">
        <div class="contact-text-block">
          <span class="contact-tag text-mono">PARTNERSCHAFT & SPONSORING</span>
          <h3 class="contact-title">WERDE PARTNER DER ULTRA INSTINCT CREW</h3>
          <p class="contact-desc">
            Präsentiere deine Marke im Umfeld der Prime League, in unseren Live-Übertragungen und vor einer aktiven Gaming-Gemeinschaft.
          </p>
        </div>
        <a 
          href="mailto:support@ultrainstinctcrew.com?subject=Partnerschaftsanfrage%20UIC" 
          class="btn btn-primary btn-partner-contact"
        >
          KONTAKT AUFNEHMEN &rarr;
        </a>
      </div>
    </div>

  </div>
</section>

<style>
  .partners-section {
    background-color: #000000;
    position: relative;
    overflow: hidden;
  }

  /* Minimalist Monochrome 3/4 Roaring Hextech-Drake Background (Left Stage) */
  .partners-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .partners-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 46% 52% at 26% 46%, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.012) 52%, transparent 78%);
  }

  .partners-drake-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 92% 86% at 38% 48%, #000000 28%, rgba(0, 0, 0, 0.7) 66%, transparent 95%);
    -webkit-mask-image: radial-gradient(ellipse 92% 86% at 38% 48%, #000000 28%, rgba(0, 0, 0, 0.7) 66%, transparent 95%);
  }

  .partners-drake-svg {
    position: absolute;
    inset: -2%;
    width: 104%;
    height: 104%;
    display: block;
    animation: drakeWingBreathe 30s ease-in-out infinite alternate;
  }

  .drake-floating-shards {
    animation: drakeCrystalFloat 7s ease-in-out infinite alternate;
  }

  .partners-drake-glint {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 200 1600;
    stroke-dashoffset: 1800;
    animation: drakeGlintTravel 26s linear infinite;
  }

  .partners-drake-glint-delayed {
    stroke: rgba(255, 255, 255, 0.16);
    stroke-dasharray: 160 1500;
    stroke-dashoffset: 1660;
    animation-duration: 32s;
    animation-delay: -14s;
  }

  @keyframes drakeWingBreathe {
    0% { transform: translate3d(0, 0, 0) scale(1); }
    100% { transform: translate3d(0.8%, -0.8%, 0) scale(1.02); }
  }

  @keyframes drakeCrystalFloat {
    0% { transform: translateY(0); }
    100% { transform: translateY(-6px); }
  }

  @keyframes drakeGlintTravel {
    0% { stroke-dashoffset: 1800; }
    100% { stroke-dashoffset: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-drake-svg,
    .drake-floating-shards,
    .partners-drake-glint {
      animation: none !important;
    }
  }

  .text-center {
    text-align: center;
  }

  .centered {
    margin-inline: auto;
  }

  /* Minimalist Open 2-Column Sponsors Showcase */
  .sponsors-showcase {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1px minmax(0, 1fr);
    align-items: start;
    gap: clamp(2rem, 5vw, 4.5rem);
    max-width: 1080px;
    margin-inline: auto;
    margin-bottom: var(--space-3xl);
    padding: var(--space-md) 0;
  }

  .sponsor-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 12px;
    text-decoration: none;
    padding: var(--space-md);
    transition: transform var(--transition-smooth);
  }

  .sponsor-item:hover,
  .sponsor-item:focus-visible {
    transform: translateY(-2px);
  }

  .sponsor-logo {
    max-height: 48px;
    width: auto;
    margin-bottom: 4px;
    filter: grayscale(1) brightness(1.15);
    opacity: 0.75;
    transition: filter var(--transition-fast), opacity var(--transition-fast), transform var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-logo,
  .sponsor-item:focus-visible .sponsor-logo {
    filter: grayscale(0) brightness(1);
    opacity: 1;
    transform: scale(1.03);
  }

  .sponsor-label {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-white);
    transition: color var(--transition-fast);
  }

  .sponsor-desc {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 440px;
    margin: 0;
  }

  .sponsor-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
  }

  .sponsor-tag {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.09);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    transition: border-color var(--transition-fast), color var(--transition-fast);
  }

  .sponsor-item:hover .sponsor-tag,
  .sponsor-item:focus-visible .sponsor-tag {
    border-color: rgba(255, 255, 255, 0.2);
    color: var(--text-white);
  }

  .sponsor-sep {
    width: 1px;

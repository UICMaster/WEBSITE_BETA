        <!-- ================= 3. ARCANE TARGETING HALO, FLOATING SHARDS & GLINTS ================= -->
        <g class="turret-crystal-core">
          <circle cx="865" cy="134" r="54" stroke="rgba(255, 255, 255, 0.08)" stroke-width="0.8" stroke-dasharray="4 7" />
          <circle cx="865" cy="134" r="34" stroke="rgba(255, 255, 255, 0.13)" stroke-width="0.85" />
          <!-- Floating Arcane Shards Around Scepter Crystal -->
          <polygon points="824,84 829,72 834,84 829,92" fill="url(#turret-crystal-core)" stroke="rgba(255,255,255,0.28)" stroke-width="0.75" />
          <polygon points="898,96 903,84 908,96 903,104" fill="url(#turret-crystal-core)" stroke="rgba(255,255,255,0.28)" stroke-width="0.75" />
          <polygon points="818,142 822,132 827,142 822,149" fill="url(#turret-gold-trim)" stroke="rgba(255,255,255,0.24)" stroke-width="0.7" />
        </g>

        <!-- Travelling Monochrome Glints Along Upright Scepter, Guardian Crown & Aggro Ring -->
        <path
          class="events-topo-glint"
          d="M 858,607 L 863,258 L 865,144 L 863,57 L 978,193 L 996,256 L 1117,421 L 970,620"
        />
        <path
          class="events-topo-glint events-glint-ring"
          d="M 702,620 A 268,72 0 1,1 1238,620 A 268,72 0 1,1 702,620"
        />
      </svg>
    </div>
  </div>

  <!-- Schema.org SportsEvent & Event Structured Data (Pre-rendered for Instant Crawler Discovery) -->
  {eventsJsonLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
  )}

  <div class="container">
    
    <div class="section-header">
      <div class="section-badge-pill">TERMINE & KALENDER</div>
      <h2 class="section-title">
        GEPLANTE <span class="text-gradient">TERMINE</span>
      </h2>
      <p class="section-desc">
        Kommende Prime League Spieltage, Turniere und Vereinstreffen direkt aus unserem Terminkalender.
      </p>
    </div>

    {events.length > 0 ? (
      <div class="events-grid">
        {events.map((event) => {
          const startDate = new Date(event.start);
          const month = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', month: 'short' }).toUpperCase();
          const day = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: 'numeric' });
          const time = startDate.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit' });
          const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
          const matchedPrimeInfo = event.location ? matchLookupByUrl[event.location] : undefined;
          const isConfirmed = matchedPrimeInfo ? matchedPrimeInfo.confirmed : !isMatch;
          const confirmedLabel = isConfirmed ? 'Bestätigt' : 'Unbestätigt';
          const eventActionAria = isMatch
            ? `Ligaspiel ${event.name} auf Prime League öffnen`
            : `Termin ${event.name} öffnen`;
          const eventStreamAria = `Live-Übertragung für ${event.name} öffnen`;

          return (
            <article class={`event-bento-card ${event.highlight ? 'is-highlighted' : ''}`}>
              <!-- Top Meta Strip: Modern Date Chip & Colored Badge -->
              <div class="event-meta-strip">
                <div class="event-date-cluster">
                  <div class="event-date-chip text-mono">
                    <span class="event-day-val">{day}. {month}</span>
                    <span class="event-sep">&bull;</span>
                    <span class="event-time-val">{time} UHR</span>
                  </div>
                  <span class={`match-status-badge ${isConfirmed ? 'is-confirmed' : 'is-unconfirmed'}`}>
                    {confirmedLabel}
                  </span>
                </div>
                <span class={`type-badge text-mono ${isMatch ? 'match-badge' : 'community-badge'}`}>
                  {isMatch ? 'LIGASPIEL' : 'VEREINSTREFFEN'}
                </span>
              </div>

              <!-- Title & Desc -->
              <div class="event-content">
                <div class="name-with-link">
                  <h3 class="event-title">{event.name}</h3>
                  {event.location && (
                    <a
                      href={event.location}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-forward-arrow"
                      title={eventActionAria}
                      aria-label={eventActionAria}
                    >
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  )}
                </div>
                {event.description && (
                  <p class="event-desc">{event.description}</p>
                )}
              </div>

              <!-- Footer Buttons -->
              <div class="event-footer">
                {event.location ? (
                  <a 
                    href={event.location} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline btn-sm event-action-btn"
                    title={eventActionAria}
                    aria-label={eventActionAria}
                  >
                    <span>{isMatch ? 'ZUM LIGASPIEL' : 'ZUM TERMIN'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : null}

                {event.streamUrl && (
                  <a 
                    href={event.streamUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-primary btn-sm event-action-btn"
                    title={eventStreamAria}
                    aria-label={eventStreamAria}
                  >
                    <span>ZUR ÜBERTRAGUNG</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}

                <button
                  type="button"
                  class="btn btn-outline btn-sm text-mono event-ics-btn"
                  data-ics-trigger
                  data-ics-title={event.name}
                  data-ics-desc={event.description || 'Ultra Instinct Crew Termin'}
                  data-ics-loc={event.location || 'https://ultrainstinctcrew.com'}
                  data-ics-begin={event.start}
                  title="Termin im Kalender speichern (.ICS)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span>+ KALENDER</span>
                </button>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-events">
        <p class="empty-title">Aktuell sind keine offiziellen Termine eingetragen.</p>
        <p class="empty-desc">Besuche unseren Discord Server, um über anstehende Spiele, Trainingseinheiten und Ankündigungen informiert zu bleiben.</p>
        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          ZUM DISCORD SERVER
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .events-section {
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }

  /* Minimalist Monochrome Rift Turret & Topographic Background */
  .events-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .events-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 46% 56% at 61% 42%, rgba(255, 255, 255, 0.048) 0%, rgba(255, 255, 255, 0.014) 52%, transparent 78%);
  }

  .events-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 92% 88% at 60% 48%, #000000 34%, rgba(0, 0, 0, 0.76) 70%, transparent 96%);
    -webkit-mask-image: radial-gradient(ellipse 92% 88% at 60% 48%, #000000 34%, rgba(0, 0, 0, 0.76) 70%, transparent 96%);
  }

  .events-topo-svg {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    display: block;
    animation: eventsTopoBreathe 32s ease-in-out infinite alternate;
  }

  .turret-crystal-core {
    animation: turretCrystalFloat 7s ease-in-out infinite alternate;
  }

  .events-topo-glint {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 200 1600;
    stroke-dashoffset: 1800;
    animation: eventsGlintTravel 28s linear infinite;
  }

  .events-glint-ring {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-dasharray: 140 1100;
    stroke-dashoffset: 1240;
    animation: eventsRingGlint 22s linear infinite;
  }

  @keyframes eventsTopoBreathe {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-1%, 0.8%, 0) scale(1.025);
    }
  }

  @keyframes turretCrystalFloat {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-7px);
    }
  }

  @keyframes eventsGlintTravel {
    0% {
      stroke-dashoffset: 1800;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes eventsRingGlint {
    0% {
      stroke-dashoffset: 1240;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-topo-svg,
    .turret-crystal-core,
    .events-topo-glint {
      animation: none !important;
    }
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr));
    gap: var(--space-lg);
  }

  /* Event Bento Card (Matching Ökosystem container) */
  .event-bento-card {
    background: rgba(13, 13, 16, 0.76);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;

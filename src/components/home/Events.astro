---
// src/components/home/Events.astro
import rawEvents from '../../../data/events.json';
import { discordInviteUrl, matchLookupByUrl } from '../../utils/uicData';

interface DiscordEvent {
  id: string;
  name: string;
  description?: string;
  type?: string;
  highlight?: boolean;
  start: string;
  end?: string;
  location?: string;
  image?: string;
  competitors?: string[];
  streamUrl?: string;
}

const now = new Date();
const events: DiscordEvent[] = ((rawEvents as DiscordEvent[]) || []).filter((e) => {
  const endOrStart = e.end ? new Date(e.end) : new Date(e.start);
  return isNaN(endOrStart.getTime()) || endOrStart >= now;
});

// Pre-render Schema.org Event & SportsEvent Structured Data for instant Search Engine Crawler detection (SSG)
const siteUrl = "https://ultrainstinctcrew.com";
const defaultImage = `${siteUrl}/assets/logo/logo.png`;

const eventsJsonLd = events.map((event) => {
  const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
  const eventUrl = event.location || `${siteUrl}/#events`;
  const endFallback = event.end || (event.start ? new Date(new Date(event.start).getTime() + 2 * 3600000).toISOString() : event.start);

  const schema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": isMatch ? "SportsEvent" : "Event",
    "@id": `${siteUrl}/#event-${event.id}`,
    "name": event.name,
    "description": event.description || `Offizieller Termin der Ultra Instinct Crew: ${event.name}`,
    "startDate": event.start,
    "endDate": endFallback,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
    "location": {
      "@type": "VirtualLocation",
      "url": eventUrl
    },
    "image": [
      event.image || defaultImage
    ],
    "organizer": {
      "@type": "SportsOrganization",
      "@id": `${siteUrl}/#organization`,
      "name": "Ultra Instinct Crew",
      "url": `${siteUrl}/`
    },
    "offers": {
      "@type": "Offer",
      "url": eventUrl,
      "price": "0",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": event.start
    }
  };

  if (isMatch && Array.isArray(event.competitors) && event.competitors.length >= 2) {
    schema.competitor = [
      {
        "@type": "SportsTeam",
        "name": event.competitors[0]
      },
      {
        "@type": "SportsTeam",
        "name": event.competitors[1]
      }
    ];
  }

  if (event.streamUrl) {
    schema.recordedIn = {
      "@type": "VideoObject",
      "name": `Live-Stream: ${event.name}`,
      "description": `Offizielle Live-Übertragung von ${event.name} auf Twitch`,
      "thumbnailUrl": event.image || defaultImage,
      "uploadDate": event.start,
      "url": event.streamUrl,
      "embedUrl": event.streamUrl
    };
  }

  return schema;
});

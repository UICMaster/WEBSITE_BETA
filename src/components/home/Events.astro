---
// src/components/home/Events.astro
import rawEvents from '../../../data/events.json';
import { discordInviteUrl, matchLookupByUrl } from '../../utils/uicData';

interface DiscordEvent {
  id: string;
  name: string;
  description?: string;
  type?: string;
  highlight?: boolean;
  start: string;
  end?: string;
  location?: string;
  image?: string;
  competitors?: string[];
  streamUrl?: string;
}

const now = new Date();
const events: DiscordEvent[] = ((rawEvents as DiscordEvent[]) || []).filter((e) => {
  const endOrStart = e.end ? new Date(e.end) : new Date(e.start);
  return isNaN(endOrStart.getTime()) || endOrStart >= now;
});

// Pre-render Schema.org Event & SportsEvent Structured Data for instant Search Engine Crawler detection (SSG)
const siteUrl = "https://ultrainstinctcrew.com";
const defaultImage = `${siteUrl}/assets/logo/logo.png`;

const eventsJsonLd = events.map((event) => {
  const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
  const eventUrl = event.location || `${siteUrl}/#events`;
  const endFallback = event.end || (event.start ? new Date(new Date(event.start).getTime() + 2 * 3600000).toISOString() : event.start);

  const schema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": isMatch ? "SportsEvent" : "Event",
    "@id": `${siteUrl}/#event-${event.id}`,
    "name": event.name,
    "description": event.description || `Offizieller Termin der Ultra Instinct Crew: ${event.name}`,
    "startDate": event.start,
    "endDate": endFallback,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
    "location": {
      "@type": "VirtualLocation",
      "url": eventUrl
    },
    "image": [
      event.image || defaultImage
    ],
    "organizer": {
      "@type": "SportsOrganization",
      "@id": `${siteUrl}/#organization`,
      "name": "Ultra Instinct Crew",
      "url": `${siteUrl}/`
    },
    "offers": {
      "@type": "Offer",
      "url": eventUrl,
      "price": "0",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": event.start
    }
  };

  if (isMatch && Array.isArray(event.competitors) && event.competitors.length >= 2) {
    schema.competitor = [
      {
        "@type": "SportsTeam",
        "name": event.competitors[0]
      },
      {
        "@type": "SportsTeam",
        "name": event.competitors[1]
      }
    ];
  }

  if (event.streamUrl) {
    schema.recordedIn = {
      "@type": "VideoObject",
      "name": `Live-Stream: ${event.name}`,
      "description": `Offizielle Live-Übertragung von ${event.name} auf Twitch`,
      "thumbnailUrl": event.image || defaultImage,
      "uploadDate": event.start,
      "url": event.streamUrl,
      "embedUrl": event.streamUrl
    };
  }

  return schema;
});
---

<section id="events" class="section-pad events-section">
  <!-- Schema.org SportsEvent & Event Structured Data (Pre-rendered for Instant Crawler Discovery) -->
  {eventsJsonLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
  )}

  <div class="container">
    
    <div class="section-header">
      <div class="section-badge-pill">TERMINE & KALENDER</div>
      <h2 class="section-title">
        GEPLANTE <span class="text-gradient">TERMINE</span>
      </h2>
      <p class="section-desc">
        Kommende Prime League Spieltage, Turniere und Vereinstreffen direkt aus unserem Terminkalender.
      </p>
    </div>

    {events.length > 0 ? (
      <div class="events-grid">
        {events.map((event) => {
          const startDate = new Date(event.start);
          const month = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', month: 'short' }).toUpperCase();
          const day = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: 'numeric' });
          const time = startDate.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit' });
          const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
          const matchedPrimeInfo = event.location ? matchLookupByUrl[event.location] : undefined;
          const isConfirmed = matchedPrimeInfo ? matchedPrimeInfo.confirmed : !isMatch;
          const confirmedLabel = isConfirmed ? 'Bestätigt' : 'Unbestätigt';
          const eventActionAria = isMatch
            ? `Ligaspiel ${event.name} auf Prime League öffnen`
            : `Termin ${event.name} öffnen`;
          const eventStreamAria = `Live-Übertragung für ${event.name} öffnen`;

          return (
            <article class={`event-bento-card ${event.highlight ? 'is-highlighted' : ''}`}>
              <!-- Top Meta Strip: Modern Date Chip & Colored Badge -->
              <div class="event-meta-strip">
                <div class="event-date-cluster">
                  <div class="event-date-chip text-mono">
                    <span class="event-day-val">{day}. {month}</span>
                    <span class="event-sep">&bull;</span>
                    <span class="event-time-val">{time} UHR</span>
                  </div>
                  <span class={`match-status-badge ${isConfirmed ? 'is-confirmed' : 'is-unconfirmed'}`}>
                    {confirmedLabel}
                  </span>
                </div>
                <span class={`type-badge text-mono ${isMatch ? 'match-badge' : 'community-badge'}`}>
                  {isMatch ? 'LIGASPIEL' : 'VEREINSTREFFEN'}
                </span>
              </div>

              <!-- Title & Desc -->
              <div class="event-content">
                <div class="name-with-link">
                  <h3 class="event-title">{event.name}</h3>
                  {event.location && (
                    <a
                      href={event.location}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-forward-arrow"
                      title={eventActionAria}
                      aria-label={eventActionAria}
                    >
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  )}
                </div>
                {event.description && (
                  <p class="event-desc">{event.description}</p>
                )}
              </div>

              <!-- Footer Buttons -->
              <div class="event-footer">
                {event.location ? (
                  <a 
                    href={event.location} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline btn-sm event-action-btn"
                    title={eventActionAria}
                    aria-label={eventActionAria}
                  >
                    <span>{isMatch ? 'ZUM LIGASPIEL' : 'ZUM TERMIN'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : null}

                {event.streamUrl && (
                  <a 
                    href={event.streamUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-primary btn-sm event-action-btn"
                    title={eventStreamAria}
                    aria-label={eventStreamAria}
                  >
                    <span>ZUR ÜBERTRAGUNG</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}

                <button
                  type="button"
                  class="btn btn-outline btn-sm text-mono event-ics-btn"
                  data-ics-trigger
                  data-ics-title={event.name}
                  data-ics-desc={event.description || 'Ultra Instinct Crew Termin'}
                  data-ics-loc={event.location || 'https://ultrainstinctcrew.com'}
                  data-ics-begin={event.start}
                  title="Termin im Kalender speichern (.ICS)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span>+ KALENDER</span>
                </button>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-events">
        <p class="empty-title">Aktuell sind keine offiziellen Termine eingetragen.</p>
        <p class="empty-desc">Besuche unseren Discord Server, um über anstehende Spiele, Trainingseinheiten und Ankündigungen informiert zu bleiben.</p>
        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          ZUM DISCORD SERVER
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .events-section {
    position: relative;
    background-color: #000000;
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr));
    gap: var(--space-lg);
  }

  /* Event Bento Card (Matching Ökosystem container) */
  .event-bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.45);
    transition: border-color var(--transition-fast), transform var(--transition-smooth), background-color var(--transition-fast);
    min-width: 0;
  }

  .event-bento-card:hover {
    background: #121216;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .event-bento-card.is-highlighted {
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 12px 32px rgba(255, 255, 255, 0.08);
  }

  .event-meta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .event-date-cluster {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .event-date-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xs);
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 700;
    height: 22px;
    box-sizing: border-box;
  }

  .event-day-val {
    color: #ffffff;
    font-weight: 800;
  }

  .event-sep {
    color: rgba(255, 255, 255, 0.25);
  }

  .event-time-val {
    color: var(--text-secondary);
  }

  .event-meta-strip :global(.match-status-badge),
  .type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    line-height: 1;
    height: 22px;
    box-sizing: border-box;
  }

  .match-badge {
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.32);
  }

  .community-badge {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .event-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .event-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .event-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .event-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .event-footer .btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .event-action-btn {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .event-ics-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  @media (max-width: 480px) {
    .event-bento-card {
      padding: var(--space-lg);
    }

    .event-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .event-footer .btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Empty State */
  .empty-events {
    background: rgba(13, 13, 16, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--space-3xl);
    text-align: center;
  }

  .empty-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: var(--space-xs);
  }

  .empty-desc {
    color: var(--text-secondary);
    margin-bottom: var(--space-lg);
  }
</style>

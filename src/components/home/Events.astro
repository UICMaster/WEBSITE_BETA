---
// src/components/home/Events.astro
import rawEvents from '../../../data/events.json';
import { discordInviteUrl, matchLookupByUrl } from '../../utils/uicData';

interface DiscordEvent {
  id: string;
  name: string;
  description?: string;
  type?: string;
  highlight?: boolean;
  start: string;
  end?: string;
  location?: string;
  image?: string;
  competitors?: string[];
  streamUrl?: string;
}

const now = new Date();
const events: DiscordEvent[] = ((rawEvents as DiscordEvent[]) || []).filter((e) => {
  const endOrStart = e.end ? new Date(e.end) : new Date(e.start);
  return isNaN(endOrStart.getTime()) || endOrStart >= now;
});

// Pre-render Schema.org Event & SportsEvent Structured Data for instant Search Engine Crawler detection (SSG)
const siteUrl = "https://ultrainstinctcrew.com";
const defaultImage = `${siteUrl}/assets/logo/logo.png`;

const eventsJsonLd = events.map((event) => {
  const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
  const eventUrl = event.location || `${siteUrl}/#events`;
  const endFallback = event.end || (event.start ? new Date(new Date(event.start).getTime() + 2 * 3600000).toISOString() : event.start);

  const schema: Record<string, any> = {
    "@context": "https://schema.org",
    "@type": isMatch ? "SportsEvent" : "Event",
    "@id": `${siteUrl}/#event-${event.id}`,
    "name": event.name,
    "description": event.description || `Offizieller Termin der Ultra Instinct Crew: ${event.name}`,
    "startDate": event.start,
    "endDate": endFallback,
    "eventStatus": "https://schema.org/EventScheduled",
    "eventAttendanceMode": "https://schema.org/OnlineEventAttendanceMode",
    "location": {
      "@type": "VirtualLocation",
      "url": eventUrl
    },
    "image": [
      event.image || defaultImage
    ],
    "organizer": {
      "@type": "SportsOrganization",
      "@id": `${siteUrl}/#organization`,
      "name": "Ultra Instinct Crew",
      "url": `${siteUrl}/`
    },
    "offers": {
      "@type": "Offer",
      "url": eventUrl,
      "price": "0",
      "priceCurrency": "EUR",
      "availability": "https://schema.org/InStock",
      "validFrom": event.start
    }
  };

  if (isMatch && Array.isArray(event.competitors) && event.competitors.length >= 2) {
    schema.competitor = [
      {
        "@type": "SportsTeam",
        "name": event.competitors[0]
      },
      {
        "@type": "SportsTeam",
        "name": event.competitors[1]
      }
    ];
  }

  if (event.streamUrl) {
    schema.recordedIn = {
      "@type": "VideoObject",
      "name": `Live-Stream: ${event.name}`,
      "description": `Offizielle Live-Übertragung von ${event.name} auf Twitch`,
      "thumbnailUrl": event.image || defaultImage,
      "uploadDate": event.start,
      "url": event.streamUrl,
      "embedUrl": event.streamUrl
    };
  }

  return schema;
});
---

<section id="events" class="section-pad events-section">
  <!-- Minimalist Monochrome Rift Turret & Topographic Lane Bastion Background -->
  <div class="events-bg-fx" aria-hidden="true">
    <div class="events-glare"></div>

    <div class="events-topo-wrap">
      <svg
        class="events-topo-svg"
        viewBox="0 0 1600 820"
        fill="none"
        preserveAspectRatio="xMidYMid slice"
      >
        <defs>
          <linearGradient id="events-topo-line" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.025" />
            <stop offset="55%" stop-color="#ffffff" stop-opacity="0.09" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.02" />
          </linearGradient>
          <linearGradient id="events-turret-stroke" x1="50%" y1="0%" x2="50%" y2="100%">
            <stop offset="0%" stop-color="#ffffff" stop-opacity="0.22" />
            <stop offset="50%" stop-color="#ffffff" stop-opacity="0.13" />
            <stop offset="100%" stop-color="#ffffff" stop-opacity="0.05" />
          </linearGradient>
        </defs>

        <!-- 1. Flanking Lane & Jungle Cliff Topographic Contours -->
        <g stroke="url(#events-topo-line)" stroke-width="1">
          <!-- Sweeping Lane Corridor Isolines -->
          <path d="M-120,690 C240,650 560,575 890,545 C1220,515 1440,455 1720,395" />
          <path d="M-120,735 C260,695 585,615 920,582 C1255,549 1465,492 1720,435" />
          <path d="M-120,645 C220,605 535,535 860,508 C1185,481 1415,418 1720,355" stroke-opacity="0.65" />

          <!-- Left High-Ground Jungle Wall Contours -->
          <path d="M-90,140 C95,95 310,115 435,205 C560,295 520,445 365,505 C210,565 15,525 -100,440 Z" />
          <path d="M-50,180 C105,142 282,158 385,232 C488,306 455,425 328,472 C201,519 42,488 -60,415 Z" />
          <path d="M-10,220 C115,190 252,202 332,258 C412,314 388,402 290,438 C192,474 68,450 -18,390 Z" />

          <!-- Right Bastion Cliff Elevation Contours (Behind Turret) -->
          <path d="M980,95 C1165,45 1420,65 1575,165 C1730,265 1690,435 1515,505 C1340,575 1095,535 975,425 C855,315 795,145 980,95 Z" />
          <path d="M1035,135 C1185,95 1390,110 1515,192 C1640,274 1608,410 1468,465 C1328,520 1132,488 1035,400 C938,312 885,175 1035,135 Z" />
        </g>

        <!-- 2. Turret Aggro-Range & Bastion Ground Rings (Perspective Ellipses @ 1190, 545) -->
        <g class="turret-ground-rings">
          <!-- Outer Aggro Boundary Ring -->
          <ellipse
            cx="1190"
            cy="545"
            rx="310"
            ry="108"
            stroke="rgba(255, 255, 255, 0.08)"
            stroke-width="1"
            stroke-dasharray="8 10"
          />
          <!-- Secondary Tactical Range Ring -->
          <ellipse
            cx="1190"
            cy="545"
            rx="225"
            ry="78"
            stroke="rgba(255, 255, 255, 0.09)"
            stroke-width="0.95"
          />
          <!-- Stepped Pedestal Base Rings -->
          <ellipse
            cx="1190"
            cy="545"
            rx="135"
            ry="46"
            stroke="rgba(255, 255, 255, 0.13)"
            stroke-width="1"
            stroke-dasharray="4 6"
          />
          <ellipse
            cx="1190"
            cy="545"
            rx="78"
            ry="26"
            stroke="rgba(255, 255, 255, 0.18)"
            stroke-width="1.1"
          />
          <!-- Ground Axis Crosshairs -->
          <line x1="860" y1="545" x2="915" y2="545" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.9" />
          <line x1="1465" y1="545" x2="1520" y2="545" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.9" />
          <line x1="1190" y1="635" x2="1190" y2="668" stroke="rgba(255, 255, 255, 0.14)" stroke-width="0.9" />
        </g>

        <!-- 3. Minimalist Summoner's Rift Turret Architecture (Wireframe Monolith @ X=1190) -->
        <g stroke="url(#events-turret-stroke)" stroke-width="1.1" stroke-linejoin="round">
          <!-- Octagonal Stepped Plinth / Pedestal -->
          <polygon points="1118,545 1146,562 1234,562 1262,545 1246,515 1134,515" fill="rgba(255, 255, 255, 0.012)" />
          <polygon points="1134,515 1156,528 1224,528 1246,515 1232,482 1148,482" />
          <line x1="1156" y1="528" x2="1146" y2="562" />
          <line x1="1224" y1="528" x2="1234" y2="562" />
          <line x1="1190" y1="482" x2="1190" y2="562" stroke-opacity="0.5" />

          <!-- Tapered Central Monolith Column & Facet Ribs -->
          <polygon points="1148,482 1166,492 1214,492 1232,482 1216,295 1190,308 1164,295" fill="rgba(255, 255, 255, 0.015)" />
          <line x1="1190" y1="308" x2="1190" y2="492" />
          <line x1="1166" y1="492" x2="1174" y2="302" stroke-opacity="0.6" />
          <line x1="1214" y1="492" x2="1206" y2="302" stroke-opacity="0.6" />

          <!-- Iconic Floating Shoulder Shields / Wing Buttresses -->
          <polygon points="1116,355 1142,272 1154,292 1144,415 1122,395" fill="rgba(255, 255, 255, 0.015)" />
          <polygon points="1264,355 1238,272 1226,292 1236,415 1258,395" fill="rgba(255, 255, 255, 0.015)" />

          <!-- Upper Crown Horns Framing the Arcane Core -->
          <polygon points="1146,268 1132,188 1158,215 1172,278" fill="rgba(255, 255, 255, 0.02)" />
          <polygon points="1234,268 1248,188 1222,215 1208,278" fill="rgba(255, 255, 255, 0.02)" />
          <!-- Inner Crown Cradle -->
          <path d="M 1158,274 L 1190,290 L 1222,274" />
        </g>

        <!-- 4. Levitating Arcane Turret Crystal & Targeting Pulse (@ 1190, 205) -->
        <g class="turret-crystal-core">
          <!-- Concentric Arcane Halo Rings -->
          <circle cx="1190" cy="205" r="56" stroke="rgba(255, 255, 255, 0.07)" stroke-width="0.85" stroke-dasharray="3 6" />
          <circle cx="1190" cy="205" r="34" stroke="rgba(255, 255, 255, 0.12)" stroke-width="0.9" />
          <!-- Faceted Octahedron Crystal -->
          <polygon
            points="1190,162 1212,205 1190,248 1168,205"
            stroke="rgba(255, 255, 255, 0.34)"
            stroke-width="1.2"
            fill="rgba(255, 255, 255, 0.04)"
          />
          <polyline points="1168,205 1190,214 1212,205" stroke="rgba(255, 255, 255, 0.24)" stroke-width="0.95" />
          <line x1="1190" y1="162" x2="1190" y2="248" stroke="rgba(255, 255, 255, 0.24)" stroke-width="0.95" />
          <circle cx="1190" cy="205" r="2.5" fill="rgba(255, 255, 255, 0.65)" />
        </g>

        <!-- Subtle Targeting Beam Line from Crystal to Outer Aggro Ring -->
        <line
          x1="1190"
          y1="205"
          x2="925"
          y2="598"
          stroke="rgba(255, 255, 255, 0.08)"
          stroke-width="0.9"
          stroke-dasharray="4 8"
        />
        <circle cx="925" cy="598" r="5" stroke="rgba(255, 255, 255, 0.22)" stroke-width="1" />
        <circle cx="925" cy="598" r="1.8" fill="rgba(255, 255, 255, 0.45)" />

        <!-- 5. Travelling Monochrome Glints along Lane & Turret Ring -->
        <path
          class="events-topo-glint"
          d="M-120,690 C240,650 560,575 890,545 C1220,515 1440,455 1720,395"
        />
        <path
          class="events-topo-glint events-glint-ring"
          d="M 965,545 A 225,78 0 1,1 1415,545 A 225,78 0 1,1 965,545"
        />
      </svg>
    </div>
  </div>

  <!-- Schema.org SportsEvent & Event Structured Data (Pre-rendered for Instant Crawler Discovery) -->
  {eventsJsonLd.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(eventsJsonLd)} />
  )}

  <div class="container">
    
    <div class="section-header">
      <div class="section-badge-pill">TERMINE & KALENDER</div>
      <h2 class="section-title">
        GEPLANTE <span class="text-gradient">TERMINE</span>
      </h2>
      <p class="section-desc">
        Kommende Prime League Spieltage, Turniere und Vereinstreffen direkt aus unserem Terminkalender.
      </p>
    </div>

    {events.length > 0 ? (
      <div class="events-grid">
        {events.map((event) => {
          const startDate = new Date(event.start);
          const month = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', month: 'short' }).toUpperCase();
          const day = startDate.toLocaleString('de-DE', { timeZone: 'Europe/Berlin', day: 'numeric' });
          const time = startDate.toLocaleTimeString('de-DE', { timeZone: 'Europe/Berlin', hour: '2-digit', minute: '2-digit' });
          const isMatch = event.type === 'ESPORTS MATCH' || event.name.toLowerCase().includes('vs');
          const matchedPrimeInfo = event.location ? matchLookupByUrl[event.location] : undefined;
          const isConfirmed = matchedPrimeInfo ? matchedPrimeInfo.confirmed : !isMatch;
          const confirmedLabel = isConfirmed ? 'Bestätigt' : 'Unbestätigt';
          const eventActionAria = isMatch
            ? `Ligaspiel ${event.name} auf Prime League öffnen`
            : `Termin ${event.name} öffnen`;
          const eventStreamAria = `Live-Übertragung für ${event.name} öffnen`;

          return (
            <article class={`event-bento-card ${event.highlight ? 'is-highlighted' : ''}`}>
              <!-- Top Meta Strip: Modern Date Chip & Colored Badge -->
              <div class="event-meta-strip">
                <div class="event-date-cluster">
                  <div class="event-date-chip text-mono">
                    <span class="event-day-val">{day}. {month}</span>
                    <span class="event-sep">&bull;</span>
                    <span class="event-time-val">{time} UHR</span>
                  </div>
                  <span class={`match-status-badge ${isConfirmed ? 'is-confirmed' : 'is-unconfirmed'}`}>
                    {confirmedLabel}
                  </span>
                </div>
                <span class={`type-badge text-mono ${isMatch ? 'match-badge' : 'community-badge'}`}>
                  {isMatch ? 'LIGASPIEL' : 'VEREINSTREFFEN'}
                </span>
              </div>

              <!-- Title & Desc -->
              <div class="event-content">
                <div class="name-with-link">
                  <h3 class="event-title">{event.name}</h3>
                  {event.location && (
                    <a
                      href={event.location}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="link-forward-arrow"
                      title={eventActionAria}
                      aria-label={eventActionAria}
                    >
                      <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                    </a>
                  )}
                </div>
                {event.description && (
                  <p class="event-desc">{event.description}</p>
                )}
              </div>

              <!-- Footer Buttons -->
              <div class="event-footer">
                {event.location ? (
                  <a 
                    href={event.location} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-outline btn-sm event-action-btn"
                    title={eventActionAria}
                    aria-label={eventActionAria}
                  >
                    <span>{isMatch ? 'ZUM LIGASPIEL' : 'ZUM TERMIN'}</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                ) : null}

                {event.streamUrl && (
                  <a 
                    href={event.streamUrl} 
                    target="_blank" 
                    rel="noopener noreferrer" 
                    class="btn btn-primary btn-sm event-action-btn"
                    title={eventStreamAria}
                    aria-label={eventStreamAria}
                  >
                    <span>ZUR ÜBERTRAGUNG</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}

                <button
                  type="button"
                  class="btn btn-outline btn-sm text-mono event-ics-btn"
                  data-ics-trigger
                  data-ics-title={event.name}
                  data-ics-desc={event.description || 'Ultra Instinct Crew Termin'}
                  data-ics-loc={event.location || 'https://ultrainstinctcrew.com'}
                  data-ics-begin={event.start}
                  title="Termin im Kalender speichern (.ICS)"
                >
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                  <span>+ KALENDER</span>
                </button>
              </div>
            </article>
          );
        })}
      </div>
    ) : (
      <div class="empty-events">
        <p class="empty-title">Aktuell sind keine offiziellen Termine eingetragen.</p>
        <p class="empty-desc">Besuche unseren Discord Server, um über anstehende Spiele, Trainingseinheiten und Ankündigungen informiert zu bleiben.</p>
        <a href={discordInviteUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
          ZUM DISCORD SERVER
        </a>
      </div>
    )}

  </div>
</section>

<style>
  .events-section {
    position: relative;
    background-color: #000000;
    overflow: hidden;
  }

  /* Minimalist Monochrome Rift Turret & Topographic Background */
  .events-bg-fx {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
    overflow: hidden;
  }

  .events-glare {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 48% 50% at 74% 38%, rgba(255, 255, 255, 0.045) 0%, rgba(255, 255, 255, 0.012) 52%, transparent 78%),
      radial-gradient(ellipse 45% 40% at 18% 30%, rgba(255, 255, 255, 0.03) 0%, transparent 70%);
  }

  .events-topo-wrap {
    position: absolute;
    inset: 0;
    mask-image: radial-gradient(ellipse 90% 82% at 58% 48%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
    -webkit-mask-image: radial-gradient(ellipse 90% 82% at 58% 48%, #000000 22%, rgba(0, 0, 0, 0.65) 64%, transparent 94%);
  }

  .events-topo-svg {
    position: absolute;
    inset: -3%;
    width: 106%;
    height: 106%;
    display: block;
    animation: eventsTopoBreathe 32s ease-in-out infinite alternate;
  }

  .turret-crystal-core {
    animation: turretCrystalFloat 7s ease-in-out infinite alternate;
  }

  .events-topo-glint {
    stroke: rgba(255, 255, 255, 0.22);
    stroke-width: 1.1;
    stroke-linecap: round;
    stroke-dasharray: 200 1600;
    stroke-dashoffset: 1800;
    animation: eventsGlintTravel 28s linear infinite;
  }

  .events-glint-ring {
    stroke: rgba(255, 255, 255, 0.2);
    stroke-dasharray: 140 1100;
    stroke-dashoffset: 1240;
    animation: eventsRingGlint 22s linear infinite;
  }

  @keyframes eventsTopoBreathe {
    0% {
      transform: translate3d(0, 0, 0) scale(1);
    }
    100% {
      transform: translate3d(-1%, 0.8%, 0) scale(1.025);
    }
  }

  @keyframes turretCrystalFloat {
    0% {
      transform: translateY(0);
    }
    100% {
      transform: translateY(-7px);
    }
  }

  @keyframes eventsGlintTravel {
    0% {
      stroke-dashoffset: 1800;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @keyframes eventsRingGlint {
    0% {
      stroke-dashoffset: 1240;
    }
    100% {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events-topo-svg,
    .turret-crystal-core,
    .events-topo-glint {
      animation: none !important;
    }
  }

  .events-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 350px), 1fr));
    gap: var(--space-lg);
  }

  /* Event Bento Card (Matching Ökosystem container) */
  .event-bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-md);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.5);
    transition: border-color var(--transition-fast), transform var(--transition-smooth);
    min-width: 0;
  }

  .event-bento-card:hover {
    background: #121216;
    border-color: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .event-bento-card.is-highlighted {
    border-color: rgba(255, 255, 255, 0.35);
    box-shadow: 0 12px 32px rgba(255, 255, 255, 0.08);
  }

  .event-meta-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .event-date-cluster {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
  }

  .event-date-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-xs);
    padding: 3px 10px;
    font-size: 0.75rem;
    font-weight: 700;
    height: 22px;
    box-sizing: border-box;
  }

  .event-day-val {
    color: #ffffff;
    font-weight: 800;
  }

  .event-sep {
    color: rgba(255, 255, 255, 0.25);
  }

  .event-time-val {
    color: var(--text-secondary);
  }

  .event-meta-strip :global(.match-status-badge),
  .type-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.625rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    line-height: 1;
    height: 22px;
    box-sizing: border-box;
  }

  .match-badge {
    color: #60a5fa;
    background: rgba(59, 130, 246, 0.14);
    border: 1px solid rgba(59, 130, 246, 0.32);
  }

  .community-badge {
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .event-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .event-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: #ffffff;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  .event-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .event-footer {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: auto;
    padding-top: var(--space-xs);
  }

  .event-footer .btn {
    padding: 0.45rem 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  .event-action-btn {
    flex: 1 1 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  .event-ics-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
  }

  @media (max-width: 480px) {
    .event-bento-card {
      padding: var(--space-lg);
    }

    .event-footer {
      flex-direction: column;
      align-items: stretch;
    }

    .event-footer .btn {
      width: 100%;
      justify-content: center;
    }
  }

  /* Empty State */
  .empty-events {
    background: #0d0d10;
    border: 1px dashed rgba(255, 255, 255, 0.15);
    border-radius: var(--radius-md);
    padding: var(--space-3xl);
    text-align: center;
  }


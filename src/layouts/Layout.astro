---
// src/layouts/Layout.astro
import '../styles/global.css';
import fontJakarta800 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-800-normal.woff2?url';
import fontJakarta400 from '@fontsource/plus-jakarta-sans/files/plus-jakarta-sans-latin-400-normal.woff2?url';
import fontSpace700 from '@fontsource/space-grotesk/files/space-grotesk-latin-700-normal.woff2?url';
import Navbar from '../components/common/Navbar.astro';
import Footer from '../components/common/Footer.astro';
import DockedTicker from '../components/common/DockedTicker.astro';
import rawTeams from '../../data/teams.json';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  ogType?: 'website' | 'profile' | 'article';
  canonical?: string;
}

const siteUrl = "https://ultrainstinctcrew.com";
const basePath = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');

// Normalize pathname: strip staging basePath (e.g. /WEBSITE_BETA) and ensure trailing slash for directories
const rawPathname = Astro.url.pathname;
const strippedPath =
  basePath && rawPathname.startsWith(basePath)
    ? rawPathname.slice(basePath.length) || '/'
    : rawPathname || '/';
const normalizedPath =
  strippedPath === '/'
    ? '/'
    : /\.[a-z0-9]+$/i.test(strippedPath)
      ? strippedPath
      : `${strippedPath.replace(/\/+$/, '')}/`;

// Canonical URL and social og:url ALWAYS point to the canonical production domain
const defaultCanonical = `${siteUrl}${normalizedPath}`;

const {
  title = "Ultra Instinct Crew | League of Legends eSport Organisation & Community",
  description = "Ultra Instinct Crew (UIC) ist eine deutsche League of Legends eSport Organisation in der Prime League mit aktiven Teams, Live-Übertragungen und einer engagierten Gaming-Community.",
  image = "/og-image.png",
  imageAlt = "Ultra Instinct Crew: Deutsche League of Legends eSport Organisation in der Prime League",
  imageWidth,
  imageHeight,
  ogType = "website",
  canonical = defaultCanonical
} = Astro.props;

const isDefaultOg = image === "/og-image.png";
const resolvedImageWidth = imageWidth ?? (isDefaultOg ? 1200 : undefined);
const resolvedImageHeight = imageHeight ?? (isDefaultOg ? 630 : undefined);

const fullImageUrl = image.startsWith('http')
  ? image
  : `${siteUrl}${image.startsWith('/') ? image : `/${image}`}`;

const imageExt = fullImageUrl.split('?')[0].split('.').pop()?.toLowerCase();
const imageMimeType =
  imageExt === 'webp'
    ? 'image/webp'
    : imageExt === 'jpg' || imageExt === 'jpeg'
      ? 'image/jpeg'
      : 'image/png';

const swUrl = `${basePath}/service-worker.js`;

// Build rich Schema.org @graph (WebSite + SportsOrganization with all active Prime League Teams + BreadcrumbList)
const teamsMap = (rawTeams || {}) as Record<string, any>;
const subTeamsSchema = Object.entries(teamsMap)
  .filter(([, meta]) => Boolean(meta?.primeLeagueId && String(meta.primeLeagueId).trim() !== ''))
  .map(([key, meta]) => ({
    "@type": "SportsTeam",
    "@id": `${siteUrl}/#team-${key}`,
    "name": meta.teamDisplay || `UIC ${key.toUpperCase()}`,
    "sport": "League of Legends",
    "memberOf": {
      "@type": "SportsOrganization",
      "name": `Prime League (${meta.tier || 'Division'})`
    },
    "parentOrganization": { "@id": `${siteUrl}/#organization` }
  }));

const breadcrumbLabelMap: Record<string, string> = {
  ruhmeshalle: 'Ruhmeshalle',
  brandkit: 'Brandkit & Markenrichtlinien',
  obs: 'OBS Spieltags-Overlay',
  impressum: 'Impressum',
  datenschutzbestimmungen: 'Datenschutzbestimmungen'
};

const pathSegments = normalizedPath.split('/').filter(Boolean);
const breadcrumbItems = [
  {
    "@type": "ListItem",
    "position": 1,
    "name": "Startseite",
    "item": `${siteUrl}/`
  },
  ...pathSegments.map((seg, idx) => {
    const accPath = `/${pathSegments.slice(0, idx + 1).join('/')}/`;
    const isLast = idx === pathSegments.length - 1;
    const cleanTitle = title.split('|')[0].split('–')[0].trim();
    const label = breadcrumbLabelMap[seg.toLowerCase()] || (isLast && cleanTitle ? cleanTitle : seg.toUpperCase());
    return {
      "@type": "ListItem",
      "position": idx + 2,
      "name": label,
      "item": `${siteUrl}${accPath}`
    };
  })
];

const schemaGraph: Record<string, any>[] = [
  {
    "@type": "WebSite",
    "@id": `${siteUrl}/#website`,
    "url": `${siteUrl}/`,
    "name": "Ultra Instinct Crew",
    "alternateName": ["UIC", "UIC eSports", "Ultra Instinct Crew LoL"],
    "description": description,
    "inLanguage": "de-DE",
    "publisher": { "@id": `${siteUrl}/#organization` }
  },
  {
    "@type": "SportsOrganization",
    "@id": `${siteUrl}/#organization`,
    "name": "Ultra Instinct Crew",
    "alternateName": "UIC",
    "url": `${siteUrl}/`,
    "logo": {
      "@type": "ImageObject",
      "url": `${siteUrl}/android-chrome-512x512.png`,
      "width": 512,
      "height": 512
    },
    "image": `${siteUrl}/og-image.png`,
    "sport": "League of Legends",
    "foundingDate": "2018",
    "description": "Deutsche League of Legends eSport Organisation und Gaming-Community in der Prime League.",
    "sameAs": [
      "https://www.twitch.tv/ultrainstinctcrew",
      "https://www.instagram.com/ultrainstinctcrew",
      "https://x.com/uic_gaming",
      "https://www.youtube.com/@UltraInstinctCrew",
      "https://discord.gg/ultrainstinctcrew"
    ],
    "memberOf": {
      "@type": "SportsOrganization",
      "name": "Prime League"
    },
    "subOrganization": subTeamsSchema
  }
];

if (pathSegments.length > 0) {
  schemaGraph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical}#breadcrumb`,
    "itemListElement": breadcrumbItems
  });
}

const schemaJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": schemaGraph
});
---

<!DOCTYPE html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Ultra Instinct Crew" />
    <link rel="canonical" href={canonical} />

    <!-- PWA & Theme -->
    <meta name="theme-color" content="#000000" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="UIC" />
    <link rel="manifest" href="/manifest.json" />

    <!-- Modern Minimalist Favicons (Adaptive Vector SVG + Multi-Size ICO + Apple Touch) -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Preload Critical Above-the-Fold Fonts (LCP / FCP Optimization) -->
    <link rel="preload" href={fontJakarta800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontJakarta400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={fontSpace700} as="font" type="font/woff2" crossorigin />

    <!-- Open Graph / Discord / WhatsApp / Facebook / LinkedIn -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Ultra Instinct Crew" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:image:secure_url" content={fullImageUrl} />
    <meta property="og:image:type" content={imageMimeType} />
    {resolvedImageWidth && <meta property="og:image:width" content={String(resolvedImageWidth)} />}
    {resolvedImageHeight && <meta property="og:image:height" content={String(resolvedImageHeight)} />}
    <meta property="og:image:alt" content={imageAlt} />

    <!-- X / Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@uic_gaming" />
    <meta name="twitter:url" content={canonical} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <!-- Schema.org Rich Graph: WebSite + SportsOrganization (with 14 Prime League Teams) + BreadcrumbList -->
    <script type="application/ld+json" set:html={schemaJsonLd} />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Zum Inhalt springen</a>
    
    <Navbar />
    
    <main id="main-content">
      <slot />
    </main>

    <Footer />
    
    <DockedTicker />

    <style is:global>
      .skip-link {
        position: absolute;
        top: -100px;
        left: var(--space-md);
        background: var(--text-white);
        color: var(--bg-void);
        padding: var(--space-xs) var(--space-md);
        border-radius: var(--radius-sm);
        font-weight: 700;
        z-index: 9999;
        transition: top var(--transition-fast);
      }
      .skip-link:focus {
        top: var(--space-md);
      }
    </style>
    <script is:inline define:vars={{ swUrl }}>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register(swUrl).catch(() => {});
        });
      }

      // 1. Cursor-Tracked Specular Border Light (Proximity Illumination)
      (() => {
        const SPOT_SELECTOR = '.bento-card, .player-card, .matchup-bento-card, .event-bento-card, .asset-card, .brandkit-card, .team-fixture-card';
        let rafId = 0;
        let lastX = 0;
        let lastY = 0;

        window.addEventListener('pointermove', (e) => {
          lastX = e.clientX;
          lastY = e.clientY;
          if (rafId) return;
          rafId = requestAnimationFrame(() => {
            rafId = 0;
            const cards = document.querySelectorAll(SPOT_SELECTOR);
            for (let i = 0; i < cards.length; i++) {
              const card = cards[i];
              if (card.offsetParent === null) continue;
              const rect = card.getBoundingClientRect();
              if (rect.bottom < -120 || rect.top > window.innerHeight + 120) continue;
              const x = lastX - rect.left;
              const y = lastY - rect.top;
              card.style.setProperty('--spot-x', `${x}px`);
              card.style.setProperty('--spot-y', `${y}px`);
              card.style.setProperty('--spot-opacity', '1');
            }
          });
        }, { passive: true });
      })();

      // 2. Shared Client-Side .ICS Calendar Generator for Matches & Events
      window.downloadUicIcs = ({ title, description, location, beginISO }) => {
        if (!beginISO) return;
        const start = new Date(beginISO);
        if (isNaN(start.getTime())) return;
        const end = new Date(start.getTime() + 2 * 60 * 60 * 1000);
        const fmt = (d) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
        const clean = (str) => String(str || '').replace(/\r?\n/g, '\\n').replace(/,/g, '\\,');
        const icsLines = [
          'BEGIN:VCALENDAR',
          'VERSION:2.0',
          'PRODID:-//Ultra Instinct Crew//UIC Match Calendar//DE',
          'CALSCALE:GREGORIAN',
          'METHOD:PUBLISH',
          'BEGIN:VEVENT',
          `UID:uic-${start.getTime()}@ultrainstinctcrew.com`,
          `DTSTAMP:${fmt(new Date())}`,
          `DTSTART:${fmt(start)}`,
          `DTEND:${fmt(end)}`,
          `SUMMARY:${clean(title)}`,
          `DESCRIPTION:${clean(description)}`,
          location ? `URL:${clean(location)}` : '',
          location ? `LOCATION:${clean(location)}` : '',
          'END:VEVENT',
          'END:VCALENDAR'
        ].filter(Boolean).join('\r\n');

        const blob = new Blob([icsLines], { type: 'text/calendar;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${String(title || 'uic-termin').toLowerCase().replace(/[^a-z0-9]+/g, '-')}.ics`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
      };
    </script>
  </body>
</html>

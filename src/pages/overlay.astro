        if (pauseMatchTime) pauseMatchTime.textContent = state.matchTimeStr;
        var pauseRecordVal = document.getElementById("pause-record-val");
        if (pauseRecordVal) pauseRecordVal.textContent = state.wins + "S \u2013 " + state.losses + "N";
        var pauseFormPills = document.getElementById("pause-form-pills");
        if (pauseFormPills) pauseFormPills.innerHTML = buildFormBadgesHtml(state.formArr);

        var pauseStarters = document.getElementById("pause-starters-list");
        if (pauseStarters) {
          var psHtml = "";
          for (var i = 0; i < state.starters.length; i++) {
            var sp = state.starters[i];
            psHtml += '<div class="ps-starter-row">' +
              '<span class="ps-st-role text-mono"><img src="' + sp.roleIconSrc + '" alt="">' + esc(sp.role) + '</span>' +
              '<span class="ps-st-name">' + esc(sp.name) + '</span>' +
              '<span class="ps-st-rank text-mono">' + esc(sp.tier) + '</span>' +
            '</div>';
          }
          pauseStarters.innerHTML = psHtml;
        }

        var pauseSeasonLbl = document.getElementById("pause-season-label");
        if (pauseSeasonLbl) pauseSeasonLbl.textContent = state.seasonLabel || "PRIME LEAGUE";

        var pauseSched = document.getElementById("pause-schedule-list");
        if (pauseSched) {
          var scRows = state.schedule;
          if (scRows.length > 4) {
            var nIdx = Math.max(0, scRows.indexOf(state.nextMatch));
            var sStart = Math.max(0, Math.min(nIdx - 1, scRows.length - 4));
            scRows = scRows.slice(sStart, sStart + 4);
          }
          var scHtml = "";
          for (var r = 0; r < scRows.length; r++) {
            var sm = scRows[r];
            var enemy = sm.enemy_team || {};
            var isNext = state.nextMatch && sm === state.nextMatch;
            var rightTxt = sm.result ? sm.result : formatSlotDate(sm.begin);
            scHtml += '<div class="ps-sched-row' + (isNext ? ' is-next' : '') + '">' +
              '<span class="ps-sch-day text-mono">T' + esc(sm.match_day || "\u2013") + '</span>' +
              '<span class="ps-sch-enemy">' + esc(enemy.name || "Gegner") + '</span>' +
              '<span class="ps-sch-res text-mono">' + esc(rightTxt) + '</span>' +
            '</div>';
          }
          pauseSched.innerHTML = scHtml;
        }
      }

      // 8d. Scene 4: Ending Renderer
      function renderEndingScene(state) {
        var endSub = document.getElementById("ending-team-sub");
        if (endSub) {
          var parts = [state.displayName.toUpperCase()];
          if (state.tierUpper) parts.push(state.tierUpper);
          if (state.seasonLabel) parts.push(state.seasonLabel);
          endSub.textContent = parts.join(" \u2022 ");
        }

        var endLogo = document.getElementById("ending-uic-logo");
        if (endLogo) endLogo.src = state.uicLogo;
        var endName = document.getElementById("ending-uic-name");
        if (endName) endName.textContent = state.displayName;
        var endDiv = document.getElementById("ending-uic-div");
        if (endDiv) endDiv.textContent = "PRIME LEAGUE" + (state.tierUpper ? " \u2022 " + state.tierUpper : "");

        var endRec = document.getElementById("ending-record-val");
        if (endRec) endRec.textContent = state.wins + "S \u2013 " + state.losses + "N";
        var endForm = document.getElementById("ending-form-pills");
        if (endForm) endForm.innerHTML = buildFormBadgesHtml(state.formArr);

        var endSeason = document.getElementById("ending-season-label");
        if (endSeason) endSeason.textContent = state.seasonLabel || "PRIME LEAGUE";

        var endSched = document.getElementById("ending-schedule-list");
        if (endSched) {
          var eRows = state.schedule;
          if (eRows.length > 5) {
            var nIdx = Math.max(0, eRows.indexOf(state.nextMatch));
            var sStart = Math.max(0, Math.min(nIdx - 2, eRows.length - 5));
            eRows = eRows.slice(sStart, sStart + 5);
          }
          var eHtml = "";
          for (var r = 0; r < eRows.length; r++) {
            var sm = eRows[r];
            var enemy = sm.enemy_team || {};
            var isNext = state.nextMatch && sm === state.nextMatch;
            var resCell = '<span class="res-pending">OFFEN</span>';
            if (sm.result && /^\d+:\d+$/.test(sm.result)) {
              var sc = sm.result.split(":").map(Number);
              var cls = sc[0] > sc[1] ? "win" : (sc[0] < sc[1] ? "loss" : "draw");
              resCell = '<span class="res-chip ' + cls + '">' + sc[0] + ' : ' + sc[1] + '</span>';
            } else if (isNext) {
              resCell = '<span class="pg-status-chip">N\u00c4CHSTES</span>';
            }
            eHtml += '<div class="et-sched-row' + (isNext ? ' is-next' : '') + '">' +
              '<span class="et-sch-day text-mono">TAG ' + esc(sm.match_day || "\u2013") + '</span>' +
              '<div class="et-sch-opp">' +
                '<img src="' + esc(enemy.logo_url || state.fallbackLogo) + '" alt="" class="et-sch-logo" onerror="this.src=\'' + state.fallbackLogo + '\';">' +
                '<span class="et-sch-name">' + esc(enemy.name || "Gegner") + '</span>' +
              '</div>' +
              '<span class="et-sch-time text-mono">' + esc(formatSlotDate(sm.begin)) + '</span>' +
              '<div class="et-sch-res text-mono">' + resCell + '</div>' +
            '</div>';
          }
          endSched.innerHTML = eHtml;
        }
      }

      // 8d-bis. Scene 4: Replay Renderer
      function renderReplayScene(state) {
        var rpKicker = document.getElementById("replay-meta-kicker");
        if (rpKicker) {
          var kParts = [state.displayName.toUpperCase()];
          if (state.matchDayNum) kParts.push("SPIELTAG " + state.matchDayNum);
          else kParts.push("WIEDERHOLUNG");
          rpKicker.textContent = kParts.join(" \u2022 ");
        }

        var rpPipLabel = document.getElementById("replay-pip-matchup");
        if (rpPipLabel) rpPipLabel.textContent = state.displayName.toUpperCase() + " VS " + state.enemyName.toUpperCase();
      }

      // 8e. Orchestrator: Set Active Team & Update All Scenes
      function setActiveTeam(teamKey) {
        if (!teamKey || isNoTeamMode) return;
        activeTeamKey = teamKey.toLowerCase();
        teamAutoResolved = true;

        var state = computeTeamState(activeTeamKey);
        renderStartingScene(state);
        renderPregameScene(state);
        renderPauseScene(state);
        renderReplayScene(state);
        renderEndingScene(state);
      }

      // 8f. Classic No-Team Organization Mode (?team=none)
      function applyClassicNoTeamScene() {
        var startBadge = document.getElementById("start-badge-pill");
        if (startBadge) startBadge.textContent = "ULTRA INSTINCT CREW";
        var startSub = document.getElementById("start-stage-subtitle");
        if (startSub) startSub.textContent = "ESPORT & COMMUNITY STREAM";

        var ncTeam = document.getElementById("pregame-nocam-team");
        if (ncTeam) ncTeam.textContent = "ULTRA INSTINCT CREW";
        var ncRecord = document.getElementById("pregame-nocam-record");
        if (ncRecord) ncRecord.textContent = "ESPORT & COMMUNITY";
        var ncSched = document.getElementById("pregame-nocam-schedule");
        if (ncSched) {
          var channels = [
            { tag: "WEB", name: "ultrainstinctcrew.com", sub: "TEAMS & INFOS" },
            { tag: "DISCORD", name: "discord.gg/ultrainstinctcrew", sub: "COMMUNITY SERVER" },
            { tag: "SHOP", name: "teams.spized.com/ultrainstinctcrew", sub: "TRIKOTS & MERCH" },
            { tag: "SOCIAL", name: "@uic_gaming", sub: "NEWS & HIGHLIGHTS" }
          ];
          var chHtml = "";
          for (var c = 0; c < channels.length; c++) {
            chHtml += '<div class="pg-sched-row">' +
              '<span class="pg-sch-day text-mono">' + channels[c].tag + '</span>' +
              '<div class="pg-sch-opp"><span class="pg-sch-name">' + channels[c].name + '</span></div>' +
              '<span class="pg-sch-time text-mono">' + channels[c].sub + '</span>' +
              '<div class="pg-sch-res text-mono"><span class="pg-status-chip">OFFIZIELL</span></div>' +
            '</div>';
          }
          ncSched.innerHTML = chHtml;
        }

        var pauseDay = document.getElementById("pause-matchday-badge");
        if (pauseDay) pauseDay.textContent = "LIVE STREAM";
        var pauseTeam = document.getElementById("pause-team-info");
        if (pauseTeam) pauseTeam.textContent = "ULTRA INSTINCT CREW";
        var pauseDiv = document.getElementById("pause-division-info");
        if (pauseDiv) pauseDiv.textContent = "DIE CASTER SIND IN KÜRZE ZURÜCK";

        var rpKicker = document.getElementById("replay-meta-kicker");
        if (rpKicker) rpKicker.textContent = "ULTRA INSTINCT CREW \u2022 WIEDERHOLUNG";
        var rpPipLabel = document.getElementById("replay-pip-matchup");
        if (rpPipLabel) rpPipLabel.textContent = "AKTUELLES SPIEL";

        var endSub = document.getElementById("ending-team-sub");
        if (endSub) endSub.textContent = "ULTRA INSTINCT CREW \u2022 ESPORT & COMMUNITY";
      }

      // 9. Prime League Ticker Engine
      var tickerTrack = document.getElementById("ticker-track");
      var animFrameId = null;
      var scrollPos = 0;
      var lastTimestamp = null;
      var TICKER_SPEED_PX_PER_SEC = 55;
      var lastDataHash = "";
      var fallbackLogo = "/assets/logo/logo.png";

      function startContinuousScroll() {
        if (animFrameId) cancelAnimationFrame(animFrameId);
        scrollPos = 0;
        lastTimestamp = null;

        function step(timestamp) {
          if (!lastTimestamp) lastTimestamp = timestamp;
          var elapsed = (timestamp - lastTimestamp) / 1000;
          lastTimestamp = timestamp;
          if (elapsed > 0.1) elapsed = 0.1;

          if (tickerTrack) {
            scrollPos += TICKER_SPEED_PX_PER_SEC * elapsed;
            var halfWidth = tickerTrack.scrollWidth / 2;
            if (halfWidth > 0 && scrollPos >= halfWidth) {
              scrollPos -= halfWidth;
            }
            tickerTrack.style.transform = "translateX(-" + scrollPos.toFixed(2) + "px)";
          }
          animFrameId = requestAnimationFrame(step);
        }

        animFrameId = requestAnimationFrame(step);
      }

      function processPrimeData(data) {
        if (!data) return;
        primeStatsData = data;

        var upcomingMatches = [];
        var recentMatches = [];
        var now = new Date();
        var cutoffTime = new Date(now.getTime() - (6 * 3600 * 1000));

        for (var teamKey in data) {
          if (!data.hasOwnProperty(teamKey)) continue;
          if (teamKey.toLowerCase() === "community") continue;

          var teamData = data[teamKey];
          if (!teamData || !teamData.matches || !Array.isArray(teamData.matches)) continue;

          var teamDisplayName = teamData.teamDisplay || ("UIC " + teamKey.toUpperCase());
          var uicLogoStr = (teamData.api_meta && teamData.api_meta.logo_url) ? teamData.api_meta.logo_url : fallbackLogo;

          for (var mIdx = 0; mIdx < teamData.matches.length; mIdx++) {
            var m = teamData.matches[mIdx];
            var enemyLogoStr = (m.enemy_team && m.enemy_team.logo_url) ? m.enemy_team.logo_url : fallbackLogo;
            var enemyNameStr = m.enemy_team ? (m.enemy_team.name || m.enemy_team.team_tag || "Gegner") : "Gegner";
            var mDate = m.begin ? new Date(m.begin) : null;

            var matchItem = {
              id: m.id || m.match_id,
              teamKey: teamKey,
              startsAt: m.begin,
              confirmed: m.confirmed === true,
              result: m.result || null,
              uicTeamName: teamDisplayName,
              uicLogo: uicLogoStr,
              opponentLogo: enemyLogoStr,
              opponentName: enemyNameStr
            };

            if (!m.result) {
              if (!mDate || mDate >= cutoffTime) {
                upcomingMatches.push(matchItem);
              }
            } else {
              recentMatches.push(matchItem);
            }
          }
        }

        upcomingMatches.sort(function(a, b) {
          if (!a.startsAt) return 1;
          if (!b.startsAt) return -1;
          return new Date(a.startsAt) - new Date(b.startsAt);
        });

        recentMatches.sort(function(a, b) {
          if (!a.startsAt) return 1;
          if (!b.startsAt) return -1;
          return new Date(b.startsAt) - new Date(a.startsAt);
        });

        // Without explicit ?team= parameter, automatically select the team with the chronologically next upcoming match
        if (!isNoTeamMode) {
          if (!hasExplicitTeam && !teamAutoResolved && upcomingMatches.length > 0) {
            activeTeamKey = upcomingMatches[0].teamKey;
          }

          setActiveTeam(activeTeamKey);

          // ?start=auto -> set countdown target to the next match start of the active team
          if (wantsAutoStart && !autoStartResolved) {
            var activeState = computeTeamState(activeTeamKey);
            if (activeState.nextMatch && activeState.nextMatch.begin) {
              var autoTarget = new Date(activeState.nextMatch.begin).getTime();
              if (!isNaN(autoTarget)) {
                targetMs = autoTarget;
                autoStartResolved = true;
                updateCountdown();
              }
            }
          }
        }

        if (!tickerTrack || hideTicker) return;

        var dataHash = JSON.stringify(upcomingMatches);
        if (dataHash === lastDataHash && tickerTrack.children.length > 1) {
          return;
        }
        lastDataHash = dataHash;

        var displayList = upcomingMatches.slice(0, 20);
        if (displayList.length < 5) {
          displayList = displayList.concat(recentMatches.slice(0, 6));
        }

        if (displayList.length === 0) {
          tickerTrack.innerHTML = '<div class="match-item"><span class="m-time-badge">SPIELPLAN</span><span>Keine offenen Spieltermine hinterlegt</span></div>';
          return;
        }

        var singleSetHTML = "";
        for (var i = 0; i < displayList.length; i++) {
          var cur = displayList[i];
          var time = formatRelativeTime(cur.startsAt);
          var timeBadgeClass = "m-time-badge";
          if (time.isToday) timeBadgeClass += " heute";
          else if (time.isTomorrow) timeBadgeClass += " morgen";

          var statusBadgeClass = cur.confirmed ? "match-status-badge is-confirmed" : "match-status-badge is-unconfirmed";
          var statusLabel = cur.confirmed ? "BEST\u00c4TIGT" : "OFFEN";

          if (cur.result) {
            statusBadgeClass = "match-status-badge is-result";
            statusLabel = cur.result;
          }

          singleSetHTML += '<div class="match-item">' +
            '<span class="' + timeBadgeClass + '">' + esc(time.label) + '</span>' +
            '<span class="' + statusBadgeClass + '">' + esc(statusLabel) + '</span>' +
            '<div class="m-team">' +
              '<img class="m-logo" width="18" height="18" src="' + esc(cur.uicLogo) + '" alt="' + esc(cur.uicTeamName) + '" onerror="this.src=\'' + fallbackLogo + '\';">' +
              '<span class="m-name">' + esc(cur.uicTeamName) + '</span>' +
            '</div>' +
            '<span class="m-vs">VS</span>' +
            '<div class="m-team">' +
              '<span class="m-name">' + esc(cur.opponentName) + '</span>' +
              '<img class="m-logo" width="18" height="18" src="' + esc(cur.opponentLogo) + '" alt="' + esc(cur.opponentName) + '" onerror="this.src=\'' + fallbackLogo + '\';">' +
            '</div>' +
          '</div>';
        }

        tickerTrack.innerHTML = singleSetHTML + singleSetHTML;
        startContinuousScroll();
      }

      function loadTickerData() {
        var basePath = window.location.pathname.replace(/\/(overlay|obs).*$/, '');
        var statsUrl = (basePath || '') + "/data/prime_stats.json";
        fetch(statsUrl)
          .then(function(res) {
            if (!res.ok) throw new Error("HTTP " + res.status);
            return res.json();
          })
          .then(function(data) {
            processPrimeData(data);
          })
          .catch(function(err) {
            console.warn("Ticker background sync note:", err);
          });
      }

      // 10. Starting Soon Multi-View Rotator (Controlled via ?start_view= parameter)
      var startViews = ["matchup", "table", "roster", "stats"];
      var activeStartView = "matchup";
      var isAutoRotate = true;
      var ROTATE_DURATION_MS = 10000;
      var rotateStartTime = Date.now();
      var rotateProgressBar = document.getElementById("rotate-timer-bar");
      var autoRotatePill = document.getElementById("auto-rotate-pill");

      var subTitles = {
        "matchup": "BEGEGNUNG & MATCHUP",
        "table": "SPIELPLAN & ERGEBNISSE",
        "roster": "AUFSTELLUNG & 5 STARTER",
        "stats": "TEAM STATISTIKEN"
      };

      function setStartingView(viewName) {
        if (!startViews.includes(viewName)) viewName = "matchup";
        activeStartView = viewName;

        var subEl = document.getElementById("start-stage-subtitle");
        if (subEl) {
          subEl.classList.add("sub-switching");
          setTimeout(function() {
            subEl.textContent = subTitles[viewName] || "MATCHUP";
            subEl.classList.remove("sub-switching");
          }, 150);
        }

        for (var vi = 0; vi < startViews.length; vi++) {
          var v = startViews[vi];
          var btn = document.getElementById("tab-btn-" + v);
          var panel = document.getElementById("view-" + v);
          if (btn) {
            if (v === viewName) btn.classList.add("is-active");
            else btn.classList.remove("is-active");
          }
          if (panel) {
            if (v === viewName) panel.classList.add("is-active");
            else panel.classList.remove("is-active");
          }
        }

        rotateStartTime = Date.now();
      }

      var initialStartView = (params.get("start_view") || "").toLowerCase();
      if (isNoTeamMode) {
        isAutoRotate = false;
        if (autoRotatePill) autoRotatePill.style.display = "none";
      } else if (initialStartView && startViews.includes(initialStartView)) {
        isAutoRotate = false;
        setStartingView(initialStartView);
        if (autoRotatePill) autoRotatePill.style.display = "none";
      }

      setInterval(function() {
        if (!isAutoRotate) return;
        var elapsed = Date.now() - rotateStartTime;
        var pct = Math.min(100, (elapsed / ROTATE_DURATION_MS) * 100);
        if (rotateProgressBar) rotateProgressBar.style.width = pct + "%";

        if (elapsed >= ROTATE_DURATION_MS) {
          var curIdx = startViews.indexOf(activeStartView);
          var nextIdx = (curIdx + 1) % startViews.length;
          setStartingView(startViews[nextIdx]);
        }
      }, 100);

      if (isNoTeamMode) {
        applyClassicNoTeamScene();
        if (!hideTicker) {
          if (embeddedData && embeddedData.primeStats) {
            processPrimeData(embeddedData.primeStats);
          } else {
            loadTickerData();
          }
          setInterval(loadTickerData, 120000);
        }
      } else {
        if (embeddedData && embeddedData.primeStats) {
          processPrimeData(embeddedData.primeStats);
        } else {
          loadTickerData();
        }
        setInterval(loadTickerData, 120000);
      }
    })();
  </script>
</body>
</html>

<style is:global>
  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html, body {
    width: 1920px;
    height: 1080px;
    margin: 0;
    padding: 0;
    overflow: hidden;
    background-color: transparent;
    color: var(--text-primary);
    font-family: var(--font-body);
    user-select: none;
    -webkit-font-smoothing: antialiased;
  }

  .text-mono { font-family: var(--font-mono); }

  .broadcast-stage {
    position: absolute;
    inset: 0;
    width: 1920px;
    height: 1080px;
    display: none;
    z-index: 10;
  }

  body.scene-starting #stage-starting,
  body.scene-pregame #stage-pregame,
  body.scene-pause #stage-pause,
  body.scene-replay #stage-replay,
  body.scene-ending #stage-ending {
    display: block;
  }

  /* Streamlabs Alert Box Overlay Layer */
  .streamlabs-alert-layer {
    display: none;
    position: fixed;
    top: 64px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 320px;
    pointer-events: none;
    z-index: 60;
    overflow: hidden;
  }

  .streamlabs-alert-layer.is-active {
    display: block;
  }

  .alert-widget-iframe {
    width: 100%;
    height: 100%;
    border: none;
    background: transparent;
    pointer-events: none;
  }
</style>

---
// src/pages/overlay.astro
import '../styles/tokens.css';
import '@fontsource/plus-jakarta-sans/latin-400.css';
import '@fontsource/plus-jakarta-sans/latin-600.css';
import '@fontsource/plus-jakarta-sans/latin-700.css';
import '@fontsource/plus-jakarta-sans/latin-800.css';
import '@fontsource/space-grotesk/latin-500.css';
import '@fontsource/space-grotesk/latin-700.css';
import '@fontsource/orbitron/latin-500.css';
import '@fontsource/orbitron/latin-700.css';
import '@fontsource/orbitron/latin-800.css';
import '@fontsource/orbitron/latin-900.css';

import rawData from '../../data/data.json';
import rawTeams from '../../data/teams.json';
import rawPlayerState from '../../data/player_state.json';
import rawPrimeStats from '../../data/prime_stats.json';

const teamsMeta = (rawTeams || {}) as Record<string, any>;
const primeMeta = (rawPrimeStats || {}) as Record<string, any>;
const playerTelemetry = (rawPlayerState || {}) as Record<string, any>;
const profileAssetMap = import.meta.glob('/public/assets/profile/*.{webp,png}');

const enrichedTeams: Record<string, any> = {};

for (const [key, meta] of Object.entries(teamsMeta)) {
  if (key.toLowerCase() === 'community') continue;
  const players = ((rawData as any)[key] || []) as any[];
  const metaRoster = (meta.roster || []) as any[];

  const enrichedPlayers = players.map(p => {
    const mp = metaRoster.find(m => m.playerId === p.playerId || (m.gameName && m.gameName.toLowerCase() === p.name.toLowerCase()));
    const puuid = mp?.puuid;
    const pState = puuid ? playerTelemetry[puuid] : null;
    const avg = pState?.averages || {};
    const pid = p.playerId || "unknown";
    const hasCustomWebp = `/public/assets/profile/${pid}.webp` in profileAssetMap;
    const hasCustomPng = `/public/assets/profile/${pid}.png` in profileAssetMap;
    const photoSrc = hasCustomWebp
      ? `/assets/profile/${pid}.webp`
      : hasCustomPng
        ? `/assets/profile/${pid}.png`
        : '/assets/profile/profile_placeholder.webp';

    return {
      playerId: pid,
      name: p.name || "Unbekannt",
      tagLine: mp?.tagLine || "",
      role: p.role || mp?.role || "SUB",
      tier: p.tier || "UNRANKED",
      lp: p.lp || 0,
      wins: p.wins || 0,
      losses: p.losses || 0,
      winRate: p.winRate || 0,
      icon: p.icon || "/assets/profile/placeholder.webp",
      photoSrc,
      isCaptain: !!mp?.isCaptain,
      isSubstitute: mp?.rosterStatus === "substitute" || p.role === "SUB",
      kda: Number.isFinite(avg.kda) ? Number(avg.kda.toFixed(1)) : null,
      dpm: Number.isFinite(avg.dpm) ? Math.round(avg.dpm) : null,
      csm: Number.isFinite(avg.csm) ? Number(avg.csm.toFixed(1)) : null,
      kp: Number.isFinite(avg.kp) ? Math.round(avg.kp) : null,
      gd15: Number.isFinite(avg.gd15) ? Math.round(avg.gd15) : null,
      games: Array.isArray(pState?.processedMatches) ? pState.processedMatches.length : 0
    };
  });

  const avgOf = (field: string) => {
    const vals = enrichedPlayers
      .filter(pl => !pl.isSubstitute && (pl as any)[field] !== null && (pl as any)[field] !== undefined)
      .map(pl => (pl as any)[field] as number);
    return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
  };
  const teamStats = {
    kda: avgOf('kda'),
    dpm: avgOf('dpm'),
    csm: avgOf('csm'),
    kp: avgOf('kp'),
    gd15: avgOf('gd15'),
    players: enrichedPlayers.filter(pl => !pl.isSubstitute && pl.kda !== null).length
  };

  enrichedTeams[key] = {
    key,
    displayName: meta.teamDisplay || ("UIC " + key.toUpperCase()),
    tier: meta.tier || "Prime League",
    logoSrc: meta.logoUrl || ("/assets/teams/" + key + ".webp"),
    players: enrichedPlayers,
    stats: teamStats
  };
}

const cleanPrimeStats: Record<string, any> = {};
for (const [key, pTeam] of Object.entries(primeMeta as Record<string, any>)) {
  if (!pTeam || key.toLowerCase() === 'community') continue;
  cleanPrimeStats[key] = {
    teamDisplay: pTeam.teamDisplay,
    tier: pTeam.tier,
    api_meta: pTeam.api_meta ? { logo_url: pTeam.api_meta.logo_url, name: pTeam.api_meta.name, team_tag: pTeam.api_meta.team_tag } : null,
    matches: (pTeam.matches || []).map((m: any) => ({
      id: m.id || m.match_id,
      match_day: m.match_day,
      begin: m.begin,
      confirmed: !!m.confirmed,
      result: m.result || null,
      enemy_team: m.enemy_team ? {
        name: m.enemy_team.name || m.enemy_team.team_tag || "Gegner",
        team_tag: m.enemy_team.team_tag || "OPP",
        logo_url: m.enemy_team.logo_url || "/assets/logo/logo.png"
      } : null
    }))
  };
}

import EsportsBackground from '../components/overlay/EsportsBackground.astro';
import OverlayTicker from '../components/overlay/OverlayTicker.astro';
import StartingScene from '../components/overlay/StartingScene.astro';
import PregameScene from '../components/overlay/PregameScene.astro';
import PauseScene from '../components/overlay/PauseScene.astro';
import ReplayScene from '../components/overlay/ReplayScene.astro';
import EndingScene from '../components/overlay/EndingScene.astro';
---

<!doctype html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>UIC OBS Broadcast Overlay</title>
</head>

<body class="scene-pregame layout-cam-2">

  <script id="uic-embedded-data" type="application/json" set:html={JSON.stringify({ enriched: enrichedTeams, primeStats: cleanPrimeStats })}></script>

  <EsportsBackground />
  <OverlayTicker />
  <StartingScene />
  <PregameScene />
  <PauseScene />
  <ReplayScene />
  <EndingScene />

  <!-- Global Streamlabs Alert Layer (Active when ?alert_url= is configured) -->
  <div id="streamlabs-alert-layer" class="streamlabs-alert-layer" aria-hidden="true">
    <iframe
      id="alert-widget-iframe"
      class="alert-widget-iframe"
      title="Streamlabs Alert Widget"
      allow="autoplay"
    ></iframe>
  </div>

  <script is:inline>
    (function() {
      var embeddedRaw = document.getElementById("uic-embedded-data");
      var embeddedData = embeddedRaw ? JSON.parse(embeddedRaw.textContent || "{}") : {};
      var enrichedTeamsMap = embeddedData.enriched || {};

      // URL Parameters
      var params = new URLSearchParams(window.location.search);
      var currentScene = (params.get("scene") || "pregame").toLowerCase();
      var currentLayout = (params.get("layout") || "cam-2").toLowerCase();
      var rawTickerParam = params.get("ticker");
      var tickerPos = (rawTickerParam || "top").toLowerCase();
      var chatParam = params.get("chat");
      var rawChatUrl = params.get("chat_url") || "";
      var rawAlertUrl = params.get("alert_url") || "";
      var rawTeamParam = (params.get("team") || "").trim().toLowerCase();
      var inlineMatchDay = "";
      if (rawTeamParam.indexOf(":") !== -1) {
        var tParts = rawTeamParam.split(":");
        rawTeamParam = tParts[0].trim();
        inlineMatchDay = (tParts[1] || "").trim();
      }
      var matchDayParam = (params.get("matchday") || params.get("match") || inlineMatchDay || "").trim();
      var isNoTeamMode = (rawTeamParam === "none" || rawTeamParam === "off" || rawTeamParam === "classic");
      var hasExplicitTeam = rawTeamParam !== "" && rawTeamParam !== "auto" && !isNoTeamMode;
      var timerMinutes = parseInt(params.get("timer"), 10) || 5;
      var startParam = params.get("start");

      var activeTeamKey = hasExplicitTeam ? rawTeamParam : "prime";
      var teamAutoResolved = hasExplicitTeam;
      var primeStatsData = null;

      // 1. Apply Scene (1. start, 2. pregame, 3. break, 4. replay, 5. end + legacy aliases)
      function applyScene(sc) {
        currentScene = sc;
        document.body.classList.remove("scene-starting", "scene-pregame", "scene-pause", "scene-replay", "scene-ending");
        if (sc === "start" || sc === "starting") document.body.classList.add("scene-starting");
        else if (sc === "break" || sc === "pause" || sc === "ingame") document.body.classList.add("scene-pause");
        else if (sc === "replay") document.body.classList.add("scene-replay");
        else if (sc === "end" || sc === "ending") document.body.classList.add("scene-ending");
        else document.body.classList.add("scene-pregame");
      }
      applyScene(currentScene);

      // 1b. Apply Classic No-Team Mode (?team=none)
      if (isNoTeamMode) {
        document.body.classList.add("team-none");
      }

      // 1c. Mount Streamlabs Chat & Alert Widgets (if URL parameters or tokens are provided)
      function resolveStreamlabsUrl(raw, widgetType) {
        if (!raw) return "";
        var s = String(raw).trim();
        try {
          if (s.indexOf("%3A") !== -1 || s.indexOf("%3a") !== -1 || s.indexOf("%2F") !== -1 || s.indexOf("%2f") !== -1) {
            s = decodeURIComponent(s).trim();
          }
        } catch (e) {}
        if (/^[A-Fa-f0-9]{24,}$/.test(s)) {
          return widgetType === "alert"
            ? "https://streamlabs.com/alert-box/v3/" + s
            : "https://streamlabs.com/widgets/chat-box/v1/" + s;
        }
        if (/^(www\.)?streamlabs\.com\//i.test(s)) {
          s = "https://" + s;
        }
        try {
          var u = new URL(s);
          if (u.protocol === "https:" || u.protocol === "http:") return u.href;
        } catch (e2) {}
        return "";
      }

      var validChatUrl = resolveStreamlabsUrl(rawChatUrl, "chat");
      var chatWidgetIframe = document.getElementById("chat-widget-iframe");
      var chatChannelTag = document.getElementById("chat-channel-tag");
      if (chatWidgetIframe && validChatUrl) {
        chatWidgetIframe.src = validChatUrl;
        chatWidgetIframe.classList.add("is-loaded");
        if (chatChannelTag) {
          chatChannelTag.textContent = "TWITCH \u2022 VERBUNDEN";
          chatChannelTag.classList.add("is-connected");
        }
      }

      var validAlertUrl = resolveStreamlabsUrl(rawAlertUrl, "alert");
      var alertWidgetIframe = document.getElementById("alert-widget-iframe");
      var alertLayerEl = document.getElementById("streamlabs-alert-layer");
      if (alertWidgetIframe && alertLayerEl && validAlertUrl) {
        alertWidgetIframe.src = validAlertUrl;
        alertLayerEl.classList.add("is-active");
      }

      // 2. Apply Ticker Visibility (in team=none mode, default ticker to off unless ?ticker=top is explicitly set)
      var hideTicker = tickerPos === "off" || (isNoTeamMode && (!rawTickerParam || tickerPos !== "top"));
      if (hideTicker) document.body.classList.add("ticker-off");

      // 3. Apply Chat Visibility
      if (chatParam === "0") document.body.classList.add("chat-off");
      else document.body.classList.remove("chat-off");

      // 4. Apply PreGame Camera Layout & Punch Alpha-Transparent Cutouts in #esports-bg (Pregame Cams + Break Highlight Box)
      function getStageOffsetRect(el) {
        var x = 0, y = 0;
        var w = el.offsetWidth || 0;
        var h = el.offsetHeight || 0;
        var cur = el;
        while (cur && cur !== document.body && cur !== document.documentElement) {
          x += cur.offsetLeft || 0;
          y += cur.offsetTop || 0;
          cur = cur.offsetParent;
        }
        return { x: x, y: y, w: w, h: h };
      }

      function buildRoundedHolePath(x, y, w, h, r) {
        return " M " + (x + r) + " " + y +
          " A " + r + " " + r + " 0 0 0 " + x + " " + (y + r) +
          " V " + (y + h - r) +
          " A " + r + " " + r + " 0 0 0 " + (x + r) + " " + (y + h) +
          " H " + (x + w - r) +
          " A " + r + " " + r + " 0 0 0 " + (x + w) + " " + (y + h - r) +
          " V " + (y + r) +
          " A " + r + " " + r + " 0 0 0 " + (x + w - r) + " " + y +
          " Z";
      }

      function updateCameraCutoutMask() {
        var bgEl = document.getElementById("esports-bg");
        if (!bgEl) return;
        var isPregameCams = document.body.classList.contains("scene-pregame") && !document.body.classList.contains("layout-none");
        var isBreakScene = document.body.classList.contains("scene-pause");
        if (!isPregameCams && !isBreakScene) {
          bgEl.style.clipPath = "";
          bgEl.style.webkitClipPath = "";
          return;
        }
        var pathStr = "M 0 0 H 1920 V 1080 H 0 Z";
        var cutoutIds = isPregameCams ? ["cam-box-1", "cam-box-2"] : ["break-highlight-box"];
        for (var c = 0; c < cutoutIds.length; c++) {
          var box = document.getElementById(cutoutIds[c]);
          if (box && box.style.display !== "none" && box.offsetWidth > 0) {
            var rect = getStageOffsetRect(box);
            pathStr += buildRoundedHolePath(rect.x + 1, rect.y + 1, rect.w - 2, rect.h - 3, 9);
          }
        }
        bgEl.style.clipPath = "path('" + pathStr + "')";
        bgEl.style.webkitClipPath = "path('" + pathStr + "')";
      }

      function applyLayout(ly) {
        currentLayout = ly;
        document.body.classList.remove("layout-cam-2", "layout-cam-1", "layout-none");
        var camsWrap = document.getElementById("pregame-cams-wrapper");
        var cam1 = document.getElementById("cam-box-1");
        var cam2 = document.getElementById("cam-box-2");
        var cam1Lbl = document.getElementById("cam-1-label");

        if (ly === "cam-1") {
          document.body.classList.add("layout-cam-1");
          if (camsWrap) camsWrap.style.display = "flex";
          if (cam1) {
            cam1.style.display = "block";
            cam1.classList.add("is-solo");
          }
          if (cam2) cam2.style.display = "none";
          if (cam1Lbl) cam1Lbl.textContent = "CASTER";
        } else if (ly === "none" || ly === "chat-only") {
          document.body.classList.add("layout-none");
          if (camsWrap) camsWrap.style.display = "none";
        } else {
          document.body.classList.add("layout-cam-2");
          if (camsWrap) camsWrap.style.display = "flex";
          if (cam1) {
            cam1.style.display = "block";
            cam1.classList.remove("is-solo");
          }
          if (cam2) cam2.style.display = "block";
          if (cam1Lbl) cam1Lbl.textContent = "CASTER 1";
        }
        setTimeout(updateCameraCutoutMask, 20);
      }
      applyLayout(currentLayout);
      window.addEventListener("load", updateCameraCutoutMask);

      // 5. Countdown Timer Engine
      var startMinEl = document.getElementById("start-cd-min");
      var startSecEl = document.getElementById("start-cd-sec");
      var pauseTimerEl = document.getElementById("pause-cd-timer");

      function formatNum(n) { return n < 10 ? "0" + n : "" + n; }

      function parseStartTarget(value) {
        if (!value) return null;
        var v = String(value).trim();
        var clock = /^(\d{1,2}):(\d{2})$/.exec(v);
        if (clock) {
          var d = new Date();
          d.setHours(parseInt(clock[1], 10), parseInt(clock[2], 10), 0, 0);
          return d.getTime();
        }
        var parsed = new Date(v).getTime();
        return isNaN(parsed) ? null : parsed;
      }

      var wantsAutoStart = startParam && startParam.toLowerCase() === "auto";
      var autoStartResolved = false;
      var targetMs = wantsAutoStart ? null : parseStartTarget(startParam);
      if (targetMs === null) targetMs = Date.now() + timerMinutes * 60 * 1000;

      function updateCountdown() {
        var totalSeconds = Math.max(0, Math.ceil((targetMs - Date.now()) / 1000));
        var mins = Math.floor(totalSeconds / 60);
        var secs = totalSeconds % 60;

        var timeStr = formatNum(mins) + ":" + formatNum(secs);
        if (startMinEl) startMinEl.textContent = formatNum(mins);
        if (startSecEl) startSecEl.textContent = formatNum(secs);
        if (pauseTimerEl) pauseTimerEl.textContent = timeStr;
        var syncEls = document.querySelectorAll(".sync-cd-time");
        for (var si = 0; si < syncEls.length; si++) {
          syncEls[si].textContent = timeStr;
        }
      }
      updateCountdown();
      setInterval(updateCountdown, 250);

      // 6. Background Canvas Particles
      var canvas = document.getElementById("streak-canvas");
      if (canvas && canvas.getContext) {
        var ctx = canvas.getContext("2d");
        var width = window.innerWidth || 1920;
        var height = window.innerHeight || 1080;

        function resizeCanvas() {
          width = window.innerWidth || 1920;
          height = window.innerHeight || 1080;
          canvas.width = width;
          canvas.height = height;
        }
        window.addEventListener("resize", resizeCanvas);
        resizeCanvas();

        var streaks = [];
        var sparks = [];
        var STREAK_COUNT = 15;
        var SPARK_COUNT = 36;

        var palette = [
          { c1: "#00E5FF", c2: "#3A7BD5" },
          { c1: "#38C8FF", c2: "#8A2BE2" },
          { c1: "#8A2BE2", c2: "#D900FF" },
          { c1: "#00E5FF", c2: "#FFFFFF" }
        ];

        function createStreak() {
          var col = palette[Math.floor(Math.random() * palette.length)];
          var len = 50 + Math.random() * 145;
          var speed = 1.1 + Math.random() * 2.8;
          var dir = Math.random() > 0.35 ? 1 : -1;
          return {
            x: Math.random() * width,
            y: Math.random() * height,
            len: len,
            speed: speed * dir,
            thickness: 1.4 + Math.random() * 2.2,
            alpha: 0.22 + Math.random() * 0.55,
            c1: col.c1,
            c2: col.c2
          };
        }

        function createSpark() {
          return {
            x: Math.random() * width,
            y: Math.random() * height,
            r: 0.8 + Math.random() * 1.7,
            vx: (Math.random() - 0.5) * 0.35,
            vy: (Math.random() - 0.5) * 0.35,
            alpha: 0.12 + Math.random() * 0.45,
            pulse: Math.random() * Math.PI * 2,
            color: Math.random() > 0.5 ? "#00E5FF" : "#9D4EDD"
          };
        }

        for (var si = 0; si < STREAK_COUNT; si++) streaks.push(createStreak());
        for (var pi = 0; pi < SPARK_COUNT; pi++) sparks.push(createSpark());

        var INV_SQRT2 = 0.70710678;
        var lastAnimTime = 0;

        function renderBackgroundParticles(now) {
          requestAnimationFrame(renderBackgroundParticles);
          if (now - lastAnimTime < 32) return;
          lastAnimTime = now;

          ctx.clearRect(0, 0, width, height);

          for (var j = 0; j < sparks.length; j++) {
            var sp = sparks[j];
            sp.x += sp.vx;
            sp.y += sp.vy;
            sp.pulse += 0.025;

            if (sp.x < 0) sp.x = width;
            if (sp.x > width) sp.x = 0;
            if (sp.y < 0) sp.y = height;
            if (sp.y > height) sp.y = 0;

            var curAlpha = sp.alpha * (0.6 + 0.4 * Math.sin(sp.pulse));
            ctx.globalAlpha = curAlpha;
            ctx.fillStyle = sp.color;
            ctx.beginPath();
            ctx.arc(sp.x, sp.y, sp.r, 0, Math.PI * 2);
            ctx.fill();
          }

          for (var i = 0; i < streaks.length; i++) {
            var s = streaks[i];
            s.x += s.speed * INV_SQRT2;
            s.y -= s.speed * INV_SQRT2;

            var margin = 200;
            if (s.x > width + margin || s.y < -margin) {
              s.x = Math.random() * (width * 0.8) - 100;
              s.y = height + Math.random() * 150;
            } else if (s.x < -margin || s.y > height + margin) {
              s.x = Math.random() * width + 100;
              s.y = -Math.random() * 150;
            }

            var x2 = s.x - s.len * INV_SQRT2;
            var y2 = s.y + s.len * INV_SQRT2;

            var grad = ctx.createLinearGradient(x2, y2, s.x, s.y);
            grad.addColorStop(0, "rgba(0, 229, 255, 0)");
            grad.addColorStop(0.5, s.c2);
            grad.addColorStop(1, s.c1);

            ctx.globalAlpha = s.alpha;
            ctx.strokeStyle = grad;
            ctx.lineWidth = s.thickness;
            ctx.lineCap = "round";

            ctx.beginPath();
            ctx.moveTo(x2, y2);
            ctx.lineTo(s.x, s.y);
            ctx.stroke();
          }
          ctx.globalAlpha = 1.0;
        }

        requestAnimationFrame(renderBackgroundParticles);
      }

      // 7. Formatting Helpers
      function esc(str) {
        if (!str) return "";
        return String(str).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
      }

      function formatTierLabel(tier, lp) {
        if (!tier) return "UNRANKED";
        var t = tier.toUpperCase();
        if (t.endsWith("IV")) t = t.slice(0, -2) + " IV";
        else if (t.endsWith("III")) t = t.slice(0, -3) + " III";
        else if (t.endsWith("II")) t = t.slice(0, -2) + " II";
        else if (t.endsWith("I")) t = t.slice(0, -1) + " I";
        if (lp !== undefined && lp !== null) t += " (" + lp + " LP)";
        return t;
      }

      function formatSlotDate(iso) {
        var d = iso ? new Date(iso) : null;
        if (!d || isNaN(d.getTime())) return "\u2013";
        return d.toLocaleDateString("de-DE", { day: "2-digit", month: "2-digit", timeZone: "Europe/Berlin" }) +
          " \u00b7 " + d.toLocaleTimeString("de-DE", { hour: "2-digit", minute: "2-digit", timeZone: "Europe/Berlin" });
      }

      function formatRelativeTime(iso) {
        if (!iso) return { label: "TERMIN OFFEN", isToday: false, isTomorrow: false };
        var d = new Date(iso);
        var now = new Date();

        var timeStr = "";
        try {
          timeStr = new Intl.DateTimeFormat("de-DE", {
            timeZone: "Europe/Berlin",
            hour: "2-digit",
            minute: "2-digit"
          }).format(d) + " UHR";
        } catch (e) {
          timeStr = "UHRZEIT OFFEN";
        }

        var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
        var matchDay = new Date(d.getFullYear(), d.getMonth(), d.getDate());
        var diffDays = Math.round((matchDay - today) / (1000 * 60 * 60 * 24));

        var dayStr = "";
        var isToday = false;
        var isTomorrow = false;

        if (diffDays === 0) {
          dayStr = "HEUTE";
          isToday = true;
        } else if (diffDays === 1) {
          dayStr = "MORGEN";
          isTomorrow = true;
        } else {
          try {
            var weekday = new Intl.DateTimeFormat("de-DE", {
              timeZone: "Europe/Berlin",
              weekday: "short"
            }).format(d).replace(/\./g, "").toUpperCase();
            var dayMonth = new Intl.DateTimeFormat("de-DE", {
              timeZone: "Europe/Berlin",
              day: "2-digit",
              month: "2-digit"
            }).format(d);
            dayStr = weekday + "., " + dayMonth + ".";
          } catch (e2) {
            dayStr = "TERMIN";
          }
        }

        return { label: dayStr + " " + timeStr, isToday: isToday, isTomorrow: isTomorrow };
      }

      // 8. Compute Team State & Automatically Select Next Match of the Given Team
      function computeTeamState(teamKey) {
        var fallbackLogo = "/assets/logo/logo.png";
        var teamStats = (primeStatsData && primeStatsData[teamKey]) ? primeStatsData[teamKey] : null;
        var enrichedTeam = enrichedTeamsMap[teamKey] || {};
        var teamPlayers = enrichedTeam.players || [];

        var displayName = (teamStats && teamStats.teamDisplay) || enrichedTeam.displayName || ("UIC " + teamKey.toUpperCase());
        var tierName = (teamStats && teamStats.tier) || enrichedTeam.tier || "Prime League";
        var uicLogo = (teamStats && teamStats.api_meta && teamStats.api_meta.logo_url) ? teamStats.api_meta.logo_url : fallbackLogo;

        var wins = 0, losses = 0, draws = 0;
        var formArr = [];
        var nextMatch = null;
        var cutoff = new Date(new Date().getTime() - (6 * 3600 * 1000));

        if (teamStats && teamStats.matches && Array.isArray(teamStats.matches)) {
          var played = teamStats.matches.filter(function(m) { return m.result; })
            .sort(function(a, b) { return new Date(a.begin) - new Date(b.begin); });

          for (var pIdx = 0; pIdx < played.length; pIdx++) {
            var resParts = played[pIdx].result.split(":").map(Number);
            if (resParts.length === 2) {
              if (resParts[0] > resParts[1]) { wins++; formArr.push("W"); }
              else if (resParts[0] < resParts[1]) { losses++; formArr.push("L"); }
              else { draws++; formArr.push("D"); }
            }
          }

          // Optional explicit matchday/match selection (?matchday=4 or ?match=1165669)
          var explicitMatch = null;
          if (matchDayParam) {
            var candidates = teamStats.matches.filter(function(m) {
              return String(m.id) === matchDayParam || String(m.match_day) === matchDayParam;
            });
            if (candidates.length > 0) {
              candidates.sort(function(a, b) {
                return new Date(b.begin || 0) - new Date(a.begin || 0);
              });
              explicitMatch = candidates[0];
            }
          }

          // Chronologically next upcoming match of this team; fallback to latest unplayed or last played
          var upcomingFuture = teamStats.matches.filter(function(m) {
            return !m.result && (!m.begin || new Date(m.begin) >= cutoff);
          }).sort(function(a, b) { return new Date(a.begin) - new Date(b.begin); });

          var anyUnplayed = teamStats.matches.filter(function(m) {
            return !m.result;
          }).sort(function(a, b) { return new Date(b.begin || 0) - new Date(a.begin || 0); });

          nextMatch = explicitMatch || upcomingFuture[0] || anyUnplayed[0] || played[played.length - 1] || null;
        }

        var enemyName = "Gegner offen";
        var enemyLogo = fallbackLogo;
        var matchTimeStr = "TERMIN OFFEN";
        var isConfirmed = false;
        var matchDayNum = null;

        if (nextMatch) {
          if (nextMatch.enemy_team) {
            enemyName = nextMatch.enemy_team.name || nextMatch.enemy_team.team_tag || "Gegner";
            if (nextMatch.enemy_team.logo_url) enemyLogo = nextMatch.enemy_team.logo_url;
          }
          if (nextMatch.begin) {
            var formatted = formatRelativeTime(nextMatch.begin);
            matchTimeStr = formatted.label;
          }
          isConfirmed = nextMatch.confirmed === true;
          if (nextMatch.match_day) matchDayNum = nextMatch.match_day;
        }

        var totalMatches = wins + losses + draws;
        var wrPercent = totalMatches > 0 ? Math.round((wins / totalMatches) * 100) : null;
        var tierUpper = tierName.toUpperCase();

        var seriesLabel = "";
        if (teamStats && Array.isArray(teamStats.matches)) {
          var finished = teamStats.matches.filter(function(m) { return m.result && /^\d+:\d+$/.test(m.result); });
          if (finished.length > 0 && finished.every(function(m) {
            var sc = m.result.split(":").map(Number);
            return Math.max(sc[0], sc[1]) === 2;
          })) seriesLabel = "BO3";
        }

        var seasonLabel = "";
        if (teamStats && Array.isArray(teamStats.matches)) {
          var earliestYear = null;
          for (var sy = 0; sy < teamStats.matches.length; sy++) {
            var syDate = teamStats.matches[sy].begin ? new Date(teamStats.matches[sy].begin) : null;
            if (syDate && !isNaN(syDate.getTime())) {
              var yr = syDate.getFullYear();
              if (earliestYear === null || yr < earliestYear) earliestYear = yr;
            }
          }
          if (earliestYear !== null) seasonLabel = "SAISON " + earliestYear;
        }

        var targetRoles = ["TOP", "JGL", "MID", "BOT", "SUP"];
        var enrichedList = (embeddedData && embeddedData.enriched && embeddedData.enriched[teamKey])
          ? embeddedData.enriched[teamKey].players
          : teamPlayers;

        var starters = [];
        for (var rk = 0; rk < targetRoles.length; rk++) {
          var targetRole = targetRoles[rk];
          var matchedPlayer = enrichedList.find(function(p) {
            return (p.role && p.role.toUpperCase() === targetRole) ||
                   (targetRole === "BOT" && (p.role === "ADC" || p.role === "BOT"));
          });
          if (!matchedPlayer && enrichedList[rk]) {
            matchedPlayer = enrichedList[rk];
          }

          var pName = matchedPlayer ? matchedPlayer.name : "\u2013";
          var pTag = matchedPlayer && matchedPlayer.tagLine ? "#" + matchedPlayer.tagLine : "";
          var pRole = matchedPlayer && matchedPlayer.role ? matchedPlayer.role : targetRole;
          var roleKey = targetRole.toLowerCase();
          var roleIconSrc = "/assets/roles/" + (roleKey === "bot" ? "bot" : roleKey) + ".webp";
          var pPhoto = matchedPlayer && matchedPlayer.photoSrc ? matchedPlayer.photoSrc : (matchedPlayer && matchedPlayer.playerId ? "/assets/profile/" + matchedPlayer.playerId + ".webp" : "/assets/profile/profile_placeholder.webp");
          var pIcon = matchedPlayer && matchedPlayer.icon ? matchedPlayer.icon : "/assets/profile/placeholder.webp";
          var pTier = matchedPlayer ? formatTierLabel(matchedPlayer.tier, matchedPlayer.lp) : "\u2013";
          var pWr = matchedPlayer && matchedPlayer.winRate ? matchedPlayer.winRate + "% WR" : "\u2013";
          var pWins = matchedPlayer && matchedPlayer.wins ? matchedPlayer.wins : 0;
          var pLosses = matchedPlayer && matchedPlayer.losses ? matchedPlayer.losses : 0;
          var showVal = function(v, suffix) { return (v === null || v === undefined) ? "\u2013" : v + (suffix || ""); };

          starters.push({
            name: pName,
            tag: pTag,
            role: pRole,
            roleIconSrc: roleIconSrc,
            photoSrc: pPhoto,
            iconSrc: pIcon,
            tier: pTier,
            wr: pWr,
            wins: pWins,
            losses: pLosses,
            kda: matchedPlayer ? showVal(matchedPlayer.kda) : "\u2013",
            dpm: matchedPlayer ? showVal(matchedPlayer.dpm) : "\u2013",
            csm: matchedPlayer ? showVal(matchedPlayer.csm) : "\u2013",
            kp: matchedPlayer ? showVal(matchedPlayer.kp, "%") : "\u2013",
            isCaptain: matchedPlayer && matchedPlayer.isCaptain === true,
            isSubstitute: matchedPlayer && matchedPlayer.isSubstitute === true
          });
        }

        var embeddedTeam = (embeddedData.enriched && embeddedData.enriched[teamKey]) || {};
        var ts = embeddedTeam.stats || {};
        var has = function(v) { return v !== null && v !== undefined && isFinite(v); };
        var clampPct = function(v) { return Math.max(0, Math.min(100, Math.round(v))); };

        var metricsData = [];
        if (wrPercent !== null) metricsData.push({ label: "WINRATE PRIME LEAGUE", uicVal: wrPercent + "%", pct: wrPercent });
        if (has(ts.kda)) metricsData.push({ label: "\u00d8 KDA", uicVal: ts.kda.toFixed(2), pct: clampPct(ts.kda / 6 * 100) });
        if (has(ts.dpm)) metricsData.push({ label: "\u00d8 SCHADEN / MIN", uicVal: String(Math.round(ts.dpm)), pct: clampPct(ts.dpm / 1200 * 100) });
        if (has(ts.csm)) metricsData.push({ label: "\u00d8 CS / MIN", uicVal: ts.csm.toFixed(1), pct: clampPct(ts.csm / 10 * 100) });
        if (has(ts.kp)) metricsData.push({ label: "\u00d8 KILL-BETEILIGUNG", uicVal: Math.round(ts.kp) + "%", pct: clampPct(ts.kp) });
        if (has(ts.gd15)) metricsData.push({ label: "\u00d8 GOLD-DIFF @ 15", uicVal: (ts.gd15 > 0 ? "+" : "") + Math.round(ts.gd15), pct: clampPct(50 + ts.gd15 / 20) });

        var schedule = (teamStats && Array.isArray(teamStats.matches) ? teamStats.matches.slice() : [])
          .sort(function(a, b) {
            if (!a.begin) return 1;
            if (!b.begin) return -1;
            return new Date(a.begin) - new Date(b.begin);
          });

        var maxRows = 8;
        if (schedule.length > maxRows) {
          var nextIdx = Math.max(0, schedule.indexOf(nextMatch));
          var sliceStart = Math.max(0, Math.min(nextIdx - 3, schedule.length - maxRows));
          schedule = schedule.slice(sliceStart, sliceStart + maxRows);
        }

        return {
          teamKey: teamKey,
          teamStats: teamStats,
          displayName: displayName,
          tierName: tierName,
          tierUpper: tierUpper,
          uicLogo: uicLogo,
          fallbackLogo: fallbackLogo,
          wins: wins,
          losses: losses,
          draws: draws,
          formArr: formArr,
          nextMatch: nextMatch,
          enemyName: enemyName,
          enemyLogo: enemyLogo,
          matchTimeStr: matchTimeStr,
          isConfirmed: isConfirmed,
          matchDayNum: matchDayNum,
          seriesLabel: seriesLabel,
          seasonLabel: seasonLabel,
          wrPercent: wrPercent,
          starters: starters,
          metricsData: metricsData,
          schedule: schedule
        };
      }

      function buildFormBadgesHtml(formArr, emptyText) {
        var rf = formArr.slice(-5);
        if (rf.length === 0) return '<span class="form-badge draw">' + (emptyText || "\u2013") + '</span>';
        var html = "";
        for (var i = 0; i < rf.length; i++) {
          var cls = rf[i] === "W" ? "win" : (rf[i] === "L" ? "loss" : "draw");
          html += '<span class="form-badge ' + cls + '">' + rf[i] + '</span>';
        }
        return html;
      }


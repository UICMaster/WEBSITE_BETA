// src/pages/obs.astro
import Layout from '../layouts/Layout.astro';
import rawTeams from '../../data/teams.json';
import rawPrimeStats from '../../data/prime_stats.json';

const teamsMap = (rawTeams || {}) as Record<string, any>;
const primeStatsMap = (rawPrimeStats || {}) as Record<string, any>;

const teamOptions = Object.entries(teamsMap)
  .filter(([key]) => key.toLowerCase() !== 'community')
  .map(([key, val]) => ({
    key,
    name: val.teamDisplay || `UIC ${key.toUpperCase()}`,
    tier: val.tier || 'Prime League'
  }));

function formatMatchSlot(iso?: string): string {
  if (!iso) return 'Termin offen';
  const d = new Date(iso);
  if (isNaN(d.getTime())) return 'Termin offen';
  const datePart = d.toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', timeZone: 'Europe/Berlin' });
  const timePart = d.toLocaleTimeString('de-DE', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Berlin' });
  return `${datePart}. ${timePart}`;
}

const splitCutoff = new Date('2026-09-25T00:00:00Z');

const upcomingMatchdayOptions: { value: string; label: string; beginMs: number }[] = [];
const teamMatchdayGroups: { teamKey: string; teamName: string; tier: string; matches: { value: string; label: string; day: number }[] }[] = [];

for (const t of teamOptions) {
  const pTeam = primeStatsMap[t.key];
  const rawMatches = Array.isArray(pTeam?.matches) ? pTeam.matches : [];
  const hasGroupStage = rawMatches.some((m: any) => m.begin && new Date(m.begin) >= splitCutoff);
  const splitMatches = hasGroupStage
    ? rawMatches.filter((m: any) => !m.begin || new Date(m.begin) >= splitCutoff)
    : rawMatches;

  const byDay = new Map<number, any>();
  const sortedByDate = [...splitMatches].sort((a, b) => new Date(a.begin || 0).getTime() - new Date(b.begin || 0).getTime());
  for (const m of sortedByDate) {
    if (m.match_day) byDay.set(Number(m.match_day), m);
  }

  const groupMatches = [...byDay.values()]
    .sort((a, b) => (Number(a.match_day) || 99) - (Number(b.match_day) || 99))
    .map((m: any) => {
      const enemyName = m.enemy_team?.name || m.enemy_team?.team_tag || 'Gegner';
      const statusStr = m.result ? m.result : formatMatchSlot(m.begin);
      const val = `${t.key}:${m.match_day}`;
      if (!m.result) {
        upcomingMatchdayOptions.push({
          value: val,
          label: `[Tag ${m.match_day} • ${formatMatchSlot(m.begin)}] ${t.name} vs. ${enemyName}`,
          beginMs: m.begin ? new Date(m.begin).getTime() : Number.MAX_SAFE_INTEGER
        });
      }
      return {
        value: val,
        day: Number(m.match_day),
        label: `${t.name} • Spieltag ${m.match_day} vs. ${enemyName} (${statusStr})`
      };
    });

  if (groupMatches.length > 0) {
    teamMatchdayGroups.push({
      teamKey: t.key,
      teamName: t.name,
      tier: t.tier,
      matches: groupMatches
    });
  }
}

upcomingMatchdayOptions.sort((a, b) => a.beginMs - b.beginMs);
---

<Layout 
  title="OBS Spieltags-Overlay | Ultra Instinct Crew"
  description="1080p OBS Broadcast-Overlay der Ultra Instinct Crew mit 5 Szenen (1. Start, 2. Pregame, 3. Break, 4. Replay, 5. End), automatischer Spieltags-Erkennung pro Team, Streamlabs-Integration, RiftOPS-Replay-Bühne und reservierter BlueBottle-Draft-Zone."
>
  <div class="obs-page section-pad">
    <div class="container obs-container">
      
      <!-- Top Back Navigation -->
      <a href="/#media-vault" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        <span>ZURÜCK ZU MEDIEN &amp; VORLAGEN</span>
      </a>

      <!-- Header Section -->
      <header class="obs-header">
        <div class="section-badge-pill">OBS OVERLAY</div>
        <h1 class="obs-title text-gradient">SPIELTAGS-OVERLAY &amp; KONFIGURATOR</h1>
        <p class="obs-lead">
          1080p Browser-Overlay für Prime League Übertragungen der Ultra Instinct Crew. 
          Wähle Szene und Team direkt über den Konfigurator — das Overlay lädt automatisch die nächste angesetzte Begegnung, Aufstellung und Saisonbilanz des gewählten Teams.
        </p>

        <!-- Quick Jump Navigation -->
        <nav class="quick-nav-strip" aria-label="Schnellnavigation">
          <a href="#preview-generator" class="quick-nav-pill">1. VORSCHAU &amp; KONFIGURATOR</a>
          <a href="#broadcast-scenes" class="quick-nav-pill">2. DIE 5 SZENEN</a>
          <a href="#obs-setup" class="quick-nav-pill">3. OBS EINRICHTUNG &amp; EBENEN</a>
          <a href="#url-params" class="quick-nav-pill">4. URL-PARAMETER</a>
        </nav>
      </header>

      <!-- =====================================================================
           1. STACKED LIVE PREVIEW (TOP) & STUDIO CONFIGURATOR (BOTTOM)
           ===================================================================== -->
      <section id="preview-generator" class="preview-generator-section" aria-label="Overlay-Vorschau und URL-Konfigurator">
        <div class="preview-interactive-stack">
          
          <!-- TOP: Full-Width 16:9 Viewport Stage Frame -->
          <div class="preview-stage-card">
            <div class="monitor-top-bar">
              <div class="monitor-left">
                <span class="monitor-title text-mono">1920 &times; 1080 &bull; LIVE-VORSCHAU</span>
              </div>

              <div class="monitor-actions">
                <a 
                  id="open-pure-link" 
                  href="/overlay?scene=pregame" 
                  target="_blank" 
                  rel="noopener noreferrer" 
                  class="btn btn-outline btn-sm open-ext-btn"
                  title="Overlay im neuen Tab in Originalauflösung öffnen"
                >
                  <span>VOLLBILD ÖFFNEN</span>
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/></svg>
                </a>
              </div>
            </div>

            <div class="monitor-viewport-wrapper" id="monitor-wrapper">
              <iframe 
                id="obs-preview-iframe" 
                src="/overlay?scene=pregame" 
                title="UIC OBS Overlay Live Vorschau" 
                loading="eager"
              ></iframe>
            </div>
          </div>

          <!-- BOTTOM: Contextual Scene, Team & Streamlabs Configurator Deck -->
          <div class="config-tabs-card">
            
            <div class="config-header">
              <div class="config-header-left">
                <div class="section-badge-pill">KONFIGURATOR</div>
                <h2 class="config-title">SZENE, TEAM &amp; WIDGETS KONFIGURIEREN</h2>
              </div>
              <p class="config-sub text-muted">
                Es werden nur die Einstellungen eingeblendet, die für die gewählte Szene relevant sind. Durch Auswahl eines Teams springt das Overlay automatisch auf dessen nächstes Spiel.
              </p>
            </div>

            <div class="preview-customizer-dock">
              
              <!-- 1. Scene Selector (Always visible, consistent naming: 1. Start, 2. Pregame, 3. Break, 4. Replay, 5. End) -->
              <div class="dock-control-group">
                <label for="scene-selector" class="dock-lbl text-mono">1. SZENE:</label>
                <select id="scene-selector" class="dock-select text-mono">
                  <option value="start">1. Start</option>
                  <option value="pregame" selected>2. Pregame</option>
                  <option value="break">3. Break (Caster-Pause)</option>
                  <option value="replay">4. Replay (InGame PiP + RiftOPS)</option>
                  <option value="end">5. End</option>
                </select>
              </div>

              <!-- 2. Team / Matchday Selector (Team option as is + option to pick specific matchday) -->
              <div class="dock-control-group">
                <label for="team-selector" class="dock-lbl text-mono">2. TEAM / MODUS:</label>
                <select id="team-selector" class="dock-select text-mono">
                  <optgroup label="MODUS">
                    <option value="auto" selected>Automatisch (Nächstes UIC-Spiel)</option>
                    <option value="none">Ohne Teamdaten (Klassisches Orga-Overlay)</option>
                  </optgroup>
                  <optgroup label="TEAMS (NÄCHSTES SPIEL AUTOMATISCH)">
                    {teamOptions.map((t) => (
                      <option value={t.key}>{t.name} ({t.tier})</option>
                    ))}
                  </optgroup>
                  <optgroup label="OFFENE SPIELTAGE (SPEZIFISCHE BEGEGNUNG)">
                    {upcomingMatchdayOptions.map((m) => (
                      <option value={m.value}>{m.label}</option>
                    ))}
                  </optgroup>
                  {teamMatchdayGroups.map((grp) => (
                    <optgroup label={`SPIELTAGE • ${grp.teamName.toUpperCase()} (${grp.tier.toUpperCase()})`}>
                      {grp.matches.map((m) => (
                        <option value={m.value}>{m.label}</option>
                      ))}
                    </optgroup>
                  ))}
                </select>
              </div>

              <!-- 3. Pregame Only: Camera Layout -->
              <div class="dock-control-group" id="group-layout">
                <label for="layout-selector" class="dock-lbl text-mono">CASTER-KAMERAS (16:9):</label>
                <select id="layout-selector" class="dock-select text-mono">
                  <option value="cam-2" selected>Duo-Caster (2 Kameras &bull; 656&times;369)</option>
                  <option value="cam-1">Solo-Caster (1 Kamera &bull; 752&times;423)</option>
                  <option value="none">Ohne Kameras (Spielplan-Ansicht)</option>
                </select>
              </div>

              <!-- 4. Pregame Only: Stream Chat -->
              <div class="dock-control-group" id="group-chat">
                <label for="chat-selector" class="dock-lbl text-mono">CHAT-FENSTER RECHTS:</label>
                <select id="chat-selector" class="dock-select text-mono">
                  <option value="1" selected>Einblenden</option>
                  <option value="0">Ausblenden (Kameras zentriert)</option>
                </select>
              </div>

              <!-- 5. Start Only: View Mode -->
              <div class="dock-control-group" id="group-start-view" style="display: none;">
                <label for="start-view-selector" class="dock-lbl text-mono">ANSICHTS-MODUS:</label>
                <select id="start-view-selector" class="dock-select text-mono">
                  <option value="auto" selected>Automatischer Wechsel (alle 10s)</option>
                  <option value="matchup">Feste Ansicht: 01 Matchup</option>
                  <option value="table">Feste Ansicht: 02 Spielplan</option>
                  <option value="roster">Feste Ansicht: 03 Kader (5 Starter)</option>
                  <option value="stats">Feste Ansicht: 04 Team-Statistiken</option>
                </select>
              </div>

              <!-- 6. Start & InGame Only: Countdown Timer -->
              <div class="dock-control-group" id="group-timer-min" style="display: none;">
                <label for="timer-selector" class="dock-lbl text-mono">COUNTDOWN (MINUTEN):</label>
                <select id="timer-selector" class="dock-select text-mono">
                  <option value="1">1 Minute</option>
                  <option value="3">3 Minuten</option>
                  <option value="5" selected>5 Minuten (Standard)</option>
                  <option value="10">10 Minuten</option>
                  <option value="15">15 Minuten</option>
                </select>
              </div>

              <div class="dock-control-group" id="group-timer-target" style="display: none;">
                <label for="start-time-input" class="dock-lbl text-mono">ODER FESTE ZIELZEIT:</label>
                <input id="start-time-input" type="text" class="dock-select dock-input text-mono" placeholder="z. B. 19:00 oder auto" autocomplete="off" spellcheck="false" />
              </div>

              <!-- 7. Pregame, InGame & End: Top Match Ticker -->
              <div class="dock-control-group" id="group-ticker">
                <label for="ticker-selector" class="dock-lbl text-mono">OBERER SPIELTAGS-TICKER:</label>
                <select id="ticker-selector" class="dock-select text-mono">
                  <option value="top" selected>Einblenden (54px oben)</option>
                  <option value="off">Ausblenden</option>
                </select>
              </div>

              <!-- 8. Streamlabs Integration Row (Empty by default; embeds directly into /overlay when filled) -->
              <div class="dock-widgets-row dock-span-full">
                <!-- Streamlabs Chat-Box Link (Pregame when Chat=1) -->
                <div class="dock-control-group" id="group-chat-url">
                  <div class="dock-lbl-row">
                    <label for="chat-url-input" class="dock-lbl text-mono">STREAMLABS CHAT-BOX LINK (OPTIONAL):</label>
                    <div class="dock-preset-actions">
                      <button type="button" class="preset-link-btn text-mono" id="btn-fill-uic-chat" title="Offiziellen Streamlabs-Chat-Link des Twitch-Kanals 'Ultra Instinct Crew' einfügen">
                        + UIC Twitch-Chat einfügen
                      </button>
                      <button type="button" class="preset-link-btn preset-clear text-mono" id="btn-clear-chat" style="display: none;">
                        Leeren
                      </button>
                    </div>
                  </div>
                  <input
                    id="chat-url-input"
                    type="text"
                    class="dock-select dock-input text-mono"
                    placeholder="https://streamlabs.com/widgets/chat-box/v1/..."
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <span class="dock-field-status text-mono" id="chat-url-status" style="display: none;"></span>
                </div>

                <!-- Streamlabs Alert-Box Link (All scenes) -->
                <div class="dock-control-group" id="group-alert-url">
                  <div class="dock-lbl-row">
                    <label for="alert-url-input" class="dock-lbl text-mono">STREAMLABS ALERT-BOX LINK (OPTIONAL):</label>
                    <div class="dock-preset-actions">
                      <button type="button" class="preset-link-btn preset-clear text-mono" id="btn-clear-alert" style="display: none;">
                        Leeren
                      </button>
                    </div>
                  </div>
                  <input
                    id="alert-url-input"
                    type="text"
                    class="dock-select dock-input text-mono"
                    placeholder="https://streamlabs.com/alert-box/v3/..."
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <span class="dock-field-status text-mono" id="alert-url-status" style="display: none;"></span>
                </div>
              </div>

            </div>

            <!-- Dynamic URL Display & Copy Bar -->
            <div class="obs-copy-bar">
              <div class="copy-url-info">
                <span class="copy-tag text-mono">OBS BROWSER-QUELLE URL:</span>
                <code id="current-obs-url" class="obs-url-code text-mono">https://ultrainstinctcrew.com/overlay?scene=pregame</code>
              </div>
              <button type="button" class="btn btn-primary btn-sm copy-btn" id="btn-copy-url">
                <span id="copy-btn-text">URL KOPIEREN</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              </button>
            </div>

          </div>

        </div>
      </section>

      <!-- =====================================================================
           2. THE 5 BROADCAST SCENES (1. START, 2. PREGAME, 3. BREAK, 4. REPLAY, 5. END)
           ===================================================================== -->
      <section id="broadcast-scenes" class="scenes-section">
        <div class="section-tag"># SZENEN</div>
        <h2 class="section-heading">DIE 5 SZENEN IM ÜBERBLICK</h2>
        <p class="section-sub">
          Jede Szene wird in OBS als eigene Browser-Quelle (1920 &times; 1080) angelegt. Mit einem Klick auf „Im Konfigurator laden“ übernimmst du die Szene direkt in die obige Vorschau.
        </p>

        <div class="scenes-grid">
          
          <!-- Scene 1: Start -->
          <article class="scene-card">
            <div class="scene-card-header">
              <span class="scene-num text-mono">01</span>
              <span class="scene-tag text-mono">VORLAUF &bull; 10S ROTATION</span>
            </div>
            <h3 class="scene-title">1. START</h3>
            <p class="scene-desc">
              Vollbild-Vorlauf vor Spielbeginn mit großem Countdown und automatischem 10-Sekunden-Wechsel durch vier Ansichten.
            </p>
            <div class="scene-detail-box">
              <span class="detail-label text-mono">INHALT:</span>
              <ul class="scene-features">
                <li><strong>01 Matchup:</strong> Vereinswappen, Gegner, Spieltag, Uhrzeit und Form</li>
                <li><strong>02 Spielplan:</strong> Chronologische Spiele und Ergebnisse des Teams</li>
                <li><strong>03 Kader:</strong> Die 5 Starter mit Rolle, SoloQ-Rang und Leistungsdaten</li>
                <li><strong>04 Stats:</strong> Team-Durchschnittswerte (Winrate, KDA, DPM, CS/M, GD@15)</li>
              </ul>
            </div>
            <div class="scene-action-row">
              <button type="button" class="btn btn-outline btn-sm load-scene-btn" data-scene="start">
                Im Konfigurator laden
              </button>
              <a href="/overlay?scene=start" target="_blank" class="btn btn-outline btn-sm">
                Vollbild &nearr;
              </a>
            </div>
          </article>

          <!-- Scene 2: Pregame -->
          <article class="scene-card is-highlight">
            <div class="scene-card-header">
              <span class="scene-num text-mono">02</span>
              <span class="scene-tag text-mono highlight-tag">BLUEBOTTLE DRAFT READY</span>
            </div>
            <h3 class="scene-title">2. PREGAME</h3>
            <p class="scene-desc">
              Vorbericht- und Pick-&amp;-Ban-Bühne mit Matchup-Scoreboard, ausgestanzten 16:9 Caster-Kameras, Stream-Chat, 5-Starter-Leiste und 320px Freiraum unten.
            </p>
            <div class="scene-detail-box">
              <span class="detail-label text-mono">AUFBAU (VON OBEN NACH UNTEN):</span>
              <ul class="scene-features">
                <li><strong>Scoreboard-Header:</strong> Aktuelles Team, Bilanz, Form, Spieltag und Gegner</li>
                <li><strong>Transparente 16:9 Kamera-Cutouts:</strong> Webcams liegen in OBS hinter dem Overlay &mdash; die <code class="inline-code">DESK | CASTER</code>-Labels liegen vor dem Kamerabild</li>
                <li><strong>5-Starter-Leiste:</strong> TOP, JGL, MID, BOT, SUP mit SoloQ-Rang und KDA</li>
                <li><strong>320px BlueBottle-Zone (760–1080px):</strong> Unten komplett frei für die BlueBottle-Quelle in OBS</li>
              </ul>
            </div>
            <div class="scene-action-row">
              <button type="button" class="btn btn-primary btn-sm load-scene-btn" data-scene="pregame">
                Im Konfigurator laden
              </button>
              <a href="/overlay?scene=pregame" target="_blank" class="btn btn-outline btn-sm">
                Vollbild &nearr;
              </a>
            </div>
          </article>

          <!-- Scene 3: Break -->
          <article class="scene-card">
            <div class="scene-card-header">
              <span class="scene-num text-mono">03</span>
              <span class="scene-tag text-mono">1280&times;720 HIGHLIGHTS &bull; PAUSE</span>
            </div>
            <h3 class="scene-title">3. BREAK</h3>
            <p class="scene-desc">
              Caster-Pausen-Szene mit ausgestanztem 1280&times;720 (16:9) Highlight-Fenster links für geschnittene Ingame-Clips und Live-Teamdaten rechts.
            </p>
            <div class="scene-detail-box">
              <span class="detail-label text-mono">INHALT:</span>
              <ul class="scene-features">
                <li><strong>Pausen-Header &amp; Timer:</strong> „KURZE PAUSE &bull; SPIEL-HIGHLIGHTS“ mit <code class="inline-code">WEITER IN</code>-Countdown</li>
                <li><strong>1280&times;720 (16:9) Highlight-Cutout links:</strong> Transparent ausgestanzt für deine geschnittenen Ingame-Highlights (mit <code class="inline-code">BREAK | MATCH HIGHLIGHTS</code>-Label im Vordergrund)</li>
                <li><strong>Team-Sidebar rechts:</strong> Aktuelles Matchup, Saisonbilanz, die 5 Starter und der Spielplan</li>
                <li><strong>Partner &amp; Kanäle:</strong> Offizieller Partner RiftOPS, Webseite, Discord und Shop</li>
              </ul>
            </div>
            <div class="scene-action-row">
              <button type="button" class="btn btn-outline btn-sm load-scene-btn" data-scene="break">
                Im Konfigurator laden
              </button>
              <a href="/overlay?scene=break&timer=3" target="_blank" class="btn btn-outline btn-sm">
                Vollbild &nearr;
              </a>
            </div>
          </article>

          <!-- Scene 4: Replay -->
          <article class="scene-card is-highlight">
            <div class="scene-card-header">
              <span class="scene-num text-mono">04</span>
              <span class="scene-tag text-mono highlight-tag">INSTANT REPLAY &bull; RIFTOPS</span>
            </div>
            <h3 class="scene-title">4. REPLAY</h3>
            <p class="scene-desc">
              Transparente InGame-Replay-Szene, um während des laufenden Spiels sofort den letzten Teamfight als Vollbild-Replay einzuspielen.
            </p>
            <div class="scene-detail-box">
              <span class="detail-label text-mono">AUFBAU (TRANSPARENTES OVERLAY):</span>
              <ul class="scene-features">
                <li><strong>Hintergrund (1920&times;1080):</strong> 100% transparent für die Vollbild-Replay-Quelle in OBS</li>
                <li><strong>Oben links (Overlay-Design):</strong> <code class="inline-code">INSTANT REPLAY &bull; POWERED BY RIFTOPS</code> Partner-Header</li>
                <li><strong>Oben rechts (544&times;306, 16:9):</strong> Picture-in-Picture-Rahmen + <code class="inline-code">LIVE</code>-Label für das weiterlaufende Live-Spiel</li>
                <li><strong>Unterer Bereich komplett frei:</strong> Keinerlei Verdeckung des LoL-Spectator-HUDs oder der Minimap</li>
              </ul>
            </div>
            <div class="scene-action-row">
              <button type="button" class="btn btn-primary btn-sm load-scene-btn" data-scene="replay">
                Im Konfigurator laden
              </button>
              <a href="/overlay?scene=replay" target="_blank" class="btn btn-outline btn-sm">
                Vollbild &nearr;
              </a>
            </div>
          </article>

          <!-- Scene 5: End -->
          <article class="scene-card">
            <div class="scene-card-header">
              <span class="scene-num text-mono">05</span>
              <span class="scene-tag text-mono">ABSCHLUSS &amp; AUSBLICK</span>
            </div>
            <h3 class="scene-title">5. END</h3>
            <p class="scene-desc">
              Abschluss-Bildschirm nach Spielende mit Saisonbilanz des übertragenen Teams, kommenden Terminen und Vereinskanälen.
            </p>
            <div class="scene-detail-box">
              <span class="detail-label text-mono">INHALT:</span>
              <ul class="scene-features">
                <li><strong>Team-Zusammenfassung links:</strong> Bilanz, Form und die nächsten Prime League Spieltage</li>
                <li><strong>Vereinskanäle rechts:</strong> Webseite, Discord-Server, Spized-Shop und Twitter/X</li>
                <li><strong>Oberer Spieltags-Ticker:</strong> Zeigt weiterhin alle anstehenden Spiele der Organisation</li>
              </ul>
            </div>
            <div class="scene-action-row">
              <button type="button" class="btn btn-outline btn-sm load-scene-btn" data-scene="end">
                Im Konfigurator laden
              </button>
              <a href="/overlay?scene=end" target="_blank" class="btn btn-outline btn-sm">
                Vollbild &nearr;
              </a>
            </div>
          </article>

        </div>
      </section>

      <!-- =====================================================================
           3. OBS STUDIO SETUP & LAYER ARCHITECTURE (CAMERA CUTOUTS & REPLAY PIP)
           ===================================================================== -->
      <section id="obs-setup" class="setup-guide-card">
        <div class="section-tag"># OBS STUDIO</div>
        <h2 class="section-heading">EINRICHTUNG &amp; EBENEN-REIHENFOLGE IN OBS</h2>
        <p class="section-sub">
          Damit Kameras, Highlight-Clips und Replays <strong>hinter den Overlay-Labels</strong> (wie <code class="inline-code">DESK | CASTER 1</code>, <code class="inline-code">BREAK | MATCH HIGHLIGHTS</code> oder <code class="inline-code">LIVE | AKTUELLES SPIEL</code>) liegen, nutzt das Overlay <strong>echte Alpha-Transparenz-Stanzlöcher</strong>. Dadurch liegt das Overlay in OBS einfach <strong>über</strong> deinen Kamera- und Spielquellen:
        </p>
        
        <div class="steps-grid">
          <div class="step-cell">
            <span class="step-num text-mono">SCHRITT 1</span>
            <h3 class="step-title">Browser-Quelle erstellen</h3>
            <p class="step-desc">
              In OBS unter <em>Quellen</em> auf <code class="inline-code">+</code> &rarr; <strong>Browser</strong> klicken und die URL aus dem Konfigurator oben einfügen.
            </p>
          </div>

          <div class="step-cell">
            <span class="step-num text-mono">SCHRITT 2</span>
            <h3 class="step-title">1920 &times; 1080 &amp; 60 FPS</h3>
            <p class="step-desc">
              <strong>Breite: 1920</strong>, <strong>Höhe: 1080</strong> und <strong>60 FPS</strong> einstellen, damit alle Rahmen und Stanzlöcher pixelgenau sitzen.
            </p>
          </div>

          <div class="step-cell">
            <span class="step-num text-mono">SCHRITT 3</span>
            <h3 class="step-title">Overlay über Kameras legen</h3>
            <p class="step-desc">
              Ziehe die <strong>UIC Overlay Browser-Quelle</strong> in der OBS-Quellenliste <strong>über</strong> deine Webcams bzw. Replay-Quellen. Die Fenster im Overlay sind transparent ausgestanzt!
            </p>
          </div>

          <div class="step-cell">
            <span class="step-num text-mono">SCHRITT 4</span>
            <h3 class="step-title">Bei Szenenwechsel aktualisieren</h3>
            <p class="step-desc">
              Aktiviere in den OBS-Eigenschaften der Quelle <em>„Quelle bei Nichtanzeige herunterfahren“</em> für minimale GPU-Last während des Spiels.
            </p>
          </div>
        </div>

        <!-- Two Side-by-Side Layer Guides: 2. Pregame / 3. Break (Cutouts) & 4. Replay (Live PiP + Fullscreen Replay) -->
        <div class="deepdive-grid" style="margin-top: var(--space-2xl);">
          
          <!-- Pregame & Break Layer Stack -->
          <div class="layer-diagram-card">
            <div class="diagram-header text-mono">EBENEN IN 2. PREGAME &amp; 3. BREAK (HINTER DEN LABELS)</div>
            <div class="layer-stack">
              <div class="layer-item l-top">
                <div class="layer-badge text-mono">EBENE 1 (GANZ OBEN &bull; NUR IN 2. PREGAME)</div>
                <div class="layer-name">BlueBottle Draft Browser-Quelle</div>
                <div class="layer-desc">Am unteren Bildschirmrand (760–1080px, 320px Höhe) positionieren. Dieser Bereich ist im Pregame-Overlay frei reserviert.</div>
              </div>

              <div class="layer-item l-top">
                <div class="layer-badge text-mono">EBENE 2 (MITTE &bull; VOR KAMERAS &amp; CLIPS)</div>
                <div class="layer-name">UIC Overlay Browser-Quelle (1920 &times; 1080)</div>
                <div class="layer-desc">Stanzt die 16:9-Kamerafenster in <strong>2. Pregame</strong> und das 1280&times;720 Highlight-Fenster in <strong>3. Break</strong> automatisch transparent aus (<code class="inline-code">alpha = 0</code>). Rahmen und Labels liegen so sauber <strong>vor</strong> dem Video!</div>
              </div>

              <div class="layer-item">
                <div class="layer-badge text-mono">EBENE 3 (UNTEN &bull; HINTER DEM OVERLAY)</div>
                <div class="layer-name">Caster-Webcams (Pregame) / Highlight-Clips (Break)</div>
                <div class="layer-desc">Webcams (Duo: 656&times;369px, Solo: 752&times;423px) bzw. deine geschnittenen Spiel-Highlights (Break: 1280&times;720px links) unter das Overlay legen.</div>
              </div>
            </div>
          </div>

          <!-- Replay Scene Layer Stack -->
          <div class="layer-diagram-card">
            <div class="diagram-header text-mono">EBENEN IN 4. REPLAY (LIVE-SPIEL OBEN RECHTS + REPLAY)</div>
            <div class="layer-stack">
              <div class="layer-item l-top">
                <div class="layer-badge text-mono">EBENE 1 (GANZ OBEN)</div>
                <div class="layer-name">UIC Replay Overlay (1920 &times; 1080 &bull; <code class="inline-code">?scene=replay</code>)</div>
                <div class="layer-desc">Liegt ganz oben und legt das <code class="inline-code">INSTANT REPLAY &bull; POWERED BY RIFTOPS</code> Modul oben links sowie den 544&times;306 Rahmen + <code class="inline-code">LIVE</code>-Label oben rechts <strong>über</strong> beide Videoquellen.</div>
              </div>

              <div class="layer-item">
                <div class="layer-badge text-mono">EBENE 2 (MITTE &bull; OBEN RECHTS IM PIP-RAHMEN)</div>
                <div class="layer-name">Aktuelles Live-Spiel (skaliert auf 544 &times; 306, 16:9)</div>
                <div class="layer-desc">Deine Live-Spielaufnahme als kleine 16:9-Quelle (544&times;306px) oben rechts hinter den PiP-Rahmen des Overlays legen.</div>
              </div>

              <div class="layer-item">
                <div class="layer-badge text-mono">EBENE 3 (UNTEN / HINTERGRUND)</div>
                <div class="layer-name">Replay-Quelle (1920 &times; 1080 Vollbild)</div>
                <div class="layer-desc">Dein Replay-Puffer / Highlight-Clip läuft auf 1920&times;1080 im Hintergrund und ist durch das transparente Overlay komplett sichtbar.</div>
              </div>
            </div>
          </div>

        </div>
      </section>

      <!-- =====================================================================
           4. URL PARAMETERS REFERENCE TABLE
           ===================================================================== -->
      <section id="url-params" class="params-section">
        <div class="section-tag"># REFERENZ</div>
        <h2 class="section-heading">URL-PARAMETER</h2>
        <p class="section-sub">
          Alle Einstellungen des Konfigurators werden direkt über diese URL-Parameter übergeben:
        </p>

        <div class="table-wrap">
          <table class="params-table">
            <thead>
              <tr class="text-mono">
                <th scope="col">Parameter</th>
                <th scope="col">Werte</th>
                <th scope="col">Standard</th>
                <th scope="col">Wirkung</th>
              </tr>
            </thead>
            <tbody class="text-mono">
              <tr>
                <td><code>scene</code></td>
                <td><code>start</code> | <code>pregame</code> | <code>break</code> | <code>replay</code> | <code>end</code></td>
                <td><code>pregame</code></td>
                <td>Wählt die aktive Szene (<code>1. Start</code>, <code>2. Pregame</code>, <code>3. Break</code>, <code>4. Replay</code>, <code>5. End</code>). Unterstützt abwärtskompatibel auch <code>starting</code>, <code>pause</code>, <code>ingame</code> und <code>ending</code>.</td>
              </tr>
              <tr>
                <td><code>team</code></td>
                <td><code>auto</code> | <code>none</code> | <code>prime</code> | <code>hydra</code> | <code>dynasty</code> | <code>tempest</code> | <code>spark</code> | <code>phoenix</code> | <code>eclipse</code> | <code>vakuum</code> | <code>cyber</code> | <code>nova</code> | <code>strawhats</code> | <code>dinonuggets</code> | <code>raiders</code> | <code>ascend</code></td>
                <td><code>auto</code></td>
                <td>Wählt das Team und schaltet automatisch auf dessen nächstes anstehendes Spiel. <code>auto</code> wählt das chronologisch nächste Spiel aller UIC-Teams; <code>none</code> aktiviert das klassische Orga-Overlay komplett ohne Team- und Spieltagsdaten.</td>
              </tr>
              <tr>
                <td><code>matchday</code></td>
                <td>Ganzzahl (z. B. <code>1</code> &ndash; <code>7</code>) oder Match-ID</td>
                <td>–</td>
                <td>Optional: Wählt gezielt einen bestimmten Prime League Spieltag des angegebenen Teams aus (z. B. <code>?team=prime&amp;matchday=4</code>). Ohne diesen Parameter lädt <code>?team=</code> automatisch das nächste Spiel des Teams.</td>
              </tr>
              <tr>
                <td><code>layout</code></td>
                <td><code>cam-2</code> | <code>cam-1</code> | <code>none</code></td>
                <td><code>cam-2</code></td>
                <td>Nur in <code>scene=pregame</code>: 2 transparente Caster-Kamerafenster (656&times;369), 1 Caster-Kamerafenster (752&times;423) oder Spielplan-Ansicht ohne Kameras.</td>
              </tr>
              <tr>
                <td><code>chat</code></td>
                <td><code>1</code> | <code>0</code></td>
                <td><code>1</code></td>
                <td>Nur in <code>scene=pregame</code>: Blendet das rechte Chat-Fenster ein (<code>1</code>) oder aus (<code>0</code>, Kameras zentriert).</td>
              </tr>
              <tr>
                <td><code>chat_url</code></td>
                <td>Streamlabs Chat-Box Widget-URL (<code>https://streamlabs.com/widgets/chat-box/v1/...</code>)</td>
                <td>–</td>
                <td>Bettet den angegebenen Streamlabs Twitch-Chat direkt in das rechte Chat-Fenster der Pregame-Szene ein.</td>
              </tr>
              <tr>
                <td><code>alert_url</code></td>
                <td>Streamlabs Alert-Box Widget-URL (<code>https://streamlabs.com/alert-box/v3/...</code>)</td>
                <td>–</td>
                <td>Bettet die Streamlabs Alert-Box (Follows, Subs, Raids) direkt als transparente Ebene oben mittig in das Overlay ein.</td>
              </tr>
              <tr>
                <td><code>timer</code></td>
                <td>Ganzzahl (z. B. <code>3</code>, <code>5</code>, <code>10</code>)</td>
                <td><code>5</code></td>
                <td>Countdown-Dauer in Minuten ab Aufruf (in <code>start</code> und <code>break</code>).</td>
              </tr>
              <tr>
                <td><code>start</code></td>
                <td><code>19:00</code> | <code>auto</code> | ISO-Zeit (<code>2026-11-08T19:00</code>)</td>
                <td>–</td>
                <td>Feste Zielzeit für den Countdown (übersteht ein Neuladen der Quelle). <code>auto</code> nutzt die angesetzte Startzeit des nächsten Spiels des aktiven Teams.</td>
              </tr>
              <tr>
                <td><code>start_view</code></td>
                <td><code>auto</code> | <code>matchup</code> | <code>table</code> | <code>roster</code> | <code>stats</code></td>
                <td><code>auto</code></td>
                <td>Nur in <code>scene=start</code>: Automatischer 10-Sekunden-Wechsel (<code>auto</code>) oder Fixierung auf eine einzelne Ansicht.</td>
              </tr>
              <tr>
                <td><code>ticker</code></td>
                <td><code>top</code> | <code>off</code></td>
                <td><code>top</code></td>
                <td>Blendet den oberen 54px Prime League Spieltags-Ticker ein oder aus (in <code>start</code> und <code>replay</code> ist der Ticker immer ausgeblendet).</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

    </div>
  </div>
</Layout>

<script>
  const UIC_STREAMLABS_CHAT_URL = 'https://streamlabs.com/widgets/chat-box/v1/D7769C1733A92891C9DD6E97721E8C7B810F1F643040F459AA1115B9ADDF3190ED6927A02D528DEFF92F28B796E8EFC3E741421C558EF20995B6B219569ACB53E969D889639937EFF750AEE1FA6385560F583B8C487DBF1D9CB11BB3A73E2402267550313775ABB986B2556D2F2E0D3C606FC7F096BF6E887826053DEE';

  const monitorWrapper = document.getElementById('monitor-wrapper');
  const previewIframe = document.getElementById('obs-preview-iframe') as HTMLIFrameElement | null;

  const sceneSelect = document.getElementById('scene-selector') as HTMLSelectElement | null;
  const teamSelect = document.getElementById('team-selector') as HTMLSelectElement | null;
  const layoutSelect = document.getElementById('layout-selector') as HTMLSelectElement | null;
  const chatSelect = document.getElementById('chat-selector') as HTMLSelectElement | null;
  const startViewSelect = document.getElementById('start-view-selector') as HTMLSelectElement | null;
  const timerSelect = document.getElementById('timer-selector') as HTMLSelectElement | null;
  const startTimeInput = document.getElementById('start-time-input') as HTMLInputElement | null;
  const tickerSelect = document.getElementById('ticker-selector') as HTMLSelectElement | null;
  const chatUrlInput = document.getElementById('chat-url-input') as HTMLInputElement | null;
  const alertUrlInput = document.getElementById('alert-url-input') as HTMLInputElement | null;

  const btnFillUicChat = document.getElementById('btn-fill-uic-chat');
  const btnClearChat = document.getElementById('btn-clear-chat');
  const btnClearAlert = document.getElementById('btn-clear-alert');
  const chatUrlStatus = document.getElementById('chat-url-status');
  const alertUrlStatus = document.getElementById('alert-url-status');

  const groupLayout = document.getElementById('group-layout');
  const groupChat = document.getElementById('group-chat');
  const groupStartView = document.getElementById('group-start-view');
  const groupTimerMin = document.getElementById('group-timer-min');
  const groupTimerTarget = document.getElementById('group-timer-target');
  const groupTicker = document.getElementById('group-ticker');
  const groupChatUrl = document.getElementById('group-chat-url');

  const currentObsUrl = document.getElementById('current-obs-url');
  const openPureLink = document.getElementById('open-pure-link') as HTMLAnchorElement | null;
  const btnCopy = document.getElementById('btn-copy-url');
  const copyBtnText = document.getElementById('copy-btn-text');

  function resizePreviewScale() {
    if (!monitorWrapper || !previewIframe) return;
    const containerWidth = monitorWrapper.clientWidth;
    const scale = containerWidth / 1920;
    previewIframe.style.transform = `scale(${scale})`;
  }

  window.addEventListener('resize', resizePreviewScale);
  if (typeof ResizeObserver !== 'undefined' && monitorWrapper) {
    new ResizeObserver(resizePreviewScale).observe(monitorWrapper);
  }
  resizePreviewScale();

  function normalizeStreamlabsInput(raw: string, widgetType: 'chat' | 'alert'): { url: string; valid: boolean } {
    const s = raw.trim();
    if (!s) return { url: '', valid: false };
    if (/^[A-Fa-f0-9]{24,}$/.test(s)) {
      return {
        url: widgetType === 'alert'
          ? `https://streamlabs.com/alert-box/v3/${s}`
          : `https://streamlabs.com/widgets/chat-box/v1/${s}`,
        valid: true
      };
    }
    const candidate = /^(www\.)?streamlabs\.com\//i.test(s) ? `https://${s}` : s;
    try {
      const u = new URL(candidate);
      if (u.protocol === 'https:' || u.protocol === 'http:') {
        return { url: u.href, valid: true };
      }
    } catch {
      // invalid URL
    }
    return { url: s, valid: false };
  }

  let lastTeamValue = teamSelect ? teamSelect.value : 'auto';
  let lastLoadedPreviewUrl = '';
  let inputDebounceTimer: ReturnType<typeof setTimeout> | null = null;

  function updateGenerator() {
    if (!sceneSelect || !previewIframe) return;

    const scene = sceneSelect.value;
    const rawTeamVal = teamSelect ? teamSelect.value : 'auto';
    const [team, explicitMatchday] = rawTeamVal.includes(':')
      ? rawTeamVal.split(':')
      : [rawTeamVal, ''];

    // When switching to/from "none", automatically toggle the ticker default
    if (team !== lastTeamValue && tickerSelect) {
      if (team === 'none') {
        tickerSelect.value = 'off';
      } else if (lastTeamValue === 'none') {
        tickerSelect.value = 'top';
      }
      lastTeamValue = team;
    }

    const layout = layoutSelect ? layoutSelect.value : 'cam-2';
    const chat = chatSelect ? chatSelect.value : '1';
    const startView = startViewSelect ? startViewSelect.value : 'auto';
    const timer = timerSelect ? timerSelect.value : '5';
    const startTime = startTimeInput ? startTimeInput.value.trim() : '';
    const ticker = tickerSelect ? tickerSelect.value : 'top';
    const rawChatUrl = chatUrlInput ? chatUrlInput.value.trim() : '';
    const rawAlertUrl = alertUrlInput ? alertUrlInput.value.trim() : '';

    const parsedChat = normalizeStreamlabsInput(rawChatUrl, 'chat');
    const parsedAlert = normalizeStreamlabsInput(rawAlertUrl, 'alert');

    if (btnClearChat) btnClearChat.style.display = rawChatUrl ? 'inline-flex' : 'none';
    if (btnClearAlert) btnClearAlert.style.display = rawAlertUrl ? 'inline-flex' : 'none';

    if (chatUrlStatus) {
      if (!rawChatUrl) {
        chatUrlStatus.style.display = 'none';
      } else if (parsedChat.valid) {
        chatUrlStatus.style.display = 'block';
        chatUrlStatus.className = 'dock-field-status is-ok text-mono';
        chatUrlStatus.textContent = '✓ Streamlabs Chat-Widget verbunden (Live-Nachrichten erscheinen im Chat-Fenster sobald im Stream geschrieben wird)';
      } else {
        chatUrlStatus.style.display = 'block';
        chatUrlStatus.className = 'dock-field-status is-warn text-mono';
        chatUrlStatus.textContent = 'Bitte vollständigen Streamlabs-Link (https://streamlabs.com/widgets/chat-box/v1/...) oder Token eingeben';
      }
    }

    if (alertUrlStatus) {
      if (!rawAlertUrl) {
        alertUrlStatus.style.display = 'none';
      } else if (parsedAlert.valid) {
        alertUrlStatus.style.display = 'block';
        alertUrlStatus.className = 'dock-field-status is-ok text-mono';
        alertUrlStatus.textContent = '✓ Streamlabs Alert-Box verbunden (Alerts werden transparent im Overlay eingeblendet)';
      } else {
        alertUrlStatus.style.display = 'block';
        alertUrlStatus.className = 'dock-field-status is-warn text-mono';
        alertUrlStatus.textContent = 'Bitte vollständigen Streamlabs-Link (https://streamlabs.com/alert-box/v3/...) oder Token eingeben';
      }
    }

    const isStart = scene === 'start';
    const isPregame = scene === 'pregame';
    const isBreak = scene === 'break';
    const isReplay = scene === 'replay';

    // Show/hide only the controls that apply to the selected scene & mode
    if (groupLayout) groupLayout.style.display = isPregame ? 'flex' : 'none';
    if (groupChat) groupChat.style.display = isPregame ? 'flex' : 'none';
    if (groupChatUrl) groupChatUrl.style.display = (isPregame && chat === '1') ? 'flex' : 'none';
    if (groupStartView) groupStartView.style.display = (isStart && team !== 'none') ? 'flex' : 'none';
    if (groupTimerMin) groupTimerMin.style.display = (isStart || isBreak) ? 'flex' : 'none';
    if (groupTimerTarget) groupTimerTarget.style.display = (isStart || isBreak) ? 'flex' : 'none';
    if (groupTicker) groupTicker.style.display = (!isStart && !isReplay) ? 'flex' : 'none';

    const q = new URLSearchParams();
    q.set('scene', scene);

    if (team && team !== 'auto') {
      q.set('team', team);
    }
    if (explicitMatchday) {
      q.set('matchday', explicitMatchday);
    }

    if (isPregame) {
      if (layout !== 'cam-2') q.set('layout', layout);
      if (chat === '0') {
        q.set('chat', '0');
      } else if (parsedChat.valid) {
        q.set('chat_url', parsedChat.url);
      }
    }

    if (parsedAlert.valid) {
      q.set('alert_url', parsedAlert.url);
    }

    if (isStart || isBreak) {
      if (startTime) q.set('start', startTime);
      else if (timer !== '5') q.set('timer', timer);

      if (isStart && team !== 'none' && startView !== 'auto') {
        q.set('start_view', startView);
      }
    }

    if (!isStart && !isReplay) {
      if (team === 'none' && ticker === 'top') {
        q.set('ticker', 'top');
      } else if (team !== 'none' && ticker === 'off') {
        q.set('ticker', 'off');
      }
    }

    const rawQuery = q.toString().replace(/%3A/gi, ':').replace(/%2F/gi, '/');
    const queryString = rawQuery ? `?${rawQuery}` : '';
    const basePath = window.location.pathname.replace(/\/(obs|overlay).*$/, '');
    const relativeUrl = `${basePath}/overlay${queryString}`;
    const fullUrl = `${window.location.origin}${relativeUrl}`;

    if (relativeUrl !== lastLoadedPreviewUrl) {
      lastLoadedPreviewUrl = relativeUrl;
      previewIframe.src = relativeUrl;
    }
    if (currentObsUrl) currentObsUrl.textContent = fullUrl;
    if (openPureLink) openPureLink.href = relativeUrl;

    setTimeout(resizePreviewScale, 100);
  }

  [sceneSelect, teamSelect, layoutSelect, chatSelect, startViewSelect, timerSelect, startTimeInput, tickerSelect, chatUrlInput, alertUrlInput].forEach((el) => {
    if (!el) return;
    if (el.tagName === 'INPUT') {
      el.addEventListener('input', () => {
        if (inputDebounceTimer) clearTimeout(inputDebounceTimer);
        inputDebounceTimer = setTimeout(updateGenerator, 180);
      });
      el.addEventListener('change', updateGenerator);
    } else {
      el.addEventListener('change', updateGenerator);
    }
  });

  if (btnFillUicChat && chatUrlInput) {
    btnFillUicChat.addEventListener('click', () => {
      chatUrlInput.value = UIC_STREAMLABS_CHAT_URL;
      updateGenerator();
    });
  }

  if (btnClearChat && chatUrlInput) {
    btnClearChat.addEventListener('click', () => {
      chatUrlInput.value = '';
      updateGenerator();
    });
  }

  if (btnClearAlert && alertUrlInput) {
    btnClearAlert.addEventListener('click', () => {
      alertUrlInput.value = '';
      updateGenerator();
    });
  }

  // Scene Cards "Im Konfigurator laden" Buttons
  document.querySelectorAll<HTMLButtonElement>('.load-scene-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetScene = btn.getAttribute('data-scene');
      if (targetScene && sceneSelect) {
        sceneSelect.value = targetScene;
        if (targetScene === 'break' && timerSelect) timerSelect.value = '3';
        if (targetScene === 'start' && timerSelect) timerSelect.value = '5';
        updateGenerator();
        document.getElementById('preview-generator')?.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });

  if (btnCopy && currentObsUrl) {
    btnCopy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(currentObsUrl.textContent || '');
        if (copyBtnText) {
          const original = copyBtnText.textContent;
          copyBtnText.textContent = '✓ KOPIERT!';
          setTimeout(() => {
            copyBtnText.textContent = original;
          }, 2000);
        }
      } catch (err) {
        console.warn('Clipboard write error:', err);
      }
    });
  }

  updateGenerator();
</script>

<style>
  .obs-page {
    background-color: var(--bg-void);
    min-height: 100vh;
  }

  .obs-container {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--container-pad);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: var(--space-xl);
    transition: color var(--transition-fast);
  }
  .back-link:hover {
    color: var(--text-white);
  }

  .obs-header {
    margin-bottom: var(--space-3xl);
  }

  .obs-title {
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1.05;
    margin: var(--space-xs) 0 var(--space-md);
  }

  .obs-lead {
    font-size: 1.15rem;
    color: var(--text-secondary);
    line-height: 1.6;
    max-width: 860px;
    margin-bottom: var(--space-xl);
  }

  .quick-nav-strip {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .quick-nav-pill {

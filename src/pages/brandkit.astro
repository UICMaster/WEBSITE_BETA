<script>
  // 1. Copy SVG Markup to Clipboard
  document.querySelectorAll<HTMLButtonElement>('[data-copy-svg]').forEach((btn) => {
    const original = btn.textContent;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', () => {
      const svgCode = btn.getAttribute('data-copy-svg');
      if (!svgCode) return;
      navigator.clipboard?.writeText(svgCode).catch(() => {});
      btn.textContent = 'SVG KOPIERT ✓';
      btn.classList.add('is-copied');
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-copied');
      }, 1800);
    });
  });

  // 2. Copy HEX Color Swatches to Clipboard
  document.querySelectorAll<HTMLButtonElement>('[data-copy-color]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hex = btn.getAttribute('data-copy-color');
      const statusEl = btn.querySelector<HTMLElement>('[data-color-status]');
      if (!hex || !statusEl) return;
      navigator.clipboard?.writeText(hex).catch(() => {});
      statusEl.textContent = 'KOPIERT ✓';
      btn.classList.add('is-copied');
      setTimeout(() => {
        statusEl.textContent = hex;
        btn.classList.remove('is-copied');
      }, 1500);
    });
  });

  // 3. Copy Official Press Boilerplate Text to Clipboard
  document.querySelectorAll<HTMLButtonElement>('[data-copy-text]').forEach((btn) => {
    const original = btn.textContent;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy-text');
      if (!text) return;
      navigator.clipboard?.writeText(text).catch(() => {});
      btn.textContent = 'KOPIERT ✓';
      btn.classList.add('is-copied');
      if (resetTimer) clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('is-copied');
      }, 1800);
    });
  });
</script>


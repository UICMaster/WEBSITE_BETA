---
// src/pages/brandkit.astro
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import rawTeams from '../../data/teams.json';
import { discordInviteUrl } from '../utils/uicData';

const logoSvgPath = path.resolve(process.cwd(), 'public', 'assets', 'logo', 'logo.svg');
const rawLogoSvg = fs.existsSync(logoSvgPath) ? fs.readFileSync(logoSvgPath, 'utf8').trim() : '';

const teamsMap = (rawTeams || {}) as Record<string, any>;
const teamAssetMap = import.meta.glob('/public/assets/teams/*.{webp,png,jpg,svg}');

const activeTeamEmblems = Object.entries(teamsMap)
  .filter(([, meta]) => Boolean(meta?.primeLeagueId))
  .map(([key, meta]) => {
    const hasWebp = `/public/assets/teams/${key}.webp` in teamAssetMap;
    const hasPng = `/public/assets/teams/${key}.png` in teamAssetMap;
    const fileSrc = hasWebp
      ? `/assets/teams/${key}.webp`
      : hasPng
        ? `/assets/teams/${key}.png`
        : null;
    const formatLabel = hasWebp ? 'WEBP' : hasPng ? 'PNG' : null;
    return {
      key,
      name: meta.teamDisplay || `UIC ${key.toUpperCase()}`,
      tier: meta.tier || 'Prime League',
      fileSrc,
      formatLabel
    };
  });

const primaryColors = [
  {
    name: 'Tiefschwarz (Void)',
    hex: '#000000',
    rgb: '0, 0, 0',
    token: '--bg-void',
    role: 'Primärer Seitenhintergrund & Canvas',
    contrast: '21:1 mit #FFFFFF',
    border: 'rgba(255, 255, 255, 0.32)',
    darkInk: false
  },
  {
    name: 'Karbon Obsidian',
    hex: '#08080A',
    rgb: '8, 8, 10',
    token: '--bg-surface',
    role: 'Abgesetzte Flächen & Footer-Ebene',
    contrast: '19.8:1 mit #FFFFFF',
    border: 'rgba(255, 255, 255, 0.24)',
    darkInk: false
  },
  {
    name: 'Karten-Schiefer',
    hex: '#0D0D10',
    rgb: '13, 13, 16',
    token: '--bg-card',
    role: 'Bento-Module, Karten & Boxen',
    contrast: '18.9:1 mit #FFFFFF',
    border: 'rgba(255, 255, 255, 0.22)',
    darkInk: false
  },
  {
    name: 'Reines Weiß (Primary)',
    hex: '#FFFFFF',
    rgb: '255, 255, 255',
    token: '--text-white',
    role: 'Wappen, Überschriften & Primär-CTAs',
    contrast: '21:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.45)',
    darkInk: true
  },
  {
    name: 'Sekundärgrau',
    hex: '#D4D4D8',
    rgb: '212, 212, 216',
    token: '--text-secondary',
    role: 'Fließtext, Beschreibungen & Listen',
    contrast: '14.3:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.25)',
    darkInk: true
  },
  {
    name: 'Stahl-Grau (Muted)',
    hex: '#A1A1AA',
    rgb: '161, 161, 170',
    token: '--text-muted',
    role: 'Metadaten, Kategorien & Captions',
    contrast: '8.2:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.2)',
    darkInk: true
  }
];

const statusColors = [
  {
    name: 'Bestätigt / Sieg',
    hex: '#10B981',
    rgb: '16, 185, 129',
    token: '--state-win',
    usage: 'Ausschließlich für bestätigte Spieltermine und gewonnene Serien.'
  },
  {
    name: 'Offen / Unentschieden',
    hex: '#F59E0B',
    rgb: '245, 158, 11',
    token: '--state-draw',
    usage: 'Ausschließlich für unbestätigte Termine, Unentschieden & Ruhmeshalle-Siegel.'
  },
  {
    name: 'Niederlage / Warnung',
    hex: '#F43F5E',
    rgb: '244, 63, 94',
    token: '--state-loss',
    usage: 'Ausschließlich für Niederlagen, Live-Statuspunkte und Fehlerhinweise.'
  }
];

const logoPlaceholders = [
  {
    id: 'LOC-01',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Wortmarke / Horizontal Lockup',
    spec: 'SVG & PNG • Empfohlen 1600 × 400 px • Transparent',
    desc: 'Kombination aus UIC Wappen links und „ULTRA INSTINCT CREW“ Schriftzug rechts für Web-Header, Stream-Banderolen und Sponsoren-Leisten.',
    previewType: 'horizontal'
  },
  {
    id: 'LOC-02',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Vertikales Lockup (Stacked)',
    spec: 'SVG & PNG • Empfohlen 1000 × 1200 px • Transparent',
    desc: 'Zentriertes Wappen über zweizeiliger Wortmarke für Poster, Pokale, Turnier-Kacheln und Print-Materialien.',
    previewType: 'stacked'
  },
  {
    id: 'LOC-03',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Print-Wappen (Dunkel auf Hell)',
    spec: 'SVG & EPS • #000000 Vollton • CMYK-tauglich',
    desc: 'Dedizierte tiefschwarze Reinzeichnungs-Datei für weiße Trikots, Verträge, Briefbögen und helle Partner-Hintergründe.',
    previewType: 'dark-ink'
  }
];

const mediaPlaceholders = [
  {
    code: 'MEDIA-01',
    category: 'SOCIAL MEDIA AVATARE',
    title: 'Profilbilder-Set (1:1)',
    format: '1000 × 1000 px • PNG / WEBP',
    desc: 'Zentrierte Profilbilder mit vorkalibrierter Safe-Zone für runde Zuschnitte auf Discord, Twitch, X, YouTube und Instagram.',
    aspect: '1 / 1'
  },
  {
    code: 'MEDIA-02',
    category: 'KANAL-BANNER',
    title: 'Header & Offline-Screens',
    format: '1500 × 500 px / 2560 × 1440 px',
    desc: 'Einheitliche Kopfzeilen-Grafiken für Twitch-Panels, X-Header, YouTube-Kanalbanner und Prime-League-Teamseiten.',
    aspect: '16 / 9'
  },
  {
    code: 'MEDIA-03',
    category: 'SPIELTAG & ERGEBNISSE',
    title: 'Matchday- & Score-Templates',
    format: '1080 × 1350 px / 1920 × 1080 px',
    desc: 'Bearbeitbare Figma- & PSD-Vorlagen für Aufstellungs-Ankündigungen, Endergebnisse und Split-Rückblicke.',
    aspect: '4 / 5'
  },
  {
    code: 'MEDIA-04',
    category: 'TRIKOTS & MERCH',
    title: 'Jersey- & Spized-Richtlinie',
    format: 'PDF Vektor / PSD Mockups',
    desc: 'Verbindliche Positionierung von Hauptwappen, Spieler-Nicknames und Sponsoren-Logos auf offizieller Teamkleidung.',
    aspect: '1 / 1'
  },
  {
    code: 'MEDIA-05',
    category: 'CO-BRANDING',
    title: 'Partner- & Event-Lockups',
    format: 'SVG / PNG • 16:9 Trennlinie',
    desc: 'Standardisierte „UIC × Partner“-Kombinationen mit definierter Trennlinie und ausgeglichener optischer Logogröße.',
    aspect: '16 / 9'
  },
  {
    code: 'MEDIA-06',
    category: 'PRESSE & MEDIA',
    title: 'Foto- & Presse-Kit',
    format: 'JPG / WEBP • Hochauflösend',
    desc: 'Freigestellte Spieler-Porträts, Event-Eindrücke und freigegebene Team-Aufnahmen für Berichterstattung.',
    aspect: '16 / 10'
  }
];
---

<Layout
  title="Brandkit & Markenrichtlinien | Ultra Instinct Crew"
  description="Offizielles Brandkit und Corporate Design Richtlinien der Ultra Instinct Crew (UIC): Logos, Schutzzonen, Monochrom-Farbsystem, Typografie, Team-Wappen und Medien-Vorlagen."
>
  <div class="brandkit-page section-pad">
    <div class="container bk-container">

      <!-- Top Back Bar -->
      <div class="bk-topbar">
        <a href="/#medien" class="back-link text-mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>ZURÜCK ZU MEDIEN &amp; VORLAGEN</span>
        </a>

        <div class="bk-version-pills text-mono">
          <span class="ver-pill">VERSION 1.0</span>
          <span class="ver-pill is-highlight">STAND 2026</span>
        </div>
      </div>

      <!-- Page Header -->
      <header class="bk-header">
        <div class="section-badge-pill">CORPORATE DESIGN &amp; RICHTLINIEN</div>
        <h1 class="bk-title">
          UIC MARKE &amp; <span class="text-gradient">BRANDKIT</span>
        </h1>
        <p class="bk-lead">
          Verbindlicher Leitfaden für die visuelle Identität der Ultra Instinct Crew. Entwickelt für Partner, Turnierveranstalter, Caster, Medienschaffende und alle Teams innerhalb unserer Organisation.
        </p>

        <!-- Action Strip & Anchor Navigation -->
        <div class="bk-controls-row">
          <nav class="bk-toc text-mono" aria-label="Brandkit-Bereiche">
            <a href="#markenkern" class="toc-chip">01 Markenkern</a>
            <a href="#logos" class="toc-chip">02 Logo-System</a>
            <a href="#regeln" class="toc-chip">03 Schutzzone &amp; Regeln</a>
            <a href="#farben" class="toc-chip">04 Farbsystem</a>
            <a href="#typografie" class="toc-chip">05 Typografie</a>
            <a href="#teams-wappen" class="toc-chip">06 Team-Wappen</a>
            <a href="#platzhalter" class="toc-chip">07 Vorlagen</a>
            <a href="#nutzung" class="toc-chip">08 Nutzungsrechte</a>
          </nav>

          <button
            type="button"
            class="btn btn-outline btn-sm bundle-placeholder-btn text-mono"
            disabled
            aria-disabled="true"
            title="Das gebündelte ZIP-Archiv wird ergänzt, sobald alle ausstehenden Vorlagen hochgeladen sind."
          >
            <span>GESAMTPAKET (.ZIP) &bull; PLATZHALTER</span>
          </button>
        </div>
      </header>

      <!-- =================================================================
           01. MARKENKERN & SCHREIBWEISE
           ================================================================= -->
      <section id="markenkern" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">01 / IDENTITÄT</span>
          <h2 class="bk-sec-title">MARKENKERN &amp; SCHREIBWEISE</h2>
          <p class="bk-sec-desc">
            Konsistenz beginnt bei korrekten Begriffen. So werden die Organisation, unsere Teams und die Community offiziell benannt.
          </p>
        </div>

        <div class="identity-grid">
          <article class="bento-card id-card">
            <span class="id-label text-mono">VOLLSTÄNDIGER NAME</span>
            <h3 class="id-value">Ultra Instinct Crew</h3>
            <p class="id-note">
              Immer ausgeschrieben in Überschriften, Rechtstexten und offiziellen Ankündigungen. Die Abkürzung <strong>UIC</strong> steht für das Kürzel in Spielplänen, Tags und Badges.
            </p>
          </article>

          <article class="bento-card id-card">
            <span class="id-label text-mono">STRUKTUR &amp; BEGRIFFE</span>
            <h3 class="id-value">Organisation &bull; Community &bull; Teams</h3>
            <p class="id-note">
              Wir bezeichnen uns ausschließlich als <strong>Organisation</strong> mit angeschlossener <strong>Community</strong> und aktiven <strong>Teams</strong>. Begriffe wie <em>„Verein“</em>, <em>„e.V.“</em> oder <em>„GbR“</em> werden nicht verwendet.
            </p>
          </article>

          <article class="bento-card id-card">
            <span class="id-label text-mono">GESTALTUNGSPRINZIP</span>
            <h3 class="id-value">Scharf &bull; Monochrom &bull; Präzise</h3>
            <p class="id-note">
              Tiefschwarze Flächen, reines Weiß für Kernaussagen, feine Haarlinien-Rahmen und Verzicht auf verspielte Verläufe. Farbe wird ausschließlich funktional für Match- und Statusanzeigen eingesetzt.
            </p>
          </article>
        </div>
      </section>

      <!-- =================================================================
           02. LOGO-SYSTEM & DOWNLOADS
           ================================================================= -->
      <section id="logos" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">02 / LOGOMARKEN</span>
          <h2 class="bk-sec-title">PRIMÄRLOGO &amp; VARIANTEN</h2>
          <p class="bk-sec-desc">
            Das UIC-Wappen ist das zentrale Erkennungszeichen der Organisation. Für digitale Medien steht die verlustfreie SVG-Vektordatei im Vordergrund.
          </p>
        </div>

        <!-- Primary Crest Showcase (Real Uploaded Asset) -->
        <div class="bento-card logo-master-card">
          <div class="lm-stage" id="master-logo-stage" data-bg="dark">
            <div class="lm-stage-controls text-mono">
              <span class="lm-status-pill is-live">VERFÜGBAR &bull; MASTER</span>
              <div class="stage-bg-switch" role="group" aria-label="Hintergrund-Vorschau wechseln">
                <button type="button" class="bg-sw-btn is-active" data-stage-bg="dark">SCHWARZ</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="slate">KARBON</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="grid">RASTER</button>
              </div>
            </div>

            <div class="lm-preview-wrap">
              <img
                src="/assets/logo/logo.svg"
                alt="Offizielles Ultra Instinct Crew Vektor-Wappen"
                class="lm-logo-img"
                width="160"
                height="160"
              />
            </div>

            <span class="lm-dim-caption text-mono">VIEWBOX 1000 &times; 1000 &bull; SYMMETRISCHER VEKTORPFAD</span>
          </div>

          <div class="lm-details">
            <div class="asset-meta-row text-mono">
              <span class="meta-type">PRIMÄRMARKE (WEISS)</span>
              <span class="meta-spec">1:1 QUADRATISCH</span>
            </div>
            <h3 class="lm-title">UIC ORGANISATIONS-WAPPEN</h3>
            <p class="lm-desc">
              Standard-Logo in reinem Weiß (<code>#FFFFFF</code>) auf transparentem Hintergrund. Optimal für dunkle UI-Flächen, Twitch-Overlays, Turnier-Brackets und Social Media.
            </p>

            <div class="lm-specs-grid text-mono">
              <div class="spec-mini">
                <span class="sm-lbl">VEKTOR</span>
                <span class="sm-val">SVG (1000&times;1000)</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">RASTER</span>
                <span class="sm-val">PNG Hochauflösend</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">SEITENVERHÄLTNIS</span>
                <span class="sm-val">1 : 1</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">FARBE</span>
                <span class="sm-val">#FFFFFF</span>
              </div>
            </div>

            <div class="lm-actions">
              <a href="/assets/logo/logo.svg" download="uic-logo.svg" class="btn btn-primary btn-sm">
                SVG HERUNTERLADEN ↓
              </a>
              <a href="/assets/logo/logo.png" download="uic-logo.png" class="btn btn-outline btn-sm">
                PNG HERUNTERLADEN ↓
              </a>
              {rawLogoSvg && (
                <button
                  type="button"
                  class="btn btn-outline btn-sm text-mono"
                  id="copy-svg-btn"
                  data-copy-svg={rawLogoSvg}
                >
                  SVG-CODE KOPIEREN
                </button>
              )}
            </div>
          </div>
        </div>

        <!-- Secondary Lockups & Un-uploaded Placeholders -->
        <div class="lockups-grid">
          {logoPlaceholders.map((item) => (
            <article class="placeholder-card">
              <div class="ph-header text-mono">
                <span class="ph-code">{item.id}</span>
                <span class="ph-badge">{item.badge}</span>
              </div>

              <div class={`ph-stage ph-stage-${item.previewType}`} aria-hidden="true">
                {item.previewType === 'horizontal' && (
                  <div class="ph-mock-horizontal">
                    <span class="ph-mock-crest-box">UIC</span>
                    <span class="ph-mock-wordbar">ULTRA INSTINCT CREW</span>
                  </div>
                )}
                {item.previewType === 'stacked' && (
                  <div class="ph-mock-stacked">
                    <span class="ph-mock-crest-box">UIC</span>
                    <span class="ph-mock-wordbar short">ULTRA INSTINCT CREW</span>
                  </div>
                )}
                {item.previewType === 'dark-ink' && (
                  <div class="ph-mock-darkink">
                    <img
                      src="/assets/logo/logo.svg"
                      alt=""
                      width="68"
                      height="68"
                      class="ph-dark-preview-img"
                    />
                  </div>
                )}
                <span class="ph-overlay-label text-mono">PLATZHALTER</span>
              </div>

              <div class="ph-body">
                <h3 class="ph-title">{item.title}</h3>
                <span class="ph-spec text-mono">{item.spec}</span>
                <p class="ph-desc">{item.desc}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- =================================================================
           03. SCHUTZZONE, MINDESTGRÖSSE & DO'S / DON'TS
           ================================================================= -->
      <section id="regeln" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">03 / ANWENDUNGSREGELN</span>
          <h2 class="bk-sec-title">SCHUTZZONE, MINDESTGRÖSSEN &amp; DO / DON'T</h2>
          <p class="bk-sec-desc">
            Klare Abstands- und Kontrastregeln sichern die Lesbarkeit unseres Wappens auf kleinen Handy-Displays ebenso wie auf großen Turnier-Bühnen.
          </p>
        </div>

        <div class="rules-split">
          <!-- Clearspace Diagram -->
          <div class="bento-card clearspace-card">
            <div class="card-meta">
              <span class="meta-num">SCHUTZZONE</span>
              <span class="meta-tag text-mono">PROPORTIONAL: X = 25% LOGOBREITE</span>
            </div>

            <div class="clearspace-diagram" aria-label="Schematische Darstellung der Logoschutzzone">
              <div class="cs-outer-box">
                <span class="cs-measure cs-top text-mono">x</span>
                <span class="cs-measure cs-bottom text-mono">x</span>
                <span class="cs-measure cs-left text-mono">x</span>
                <span class="cs-measure cs-right text-mono">x</span>
                <div class="cs-inner-box">
                  <img src="/assets/logo/logo.svg" alt="UIC Logo in Schutzzone" width="110" height="110" />
                </div>
              </div>
            </div>

            <div class="minsize-row">
              <div class="ms-box">
                <span class="ms-lbl text-mono">DIGITAL MINIMUM</span>
                <strong class="ms-val text-mono">32 &times; 32 px</strong>
                <span class="ms-sub">Favicon-Ausnahme: 16 px</span>
              </div>
              <div class="ms-box">
                <span class="ms-lbl text-mono">DRUCK &amp; STICKEREI</span>
                <strong class="ms-val text-mono">15 &times; 15 mm</strong>
                <span class="ms-sub">Darunter Feindetails prüfen</span>
              </div>
            </div>
          </div>

          <!-- Do's & Don'ts Grid -->
          <div class="dos-donts-col">
            <div class="dd-group-head text-mono is-do">ERLAUBT (DO)</div>
            <div class="dd-grid">
              <div class="dd-card is-do">
                <div class="dd-preview dark">
                  <img src="/assets/logo/logo.svg" alt="Korrekte Darstellung auf Schwarz" width="52" height="52" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-do text-mono">✓ RICHTIG</span>
                  <p>Unverzerrt und kontrastreich in Reinweiß auf ruhigen dunklen Flächen platzieren.</p>
                </div>
              </div>

              <div class="dd-card is-do">
                <div class="dd-preview split">
                  <span class="dd-badge-inline text-mono">UIC</span>
                  <span class="dd-divider-x">&times;</span>
                  <span class="dd-partner-box text-mono">PARTNER</span>
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-do text-mono">✓ RICHTIG</span>
                  <p>Bei Co-Branding durch saubere Trennlinie und ausgeglichene Schutzzonen trennen.</p>
                </div>
              </div>
            </div>

            <div class="dd-group-head text-mono is-dont">UNTERSAGT (DON'T)</div>
            <div class="dd-grid">
              <div class="dd-card is-dont">
                <div class="dd-preview">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-stretch" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>
                  <p>Proportionen niemals stauchen, strecken oder frei skalieren.</p>
                </div>
              </div>

              <div class="dd-card is-dont">
                <div class="dd-preview">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-recolor" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>
                  <p>Keine Fremdfarben, bunten Neon-Scheine oder Effekte auf das Wappen anwenden.</p>
                </div>
              </div>

              <div class="dd-card is-dont">
                <div class="dd-preview">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-rotate" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>
                  <p>Wappen nicht drehen, kippen, spiegeln oder Kanten beschneiden.</p>
                </div>
              </div>

              <div class="dd-card is-dont">
                <div class="dd-preview low-contrast">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-lowcontrast" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>
                  <p>Nicht auf hellen oder unruhigen Fotos ohne ausreichenden Kontrast einsetzen.</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- =================================================================
           04. FARBSYSTEM & KONTRAST-TOKENS
           ================================================================= -->
      <section id="farben" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">04 / FARBSYSTEM</span>
          <h2 class="bk-sec-title">MONOCHROME PALETTE &amp; FUNKTIONSFARBEN</h2>
          <p class="bk-sec-desc">
            Klick auf eine Farbkarte kopiert den HEX-Code direkt in die Zwischenablage. Statusfarben sind streng für Liga-Telemetrie reserviert.
          </p>
        </div>

        <div class="swatches-grid">
          {primaryColors.map((col) => (
            <button
              type="button"
              class="swatch-card"
              data-copy-color={col.hex}
              title={`HEX-Code ${col.hex} kopieren`}
            >
              <div
                class="swatch-fill"
                style={`background-color: ${col.hex}; border-bottom: 1px solid ${col.border};`}
              >
                <span class={`swatch-hex-badge text-mono ${col.darkInk ? 'is-dark' : ''}`} data-color-status={col.hex}>
                  {col.hex}
                </span>
              </div>
              <div class="swatch-meta">
                <h3 class="swatch-name">{col.name}</h3>
                <div class="swatch-codes text-mono">
                  <span>RGB {col.rgb}</span>

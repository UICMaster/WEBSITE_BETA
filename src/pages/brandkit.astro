---
// src/pages/brandkit.astro
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import rawTeams from '../../data/teams.json';
import { discordInviteUrl, totalTeams } from '../utils/uicData';

interface ResolvedAsset {
  src: string;
  fileName: string;
  ext: string;
  sizeBytes: number;
  sizeLabel: string;
  svgMarkup: string | null;
}

const formatFileSize = (bytes: number): string => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1).replace('.', ',')} MB`;
};

const publicRoot = path.resolve(process.cwd(), 'public');

const resolvePublicAsset = (webPath: string): ResolvedAsset | null => {
  const cleanPath = webPath.startsWith('/') ? webPath.slice(1) : webPath;
  const absPath = path.join(publicRoot, ...cleanPath.split('/'));
  if (!fs.existsSync(absPath)) return null;
  const stat = fs.statSync(absPath);
  if (!stat.isFile()) return null;
  const ext = path.extname(cleanPath).slice(1).toUpperCase();
  const fileName = path.basename(cleanPath);
  const svgMarkup = ext === 'SVG' ? fs.readFileSync(absPath, 'utf8').trim() : null;
  return {
    src: `/${cleanPath}`,
    fileName,
    ext,
    sizeBytes: stat.size,
    sizeLabel: formatFileSize(stat.size),
    svgMarkup
  };
};

const brandkitBundle = resolvePublicAsset('/assets/downloads/uic-brandkit.zip');

// 5 Official Logo Variants (4 core white-on-dark variants + 1 black-on-light variant)
const logoSpecs = [
  {
    id: '01',
    role: 'WAPPEN (ICON)',
    title: 'UIC Wappen',
    dimensions: '484 × 504 px (1:1)',
    minSize: 'Min. 32 px digital / 15 mm Print (Favicon: 16 px)',
    desc: 'Das alleinstehende Rauten-Wappen der Ultra Instinct Crew. Wird für quadratische oder runde Profilbilder (Discord, Twitch, X, Favicons) sowie als kompaktes Team-Abzeichen in Tabellen und Overlays genutzt.',
    canvasMode: 'dark',
    svgPath: '/assets/logo/logo.svg',
    pngPath: '/assets/logo/logo.png',
    downloadPrefix: 'uic-logo-icon'
  },
  {
    id: '02',
    role: 'WORTMARKE (WORDMARK)',
    title: 'Wortmarke Einzeilig',
    dimensions: '356 × 25 px (14:1)',
    minSize: 'Min. 120 px Breite digital / 30 mm Print',
    desc: 'Der ausgeschriebene Markenname „ULTRA INSTINCT CREW“ in einer durchgehenden Zeile. Gedacht für flache Header, Trikot-Schriftzüge und Layouts, in denen das Wappen bereits an anderer Stelle sichtbar ist.',
    canvasMode: 'dark',
    svgPath: '/assets/logo/logo-wordmark.svg',
    pngPath: '/assets/logo/logo-wordmark.png',
    downloadPrefix: 'uic-logo-wordmark'
  },
  {
    id: '03',
    role: 'HORIZONTALES LOCKUP',
    title: 'Horizontales Logo',
    dimensions: '1200 × 260 px (4.6:1)',
    minSize: 'Min. 160 px Breite digital / 40 mm Print',
    desc: 'Kombiniert das UIC-Wappen links mit der einzeiligen Wortmarke „ULTRA INSTINCT CREW“ rechts in fest definiertem Abstand. Unsere Standardform für Website-Header, Stream-Banner und Partner-Übersichten mit begrenzter Höhe.',
    canvasMode: 'dark',
    svgPath: '/assets/logo/logo-horizontal.svg',
    pngPath: '/assets/logo/logo-horizontal.png',
    downloadPrefix: 'uic-logo-horizontal'
  },
  {
    id: '04',
    role: 'VERTIKALES LOCKUP',
    title: 'Vertikales Logo',
    dimensions: '1000 × 640 px (1.56:1)',
    minSize: 'Min. 120 px Breite digital / 30 mm Print',
    desc: 'Zentriertes UIC-Wappen über der einzeiligen Wortmarke „ULTRA INSTINCT CREW“. Ideal für zentrierte Titelbilder, Poster, Turnier-Grafiken und Flächen mit begrenzter Breite.',
    canvasMode: 'dark',
    svgPath: '/assets/logo/logo-stacked.svg',
    pngPath: '/assets/logo/logo-stacked.png',
    downloadPrefix: 'uic-logo-vertical'
  },
  {
    id: '05',
    role: 'DUNKEL-VARIANTE (PRINT & HELL)',
    title: 'Wappen Tiefschwarz',
    dimensions: '484 × 504 px (1:1 • #000000)',
    minSize: 'Min. 32 px digital / 15 mm Print',
    desc: 'Tiefschwarze Reinzeichnung (#000000) auf transparentem Grund für helle Hintergründe, Dokumente, Verträge, Briefbögen und helle Textilien.',
    canvasMode: 'light',
    svgPath: '/assets/logo/logo-dark.svg',
    pngPath: '/assets/logo/logo-dark.png',
    downloadPrefix: 'uic-logo-dark'
  }
].map((item) => {
  const svgAsset = resolvePublicAsset(item.svgPath);
  const pngAsset = resolvePublicAsset(item.pngPath);
  return {
    ...item,
    svgAsset,
    pngAsset
  };
});

const brandColors = [
  {
    name: 'Tiefschwarz',
    tag: 'PRIMÄRER HINTERGRUND',
    hex: '#000000',
    rgb: '0, 0, 0',
    cmyk: '0 / 0 / 0 / 100',
    role: 'Hauptfarbe für Seitenhintergründe sowie Logofarbe auf hellen Medien und im Druck.',
    darkInk: false
  },
  {
    name: 'Reinweiß',
    tag: 'PRIMÄRE LOGOFARBE',
    hex: '#FFFFFF',
    rgb: '255, 255, 255',
    cmyk: '0 / 0 / 0 / 0',
    role: 'Standardfarbe für Wappen, Wortmarke, Lockups und Hauptüberschriften auf dunklem Grund.',
    darkInk: true
  },
  {
    name: 'Silbergrau',
    tag: 'FLIESSTEXT',
    hex: '#D4D4D8',
    rgb: '212, 212, 216',
    cmyk: '16 / 12 / 11 / 0',
    role: 'Sekundärer Grauton für gut lesbare Fließtexte und Beschreibungen auf schwarzem Hintergrund.',
    darkInk: true
  },
  {
    name: 'Graphitgrau',
    tag: 'LABELS & LINIEN',
    hex: '#A1A1AA',
    rgb: '161, 161, 170',
    cmyk: '37 / 30 / 26 / 1',
    role: 'Dezenter Grauton für Metadaten, Tabellenköpfe, Zeitangaben und feine Rahmen.',
    darkInk: true
  }
];

const boilerplates = [
  {
    label: 'KURZFORM (1 SATZ FÜR STREAMS, OVERLAYS & ANKÜNDIGUNGEN)',
    text: 'Die Ultra Instinct Crew (UIC) ist eine deutschsprachige League of Legends eSport-Organisation mit einer aktiven Community und festen Teams in der Prime League.'
  },
  {
    label: 'STANDARD-BESCHREIBUNG (FÜR PRESSE, PARTNER & TURNIERVERANSTALTER)',
    text: 'Die Ultra Instinct Crew (kurz UIC) ist eine deutschsprachige League of Legends eSport-Organisation. Mit einer aktiven Community und festen Teams in mehreren Divisionen der Prime League verbinden wir geregelten Ligabetrieb mit langfristigem Teamaufbau.'
  }
];

const teamsMap = (rawTeams || {}) as Record<string, any>;
const teamAssetMap = import.meta.glob('/public/assets/teams/*.{webp,png,jpg,svg}');

const activeTeamEmblems = Object.entries(teamsMap)
  .filter(([, meta]) => Boolean(meta?.primeLeagueId))
  .map(([key, meta]) => {
    const hasWebp = `/public/assets/teams/${key}.webp` in teamAssetMap;
    const hasPng = `/public/assets/teams/${key}.png` in teamAssetMap;
    const hasSvg = `/public/assets/teams/${key}.svg` in teamAssetMap;
    const fileSrc = hasWebp
      ? `/assets/teams/${key}.webp`
      : hasPng
        ? `/assets/teams/${key}.png`
        : hasSvg
          ? `/assets/teams/${key}.svg`
          : null;
    const formatLabel = hasWebp ? 'WEBP' : hasPng ? 'PNG' : hasSvg ? 'SVG' : 'DATEI';
    return {
      key,
      name: meta.teamDisplay || `UIC ${key.toUpperCase()}`,
      tier: meta.tier || 'Prime League',
      fileSrc,
      formatLabel
    };
  });
---

<Layout
  title="Brandkit & Markenrichtlinien | Ultra Instinct Crew"
  description="Offizielles Brandkit der Ultra Instinct Crew (UIC): Logos (Wappen, Wortmarke, Horizontales & Vertikales Lockup), Schutzzonen, Farben, Schriften und Team-Wappen."
>
  <div class="brandkit-page section-pad">
    <div class="container bk-container">

      <!-- Top Navigation -->
      <div class="bk-topbar">
        <a href="/#medien" class="back-link text-mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>ZURÜCK ZU MEDIEN &amp; VORLAGEN</span>
        </a>

        {brandkitBundle && (
          <a
            href={brandkitBundle.src}
            download={brandkitBundle.fileName}
            class="btn btn-primary btn-sm text-mono"
          >
            <span>ALLE LOGOS &amp; WAPPEN (.ZIP &bull; {brandkitBundle.sizeLabel}) &darr;</span>
          </a>
        )}
      </div>

      <!-- Page Header -->
      <header class="bk-header">
        <div class="section-badge-pill">BRANDKIT &amp; RICHTLINIEN</div>
        <h1 class="bk-title">
          UIC <span class="text-gradient">BRANDKIT</span>
        </h1>
        <p class="bk-lead">
          Offizielle Logos, Schutzzonen, Farben und Schriften der Ultra Instinct Crew. Klar aufgebaut für Partner, Caster, Turnierveranstalter und unsere eigenen Teams.
        </p>

        <nav class="bk-toc text-mono" aria-label="Brandkit Kapitel">
          <a href="#identitaet" class="toc-chip">01 Identität &amp; Sprache</a>
          <a href="#logos" class="toc-chip">02 Logo-System</a>
          <a href="#schutzzone" class="toc-chip">03 Schutzzone &amp; Regeln</a>
          <a href="#farben" class="toc-chip">04 Farbpalette</a>
          <a href="#typografie" class="toc-chip">05 Typografie</a>
          <a href="#team-wappen" class="toc-chip">06 Team-Wappen</a>
        </nav>
      </header>

      <!-- =================================================================
           01. IDENTITÄT, SCHREIBWEISE & KURZBESCHREIBUNGEN
           ================================================================= -->
      <section id="identitaet" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">01 / IDENTITÄT &amp; SPRACHE</span>
          <h2 class="bk-sec-title">NAME, BEGRIFFE &amp; TONFALL</h2>
          <p class="bk-sec-desc">
            Wir kommunizieren direkt, verständlich und ohne künstliche Werbesprache. Hier sind die verbindlichen Schreibweisen und Kurztexte für Ankündigungen, Streams und Berichte.
          </p>
        </div>

        <div class="identity-grid">
          <article class="bento-card id-card">
            <span class="id-label text-mono">MARKENNAME &amp; KÜRZEL</span>
            <h3 class="id-value">Ultra Instinct Crew &bull; UIC</h3>
            <p class="id-note">
              Der vollständige Name lautet <strong>Ultra Instinct Crew</strong> (drei Wörter). Das Kürzel <strong>UIC</strong> wird durchgehend großgeschrieben und steht vor allen Teamnamen (z. B. <em>UIC Prime</em>, <em>UIC Hydra</em>).
            </p>
          </article>

          <article class="bento-card id-card">
            <span class="id-label text-mono">BEZEICHNUNG</span>
            <h3 class="id-value">Organisation &bull; Community &bull; Teams</h3>
            <p class="id-note">
              Wir bezeichnen uns als <strong>eSport-Organisation</strong> mit einer aktiven <strong>Community</strong> und festen <strong>Teams</strong> in der Prime League. Begriffe wie <em>„Verein“</em>, <em>„e.V.“</em>, <em>„Clan“</em> oder <em>„GbR“</em> werden nicht verwendet.
            </p>
          </article>

          <article class="bento-card id-card">
            <span class="id-label text-mono">TONFALL &amp; HALTUNG</span>
            <h3 class="id-value">Klar, ehrlich &amp; bodenständig</h3>
            <p class="id-note">
              Unsere Texte kommen ohne übertriebene Superlative, englische Marketing-Buzzwords oder leere Phrasen aus. Wir benennen Fakten, Spieltage und Ergebnisse so, wie sie sind.
            </p>
          </article>
        </div>

        <div class="bento-card boilerplate-card">
          <div class="bp-head">
            <span class="id-label text-mono">OFFIZIELLE KURZTEXTE ZUM KOPIEREN</span>
          </div>
          <div class="bp-grid">
            {boilerplates.map((bp) => (
              <div class="bp-box">
                <div class="bp-top">
                  <span class="bp-label text-mono">{bp.label}</span>
                  <button
                    type="button"
                    class="bp-copy-btn text-mono"
                    data-copy-text={bp.text}
                  >
                    TEXT KOPIEREN
                  </button>
                </div>
                <p class="bp-text">{bp.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- =================================================================
           02. LOGO-SYSTEM (4 GRUNDFORMEN + DUNKEL-VARIANTE)
           ================================================================= -->
      <section id="logos" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">02 / LOGO-SYSTEM</span>
          <h2 class="bk-sec-title">LOGOMARKEN &amp; LOCKUPS</h2>
          <p class="bk-sec-desc">
            Das UIC-Logo besteht aus zwei Elementen: dem rautenförmigen <strong>Wappen</strong> und der einzeiligen <strong>Wortmarke „ULTRA INSTINCT CREW“</strong>. Daraus ergeben sich vier Grundformen sowie eine schwarze Variante für helle Hintergründe.
          </p>
        </div>

        <div class="logos-grid">
          {logoSpecs.map((item) => (
            <article class={`bento-card logo-card ${item.id === '03' || item.id === '04' ? 'is-wide-lockup' : ''}`}>
              <div class="lc-top text-mono">
                <span class="lc-role">{item.id} &bull; {item.role}</span>
                <span class="lc-dim">{item.dimensions}</span>
              </div>

              <div class={`lc-stage ${item.canvasMode === 'light' ? 'is-light' : 'is-dark'}`}>
                {item.svgAsset && (
                  <img
                    src={item.svgAsset.src}
                    alt={item.title}
                    class={`lc-img lc-img-${item.id}`}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="lc-body">
                <div class="lc-title-row">
                  <h3 class="lc-title">{item.title}</h3>
                  <span class="lc-min text-mono">{item.minSize}</span>
                </div>
                <p class="lc-desc">{item.desc}</p>

                <div class="lc-actions text-mono">
                  {item.svgAsset && (
                    <a
                      href={item.svgAsset.src}
                      download={`${item.downloadPrefix}.svg`}
                      class="dl-pill is-primary"
                    >
                      SVG ({item.svgAsset.sizeLabel}) &darr;
                    </a>
                  )}
                  {item.pngAsset && (
                    <a
                      href={item.pngAsset.src}
                      download={`${item.downloadPrefix}.png`}
                      class="dl-pill"
                    >
                      PNG ({item.pngAsset.sizeLabel}) &darr;
                    </a>
                  )}
                  {item.svgAsset?.svgMarkup && (
                    <button
                      type="button"
                      class="dl-pill is-copy"
                      data-copy-svg={item.svgAsset.svgMarkup}
                    >
                      SVG-CODE KOPIEREN
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- =================================================================
           03. SCHUTZZONE (ISOLATION) & ANWENDUNGSREGELN
           ================================================================= -->
      <section id="schutzzone" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">03 / SCHUTZZONE &amp; REGELN</span>
          <h2 class="bk-sec-title">ABSTÄNDE (ISOLATION) &amp; RICHTIGE ANWENDUNG</h2>
          <p class="bk-sec-desc">
            Rund um jedes Logo muss ein freier Schutzraum eingehalten werden, damit Wappen und Wortmarke klar erkennbar bleiben. In den herunterladbaren Lockup-Dateien ist dieser Abstand bereits im Format berücksichtigt.
          </p>
        </div>

        <!-- 3 Clearspace Diagrams (Icon, Wordmark, Horizontal Lockup) -->
        <div class="clearspace-grid">
          <!-- Diagram 1: Icon Clearspace -->
          <div class="bento-card cs-card">
            <div class="cs-card-head text-mono">
              <span>01 &bull; WAPPEN SOLO</span>
              <span>FREIRAUM: X = 25 % WAPPENBREITE</span>
            </div>
            <div class="cs-canvas">
              <div class="cs-box cs-box-icon">
                <span class="cs-tag cs-t text-mono">x</span>
                <span class="cs-tag cs-b text-mono">x</span>
                <span class="cs-tag cs-l text-mono">x</span>
                <span class="cs-tag cs-r text-mono">x</span>
                <div class="cs-inner">
                  <img src="/assets/logo/logo.svg" alt="UIC Wappen Schutzzone" width="76" height="76" />
                </div>
              </div>
            </div>
            <p class="cs-note">
              Um das alleinstehende Wappen bleibt an allen vier Seiten mindestens <strong>25 % der Wappenbreite (x)</strong> frei von Text, Rahmen und Bildkanten.
            </p>
          </div>

          <!-- Diagram 2: Horizontal Lockup Clearspace -->
          <div class="bento-card cs-card">
            <div class="cs-card-head text-mono">
              <span>02 &bull; HORIZONTALES &amp; VERTIKALES LOCKUP</span>
              <span>ABSTAND WAPPEN ZU TEXT: 0.3 &times; WAPPEN</span>
            </div>
            <div class="cs-canvas">
              <div class="cs-box cs-box-wide">
                <span class="cs-tag cs-t text-mono">x</span>
                <span class="cs-tag cs-b text-mono">x</span>
                <div class="cs-inner cs-inner-wide">
                  <img src="/assets/logo/logo-horizontal.svg" alt="UIC Horizontales Lockup Schutzzone" width="290" height="63" />
                </div>
              </div>
            </div>
            <p class="cs-note">
              Im horizontalen und vertikalen Lockup steht die einzeilige Wortmarke <strong>ULTRA INSTINCT CREW</strong> im festen Abstand von <strong>30 % der Wappengröße</strong> neben bzw. unter dem Wappen.
            </p>
          </div>
        </div>

        <!-- Concise 4-Card Do's & Don'ts Strip -->
        <div class="rules-row">
          <div class="bento-card rule-card is-do">
            <span class="rule-badge is-do text-mono">✓ RICHTIG: KONTRAST</span>
            <p>Auf dunklen Flächen immer das weiße Logo (<code>#FFFFFF</code>), auf hellen Flächen über 70 % Helligkeit die schwarze Variante (<code>#000000</code>) verwenden.</p>
          </div>

          <div class="bento-card rule-card is-do">
            <span class="rule-badge is-do text-mono">✓ RICHTIG: CO-BRANDING</span>
            <p>Bei Paarungen mit Partnern oder Gegnern beide Logos optisch gleich groß skalieren und durch eine feine 1-Pixel-Linie oder <code>&times;</code> / <code>VS</code> trennen.</p>
          </div>

          <div class="bento-card rule-card is-dont">
            <span class="rule-badge is-dont text-mono">✕ FALSCH: VERFORMUNG &amp; UMBAU</span>
            <p>Logos niemals stauchen, drehen, beschneiden oder das Verhältnis zwischen Wappen und der einzeiligen Wortmarke eigenmächtig verändern.</p>
          </div>

          <div class="bento-card rule-card is-dont">
            <span class="rule-badge is-dont text-mono">✕ FALSCH: FREMDFARBEN &amp; EFFEKTE</span>
            <p>Keine bunten Verläufe, Neon-Schatten oder Konturen auf das Wappen legen und das Logo nicht auf unruhige Fotos ohne abgedunkelten Hintergrund setzen.</p>
          </div>
        </div>
      </section>

      <!-- =================================================================
           04. FARBPALETTE
           ================================================================= -->
      <section id="farben" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">04 / FARBPALETTE</span>
          <h2 class="bk-sec-title">MONOCHROMES FARBSYSTEM</h2>
          <p class="bk-sec-desc">
            Wir setzen bewusst auf eine reduzierte Palette aus Schwarz, Weiß und zwei neutralen Grautönen. So stehen unsere Teams, Spielerfotos und Übertragungen immer im Mittelpunkt. Ein Klick auf eine Karte kopiert den HEX-Wert.
          </p>
        </div>

        <div class="swatches-grid">
          {brandColors.map((col) => (
            <button
              type="button"
              class="swatch-card"
              data-copy-color={col.hex}
              title={`HEX-Code ${col.hex} kopieren`}
            >
              <div
                class="swatch-fill"
                style={`background-color: ${col.hex};`}
              >
                <span class={`swatch-hex-badge text-mono ${col.darkInk ? 'is-dark' : ''}`} data-color-status={col.hex}>
                  {col.hex}
                </span>
              </div>
              <div class="swatch-meta">
                <span class="swatch-tag text-mono">{col.tag}</span>
                <h3 class="swatch-name">{col.name}</h3>
                <div class="swatch-codes text-mono">
                  <span>RGB {col.rgb}</span>
                  <span>&bull;</span>
                  <span>CMYK {col.cmyk}</span>
                </div>
                <p class="swatch-role">{col.role}</p>
              </div>
            </button>
          ))}
        </div>
      </section>

      <!-- =================================================================
           05. TYPOGRAFIE
           ================================================================= -->
      <section id="typografie" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">05 / TYPOGRAFIE</span>
          <h2 class="bk-sec-title">SCHRIFTEN &amp; HIERARCHIE</h2>
          <p class="bk-sec-desc">
            Zwei klar lesbare Schriften prägen alle digitalen und gedruckten Medien der Ultra Instinct Crew: <strong>Plus Jakarta Sans</strong> für Überschriften und Fließtext sowie <strong>Space Grotesk</strong> für Zahlen, Spieltage und Tabellen.
          </p>
        </div>

        <div class="type-grid">
          <article class="bento-card type-card">
            <div class="tc-top text-mono">
              <span class="tc-role">ÜBERSCHRIFTEN &amp; FLIESSTEXT</span>
              <span class="tc-name">PLUS JAKARTA SANS</span>
            </div>
            <div class="type-specimen" style="font-family: var(--font-display);">
              <span class="specimen-big">Aa Bb Cc</span>
              <span class="specimen-headline">ULTRA INSTINCT CREW</span>
              <p class="specimen-alphabet">
                ABCDEFGHIJKLMNOPQRSTUVWXYZ &bull; abcdefghijklmnopqrstuvwxyz &bull; 0123456789
              </p>
            </div>
            <div class="type-weights text-mono">
              <span class="weight-chip"><strong>Weight 800 (ExtraBold):</strong> Hauptüberschriften, Titel und Banner in Versalien</span>
              <span class="weight-chip"><strong>Weight 400 / 500:</strong> Fließtexte, Beschreibungen und Navigation</span>
            </div>
          </article>

          <article class="bento-card type-card">
            <div class="tc-top text-mono">
              <span class="tc-role">ZAHLEN, KÜRZEL &amp; TABELLEN</span>
              <span class="tc-name">SPACE GROTESK</span>
            </div>
            <div class="type-specimen" style="font-family: var(--font-mono);">
              <span class="specimen-big">UIC // 2026</span>
              <span class="specimen-headline">SPIELTAG 7 &bull; DIVISION 4 &bull; 2 : 1</span>
              <p class="specimen-alphabet">
                #FFFFFF &bull; #000000 &bull; KDA &bull; DPM &bull; CS/M &bull; 0123456789
              </p>
            </div>

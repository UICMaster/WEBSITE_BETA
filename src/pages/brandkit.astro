---
// src/pages/brandkit.astro
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import rawTeams from '../../data/teams.json';
import { discordInviteUrl } from '../utils/uicData';

interface ResolvedAsset {
  src: string;
  fileName: string;
  ext: string;
  sizeBytes: number;
  sizeLabel: string;
  svgMarkup: string | null;
}

const formatFileSize = (bytes: number): string => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1).replace('.', ',')} MB`;
};

const publicRoot = path.resolve(process.cwd(), 'public');

const resolvePublicAsset = (webPath: string): ResolvedAsset | null => {
  const cleanPath = webPath.startsWith('/') ? webPath.slice(1) : webPath;
  const absPath = path.join(publicRoot, ...cleanPath.split('/'));
  if (!fs.existsSync(absPath)) return null;
  const stat = fs.statSync(absPath);
  if (!stat.isFile()) return null;
  const ext = path.extname(cleanPath).slice(1).toUpperCase();
  const fileName = path.basename(cleanPath);
  const svgMarkup = ext === 'SVG' ? fs.readFileSync(absPath, 'utf8').trim() : null;
  return {
    src: `/${cleanPath}`,
    fileName,
    ext,
    sizeBytes: stat.size,
    sizeLabel: formatFileSize(stat.size),
    svgMarkup
  };
};

const resolveAssetList = (candidates: string[]): ResolvedAsset[] =>
  candidates
    .map((candidate) => resolvePublicAsset(candidate))
    .filter((asset): asset is ResolvedAsset => asset !== null);

const logoSvgAsset = resolvePublicAsset('/assets/logo/logo.svg');
const logoPngAsset = resolvePublicAsset('/assets/logo/logo.png');
const rawLogoSvg = logoSvgAsset?.svgMarkup ?? '';
const viewBoxMatch = rawLogoSvg.match(/viewBox=["'][\d.\-]+\s+[\d.\-]+\s+([\d.]+)\s+([\d.]+)["']/i);
const logoViewBoxLabel = viewBoxMatch
  ? `${Math.round(Number(viewBoxMatch[1]))} × ${Math.round(Number(viewBoxMatch[2]))}`
  : '1000 × 1000';
const brandkitBundle = resolvePublicAsset('/assets/downloads/uic-brandkit.zip');

const teamsMap = (rawTeams || {}) as Record<string, any>;
const teamAssetMap = import.meta.glob('/public/assets/teams/*.{webp,png,jpg,svg}');

const activeTeamEmblems = Object.entries(teamsMap)
  .filter(([, meta]) => Boolean(meta?.primeLeagueId))
  .map(([key, meta]) => {
    const hasWebp = `/public/assets/teams/${key}.webp` in teamAssetMap;
    const hasPng = `/public/assets/teams/${key}.png` in teamAssetMap;
    const hasSvg = `/public/assets/teams/${key}.svg` in teamAssetMap;
    const fileSrc = hasWebp
      ? `/assets/teams/${key}.webp`
      : hasPng
        ? `/assets/teams/${key}.png`
        : hasSvg
          ? `/assets/teams/${key}.svg`
          : null;
    const formatLabel = hasWebp ? 'WEBP' : hasPng ? 'PNG' : hasSvg ? 'SVG' : null;
    const svgSrc = hasSvg ? `/assets/teams/${key}.svg` : null;
    return {
      key,
      name: meta.teamDisplay || `UIC ${key.toUpperCase()}`,
      tier: meta.tier || 'Prime League',
      fileSrc,
      formatLabel,
      svgSrc
    };
  });

const brandColors = [
  {
    name: 'Tiefschwarz',
    hex: '#000000',
    rgb: '0, 0, 0',
    cmyk: '60 / 40 / 40 / 100',
    role: 'Primärer Markenhintergrund sowie Reinzeichnung für die Dunkel-Variante des Logos auf hellen Trägermedien und im Print.',
    contrast: '21:1 mit #FFFFFF',
    border: 'rgba(255, 255, 255, 0.32)',
    darkInk: false
  },
  {
    name: 'Reinweiß',
    hex: '#FFFFFF',
    rgb: '255, 255, 255',
    cmyk: '0 / 0 / 0 / 0',
    role: 'Primäre Logofarbe für das Wappen, Wortmarken, Lockups und Hauptüberschriften auf dunklen Hintergründen.',
    contrast: '21:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.45)',
    darkInk: true
  },
  {
    name: 'Silbergrau',
    hex: '#D4D4D8',
    rgb: '212, 212, 216',
    cmyk: '16 / 12 / 11 / 0',
    role: 'Sekundärer Grauton für Fließtext, Begleittexte und untergeordnete grafische Elemente auf dunklem Grund.',
    contrast: '14.3:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.25)',
    darkInk: true
  },
  {
    name: 'Graphitgrau',
    hex: '#A1A1AA',
    rgb: '161, 161, 170',
    cmyk: '37 / 30 / 26 / 1',
    role: 'Neutraler Akzentton für feine Trennlinien, Bildunterschriften, Labels und technische Beschriftungen.',
    contrast: '8.2:1 auf #000000',
    border: 'rgba(255, 255, 255, 0.2)',
    darkInk: true
  }
];

const logoPlaceholders = [
  {
    id: 'VAR-01',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Wortmarke (Wordmark)',
    spec: 'SVG & PNG • Freistehender Schriftzug • Transparent',
    desc: 'Reine Wortmarke „ULTRA INSTINCT CREW“ ohne Wappen-Symbol. Optimal für Typo-Header, Trikot-Rücken, Banderolen und eigenständige Schriftzüge.',
    previewType: 'wordmark',
    candidates: ['/assets/logo/logo-wordmark.svg', '/assets/logo/logo-wordmark.png'],
    slotHint: 'public/assets/logo/logo-wordmark.svg'
  },
  {
    id: 'VAR-02',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Horizontales Lockup',
    spec: 'SVG & PNG • Empfohlen 1600 × 400 px • Transparent',
    desc: 'Kombination aus UIC Wappen links und Wortmarke rechts mit festem Abstand. Standard für Bereiche mit begrenzter Höhe.',
    previewType: 'horizontal',
    candidates: ['/assets/logo/logo-horizontal.svg', '/assets/logo/logo-horizontal.png'],
    slotHint: 'public/assets/logo/logo-horizontal.svg'
  },
  {
    id: 'VAR-03',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Vertikales Lockup (Stacked)',
    spec: 'SVG & PNG • Empfohlen 1000 × 1200 px • Transparent',
    desc: 'Zentriertes UIC Wappen über gestapelter Wortmarke. Gedacht für Formate mit begrenzter Breite wie Poster, Pokale und Kacheln.',
    previewType: 'stacked',
    candidates: ['/assets/logo/logo-stacked.svg', '/assets/logo/logo-stacked.png'],
    slotHint: 'public/assets/logo/logo-stacked.svg'
  },
  {
    id: 'VAR-04',
    badge: 'PLATZHALTER • UPLOAD FOLGT',
    title: 'Dunkel-Variante (Schwarz auf Hell)',
    spec: 'SVG, PNG & EPS • #000000 Vollton • CMYK-tauglich',
    desc: 'Monochrome schwarze Reinzeichnung aller Marken-Elemente für weiße Trikots, Verträge, Briefbögen und helle Hintergründe.',
    previewType: 'dark-ink',
    candidates: [
      '/assets/logo/logo-dark.svg',
      '/assets/logo/logo-dark.png',
      '/assets/logo/logo-dark.eps'
    ],
    slotHint: 'public/assets/logo/logo-dark.svg'
  }
];

const logoVariants = logoPlaceholders.map((item) => {
  const files = resolveAssetList(item.candidates);
  const svgAsset = files.find((f) => f.ext === 'SVG') ?? null;
  const previewAsset =
    svgAsset ??
    files.find((f) => f.ext === 'PNG' || f.ext === 'WEBP' || f.ext === 'JPG') ??
    null;
  return {
    ...item,
    files,
    svgAsset,
    previewAsset,
    isAvailable: files.length > 0
  };
});
---

<Layout
  title="Brandkit & Markenrichtlinien | Ultra Instinct Crew"
  description="Offizielles Brandkit und Markenrichtlinien der Ultra Instinct Crew (UIC): Wappen, Wortmarke, Lockups, Schutzzonen, Farbpalette, Typografie und Team-Embleme."
>
  <div class="brandkit-page section-pad">
    <div class="container bk-container">

      <!-- Top Back Bar -->
      <div class="bk-topbar">
        <a href="/#medien" class="back-link text-mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>ZURÜCK ZU MEDIEN &amp; VORLAGEN</span>
        </a>

        <div class="bk-version-pills text-mono">
          <span class="ver-pill">VERSION 1.0</span>
          <span class="ver-pill is-highlight">STAND 2026</span>
        </div>
      </div>

      <!-- Page Header -->
      <header class="bk-header">
        <div class="section-badge-pill">MARKENRICHTLINIEN &amp; LOGO-ARCHIVE</div>
        <h1 class="bk-title">
          UIC MARKE &amp; <span class="text-gradient">BRANDKIT</span>
        </h1>
        <p class="bk-lead">
          Verbindlicher Leitfaden für die visuelle Identität der Ultra Instinct Crew. Entwickelt für Partner, Turnierveranstalter, Caster, Presse und alle Teams unserer Organisation.
        </p>

        <!-- Action Strip & Anchor Navigation -->
        <div class="bk-controls-row">
          <nav class="bk-toc text-mono" aria-label="Brandkit-Bereiche">
            <a href="#markenkern" class="toc-chip">01 Markenidentität</a>
            <a href="#logos" class="toc-chip">02 Logo-System</a>
            <a href="#regeln" class="toc-chip">03 Schutzzone &amp; Regeln</a>
            <a href="#farben" class="toc-chip">04 Farbpalette</a>
            <a href="#typografie" class="toc-chip">05 Typografie</a>
            <a href="#teams-wappen" class="toc-chip">06 Team-Wappen</a>
            <a href="#nutzung" class="toc-chip">07 Nutzungsrechte</a>
          </nav>

          {brandkitBundle ? (
            <a
              href={brandkitBundle.src}
              download={brandkitBundle.fileName}
              class="btn btn-primary btn-sm text-mono"
            >
              <span>GESAMTPAKET (.ZIP &bull; {brandkitBundle.sizeLabel}) &darr;</span>
            </a>
          ) : (
            <button
              type="button"
              class="btn btn-outline btn-sm bundle-placeholder-btn text-mono"
              disabled
              aria-disabled="true"
              title="Wird automatisch aktiv unter public/assets/downloads/uic-brandkit.zip"
            >
              <span>GESAMTPAKET (.ZIP) &bull; PLATZHALTER</span>
            </button>
          )}
        </div>
      </header>

      <!-- =================================================================
           01. MARKENIDENTITÄT & SCHREIBWEISE
           ================================================================= -->
      <section id="markenkern" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">01 / IDENTITÄT</span>
          <h2 class="bk-sec-title">MARKENNAME &amp; TERMINOLOGIE</h2>
          <p class="bk-sec-desc">
            Eine einheitliche Marke beginnt bei korrekter Schreibweise. So werden die Organisation, unsere Teams und die Community offiziell bezeichnet.
          </p>
        </div>

        <div class="identity-grid">
          <article class="bento-card id-card">
            <span class="id-label text-mono">VOLLSTÄNDIGER NAME &amp; TAG</span>
            <h3 class="id-value">Ultra Instinct Crew &bull; UIC</h3>
            <p class="id-note">
              In Überschriften, Pressetexten und offiziellen Nennungen wird stets <strong>Ultra Instinct Crew</strong> ausgeschrieben. <strong>UIC</strong> dient als kurzes Kürzel in Spielplänen, Overlays und Team-Tags.
            </p>
          </article>

          <article class="bento-card id-card">
            <span class="id-label text-mono">OFFIZIELLE BEGRIFFE</span>
            <h3 class="id-value">Organisation &bull; Community &bull; Teams</h3>
            <p class="id-note">
              Wir bezeichnen uns ausschließlich als <strong>Organisation</strong> mit angeschlossener <strong>Community</strong> und aktiven <strong>Teams</strong>. Begriffe wie <em>„Verein“</em>, <em>„e.V.“</em> oder <em>„GbR“</em> werden nicht verwendet.
            </p>
          </article>
        </div>
      </section>

      <!-- =================================================================
           02. LOGO-SYSTEM & VARIANTEN
           ================================================================= -->
      <section id="logos" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">02 / LOGOMARKEN</span>
          <h2 class="bk-sec-title">PRIMÄRLOGO &amp; VARIANTEN</h2>
          <p class="bk-sec-desc">
            Das UIC-Markensystem umfasst vier Grundformen: das freistehende <strong>Wappen (Symbol)</strong>, die reine <strong>Wortmarke</strong>, das <strong>horizontale Lockup</strong> und das <strong>vertikale Lockup</strong> sowie eine schwarze Print-Variante für helle Flächen.
          </p>
        </div>

        <!-- Primary Crest Showcase (Real Uploaded Asset) -->
        <div class="bento-card logo-master-card">
          <div class="lm-stage" id="master-logo-stage" data-bg="dark">
            <div class="lm-stage-controls text-mono">
              <span class="lm-status-pill is-live">VERFÜGBAR &bull; WAPPEN</span>
              <div class="stage-bg-switch" role="group" aria-label="Hintergrund-Vorschau wechseln">
                <button type="button" class="bg-sw-btn is-active" data-stage-bg="dark">SCHWARZ</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="slate">DUNKELGRAU</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="grid">RASTER</button>
              </div>
            </div>

            <div class="lm-preview-wrap">
              <img
                src="/assets/logo/logo.svg"
                alt="Offizielles Ultra Instinct Crew Vektor-Wappen"
                class="lm-logo-img"
                width="160"
                height="160"
              />
            </div>

            <span class="lm-dim-caption text-mono">VIEWBOX {logoViewBoxLabel} &bull; REINZEICHNUNG VEKTORPFAD</span>
          </div>

          <div class="lm-details">
            <div class="asset-meta-row text-mono">
              <span class="meta-type">PRIMÄRMARKE &bull; SYMBOL</span>
              <span class="meta-spec">WAPPEN-ZEICHEN</span>
            </div>
            <h3 class="lm-title">UIC WAPPEN (SYMBOL)</h3>
            <p class="lm-desc">
              Das freistehende Symbol-Logo in Reinweiß (<code>#FFFFFF</code>) auf transparentem Hintergrund. Optimal für Profilbilder, Broadcast-Badges, Stickereien und kompakte Markierungen ohne Textzusatz.
            </p>

            <div class="lm-specs-grid text-mono">
              <div class="spec-mini">
                <span class="sm-lbl">VEKTOR</span>
                <span class="sm-val">SVG ({logoViewBoxLabel})</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">RASTER</span>
                <span class="sm-val">{logoPngAsset ? `PNG (${logoPngAsset.sizeLabel})` : 'PNG Hochauflösend'}</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">FORMAT</span>
                <span class="sm-val">1 : 1 Safe-Canvas</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">FARBE</span>
                <span class="sm-val">#FFFFFF</span>
              </div>
            </div>

            <div class="lm-actions">
              <a href="/assets/logo/logo.svg" download="uic-logo.svg" class="btn btn-primary btn-sm">
                {logoSvgAsset ? `SVG (${logoSvgAsset.sizeLabel}) ↓` : 'SVG HERUNTERLADEN ↓'}
              </a>
              <a href="/assets/logo/logo.png" download="uic-logo.png" class="btn btn-outline btn-sm">
                {logoPngAsset ? `PNG (${logoPngAsset.sizeLabel}) ↓` : 'PNG HERUNTERLADEN ↓'}
              </a>
              {rawLogoSvg && (
                <button
                  type="button"
                  class="btn btn-outline btn-sm text-mono"
                  id="copy-svg-btn"
                  data-copy-svg={rawLogoSvg}
                >
                  SVG-CODE KOPIEREN
                </button>
              )}
            </div>
          </div>
        </div>

        <!-- Secondary Logo Variants (Wordmark, Horizontal Lockup, Stacked Lockup, Dark Ink) -->
        <div class="lockups-grid">
          {logoVariants.map((item) => (
            <article class={`placeholder-card${item.isAvailable ? ' is-available' : ''}`}>
              <div class="ph-header text-mono">
                <span class="ph-code">{item.id}</span>
                {item.isAvailable ? (
                  <span class="ph-badge is-live">
                    VERF&Uuml;GBAR &bull; {item.files.map((f) => f.ext).join(' / ')}
                  </span>
                ) : (
                  <span class="ph-badge">{item.badge}</span>
                )}
              </div>

              {item.isAvailable ? (
                <div
                  class={`ph-stage ph-stage-live${item.previewType === 'dark-ink' ? ' is-light-canvas' : ''}`}
                >
                  {item.previewAsset ? (
                    <img
                      src={item.previewAsset.src}
                      alt={`${item.title} Vorschau`}
                      class="ph-live-img"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="wf-ready-badge text-mono">
                      <span class="wf-ready-ext">{item.files[0].ext}</span>
                      <span class="wf-ready-name">{item.files[0].fileName}</span>
                      <span class="wf-ready-size">{item.files[0].sizeLabel}</span>
                    </div>
                  )}
                </div>
              ) : (
                <div class={`ph-stage ph-stage-${item.previewType}`} aria-hidden="true">
                  {item.previewType === 'wordmark' && (
                    <div class="ph-mock-wordonly">
                      <span class="ph-mock-wordbar is-wordmark">ULTRA INSTINCT CREW</span>
                    </div>
                  )}
                  {item.previewType === 'horizontal' && (
                    <div class="ph-mock-horizontal">
                      <span class="ph-mock-crest-box">UIC</span>
                      <span class="ph-mock-wordbar">ULTRA INSTINCT CREW</span>
                    </div>
                  )}
                  {item.previewType === 'stacked' && (
                    <div class="ph-mock-stacked">
                      <span class="ph-mock-crest-box">UIC</span>
                      <span class="ph-mock-wordbar short">ULTRA INSTINCT CREW</span>
                    </div>
                  )}
                  {item.previewType === 'dark-ink' && (
                    <div class="ph-mock-darkink">
                      <img
                        src="/assets/logo/logo.svg"
                        alt=""
                        width="68"
                        height="68"
                        class="ph-dark-preview-img"
                      />
                    </div>
                  )}
                  <span class="ph-overlay-label text-mono">PLATZHALTER</span>
                </div>
              )}

              <div class="ph-body">
                <h3 class="ph-title">{item.title}</h3>
                <span class="ph-spec text-mono">{item.spec}</span>
                <p class="ph-desc">{item.desc}</p>
                {item.isAvailable ? (
                  <div class="ph-actions">
                    {item.files.map((file) => (
                      <a
                        href={file.src}
                        download={file.fileName}
                        class="emblem-dl text-mono"
                        title={`${file.fileName} (${file.sizeLabel})`}
                      >
                        {file.ext} ({file.sizeLabel}) &darr;
                      </a>
                    ))}
                    {item.svgAsset?.svgMarkup && (
                      <button
                        type="button"
                        class="emblem-dl is-copy text-mono"
                        data-copy-svg={item.svgAsset.svgMarkup}
                      >
                        SVG-CODE KOPIEREN
                      </button>
                    )}
                  </div>
                ) : (
                  <span class="ph-path-hint text-mono">Slot: {item.slotHint}</span>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- =================================================================
           03. SCHUTZZONE, MINDESTGRÖSSE & DO'S / DON'TS
           ================================================================= -->
      <section id="regeln" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-num text-mono">03 / ANWENDUNGSREGELN</span>
          <h2 class="bk-sec-title">SCHUTZZONE, MINDESTGRÖSSEN &amp; DO / DON'T</h2>
          <p class="bk-sec-desc">
            Klare Abstands- und Kontrastregeln sichern die Erkennbarkeit aller Logo-Varianten auf kompakten Avataren ebenso wie auf großen Turnier-Bühnen und Print-Medien.
          </p>
        </div>

        <div class="rules-split">
          <!-- Clearspace Diagram -->
          <div class="bento-card clearspace-card">
            <div class="card-meta">
              <span class="meta-num">SCHUTZZONE</span>
              <span class="meta-tag text-mono">PROPORTIONAL: X = 25% LOGOBREITE</span>
            </div>

            <div class="clearspace-diagram" aria-label="Schematische Darstellung der Logoschutzzone">
              <div class="cs-outer-box">
                <span class="cs-measure cs-top text-mono">x</span>
                <span class="cs-measure cs-bottom text-mono">x</span>
                <span class="cs-measure cs-left text-mono">x</span>
                <span class="cs-measure cs-right text-mono">x</span>
                <div class="cs-inner-box">
                  <img src="/assets/logo/logo.svg" alt="UIC Logo in Schutzzone" width="110" height="110" />
                </div>
              </div>
            </div>

            <div class="minsize-row">
              <div class="ms-box">
                <span class="ms-lbl text-mono">DIGITAL MINIMUM</span>
                <strong class="ms-val text-mono">32 &times; 32 px</strong>
                <span class="ms-sub">Favicon-Ausnahme: 16 px</span>
              </div>
              <div class="ms-box">
                <span class="ms-lbl text-mono">DRUCK &amp; STICKEREI</span>
                <strong class="ms-val text-mono">15 &times; 15 mm</strong>
                <span class="ms-sub">Darunter Feindetails prüfen</span>
              </div>
            </div>
          </div>

          <!-- Do's & Don'ts Grid -->
          <div class="dos-donts-col">
            <div class="dd-group-head text-mono is-do">ERLAUBT (DO)</div>
            <div class="dd-grid">
              <div class="dd-card is-do">
                <div class="dd-preview dark">
                  <img src="/assets/logo/logo.svg" alt="Korrekte Darstellung auf Schwarz" width="52" height="52" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-do text-mono">✓ RICHTIG</span>
                  <p>Unverzerrt und kontrastreich in Reinweiß auf ruhigen dunklen Flächen platzieren.</p>
                </div>
              </div>

              <div class="dd-card is-do">
                <div class="dd-preview split">
                  <span class="dd-badge-inline text-mono">UIC</span>
                  <span class="dd-divider-x">&times;</span>
                  <span class="dd-partner-box text-mono">PARTNER</span>
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-do text-mono">✓ RICHTIG</span>
                  <p>Bei Co-Branding durch saubere Trennlinie und ausgeglichene Schutzzonen trennen.</p>
                </div>
              </div>
            </div>

            <div class="dd-group-head text-mono is-dont">UNTERSAGT (DON'T)</div>
            <div class="dd-grid">
              <div class="dd-card is-dont">
                <div class="dd-preview">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-stretch" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>
                  <p>Proportionen niemals stauchen, strecken oder frei skalieren.</p>
                </div>
              </div>

              <div class="dd-card is-dont">
                <div class="dd-preview">
                  <img src="/assets/logo/logo.svg" alt="" width="52" height="52" class="demo-recolor" />
                </div>
                <div class="dd-text">
                  <span class="dd-badge is-dont text-mono">✕ FALSCH</span>

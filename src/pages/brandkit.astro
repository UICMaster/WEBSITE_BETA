<script>
  // 1. Master Logo Showcase Canvas Background Toggle
  const masterStage = document.getElementById('master-logo-stage');
  document.querySelectorAll<HTMLButtonElement>('[data-stage-bg]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.getAttribute('data-stage-bg');
      if (!mode || !masterStage) return;
      masterStage.setAttribute('data-bg', mode);
      document.querySelectorAll('[data-stage-bg]').forEach((b) => b.classList.toggle('is-active', b === btn));
    });
  });

  // 2. Copy SVG Markup to Clipboard
  const copySvgBtn = document.getElementById('copy-svg-btn');
  copySvgBtn?.addEventListener('click', () => {
    const svgCode = copySvgBtn.getAttribute('data-copy-svg');
    if (!svgCode) return;
    navigator.clipboard?.writeText(svgCode).catch(() => {});
    const original = copySvgBtn.textContent;
    copySvgBtn.textContent = 'SVG KOPIERT ✓';
    copySvgBtn.classList.add('is-copied');
    setTimeout(() => {
      copySvgBtn.textContent = original;
      copySvgBtn.classList.remove('is-copied');
    }, 1800);
  });

  // 3. Copy HEX Color Swatches to Clipboard
  document.querySelectorAll<HTMLButtonElement>('[data-copy-color]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const hex = btn.getAttribute('data-copy-color');
      const statusEl = btn.querySelector<HTMLElement>('[data-color-status]');
      if (!hex || !statusEl) return;
      navigator.clipboard?.writeText(hex).catch(() => {});
      statusEl.textContent = 'KOPIERT ✓';
      btn.classList.add('is-copied');
      setTimeout(() => {
        statusEl.textContent = hex;
        btn.classList.remove('is-copied');
      }, 1500);
    });
  });
</script>


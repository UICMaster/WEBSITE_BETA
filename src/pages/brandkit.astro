---
// src/pages/brandkit.astro
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import rawTeams from '../../data/teams.json';
import { discordInviteUrl, totalTeams } from '../utils/uicData';

interface ResolvedAsset {
  src: string;
  fileName: string;
  ext: string;
  sizeBytes: number;
  sizeLabel: string;
  svgMarkup: string | null;
}

const formatFileSize = (bytes: number): string => {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${Math.round(bytes / 1024)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1).replace('.', ',')} MB`;
};

const publicRoot = path.resolve(process.cwd(), 'public');

const resolvePublicAsset = (webPath: string): ResolvedAsset | null => {
  const cleanPath = webPath.startsWith('/') ? webPath.slice(1) : webPath;
  const absPath = path.join(publicRoot, ...cleanPath.split('/'));
  if (!fs.existsSync(absPath)) return null;
  const stat = fs.statSync(absPath);
  if (!stat.isFile()) return null;
  const ext = path.extname(cleanPath).slice(1).toUpperCase();
  const fileName = path.basename(cleanPath);
  const svgMarkup = ext === 'SVG' ? fs.readFileSync(absPath, 'utf8').trim() : null;
  return {
    src: `/${cleanPath}`,
    fileName,
    ext,
    sizeBytes: stat.size,
    sizeLabel: formatFileSize(stat.size),
    svgMarkup
  };
};

const logoSvgAsset = resolvePublicAsset('/assets/logo/logo.svg');
const logoPngAsset = resolvePublicAsset('/assets/logo/logo.png');
const rawLogoSvg = logoSvgAsset?.svgMarkup ?? '';
const viewBoxMatch = rawLogoSvg.match(/viewBox=["'][\d.\-]+\s+[\d.\-]+\s+([\d.]+)\s+([\d.]+)["']/i);
const logoViewBoxLabel = viewBoxMatch
  ? `${Math.round(Number(viewBoxMatch[1]))} × ${Math.round(Number(viewBoxMatch[2]))}`
  : '484 × 504';

const brandkitBundle = resolvePublicAsset('/assets/downloads/uic-brandkit.zip');

// 4 Secondary Logo Variants in symmetric 2x2 grid below the Master Logo Showcase
const logoVariants = [
  {
    role: 'WORTMARKE (WORDMARK)',
    title: 'Wortmarke Einzeilig',
    dimensions: '356 × 25 px (14:1)',
    imgWidth: 356,
    imgHeight: 25,
    minSize: 'Min. 120 px Breite digital / 30 mm Print',
    desc: 'Der ausgeschriebene Markenname „ULTRA INSTINCT CREW“ in einer durchgehenden Zeile. Gedacht für flache Header, Trikot-Schriftzüge und Layouts, in denen das Wappen bereits separat sichtbar ist.',
    canvasMode: 'dark',
    previewClass: 'is-wordmark',
    svgPath: '/assets/logo/logo-wordmark.svg',
    pngPath: '/assets/logo/logo-wordmark.png',
    downloadPrefix: 'uic-logo-wordmark'
  },
  {
    role: 'HORIZONTALES LOCKUP',
    title: 'Horizontales Logo',
    dimensions: '1200 × 260 px (4.6:1)',
    imgWidth: 320,
    imgHeight: 70,
    minSize: 'Min. 160 px Breite digital / 40 mm Print',
    desc: 'Kombiniert das UIC-Wappen links mit der einzeiligen Wortmarke „ULTRA INSTINCT CREW“ rechts. Unsere Standardform für Website-Header, Stream-Banner und Partner-Übersichten mit begrenzter Höhe.',
    canvasMode: 'dark',
    previewClass: 'is-horizontal',
    svgPath: '/assets/logo/logo-horizontal.svg',
    pngPath: '/assets/logo/logo-horizontal.png',
    downloadPrefix: 'uic-logo-horizontal'
  },
  {
    role: 'VERTIKALES LOCKUP',
    title: 'Vertikales Logo',
    dimensions: '1000 × 640 px (1.56:1)',
    imgWidth: 225,
    imgHeight: 144,
    minSize: 'Min. 120 px Breite digital / 30 mm Print',
    desc: 'Zentriertes UIC-Wappen über der einzeiligen Wortmarke „ULTRA INSTINCT CREW“. Ideal für zentrierte Titelbilder, Poster, Turnier-Grafiken und Flächen mit begrenzter Breite.',
    canvasMode: 'dark',
    previewClass: 'is-stacked',
    svgPath: '/assets/logo/logo-stacked.svg',
    pngPath: '/assets/logo/logo-stacked.png',
    downloadPrefix: 'uic-logo-vertical'
  },
  {
    role: 'DUNKEL-VARIANTE (PRINT & HELL)',
    title: 'Wappen Tiefschwarz',
    dimensions: '484 × 504 px (1:1 • #000000)',
    imgWidth: 115,
    imgHeight: 120,
    minSize: 'Min. 32 px digital / 15 mm Print',
    desc: 'Tiefschwarze Reinzeichnung (#000000) auf transparentem Grund für helle Hintergründe, Dokumente, Verträge, Briefbögen und helle Textilien.',
    canvasMode: 'light',
    previewClass: 'is-dark-crest',
    svgPath: '/assets/logo/logo-dark.svg',
    pngPath: '/assets/logo/logo-dark.png',
    downloadPrefix: 'uic-logo-dark'
  }
].map((item) => {
  const svgAsset = resolvePublicAsset(item.svgPath);
  const pngAsset = resolvePublicAsset(item.pngPath);
  return {
    ...item,
    svgAsset,
    pngAsset
  };
});

const brandColors = [
  {
    name: 'Tiefschwarz',
    tag: 'PRIMÄRER HINTERGRUND',
    hex: '#000000',
    rgb: '0, 0, 0',
    cmyk: '0 / 0 / 0 / 100',
    role: 'Hauptfarbe für Seitenhintergründe sowie Logofarbe auf hellen Medien und im Druck.',
    darkInk: false
  },
  {
    name: 'Reinweiß',
    tag: 'PRIMÄRE LOGOFARBE',
    hex: '#FFFFFF',
    rgb: '255, 255, 255',
    cmyk: '0 / 0 / 0 / 0',
    role: 'Standardfarbe für Wappen, Wortmarke, Lockups und Hauptüberschriften auf dunklem Grund.',
    darkInk: true
  },
  {
    name: 'Silbergrau',
    tag: 'FLIESSTEXT',
    hex: '#D4D4D8',
    rgb: '212, 212, 216',
    cmyk: '16 / 12 / 11 / 0',
    role: 'Sekundärer Grauton für gut lesbare Fließtexte und Beschreibungen auf schwarzem Hintergrund.',
    darkInk: true
  },
  {
    name: 'Graphitgrau',
    tag: 'LABELS & LINIEN',
    hex: '#A1A1AA',
    rgb: '161, 161, 170',
    cmyk: '37 / 30 / 26 / 1',
    role: 'Dezenter Grauton für Metadaten, Tabellenköpfe, Zeitangaben und feine Rahmen.',
    darkInk: true
  }
];

const boilerplates = [
  {
    label: 'KURZFORM (1 SATZ FÜR STREAMS, OVERLAYS & ANKÜNDIGUNGEN)',
    text: 'Die Ultra Instinct Crew (UIC) ist eine deutschsprachige League of Legends eSport-Organisation mit einer aktiven Community und festen Teams in der Prime League.'
  },
  {
    label: 'STANDARD-BESCHREIBUNG (FÜR PRESSE, PARTNER & TURNIERVERANSTALTER)',
    text: 'Die Ultra Instinct Crew (kurz UIC) ist eine deutschsprachige League of Legends eSport-Organisation. Mit einer aktiven Community und festen Teams in mehreren Divisionen der Prime League verbinden wir geregelten Ligabetrieb mit langfristigem Teamaufbau.'
  }
];

const teamsMap = (rawTeams || {}) as Record<string, any>;
const teamAssetMap = import.meta.glob('/public/assets/teams/*.{webp,png,jpg,svg}');

const activeTeamEmblems = Object.entries(teamsMap)
  .filter(([, meta]) => Boolean(meta?.primeLeagueId))
  .map(([key, meta]) => {
    const hasWebp = `/public/assets/teams/${key}.webp` in teamAssetMap;
    const hasPng = `/public/assets/teams/${key}.png` in teamAssetMap;
    const hasSvg = `/public/assets/teams/${key}.svg` in teamAssetMap;
    const fileSrc = hasWebp
      ? `/assets/teams/${key}.webp`
      : hasPng
        ? `/assets/teams/${key}.png`
        : hasSvg
          ? `/assets/teams/${key}.svg`
          : null;
    const formatLabel = hasWebp ? 'WEBP' : hasPng ? 'PNG' : hasSvg ? 'SVG' : 'DATEI';
    return {
      key,
      name: meta.teamDisplay || `UIC ${key.toUpperCase()}`,
      tier: meta.tier || 'Prime League',
      fileSrc,
      formatLabel
    };
  });
---

<Layout
  title="Brandkit & Markenrichtlinien | Ultra Instinct Crew"
  description="Offizielles Brandkit der Ultra Instinct Crew (UIC): Logos (Wappen, Wortmarke, Horizontales & Vertikales Lockup), Anwendungsregeln, Farben, Schriften und Team-Wappen."
>
  <div class="brandkit-page section-pad">
    <div class="container bk-container">

      <!-- Top Navigation -->
      <div class="bk-topbar">
        <a href="/#medien" class="back-link text-mono">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>ZURÜCK ZU MEDIEN &amp; VORLAGEN</span>
        </a>

        {brandkitBundle && (
          <a
            href={brandkitBundle.src}
            download={brandkitBundle.fileName}
            class="btn btn-primary btn-sm text-mono"
          >
            <span>ALLE LOGOS &amp; WAPPEN (.ZIP &bull; {brandkitBundle.sizeLabel}) &darr;</span>
          </a>
        )}
      </div>

      <!-- Page Header -->
      <header class="bk-header">
        <div class="section-badge-pill">BRANDKIT &amp; RICHTLINIEN</div>
        <h1 class="bk-title">
          UIC <span class="text-gradient">BRANDKIT</span>
        </h1>
        <p class="bk-lead">
          Offizielle Logos, Anwendungsregeln, Farben und Schriften der Ultra Instinct Crew. Klar aufgebaut für Partner, Caster, Turnierveranstalter und unsere eigenen Teams.
        </p>

        <nav class="bk-toc text-mono" aria-label="Brandkit Kapitel">
          <a href="#identitaet" class="toc-chip">Identität</a>
          <a href="#logos" class="toc-chip">Logo-System</a>
          <a href="#regeln" class="toc-chip">Anwendungsregeln</a>
          <a href="#farben" class="toc-chip">Farbpalette</a>
          <a href="#typografie" class="toc-chip">Typografie</a>
          <a href="#team-wappen" class="toc-chip">Team-Wappen</a>
        </nav>
      </header>

      <!-- =================================================================
           IDENTITÄT & KURZBESCHREIBUNGEN
           ================================================================= -->
      <section id="identitaet" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-kicker text-mono">IDENTITÄT</span>
          <h2 class="bk-sec-title">MARKENNAME &amp; KURZTEXTE</h2>
          <p class="bk-sec-desc">
            Verbindliche Schreibweise unseres Namens sowie fertige Kurzbeschreibungen für Streams, Ankündigungen und Berichte.
          </p>
        </div>

        <article class="bento-card id-card">
          <span class="id-label text-mono">MARKENNAME &amp; KÜRZEL</span>
          <h3 class="id-value">Ultra Instinct Crew &bull; UIC</h3>
          <p class="id-note">
            Der vollständige Name lautet <strong>Ultra Instinct Crew</strong> (drei Wörter). Das Kürzel <strong>UIC</strong> wird durchgehend großgeschrieben und steht vor allen Teamnamen (z. B. <em>UIC Prime</em>, <em>UIC Hydra</em>).
          </p>
        </article>

        <div class="bento-card boilerplate-card">
          <div class="bp-head">
            <span class="id-label text-mono">OFFIZIELLE KURZTEXTE ZUM KOPIEREN</span>
          </div>
          <div class="bp-grid">
            {boilerplates.map((bp) => (
              <div class="bp-box">
                <div class="bp-top">
                  <span class="bp-label text-mono">{bp.label}</span>
                  <button
                    type="button"
                    class="bp-copy-btn text-mono"
                    data-copy-text={bp.text}
                  >
                    TEXT KOPIEREN
                  </button>
                </div>
                <p class="bp-text">{bp.text}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- =================================================================
           LOGO-SYSTEM (PRIMÄRES WAPPEN + 2x2 VARIANTEN)
           ================================================================= -->
      <section id="logos" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-kicker text-mono">LOGO-SYSTEM</span>
          <h2 class="bk-sec-title">LOGOMARKEN &amp; LOCKUPS</h2>
          <p class="bk-sec-desc">
            Das UIC-Logo besteht aus dem rautenförmigen <strong>Wappen</strong> und der einzeiligen <strong>Wortmarke „ULTRA INSTINCT CREW“</strong>. Es wird ausschließlich in Reinweiß (<code>#FFFFFF</code>) oder Tiefschwarz (<code>#000000</code>) eingesetzt.
          </p>
        </div>

        <!-- Primary Crest Showcase (Full-Width Split Card with Background Switcher) -->
        <div class="bento-card logo-master-card">
          <div class="lm-stage" id="master-logo-stage" data-bg="dark">
            <div class="lm-stage-controls text-mono">
              <span class="lm-status-pill">PRIMÄRLOGO &bull; WAPPEN</span>
              <div class="stage-bg-switch" role="group" aria-label="Hintergrund-Vorschau wechseln">
                <button type="button" class="bg-sw-btn is-active" data-stage-bg="dark">SCHWARZ</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="slate">DUNKELGRAU</button>
                <button type="button" class="bg-sw-btn" data-stage-bg="grid">RASTER</button>
              </div>
            </div>

            <div class="lm-preview-wrap">
              <img
                src="/assets/logo/logo.svg"
                alt="Offizielles Ultra Instinct Crew Vektor-Wappen"
                class="lm-logo-img"
                width="160"
                height="160"
              />
            </div>

            <span class="lm-dim-caption text-mono">VIEWBOX {logoViewBoxLabel} &bull; REINZEICHNUNG VEKTORPFAD</span>
          </div>

          <div class="lm-details">
            <div class="asset-meta-row text-mono">
              <span class="meta-type">PRIMÄRMARKE &bull; SYMBOL</span>
              <span class="meta-spec">Min. 32 px digital / 15 mm Print</span>
            </div>
            <h3 class="lm-title">UIC WAPPEN (SYMBOL)</h3>
            <p class="lm-desc">
              Das alleinstehende Rauten-Wappen in Reinweiß (<code>#FFFFFF</code>) auf transparentem Hintergrund. Optimal für quadratische oder runde Profilbilder (Discord, Twitch, X, Favicons), Broadcast-Badges, Stickereien und kompakte Team-Abzeichen.
            </p>

            <div class="lm-specs-grid text-mono">
              <div class="spec-mini">
                <span class="sm-lbl">VEKTOR</span>
                <span class="sm-val">SVG ({logoViewBoxLabel})</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">RASTER</span>
                <span class="sm-val">{logoPngAsset ? `PNG (${logoPngAsset.sizeLabel})` : 'PNG Hochauflösend'}</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">FORMAT</span>
                <span class="sm-val">1 : 1 Safe-Canvas</span>
              </div>
              <div class="spec-mini">
                <span class="sm-lbl">FARBE</span>
                <span class="sm-val">#FFFFFF</span>
              </div>
            </div>

            <div class="lm-actions text-mono">
              <a href="/assets/logo/logo.svg" download="uic-logo.svg" class="dl-pill is-primary">
                {logoSvgAsset ? `SVG (${logoSvgAsset.sizeLabel}) ↓` : 'SVG ↓'}
              </a>
              <a href="/assets/logo/logo.png" download="uic-logo.png" class="dl-pill">
                {logoPngAsset ? `PNG (${logoPngAsset.sizeLabel}) ↓` : 'PNG ↓'}
              </a>
              {rawLogoSvg && (
                <button
                  type="button"
                  class="dl-pill is-copy"
                  data-copy-svg={rawLogoSvg}
                >
                  SVG-CODE KOPIEREN
                </button>
              )}
            </div>
          </div>
        </div>

        <!-- Secondary Logo Variants (Symmetric 2x2 Grid) -->
        <div class="lockups-grid">
          {logoVariants.map((item) => (
            <article class="bento-card logo-card">
              <div class="lc-top text-mono">
                <span class="lc-role">{item.role}</span>
                <span class="lc-dim">{item.dimensions}</span>
              </div>

              <div class={`lc-stage ${item.canvasMode === 'light' ? 'is-light' : 'is-dark'}`}>
                {item.svgAsset && (
                  <img
                    src={item.svgAsset.src}
                    alt={item.title}
                    class={`lc-img ${item.previewClass}`}
                    width={item.imgWidth}
                    height={item.imgHeight}
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </div>

              <div class="lc-body">
                <div class="lc-title-row">
                  <h3 class="lc-title">{item.title}</h3>
                  <span class="lc-min text-mono">{item.minSize}</span>
                </div>
                <p class="lc-desc">{item.desc}</p>

                <div class="lc-actions text-mono">
                  {item.svgAsset && (
                    <a
                      href={item.svgAsset.src}
                      download={`${item.downloadPrefix}.svg`}
                      class="dl-pill is-primary"
                    >
                      SVG ({item.svgAsset.sizeLabel}) &darr;
                    </a>
                  )}
                  {item.pngAsset && (
                    <a
                      href={item.pngAsset.src}
                      download={`${item.downloadPrefix}.png`}
                      class="dl-pill"
                    >
                      PNG ({item.pngAsset.sizeLabel}) &darr;
                    </a>
                  )}
                  {item.svgAsset?.svgMarkup && (
                    <button
                      type="button"
                      class="dl-pill is-copy"
                      data-copy-svg={item.svgAsset.svgMarkup}
                    >
                      SVG-CODE KOPIEREN
                    </button>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- =================================================================
           ANWENDUNGSREGELN (VISUELLE DO'S & DON'TS)
           ================================================================= -->
      <section id="regeln" class="bk-section">
        <div class="bk-sec-head">
          <span class="bk-kicker text-mono">ANWENDUNGSREGELN</span>
          <h2 class="bk-sec-title">RICHTIGE &amp; FALSCHE DARSTELLUNG</h2>
          <p class="bk-sec-desc">
            Damit Wappen und Wortmarke auf allen Kanälen sauber wirken, gelten diese Grundregeln für Kontrast, Paarungen und Proportionen.
          </p>
        </div>

        <!-- ERLAUBT (DO) - 2 Wide Visual Cards -->
        <div class="rules-group">
          <div class="rules-group-label is-do text-mono">ERLAUBT (RICHTIGE ANWENDUNG)</div>
          <div class="rules-do-grid">
            <!-- Do 1: Contrast -->
            <article class="bento-card visual-rule-card is-do">
              <div class="vr-stage vr-stage-contrast">
                <div class="vr-half is-dark">
                  <img src="/assets/logo/logo.svg" alt="Weißes Logo auf Schwarz" width="64" height="64" />
                  <span class="vr-caption text-mono">#FFFFFF AUF DUNKEL</span>
                </div>
                <div class="vr-half is-light">
                  <img src="/assets/logo/logo-dark.svg" alt="Schwarzes Logo auf Hell" width="64" height="64" />
                  <span class="vr-caption is-dark-txt text-mono">#000000 AUF HELL</span>
                </div>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-do text-mono">✓ RICHTIG: KLARER KONTRAST</span>
                <h3 class="vr-title">Weiß auf Dunkel, Schwarz auf Hell</h3>
                <p class="vr-desc">
                  Auf dunklen Hintergründen wird immer die weiße Reinzeichnung (<code>#FFFFFF</code>) eingesetzt, auf hellen Flächen und Dokumenten die schwarze Variante (<code>#000000</code>).
                </p>
              </div>
            </article>

            <!-- Do 2: Co-Branding & Matchups -->
            <article class="bento-card visual-rule-card is-do">
              <div class="vr-stage vr-stage-cobrand">
                <div class="vr-cobrand-pair">
                  <img src="/assets/logo/logo.svg" alt="UIC Wappen" width="58" height="58" />
                  <span class="vr-cobrand-sep" aria-hidden="true"></span>
                  <img src="/assets/logo/riftops-horizontal-dark.svg" alt="Partner Logo" width="136" height="32" />
                </div>
                <span class="vr-caption text-mono">OPTISCHE BALANCE &bull; KLARE TRENNUNG</span>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-do text-mono">✓ RICHTIG: CO-BRANDING &amp; MATCHUPS</span>
                <h3 class="vr-title">Optisch ausgewogene Paarung</h3>
                <p class="vr-desc">
                  Bei Paarungen mit Partnern oder Gegner-Teams werden beide Logos nach optischer Größe angeglichen und durch eine feine Linie oder <code>&times;</code> / <code>VS</code> getrennt.
                </p>
              </div>
            </article>
          </div>
        </div>

        <!-- UNTERSAGT (DON'T) - 4 Visual Cards -->
        <div class="rules-group">
          <div class="rules-group-label is-dont text-mono">UNTERSAGT (FEHLERHAFTE ANWENDUNG)</div>
          <div class="rules-dont-grid">
            <!-- Don't 1: Stretch -->
            <article class="bento-card visual-rule-card is-dont">
              <div class="vr-stage vr-stage-dont">
                <img src="/assets/logo/logo.svg" alt="" width="64" height="64" class="demo-stretch" />
                <span class="vr-strike" aria-hidden="true"></span>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-dont text-mono">✕ FALSCH: VERZERREN</span>
                <h3 class="vr-title">Nicht stauchen oder strecken</h3>
                <p class="vr-desc">Proportionen von Wappen und Wortmarke niemals unproportional skalieren.</p>
              </div>
            </article>

            <!-- Don't 2: Recolor / Neon -->
            <article class="bento-card visual-rule-card is-dont">
              <div class="vr-stage vr-stage-dont">
                <img src="/assets/logo/logo.svg" alt="" width="64" height="64" class="demo-recolor" />
                <span class="vr-strike" aria-hidden="true"></span>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-dont text-mono">✕ FALSCH: FREMDFARBEN</span>
                <h3 class="vr-title">Keine bunten Farben oder Effekte</h3>
                <p class="vr-desc">Keine Farbverläufe, Neon-Scheine oder farbige Konturen auf das Logo anwenden.</p>
              </div>
            </article>

            <!-- Don't 3: Rotate / Crop -->
            <article class="bento-card visual-rule-card is-dont">
              <div class="vr-stage vr-stage-dont">
                <img src="/assets/logo/logo.svg" alt="" width="64" height="64" class="demo-rotate" />
                <span class="vr-strike" aria-hidden="true"></span>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-dont text-mono">✕ FALSCH: DREHEN &amp; UMBAUEN</span>
                <h3 class="vr-title">Nicht kippen oder umstellen</h3>
                <p class="vr-desc">Das Wappen nicht drehen, anschneiden oder die Lockup-Anordnung verändern.</p>
              </div>
            </article>

            <!-- Don't 4: Low Contrast -->
            <article class="bento-card visual-rule-card is-dont">
              <div class="vr-stage vr-stage-dont is-low-contrast">
                <img src="/assets/logo/logo.svg" alt="" width="64" height="64" class="demo-lowcontrast" />
                <span class="vr-strike" aria-hidden="true"></span>
              </div>
              <div class="vr-body">
                <span class="rule-badge is-dont text-mono">✕ FALSCH: KONTRASTVERLUST</span>
                <h3 class="vr-title">Nicht auf unruhigem Grund</h3>
                <p class="vr-desc">Weißes Logo niemals auf helle oder unruhige Fotos ohne Abdunkelung setzen.</p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- =================================================================
           FARBPALETTE
           ================================================================= -->
      <section id="farben" class="bk-section">

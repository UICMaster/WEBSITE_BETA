---
// src/pages/honored/[slug].astro
import Layout from '../../layouts/Layout.astro';
import { honoredPlayers, type HonoredPlayerDossier } from '../../utils/honoredData';

export function getStaticPaths() {
  return honoredPlayers.map((player) => ({
    params: { slug: player.slug },
    props: { player }
  }));
}

interface Props {
  player: HonoredPlayerDossier;
}

const { player } = Astro.props;
const firstVoice = player.audioTrack || player.voiceClips[0] || null;
const firstVideo = player.videos[0] || null;

// 44-bar deterministic studio waveform profile for the single-track audio player
const waveformHeights = [
  28, 42, 64, 52, 78, 92, 60, 46, 84, 96, 72, 54, 68, 88, 100, 76, 58, 44, 70, 90,
  82, 62, 94, 74, 50, 66, 86, 98, 70, 56, 80, 92, 64, 48, 76, 88, 60, 44, 54, 38,
  50, 34, 42, 26
];
---

<Layout
  title={`${player.name} – Ruhmeshalle | Ultra Instinct Crew`}
  description={`Ruhmeshalle der Ultra Instinct Crew: Werdegang, Biografie, Sprachaufnahmen und gespielte Splits von ${player.name}.`}
>
  <!-- Schema.org ProfilePage & Person Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    "mainEntity": {
      "@type": "Person",
      "name": player.name,
      "alternateName": player.primeLeagueAccountName || player.name,
      "description": player.bioLead || player.title || `Ehrenmitglied der Ultra Instinct Crew: ${player.name}`,
      "image": player.photoSrc ? (player.photoSrc.startsWith('http') ? player.photoSrc : `https://ultrainstinctcrew.com${player.photoSrc}`) : 'https://ultrainstinctcrew.com/assets/logo/logo.png',
      "jobTitle": player.title || "Ehrenmitglied & eSports Veteran",
      "worksFor": {
        "@type": "SportsOrganization",
        "@id": "https://ultrainstinctcrew.com/#organization",
        "name": "Ultra Instinct Crew",
        "url": "https://ultrainstinctcrew.com/"
      }
    }
  })} />

  <div class="hall-page section-pad">
    <div class="container hall-container">

      <!-- Top Navigation Bar -->
      <nav class="hall-topbar" aria-label="Ruhmeshalle Navigation">
        <div class="topbar-left">
          <a href="/#teams" class="nav-chip text-mono">&larr; ZURÜCK ZU DEN TEAMS</a>
          <a href="/honored" class="nav-chip text-mono">ALLE MITGLIEDER DER RUHMESHALLE</a>
        </div>

        <div class="topbar-right text-mono">
          <span class="serial-lbl">#{player.playerId}</span>
          <span class="sep">&bull;</span>
          <span>
            AUFGENOMMEN AM <time datetime={player.inductedAtRaw}>{player.inductedAtFormatted}</time>
          </span>
        </div>
      </nav>

      <!-- =====================================================================
           1. HERO PROFILE CARD (Portrait Left | Identity & Phrases Right)
           ===================================================================== -->
      <section class="hero-profile-card" aria-label="Persönliches Profil">
        <!-- Left: Clean Edge-to-Edge Portrait (matching main page aesthetic) -->
        <div class="hero-portrait-stage">
          <div class="portrait-badges text-mono">
            <span class="crown-badge">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="1.5"><path d="M2 4l3 12h14l3-12-6 7-4-7-4 7-6-7zm3 16h14"/></svg>
              <span>RUHMESHALLE</span>
            </span>
          </div>

          <img
            src={player.photoSrc}
            alt={`Porträt von ${player.name}`}
            class="portrait-img"
            width="360"
            height="400"
            decoding="async"
            onerror="this.src='/assets/honored/honored_placeholder.webp'"
          />
          <div class="portrait-shade"></div>
        </div>

        <!-- Right: Identity, Timestamp & Phrases -->
        <div class="hero-identity-body">
          <div class="identity-top">
            <div class="meta-pills-row text-mono">
              <span class="meta-pill">
                AUFNAHME: <time datetime={player.inductedAtRaw}>{player.inductedAtFormatted}</time>
              </span>

              {player.primeLeagueUserUrl && (
                <a
                  href={player.primeLeagueUserUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="meta-pill meta-pill-link"
                  title="Offizielles Prime League Profil öffnen"
                >
                  <span>PRIME LEAGUE: {player.primeLeagueAccountName || `#${player.primeLeagueUserId}`}</span>
                  <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>

            <h1 class="person-name">{player.name}</h1>
            <p class="person-title">{player.title}</p>

            <!-- Open Intro Text Underneath Title -->
            <p class="hero-intro-text">
              {player.heroIntro || '[Platzhalter: Kurz-Intro unter dem Titel in data/honored.json unter "heroIntro" hinterlegen.]'}
            </p>
          </div>

          <!-- Redesigned Phrases / Signature Quotes Area -->
          <div class="phrases-section">
            <div class="phrases-head">
              <span class="block-label text-mono">LEGENDÄRE SPRÜCHE & ZITATE</span>
              <span class="phrases-head-line" aria-hidden="true"></span>
            </div>

            {player.phrases.length > 0 ? (
              <div class="phrases-grid">
                {player.phrases.map((phrase) => (
                  <blockquote class="phrase-card">
                    <svg class="phrase-quote-mark" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                    </svg>
                    <p class="phrase-text">„{phrase}“</p>
                  </blockquote>
                ))}
              </div>
            ) : (
              <p class="placeholder-text">[Platzhalter: Keine Sprüche hinterlegt]</p>
            )}
          </div>
        </div>
      </section>

      <!-- =====================================================================
           2. SINGLE-TRACK SIGNATURE STUDIO AUDIO CONSOLE
           ===================================================================== -->
      <section class="standalone-audio-bar" id="gad-player-shell" aria-label="Audio-Player für Ruhmeshalle-Aufnahme">
        {firstVoice ? (
          <>
            <audio id="gad-audio" preload="metadata" src={firstVoice.src}></audio>

            <!-- Left: Tactile Play/Pause Trigger & Single-Track Identity -->
            <div class="sab-left">
              <button
                type="button"
                id="gad-play-btn"
                class="sab-play-btn"
                aria-label="Audio abspielen oder pausieren"
              >
                <svg id="gad-icon-play" width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                <svg id="gad-icon-pause" class="hidden" width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
              </button>

              <div class="sab-track-meta">
                <div class="sab-kicker-row text-mono">
                  <span id="gad-current-ctx" class="sab-badge">{firstVoice.context || 'Ruhmeshalle Audio-Track'}</span>
                </div>
                <span id="gad-current-title" class="sab-title">{firstVoice.title}</span>
              </div>
            </div>

            <!-- Center: Interactive Studio Waveform Scrubber & Timecode Pills -->
            <div class="sab-center">
              <span id="gad-time-cur" class="sab-time sab-time-cur text-mono">0:00</span>

              <div
                id="gad-scrub"
                class="sab-scrub"
                role="slider"
                tabindex="0"
                aria-label="Audio-Fortschritt"
                aria-valuemin="0"
                aria-valuemax="100"
                aria-valuenow="0"
              >
                <!-- Base Unplayed Waveform Bars -->
                <div class="sab-wave-layer sab-wave-bg" aria-hidden="true">
                  {waveformHeights.map((h) => (
                    <span class="sab-wave-bar" style={`height: ${h}%`}></span>
                  ))}
                </div>

                <!-- Active Gold/White Clipped Waveform Bars -->
                <div id="gad-scrub-fill" class="sab-wave-layer sab-wave-fill" aria-hidden="true">
                  {waveformHeights.map((h) => (
                    <span class="sab-wave-bar" style={`height: ${h}%`}></span>
                  ))}
                </div>

                <!-- Glowing Playhead Needle -->
                <div id="gad-scrub-thumb" class="sab-playhead" aria-hidden="true"></div>
              </div>

              <span id="gad-time-dur" class="sab-time text-mono">0:00</span>
            </div>

            <!-- Right: Volume Slider & Mute Control -->
            <div class="sab-right">
              <button
                type="button"
                id="gad-mute-btn"
                class="sab-icon-btn"
                aria-label="Stummschalten"
                title="Ton ein/aus"
              >
                <svg id="gad-icon-vol" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
                <svg id="gad-icon-muted" class="hidden" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>
              </button>

              <div class="sab-vol-wrap">
                <input
                  type="range"
                  id="gad-vol-slider"
                  class="sab-vol-slider"
                  min="0"
                  max="100"
                  value="85"
                  aria-label="Lautstärke"
                />
              </div>
            </div>
          </>
        ) : (
          <div class="sab-empty text-mono">
            [Platzhalter: Keine Audiodatei in data/honored.json hinterlegt]
          </div>
        )}
      </section>

      <!-- =====================================================================
           3. WIDE BIOGRAPHY (With Titles, Subtitles & Chapters) + IMPACT & WERDEGANG
           ===================================================================== -->
      <section class="bio-and-impact-grid" aria-label="Biografie, Einfluss und Werdegang">
        <!-- Wide Biography Card (Left) -->
        <article class="bento-card bio-card">
          <div class="card-head">
            <span class="block-label text-mono">ÜBER DIE PERSON</span>
            <h2 class="card-title">BIOGRAFIE & HINTERGRUND</h2>
          </div>

          {player.bioLead && (
            <p class="bio-lead">{player.bioLead}</p>
          )}

          <div class="bio-chapters">
            {player.bioSections.map((section) => (
              <div class="bio-chapter">
                {section.subtitle && (
                  <span class="chapter-subtitle text-mono">{section.subtitle}</span>
                )}
                <h3 class="chapter-title">{section.title}</h3>
                <div class="chapter-paragraphs">
                  {section.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>
              </div>
            ))}
          </div>
        </article>

        <!-- Impact & Milestones Stack (Right) -->
        <div class="side-stack">
          <!-- Impact on the Organisation -->
          <div class="bento-card">
            <div class="card-head">
              <span class="block-label text-mono">EINFLUSS AUF DIE ORGANISATION</span>
              <h3 class="card-subtitle">BEITRAG FÜR VEREIN & COMMUNITY</h3>
            </div>

            <ul class="impact-list">
              {player.impact.map((point, idx) => (
                <li class="impact-item">
                  <span class="impact-num text-mono">{String(idx + 1).padStart(2, '0')}</span>
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Milestones (Werdegang) -->
          {player.milestones.length > 0 && (
            <div class="bento-card">
              <div class="card-head">
                <span class="block-label text-mono">WERDEGANG</span>
                <h3 class="card-subtitle">STATIONEN & MEILENSTEINE</h3>
              </div>

              <div class="milestones-list">
                {player.milestones.map((ms) => (
                  <div class="ms-row">
                    <span class="ms-date text-mono">{ms.date}</span>
                    <div class="ms-body">
                      <strong class="ms-label">{ms.label}</strong>
                      {ms.detail && <p class="ms-detail">{ms.detail}</p>}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- =====================================================================
           4. 50/50 SPLIT: PRIME LEAGUE SPLITS ROADMAP (LEFT) & VIDEO AREA (RIGHT)
           ===================================================================== -->
      <section class="split-two-col" aria-label="Gespielte Splits und Video-Bereich">
        <!-- Left Half: Splits Roadmap -->
        <div class="bento-card">
          <div class="card-head-flex">
            <div>
              <span class="block-label text-mono">ROADMAP & EINSÄTZE</span>
              <h2 class="card-title">GESPIELTE PRIME LEAGUE SPLITS</h2>
            </div>

            {player.primeLeagueUserUrl && (
              <a
                href={player.primeLeagueUserUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ext-pill text-mono"
              >
                <span>Prime League Akte</span>
                <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>

          {player.seasons.length > 0 ? (
            <div class="roadmap-list">
              {player.seasons.map((s, idx) => (
                <div class="roadmap-item">
                  <div class="rm-rail">
                    <span class="rm-idx text-mono">{String(idx + 1).padStart(2, '0')}</span>
                    {idx < player.seasons.length - 1 && <span class="rm-line"></span>}
                  </div>

                  <div class="rm-card">
                    <div class="rm-top text-mono">
                      <span class="rm-season">{s.season}</span>
                      <span class="rm-badge">CHRONIK</span>
                    </div>

                    <div class="rm-team-row">
                      <div class="name-with-link">
                        <h3 class="rm-team">{s.team}</h3>
                        {s.teamLink && (
                          <a
                            href={s.teamLink}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="link-forward-arrow"
                            title={`${s.team} auf Prime League öffnen`}
                            aria-label={`${s.team} auf Prime League öffnen`}
                          >
                            <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </a>
                        )}
                      </div>
                      {s.division && <span class="rm-div text-mono">{s.division}</span>}
                    </div>

                    {s.note && <p class="rm-note">{s.note}</p>}
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <p class="placeholder-text">[Platzhalter: Keine gespielten Splits hinterlegt]</p>
          )}
        </div>

        <!-- Right Half: Video Area -->
        <div class="bento-card">
          <div class="card-head">
            <span class="block-label text-mono">BEWEGTBILD & HIGHLIGHTS</span>
            <h2 class="card-title">VIDEO-BEREICH</h2>
          </div>

          {firstVideo ? (
            <div class="video-stack">
              <div class="video-frame">
                <video
                  id="hall-video-el"
                  controls
                  preload="metadata"
                  poster={firstVideo.poster}
                  class="video-el"
                  src={firstVideo.src}
                >
                  Dein Browser unterstützt das Video-Element nicht.
                </video>
              </div>

              <div class="video-info-box">
                <h3 id="hall-video-title" class="video-title">{firstVideo.title}</h3>
                <p id="hall-video-desc" class="video-desc">{firstVideo.description || ''}</p>
              </div>

              {player.videos.length > 1 && (
                <div class="video-pills">
                  {player.videos.map((vid, idx) => (
                    <button
                      type="button"
                      class={`cinema-pill text-mono ${idx === 0 ? 'is-active' : ''}`}
                      data-vid-index={idx}
                      data-vid-src={vid.src}
                      data-vid-title={vid.title}
                      data-vid-desc={vid.description || ''}
                    >
                      #{idx + 1} {vid.title}
                    </button>
                  ))}
                </div>
              )}
            </div>
          ) : (
            <p class="placeholder-text">[Platzhalter: Kein Video in data/honored.json hinterlegt]</p>
          )}
        </div>
      </section>

      <!-- =====================================================================
           5. IMAGES & GALLERY SECTION (Bilder & Eindrücke)
           ===================================================================== -->
      <section class="bento-card gallery-section" aria-label="Bilder und Galerie">
        <div class="card-head-flex">
          <div>
            <span class="block-label text-mono">ARCHIV & IMPRESSIONEN</span>
            <h2 class="card-title">BILDER & MOMENTE</h2>
          </div>
          <span class="gallery-count text-mono">{player.images.length} AUFNAHMEN</span>
        </div>

        {player.images.length > 0 ? (
          <div class="gallery-grid">
            {player.images.map((img) => (
              <figure class="gallery-item">
                <div class="gallery-img-wrap">
                  <img
                    src={img.src}
                    alt={img.title || img.caption || `Bild von ${player.name}`}
                    class="gallery-img"
                    loading="lazy"
                    decoding="async"
                    onerror="this.src='/assets/honored/honored_placeholder.webp'"
                  />
                  {img.date && <span class="gallery-date text-mono">{img.date}</span>}
                </div>
                {(img.title || img.caption) && (
                  <figcaption class="gallery-caption">
                    {img.title && <strong class="gallery-item-title">{img.title}</strong>}
                    {img.caption && <p class="gallery-item-desc">{img.caption}</p>}
                  </figcaption>
                )}
              </figure>
            ))}
          </div>
        ) : (
          <p class="placeholder-text">[Platzhalter: Keine Bilder in data/honored.json hinterlegt]</p>
        )}
      </section>

    </div>
  </div>
</Layout>

<script>
  // Single-Track Signature Studio Audio Console Controller
  const playerShell = document.getElementById('gad-player-shell');
  const audio = document.getElementById('gad-audio') as HTMLAudioElement | null;
  const playBtn = document.getElementById('gad-play-btn');
  const muteBtn = document.getElementById('gad-mute-btn');
  const volSlider = document.getElementById('gad-vol-slider') as HTMLInputElement | null;
  const iconPlay = document.getElementById('gad-icon-play');
  const iconPause = document.getElementById('gad-icon-pause');
  const iconVol = document.getElementById('gad-icon-vol');
  const iconMuted = document.getElementById('gad-icon-muted');
  const visualizer = document.getElementById('gad-visualizer');
  const timeCur = document.getElementById('gad-time-cur');
  const timeDur = document.getElementById('gad-time-dur');
  const scrub = document.getElementById('gad-scrub');

  function formatTime(sec: number): string {
    if (!isFinite(sec) || sec < 0) return '0:00';
    const m = Math.floor(sec / 60);
    const s = Math.floor(sec % 60);
    return `${m}:${s < 10 ? '0' : ''}${s}`;
  }

  function updateProgressUI(pct: number) {
    const clamped = Math.max(0, Math.min(100, pct));
    scrub?.style.setProperty('--audio-pct', `${clamped}%`);
    scrub?.setAttribute('aria-valuenow', String(Math.round(clamped)));
  }

  if (audio && playBtn) {
    // Initialize default volume
    if (volSlider) {
      audio.volume = Number(volSlider.value) / 100;
      volSlider.style.setProperty('--vol-pct', `${volSlider.value}%`);
    }

    const syncState = () => {
      const playing = !audio.paused;
      iconPlay?.classList.toggle('hidden', playing);
      iconPause?.classList.toggle('hidden', !playing);
      visualizer?.classList.toggle('is-playing', playing);
      playBtn.classList.toggle('is-playing', playing);
      playerShell?.classList.toggle('is-playing', playing);
    };

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        audio.play().catch(() => {});
      } else {
        audio.pause();
      }
    });

    muteBtn?.addEventListener('click', () => {
      audio.muted = !audio.muted;
      iconVol?.classList.toggle('hidden', audio.muted);
      iconMuted?.classList.toggle('hidden', !audio.muted);
    });

    volSlider?.addEventListener('input', () => {
      const val = Number(volSlider.value);
      audio.volume = val / 100;
      audio.muted = val === 0;
      volSlider.style.setProperty('--vol-pct', `${val}%`);
      iconVol?.classList.toggle('hidden', audio.muted);
      iconMuted?.classList.toggle('hidden', !audio.muted);
    });

    audio.addEventListener('play', syncState);
    audio.addEventListener('pause', syncState);
    audio.addEventListener('ended', () => {
      syncState();
      updateProgressUI(0);
    });

    audio.addEventListener('timeupdate', () => {
      const c = audio.currentTime || 0;
      const d = audio.duration || 0;
      if (timeCur) timeCur.textContent = formatTime(c);
      if (timeDur && d > 0) timeDur.textContent = formatTime(d);
      if (d > 0) {
        updateProgressUI((c / d) * 100);
      }
    });

    audio.addEventListener('loadedmetadata', () => {
      if (timeDur) timeDur.textContent = formatTime(audio.duration || 0);
    });

    const seekFromClientX = (clientX: number) => {
      if (!scrub || !audio.duration) return;
      const rect = scrub.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
      audio.currentTime = ratio * audio.duration;
      updateProgressUI(ratio * 100);
    };

    let isScrubbing = false;
    scrub?.addEventListener('pointerdown', (e) => {
      isScrubbing = true;
      scrub.setPointerCapture(e.pointerId);
      seekFromClientX(e.clientX);
    });

    scrub?.addEventListener('pointermove', (e) => {
      if (!isScrubbing) return;
      seekFromClientX(e.clientX);
    });

    scrub?.addEventListener('pointerup', (e) => {
      if (!isScrubbing) return;
      isScrubbing = false;
      scrub.releasePointerCapture(e.pointerId);
    });

    scrub?.addEventListener('keydown', (e) => {
      if (!audio.duration) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        audio.currentTime = Math.min(audio.duration, audio.currentTime + 5);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        audio.currentTime = Math.max(0, audio.currentTime - 5);
      }
    });
  }

  // Video Switcher
  const videoEl = document.getElementById('hall-video-el') as HTMLVideoElement | null;
  const videoTitle = document.getElementById('hall-video-title');
  const videoDesc = document.getElementById('hall-video-desc');
  const videoPills = Array.from(document.querySelectorAll('.cinema-pill'));

  if (videoEl && videoPills.length > 0) {
    videoPills.forEach((pill) => {
      pill.addEventListener('click', () => {
        videoPills.forEach((p) => p.classList.remove('is-active'));
        pill.classList.add('is-active');
        const src = pill.getAttribute('data-vid-src');
        const title = pill.getAttribute('data-vid-title');
        const desc = pill.getAttribute('data-vid-desc');
        if (src) {
          videoEl.src = src;
          videoEl.load();
        }
        if (videoTitle && title) videoTitle.textContent = title;
        if (videoDesc) videoDesc.textContent = desc || '';
      });
    });
  }
</script>

<style>
  .hall-page {
    padding-top: 6.5rem;
    padding-bottom: 4.5rem;
    min-height: 100vh;
    background-color: #000000;
  }

  .hall-container {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  /* Top Navigation Bar */
  .hall-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .topbar-left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .nav-chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 1rem;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-sm);
    transition: all var(--transition-fast);
  }

  .nav-chip:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .topbar-right {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: var(--text-muted);
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
  }

  .serial-lbl {
    color: #ffffff;
    font-weight: 800;
  }

  .topbar-right time {
    color: #ffffff;
    font-weight: 700;
  }

  /* =====================================================================
     1. HERO PROFILE CARD (Clean Main-Page Aesthetic)
     ===================================================================== */
  .hero-profile-card {
    display: grid;
    grid-template-columns: 320px 1fr;
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .hero-portrait-stage {
    position: relative;
    min-height: 360px;
    background: #0d0d10;
    overflow: hidden;
    transform: translateZ(0);
  }

  .portrait-badges {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 4;
  }

  /* Gold used only where it matters: the Crown badge */
  .crown-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.6875rem;
    font-weight: 800;
    color: #fbbf24;
    background: rgba(10, 10, 14, 0.82);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid rgba(245, 158, 11, 0.4);
    padding: 4px 10px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.06em;
  }

  .portrait-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    -webkit-mask-image: linear-gradient(180deg, #000000 0%, #000000 92%, transparent 98%);
    mask-image: linear-gradient(180deg, #000000 0%, #000000 92%, transparent 98%);
    backface-visibility: hidden;
  }

  .portrait-shade {
    position: absolute;
    bottom: -2px;
    left: -1px;
    right: -1px;
    height: 28%;
    background: linear-gradient(180deg, transparent 0%, #0d0d10 94%, #0d0d10 100%);
    transform: translateZ(0);
    z-index: 2;
    pointer-events: none;
  }

  .hero-identity-body {
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-xl);
  }

  .identity-top {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .meta-pills-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 4px;
  }

  .meta-pill {
    font-size: 0.6875rem;
    color: var(--text-secondary);
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 4px 10px;
    border-radius: var(--radius-xs);
  }

  .meta-pill time {
    color: #ffffff;
    font-weight: 700;
  }

  .meta-pill-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
    color: #ffffff;
    transition: border-color var(--transition-fast);
  }

  .meta-pill-link:hover {
    border-color: rgba(255, 255, 255, 0.35);
  }

  .person-name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.8vw, 3rem);
    font-weight: 900;
    color: #ffffff;
    letter-spacing: -0.02em;
    line-height: 1.08;
  }

  .person-title {
    font-size: 1rem;
    color: var(--text-secondary);
    font-weight: 500;
  }

  /* Open Intro Text Area Underneath Title */
  .hero-intro-text {
    margin: 6px 0 0;
    padding-top: 12px;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.96rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 72ch;
  }

  .block-label {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--text-muted);
    letter-spacing: 0.08em;
    margin-bottom: 6px;
  }

  /* Redesigned Collector Quote Plaques (Phrases Area) */
  .phrases-section {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .phrases-head {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .phrases-head .block-label {
    margin-bottom: 0;
    white-space: nowrap;
  }

  .phrases-head-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.02) 100%);
  }

  .phrases-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(175px, 1fr));
    gap: 12px;
  }

  .phrase-card {
    position: relative;
    margin: 0;
    padding: 16px 36px 16px 16px;
    background: linear-gradient(145deg, #15151c 0%, #0f0f14 100%);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: var(--radius-sm);
    display: flex;
    align-items: center;
    overflow: hidden;
    transition: border-color var(--transition-fast), transform var(--transition-smooth), box-shadow var(--transition-fast);
  }

  .phrase-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 28px;
    height: 2px;
    background: #fbbf24;
    opacity: 0.85;
    transition: width var(--transition-fast);
  }

  .phrase-card:hover {
    border-color: rgba(251, 191, 36, 0.38);
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.4);
  }

  .phrase-card:hover::before {
    width: 56px;
  }

  .phrase-quote-mark {
    position: absolute;
    top: 12px;
    right: 12px;
    color: rgba(255, 255, 255, 0.14);
    pointer-events: none;
    transition: color var(--transition-fast);
  }

  .phrase-card:hover .phrase-quote-mark {
    color: rgba(251, 191, 36, 0.45);
  }

  .phrase-text {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  /* =====================================================================
     2. SINGLE-TRACK SIGNATURE STUDIO AUDIO CONSOLE
     ===================================================================== */
  .standalone-audio-bar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    padding: 16px 24px;
    background: linear-gradient(135deg, rgba(20, 20, 26, 0.88) 0%, rgba(12, 12, 16, 0.92) 100%);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-lg);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.55);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .standalone-audio-bar.is-playing {
    border-color: rgba(251, 191, 36, 0.35);
    box-shadow: 0 14px 36px rgba(0, 0, 0, 0.6), 0 0 28px rgba(251, 191, 36, 0.08);
  }

  .sab-left {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 260px;
    max-width: 360px;
  }

  .sab-play-btn {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    border: none;
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.06);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: transform var(--transition-fast), background var(--transition-fast), box-shadow var(--transition-fast);
  }

  .sab-play-btn:hover,
  .sab-play-btn.is-playing {
    background: #fbbf24;
    box-shadow: 0 0 0 5px rgba(251, 191, 36, 0.16), 0 0 20px rgba(251, 191, 36, 0.32);
    transform: scale(1.04);
  }

  .sab-track-meta {
    display: flex;
    flex-direction: column;
    gap: 5px;
    min-width: 0;
  }

  .sab-kicker-row {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    font-size: 0.65rem;
  }

  .sab-badge {
    display: inline-flex;
    align-items: center;
    font-weight: 800;
    color: #fbbf24;
    background: rgba(251, 191, 36, 0.1);
    border: 1px solid rgba(251, 191, 36, 0.28);
    padding: 2px 8px;
    border-radius: var(--radius-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .sab-title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Interactive Studio Waveform Scrubber */
  .sab-center {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 180px;
  }

  .sab-time {
    font-size: 0.72rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--text-secondary);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 3px 8px;
    border-radius: var(--radius-xs);
    min-width: 44px;
    text-align: center;
  }

  .sab-time-cur {
    color: #ffffff;
  }

  .sab-scrub {
    --audio-pct: 0%;
    position: relative;
    flex: 1;
    height: 34px;
    display: flex;
    align-items: center;
    cursor: pointer;
    user-select: none;
    touch-action: none;
    padding: 4px 0;
  }

  .sab-wave-layer {
    position: absolute;
    inset: 4px 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 3px;
    pointer-events: none;
  }

  .sab-wave-bar {
    flex: 1;
    min-width: 2px;
    border-radius: 999px;
    transition: background-color var(--transition-fast);
  }

  .sab-wave-bg .sab-wave-bar {
    background: rgba(255, 255, 255, 0.14);
  }

  .sab-scrub:hover .sab-wave-bg .sab-wave-bar {
    background: rgba(255, 255, 255, 0.22);
  }

  .sab-wave-fill {
    clip-path: inset(0 calc(100% - var(--audio-pct, 0%)) 0 0);
  }

  .sab-wave-fill .sab-wave-bar {
    background: linear-gradient(180deg, #fde68a 0%, #fbbf24 55%, #d97706 100%);
    box-shadow: 0 0 8px rgba(251, 191, 36, 0.35);
  }

  .sab-playhead {
    position: absolute;
    top: 2px;
    bottom: 2px;
    left: var(--audio-pct, 0%);
    width: 2px;
    background: #ffffff;
    border-radius: 999px;
    box-shadow: 0 0 10px #fbbf24, 0 0 4px #ffffff;
    transform: translateX(-50%);
    pointer-events: none;
    opacity: 0.9;
  }

  /* Right Volume & Mute Cluster */
  .sab-right {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-left: 14px;
    border-left: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sab-icon-btn {
    width: 34px;
    height: 34px;
    border-radius: var(--radius-xs);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: all var(--transition-fast);
  }

  .sab-icon-btn:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.1);
  }

  .sab-vol-wrap {
    display: flex;
    align-items: center;
    width: 82px;
  }

  .sab-vol-slider {
    --vol-pct: 85%;
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: linear-gradient(
      90deg,
      #fbbf24 0%,
      #fbbf24 var(--vol-pct),
      rgba(255, 255, 255, 0.14) var(--vol-pct),
      rgba(255, 255, 255, 0.14) 100%
    );
    outline: none;
    cursor: pointer;
  }

  .sab-vol-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #fbbf24;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.5);
    cursor: pointer;
    transition: transform var(--transition-fast);
  }

  .sab-vol-slider::-webkit-slider-thumb:hover {
    transform: scale(1.15);
  }

  .sab-vol-slider::-moz-range-thumb {
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #ffffff;
    border: 2px solid #fbbf24;
    box-shadow: 0 0 6px rgba(0, 0, 0, 0.5);
    cursor: pointer;
  }

  /* =====================================================================
     3. WIDE BIOGRAPHY (With Subtitles & Titles) + IMPACT & WERDEGANG
     ===================================================================== */
  .bio-and-impact-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.85fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .bento-card {
    background: #0d0d10;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-lg);
    padding: var(--space-2xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .card-head {
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-head-flex {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
    flex-wrap: wrap;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.2vw, 1.65rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.01em;
  }

  .card-subtitle {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
  }

  .bio-lead {
    font-size: 1.05rem;
    color: #ffffff;
    line-height: 1.7;
    font-weight: 500;
    padding-bottom: var(--space-md);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .bio-chapters {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .bio-chapter {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .chapter-subtitle {
    font-size: 0.6875rem;
    color: #fbbf24;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  .chapter-title {
    font-family: var(--font-display);
    font-size: 1.2rem;
    font-weight: 800;
    color: #ffffff;
  }

  .chapter-paragraphs {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    color: var(--text-secondary);
    font-size: 0.96rem;
    line-height: 1.75;
  }

  .side-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .impact-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .impact-item {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 14px;
    background: #121216;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .impact-num {
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    flex-shrink: 0;
  }

  .milestones-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ms-row {
    display: flex;
    gap: 14px;
    padding: 12px 14px;
    background: #121216;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: var(--radius-sm);
  }

  .ms-date {
    font-size: 0.72rem;
    font-weight: 800;
    color: #fbbf24;
    white-space: nowrap;
  }

  .ms-label {
    display: block;
    font-size: 0.92rem;
    color: #ffffff;
  }

  .ms-detail {
    font-size: 0.82rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }

  /* =====================================================================
     4. 50/50 SPLIT: ROADMAP & VIDEO
     ===================================================================== */
  .split-two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-xl);
    align-items: stretch;
  }

  .ext-pill {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-primary);
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 5px 10px;
    border-radius: var(--radius-xs);
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .ext-pill:hover {
    border-color: rgba(255, 255, 255, 0.35);
    color: #ffffff;
  }

  .roadmap-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-height: 410px;
    overflow-y: auto;
    padding-right: 6px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.2) transparent;
  }

  .roadmap-list::-webkit-scrollbar {
    width: 5px;
  }

  .roadmap-list::-webkit-scrollbar-track {
    background: transparent;
  }

  .roadmap-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.2);
    border-radius: 999px;
  }

  .roadmap-item {
    display: flex;
    gap: 14px;
  }

  .rm-rail {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .rm-idx {
    width: 28px;
    height: 28px;
    border-radius: var(--radius-xs);
    background: #141418;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .rm-line {
    width: 1px;
    flex: 1;
    background: rgba(255, 255, 255, 0.1);
    margin-top: 6px;
  }

  .rm-card {
    flex: 1;
    background: #121216;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rm-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    font-size: 0.72rem;
  }

  .rm-season {
    color: var(--text-secondary);
    font-weight: 700;
  }

  .rm-badge {
    font-size: 0.625rem;
    font-weight: 800;
    padding: 2px 7px;
    border-radius: var(--radius-xs);
    color: var(--text-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .rm-team-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .rm-team {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
  }

  .rm-div {
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .rm-note {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* Video Area */
  .video-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .video-frame {
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #050507;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .video-el {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #000000;
  }

  .video-info-box {
    background: #121216;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-sm);
    padding: var(--space-md);
  }

  .video-title {
    font-size: 1rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 4px;
  }

  .video-desc {
    font-size: 0.875rem;
    color: var(--text-secondary);
